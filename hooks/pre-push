#!/bin/sh
# Refuse a push of code that is not formatted or has clippy warnings.
# The tests are not run here: they take minutes, and every change lands
# with them run on its branch and again by the CI on three platforms,
# which is where a lint that only one platform sees is caught anyway.
# A push that touches no code (docs, hooks, workflows) is let through
# at once.
#
# Turn it on once, in the working tree:
#
#     git config core.hooksPath hooks
#
# To push past it the once: GREYCARD_NO_HOOK=1 git push

if [ -n "$GREYCARD_NO_HOOK" ]; then
    echo "pre-push: skipped"
    exit 0
fi

set -e
cd "$(git rev-parse --show-toplevel)"

# git hands the hook one line per ref being pushed: local ref, local
# sha, remote ref, remote sha. The remote sha is all zeros for a new
# branch or tag, and then every commit reachable from the local sha
# counts.
zero=0000000000000000000000000000000000000000
code=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    if git diff --name-only "$range" -- 'crates/' 'Cargo.toml' 'Cargo.lock' '*.slint' '*.wgsl' | grep -q .; then
        code=1
    fi
done

if [ "$code" = 0 ]; then
    echo "pre-push: no code in this push; nothing to check"
    exit 0
fi

echo "pre-push: cargo fmt"
cargo fmt --check
echo "pre-push: cargo clippy"
cargo clippy --all-targets -- -D warnings
echo "pre-push: clean"
