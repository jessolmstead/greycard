// The sections that list what lies on disk for the develop panel: the
// camera profiles and the looks. The presets are the left pane's, in
// presets.slint.

import { Theme } from "../theme.slint";
import { LookRow } from "../structs.slint";
import { Section, EditSlider, PanelButton } from "../controls.slint";

export component CameraSection inherits Section {
    in-out property <bool> collapsed-camera;
    in property <bool> raw-input;
    in property <string> source-note;
    in-out property <string> camera-profile;
    in property <[string]> camera-profile-names;
    in property <[string]> camera-profile-labels;
    in property <string> camera-profile-note;
    in property <string> camera-profile-warning;
    callback camera-profile-picked();

    title: "CAMERA PROFILE";
    icon: @image-url("../icons/camera.svg");
    hint: root.raw-input ? "" : "raw only";
    collapsed <=> root.collapsed-camera;
    // The list: the file's own calibrations
    // first, then the profiles in the profile
    // directory that fit this camera.
    if root.raw-input: Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 2px;
            spacing: 2px;
            for label[i] in root.camera-profile-labels: Rectangle {
                property <bool> on: root.camera-profile-names[i] == root.camera-profile;
                height: Theme.control-height;
                border-radius: Theme.radius-sm;
                background: on ? Theme.raised : (profile-row.has-hover ? Theme.hover : transparent);
                animate background { duration: Theme.quick; }
                profile-row := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.camera-profile = root.camera-profile-names[i];
                        root.camera-profile-picked();
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    Text {
                        text: label;
                        color: on ? Theme.text : (profile-row.has-hover ? Theme.text : Theme.text-secondary);
                        font-size: Theme.font-xs;
                        font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
        }
    }
    if root.raw-input && root.camera-profile-warning != "": Text {
        text: root.camera-profile-warning;
        color: Theme.label-yellow;
        font-size: Theme.font-xs;
        wrap: word-wrap;
    }
    if root.raw-input && root.camera-profile-note != "": Text {
        text: root.camera-profile-note;
        color: Theme.text-muted;
        font-size: Theme.font-xs;
        wrap: word-wrap;
    }
    if !root.raw-input: Text {
        text: root.source-note;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
}

export component LookSection inherits Section {
    in-out property <bool> collapsed-look;
    in-out property <string> look-name;
    in-out property <float> look-strength;
    /// The list: None, then the looks grouped by the body they were
    /// fitted for, the open frame's first, then the general looks.
    in property <[LookRow]> look-rows;
    /// The chosen table is off for this picture, and why.
    in property <string> look-mismatch;
    /// The refit button's text, empty when there is no refit to offer.
    in property <string> look-refit;
    callback look-refit-asked();
    callback look-group-toggled(string);
    in property <string> look-note;
    in property <string> look-warning;
    /// "fitted on" a body, when the chosen look was fitted on another
    /// body than the open frame's.
    in property <string> look-fitted;
    callback look-picked();
    /// The chosen look has files in the look folder to remove; None
    /// has none.
    in property <bool> look-removable;
    callback look-remove-asked();
    /// The chosen look has files in the look folder and none is a
    /// link, so it can be renamed.
    in property <bool> look-renamable;
    callback look-rename-asked();
    callback view-changed();
    callback match-asked();

    title: "LOOK";
    icon: @image-url("../icons/film.svg");
    collapsed <=> root.collapsed-look;
    // The list: no look first, then the tables
    // the look directory holds, grouped by the
    // body they were fitted for when any was.
    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 2px;
            spacing: 2px;
            for row in root.look-rows: Rectangle {
                property <bool> on: !row.heading && row.name == root.look-name;
                height: Theme.control-height;
                border-radius: Theme.radius-sm;
                background: on ? Theme.raised : (look-row.has-hover ? Theme.hover : transparent);
                animate background { duration: Theme.quick; }
                look-row := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    accessible-role: button;
                    // Never a bare name: a look may be called anything,
                    // "Fit" included, and the panel's tests find the
                    // footer's Fit by its label.
                    accessible-label: row.heading
                        ? (row.folded ? "Unfold " : "Fold ") + row.label
                        : "Look " + row.label;
                    clicked => {
                        if (row.heading) {
                            root.look-group-toggled(row.name);
                        } else {
                            root.look-name = row.name;
                            root.look-picked();
                        }
                    }
                }
                // A heading: the fold's triangle, the body, a mark
                // for the open frame's own, and the count.
                if row.heading: HorizontalLayout {
                    padding-left: 2px;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-1;
                    Rectangle {
                        width: 14px;
                        Image {
                            source: @image-url("../icons/chevron-right.svg");
                            colorize: look-row.has-hover ? Theme.text : Theme.text-muted;
                            width: 10px;
                            height: 10px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            transform-rotation: row.folded ? 0deg : 90deg;
                        }
                    }
                    Text {
                        text: row.label;
                        color: look-row.has-hover ? Theme.text : Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if row.own: Text {
                        text: "this camera";
                        color: Theme.accent;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.note;
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                }
                // A look, set in under its heading's text when it has
                // one; with the curves it has a table for, and dimmed
                // when it has none for this picture's.
                if !row.heading: HorizontalLayout {
                    // The heading's own padding, its triangle's room
                    // and its spacing, so the names line up with it.
                    padding-left: row.indented ? 2px + 14px + Theme.space-1 : Theme.space-2;
                    padding-right: Theme.space-2;
                    spacing: Theme.space-2;
                    Text {
                        text: row.label;
                        color: row.off
                            ? Theme.text-muted
                            : (on || look-row.has-hover ? Theme.text : Theme.text-secondary);
                        font-size: Theme.font-xs;
                        font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if row.note != "": Text {
                        text: row.note;
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    EditSlider {
        label: "Strength";
        enabled: root.look-name != "none";
        minimum: 0;
        maximum: 1;
        default: 1;
        step: 0.01;
        value <=> root.look-strength;
        scale: 100;
        text: round(root.look-strength * 100) + "%";
        changed(v) => { root.view-changed(); }
    }
    if root.look-warning != "": Text {
        text: root.look-warning;
        color: Theme.label-yellow;
        font-size: Theme.font-xs;
        wrap: word-wrap;
    }
    if root.look-mismatch != "": Text {
        text: root.look-mismatch;
        color: Theme.label-yellow;
        font-size: Theme.font-xs;
        wrap: word-wrap;
    }
    if root.look-refit != "": HorizontalLayout {
        alignment: end;
        // The camera match's sheet, over this look's
        // group, under the picture's display curve.
        PanelButton {
            text: root.look-refit;
            clicked => { root.look-refit-asked(); }
        }
    }
    if root.look-fitted != "": Text {
        text: root.look-fitted;
        color: Theme.text-secondary;
        font-size: Theme.font-xs;
        wrap: word-wrap;
    }
    if root.look-note != "": Text {
        text: root.look-note;
        color: Theme.text-muted;
        font-size: Theme.font-xs;
        wrap: word-wrap;
    }
    // The chosen look renamed, or its files to the trash, each behind
    // a sheet: a row of their own, the three buttons below not leaving
    // room for them.
    if root.look-removable || root.look-renamable: HorizontalLayout {
        spacing: Theme.space-2;
        alignment: end;
        if root.look-renamable: PanelButton {
            text: "Rename…";
            icon: @image-url("../icons/pencil.svg");
            clicked => { root.look-rename-asked(); }
        }
        if root.look-removable: PanelButton {
            text: "Remove this look…";
            icon: @image-url("../icons/trash-2.svg");
            clicked => { root.look-remove-asked(); }
        }
    }
    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: end;
        // The camera match: a look fitted per body
        // and picture style from the raws' JPEGs.
        PanelButton {
            text: "Fit this camera's look…";
            clicked => { root.match-asked(); }
        }
        // Back to no look at a full strength,
        // which is what the section opens at.
        PanelButton {
            text: "Reset";
            icon: @image-url("../icons/rotate-ccw.svg");
            clicked => {
                root.look-name = "none";
                root.look-strength = 1.0;
                root.look-picked();
            }
        }
    }
}
