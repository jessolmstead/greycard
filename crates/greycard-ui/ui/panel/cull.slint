// The CULLING section: the mode's keys, the frame's turn, the
// browser's filter, the compare view and the two ways out.

import { Theme } from "../theme.slint";
import { FilterChip, FacetRow } from "../structs.slint";
import { Section, PanelButton, Segmented, Toggle } from "../controls.slint";
import { FilterBar } from "filter.slint";

export component CullSection inherits Section {
    callback frame-turned(int);
    in-out property <bool> grid-open;
    callback cull-leave();
    in-out property <string> compare-text;
    callback compare-changed(int);
    in-out property <bool> move-on;
    callback move-on-changed();
    in-out property <[FilterChip]> filter-stars;
    in-out property <[FilterChip]> filter-flags;
    in-out property <[FilterChip]> filter-labels;
    in-out property <bool> filter-exact;
    in-out property <string> filter-text;
    in-out property <int> filter-shown;
    in-out property <int> filter-total;
    in-out property <bool> filter-on;
    in-out property <bool> filter-focus;
    in property <[FacetRow]> filter-facets;
    in property <string> filter-facet-note;
    callback filter-facet-toggled(int, string);
    in-out property <bool> collapsed-culling;
    callback filter-star-picked(int);
    callback filter-flag-toggled(int);
    callback filter-label-toggled(int);
    callback filter-exact-toggled();
    callback filter-text-edited(string);
    callback filter-cleared();
    in property <int> reject-count;
    callback rejects-asked();
    /// Move back: the frames of the selection in a rejects folder, and
    /// the folder above by name.
    in property <int> back-count;
    in property <string> back-to;
    callback move-back();
    callback delete-asked(string);
    /// "Remove rejects from Archive...", one an archive (§216).
    in property <[string]> archive-rejects-choices;
    callback archive-rejects-asked(int);
    callback focus-keys();

    title: "CULLING";
    icon: @image-url("../icons/image.svg");
    hint: "C";
    collapsed <=> root.collapsed-culling;
    Text {
        text: "Camera JPEG. Enter develops.";
        font-size: Theme.font-xs;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    Text {
        text: "1-5 stars · P pick · X reject · U unflag · 6-9 label · Space 1:1 · V compare";
        font-size: Theme.font-xs;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    // The frame's own turn, for the shot the
    // camera's tag got wrong. Nothing develops.
    HorizontalLayout {
        spacing: Theme.space-2;
        Text { text: "Turn"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
        PanelButton {
            text: "[";
            icon: @image-url("../icons/rotate-ccw.svg");
            clicked => { root.frame-turned(-1); }
        }
        PanelButton {
            text: "]";
            icon: @image-url("../icons/rotate-cw.svg");
            clicked => { root.frame-turned(1); }
        }
    }
    // The same filter the grid's header holds,
    // a group of chips to a row: the panel is
    // 320px wide and the header's one row
    // would not fit in it.
    Text {
        text: "Show";
        color: Theme.text;
        font-size: Theme.font-sm;
        vertical-alignment: center;
    }
    FilterBar {
        stacked: true;
        takes-focus: !root.grid-open;
        wanted <=> root.filter-focus;
        stars: root.filter-stars;
        flags: root.filter-flags;
        labels: root.filter-labels;
        facets: root.filter-facets;
        facet-note: root.filter-facet-note;
        facet-toggled(c, k) => { root.filter-facet-toggled(c, k); }
        exact: root.filter-exact;
        shown: root.filter-shown;
        total: root.filter-total;
        on: root.filter-on;
        text <=> root.filter-text;
        star-picked(i) => { root.filter-star-picked(i); }
        flag-toggled(i) => { root.filter-flag-toggled(i); }
        label-toggled(i) => { root.filter-label-toggled(i); }
        exact-toggled => { root.filter-exact-toggled(); }
        text-edited(t) => { root.filter-text-edited(t); }
        cleared => { root.filter-cleared(); }
        released => { root.focus-keys(); }
    }
    HorizontalLayout {
        spacing: Theme.space-2;
        Text { text: "Compare"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
        Segmented {
            options: ["1", "2", "4"];
            current <=> root.compare-text;
            selected(c) => { root.compare-changed(c == "2" ? 2 : c == "4" ? 4 : 1); }
        }
    }
    // One press instead of two: the key and then the arrow. Off
    // until asked for, and the keys go back to the picture after
    // the press, as the filter's chips give them back.
    Toggle {
        label: "Move on after a rating, flag or label";
        checked <=> root.move-on;
        toggled => { root.move-on-changed(); root.focus-keys(); }
    }
    PanelButton {
        text: root.reject-count == 0 ? "No rejects to move"
            : "Move " + root.reject-count + (root.reject-count == 1 ? " reject..." : " rejects...");
        icon: @image-url("../icons/folder-open.svg");
        enabled: root.reject-count > 0;
        clicked => { root.rejects-asked(); }
    }
    // The way back, for a frame in a rejects folder: no sheet, since
    // nothing is written over and the frame can go out again.
    if root.back-count > 0: PanelButton {
        text: (root.back-count > 1 ? "Move " + root.back-count + " frames back to " : "Move back to ")
            + root.back-to;
        icon: @image-url("../icons/folder-open.svg");
        clicked => { root.move-back(); }
    }
    // Deleting, beside moving: each opens a sheet that names the
    // count and the folder, and nothing goes until it is answered.
    PanelButton {
        text: "Delete selection...";
        icon: @image-url("../icons/trash-2.svg");
        clicked => { root.delete-asked("selection"); }
    }
    PanelButton {
        text: "Delete rejects folder...";
        icon: @image-url("../icons/trash-2.svg");
        clicked => { root.delete-asked("rejects"); }
    }
    // The rejects' copies on an archive, found by hash: moved into a
    // rejects folder there, or deleted from it, behind a sheet.
    for choice[i] in root.archive-rejects-choices: PanelButton {
        text: choice;
        icon: @image-url("../icons/folder-open.svg");
        clicked => { root.archive-rejects-asked(i); }
    }
    PanelButton {
        text: "Develop";
        icon: @image-url("../icons/sliders-horizontal.svg");
        primary: true;
        clicked => { root.cull-leave(); }
    }
}
