// The top of the panel, pinned over the sections: the file and what it
// was shot at, the undo and redo buttons, and the scopes.

import { Theme } from "../theme.slint";
import { PanelButton, Segmented, ClipMark } from "../controls.slint";

export component PanelHead inherits VerticalLayout {
    in-out property <bool> culling;
    in property <string> file-name;
    in property <string> shot-camera;
    in property <string> shot-exposure;
    in property <string> shot-size;
    in property <image> scope-picture;
    in property <[string]> scopes;
    in-out property <string> scope;
    callback scope-changed(string);
    // The scopes weighed by the chosen adjustment's mask: off by
    // default, for the session only, and greyed while there is no
    // mask to weigh by.
    in-out property <bool> scope-selection;
    in property <bool> scope-mask-active;
    callback scope-selection-changed();
    in property <bool> clip-shadows-lit;
    in property <color> clip-shadows-mark;
    in property <bool> clip-highlights-lit;
    in property <color> clip-highlights-mark;
    in-out property <bool> warn-shadows;
    in-out property <bool> warn-highlights;
    callback warn-changed();
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();

    padding-left: Theme.space-4;
    padding-right: Theme.space-4;
    padding-top: Theme.space-4;
    spacing: Theme.space-2;
    // The file and what it was shot at, as one
    // caption: the name, then the body and its
    // lens, then the exposure triangle, which
    // wants two lines since the whole of it does
    // not fit the panel's width. Both lines keep
    // their height when the file says nothing, so
    // the panel below does not jump between one
    // picture and the next.
    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: Theme.space-2;
            Text {
                text: root.file-name;
                color: Theme.text;
                font-size: Theme.font-lg;
                font-weight: Theme.weight-semibold;
                overflow: elide;
                vertical-alignment: center;
            }
            PanelButton {
                icon: @image-url("../icons/rotate-ccw.svg");
                enabled: root.can-undo;
                width: Theme.control-height + Theme.space-2;
                clicked => { root.undo(); }
            }
            PanelButton {
                icon: @image-url("../icons/rotate-cw.svg");
                enabled: root.can-redo;
                width: Theme.control-height + Theme.space-2;
                clicked => { root.redo(); }
            }
        }
        Text {
            text: root.shot-camera;
            height: 16px;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }
        Text {
            text: root.shot-exposure;
            height: 16px;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }
        Text {
            text: root.shot-size;
            height: 16px;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }
    }
    // The scopes read the develop; in culling
    // there is none, and they are not shown.
    if !root.culling: VerticalLayout {
        spacing: Theme.space-1;
        Rectangle {
            // The vectorscope is square, so its
            // circle is round however wide the
            // panel is. A waveform wants height to
            // hold its trace apart; the histogram
            // is low.
            height: root.scope == "Vector" ? self.width
                : (root.scope == "RGB" ? 84px : 144px);
            border-radius: Theme.radius-md;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            Image {
                source: root.scope-picture;
                width: parent.width - 2px;
                height: parent.height - 2px;
                image-fit: fill;
                image-rendering: smooth;
            }
            if root.scope == "RGB": ClipMark {
                x: 1px;
                y: 1px;
                lit: root.clip-shadows-lit;
                mark: root.clip-shadows-mark;
                on: root.warn-shadows;
                clicked => {
                    root.warn-shadows = !root.warn-shadows;
                    root.warn-changed();
                }
            }
            if root.scope == "RGB": ClipMark {
                x: parent.width - self.width - 1px;
                y: 1px;
                lit: root.clip-highlights-lit;
                mark: root.clip-highlights-mark;
                on: root.warn-highlights;
                clicked => {
                    root.warn-highlights = !root.warn-highlights;
                    root.warn-changed();
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            Segmented {
                horizontal-stretch: 1;
                options: root.scopes;
                current <=> root.scope;
                selected(name) => { root.scope-changed(name); }
            }
            // Selection: every bin weighed by the mask, so a skin mask
            // shows the skin cloud on the vectorscope and a face its
            // level on the waveform.
            Rectangle {
                property <bool> on: root.scope-selection && root.scope-mask-active;
                horizontal-stretch: 0;
                width: selection-label.preferred-width + 2 * Theme.space-2;
                height: Theme.control-height;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                background: self.on ? Theme.raised
                    : (selection-touch.has-hover && root.scope-mask-active ? Theme.hover : Theme.base);
                opacity: root.scope-mask-active ? 1 : 0.45;
                animate background { duration: Theme.quick; }
                selection-label := Text {
                    text: "Selection";
                    color: parent.on ? Theme.text : Theme.text-secondary;
                    font-size: Theme.font-xs;
                    font-weight: parent.on ? Theme.weight-medium : Theme.weight-regular;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                selection-touch := TouchArea {
                    enabled: root.scope-mask-active;
                    mouse-cursor: root.scope-mask-active ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        root.scope-selection = !root.scope-selection;
                        root.scope-selection-changed();
                    }
                }
            }
        }
    }
}
