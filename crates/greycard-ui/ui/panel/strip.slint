// The filmstrip along the foot of the window: the folder's frames in a
// row, scrolled sideways by the wheel, the keys and a bar along its
// foot.

import { Theme } from "../theme.slint";
import { Thumb, ThumbCell } from "../structs.slint";
import { ScrollBand, ThumbBadges } from "../controls.slint";

export component Filmstrip inherits Rectangle {
    /// Every row, for the strip's length; the cells are drawn from
    /// `cells`, the rows on screen and a margin, each placed by its
    /// row.
    in property <[Thumb]> thumbs;
    in property <[ThumbCell]> cells;
    in-out property <int> selected;
    /// A click on a frame, with Ctrl and Shift as they were held
    /// when it was pressed.
    callback frame-clicked(int, bool, bool);
    /// A right-click on a frame (or, on a Mac, a Control+click): the
    /// row and where, in the window's logical pixels.
    callback frame-menu(int, length, length);
    /// Whether the frame menu is up: a press that closes it reaches
    /// the cell under it too, and is not a click there.
    pure callback menu-shown() -> bool;
    /// Whether Control+click is a right-click, as on a Mac. Slint
    /// calls the Mac's Command key `control` and its Control key
    /// `meta`, so it is `meta` held that is asked for.
    in property <bool> ctrl-click-menu;
    /// For a snapshot (`--menu`): the row to open the menu over, as
    /// if right-clicked in its middle; -1 for none.
    in property <int> menu-at: -1;
    changed menu-at => {
        if (self.menu-at >= 0 && self.menu-at < self.thumbs.length) {
            self.frame-menu(self.menu-at,
                strip.absolute-position.x + strip.content-x + self.strip-pad
                    + self.menu-at * self.strip-pitch + self.strip-item / 2,
                strip.absolute-position.y + strip.height / 2);
        }
    }
    in property <int> meta-stars;
    in property <length> strip-item;
    in property <length> strip-pitch;
    in property <length> strip-pad;
    /// Scroll the strip by a wheel's delta, kept within its ends.
    function strip-scroll(by: length) {
        strip.content-x = min(0px, max(strip.width - strip.content-width, strip.content-x + by));
    }
    /// How far the strip can be scrolled: the row less what is on
    /// screen, the bar's range.
    property <length> strip-max: max(0px, strip.content-width - strip.width);
    /// Scroll the strip to `to` along the row, held to its range: the
    /// bar's drag and its track.
    function strip-scroll-to(to: length) {
        strip.content-x = -clamp(to, 0px, root.strip-max);
    }
    callback strip-relay();
    callback strip-report();
    callback focus-keys();
    /// The scroll bar's thumb, asked of the grid's arithmetic along
    /// the strip's width, and whether it is awake after a scroll.
    pure callback bar-length(length, length) -> length;
    pure callback bar-offset(length, length, length) -> length;
    pure callback bar-drag(length, length, length, length) -> length;
    in-out property <bool> bar-awake;
    // The Flickable's scroll and extent, for App's reveal and report,
    // which read and set them through this component's id.
    in-out property <length> content-x <=> strip.content-x;
    out property <length> content-width: strip.content-width;

    height: 148px;
    background: Theme.surface;
    Rectangle { y: 0; height: 1px; width: 100%; background: Theme.border; }
    // A wheel over the strip scrolls it sideways. Slint's
    // Flickable only takes a wheel along an axis it can
    // move, and this one moves in x alone, so the vertical
    // wheel is turned here: this TouchArea encloses the
    // strip and sees what the thumbnails and the Flickable
    // reject. Dragging is the Flickable's own, and it
    // cancels the thumbnail's click once it takes over.
    TouchArea {
        scroll-event(e) => {
            // Only the vertical wheel: one with a sideways
            // component is the Flickable's, which has the
            // room for it and takes it before this is asked.
            if (e.delta-y == 0px) { return reject; }
            root.strip-scroll(e.delta-y);
            return accept;
        }
        strip := Flickable {
            content-width: max(self.width, root.thumbs.length * root.strip-pitch + 2 * root.strip-pad);
            // No room to move in y, or the Flickable takes the
            // vertical wheel for itself: its content would
            // otherwise be the row's preferred height, a few
            // pixels taller than the strip, and a wheel would
            // nudge the thumbnails up instead of along.
            content-height: self.height;
            changed content-x => { root.strip-report(); }
            // The first layout, and a folder swapped in.
            changed width => { root.strip-relay(); }
            changed content-width => { root.strip-relay(); }
            // Each cell where its row puts it, as the layout that
            // held a cell for every row put them: the pad, then a
            // pitch a row.
            for c in root.cells: cell := Rectangle {
                property <int> i: c.row;
                property <Thumb> t: c.thumb;
                x: root.strip-pad + self.i * root.strip-pitch;
                y: root.strip-pad;
                height: parent.height - 2 * root.strip-pad;
                // The current frame, and the set it is one of:
                // every frame in the set wears the selection's
                // ground, the current one its ring as well.
                property <bool> on: i == root.selected;
                property <bool> in-set: on || t.chosen;
                width: root.strip-item;
                border-radius: Theme.radius-md;
                background: in-set ? Theme.selection : (tt.has-hover ? Theme.hover : transparent);
                border-width: on ? 2px : (in-set ? 1px : 0);
                border-color: on ? Theme.accent : Theme.accent-muted;
                animate background { duration: Theme.quick; }
                // The picture is shorter than the row's full 96px by
                // the color label's band and a gap above it, whether
                // or not this frame carries one: reserved so a label
                // never moves the name below it, and so the band
                // (drawn further down, inside the border) never
                // covers the border or the name's own descenders.
                property <length> photo-h: 96px - 5px;
                VerticalLayout {
                    padding: Theme.space-2;
                    spacing: Theme.space-1;
                    Image {
                        source: t.image;
                        // A frame whose root is offline: there, but
                        // not to be had until the drive is back.
                        opacity: t.offline ? 0.4 : 1;
                        height: photo-h;
                        image-fit: contain;
                    }
                    Text {
                        text: t.name;
                        color: in-set ? Theme.text : Theme.text-secondary;
                        font-size: Theme.font-xs;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
                // Where the picture would be, as the grid marks it.
                if t.failed: Rectangle {
                    x: Theme.space-2;
                    y: Theme.space-2;
                    width: parent.width - 2 * Theme.space-2;
                    height: photo-h;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    Text {
                        text: "Unreadable";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // Over the picture's bottom corner, not in
                // the row with the name: the badges must
                // not push the name out of the middle, and
                // the cell's height is the strip's.
                ThumbBadges {
                    x: Theme.space-2 + Theme.space-1;
                    y: Theme.space-2 + photo-h - self.height - Theme.space-1;
                    rating: t.rating;
                    flag: t.flag;
                    label: t.label;
                    stars: root.meta-stars;
                }
                // The strip sits beside the developed picture, where a
                // tinted plate would pull the eye's color judgment, so
                // a color label shows as a band instead: below the
                // picture and inside the border, clear of both it and
                // the name below, and clear of the badges over the
                // picture above.
                if t.label > 0: Rectangle {
                    x: Theme.radius-md;
                    y: Theme.space-2 + photo-h + 2px;
                    width: parent.width - 2 * Theme.radius-md;
                    height: 3px;
                    background: Theme.label-color(t.label);
                }
                // `clicked` carries no modifiers, so the press
                // says which were held and the click reads them.
                // A right-click asks for the menu on the press,
                // as a desktop's menus open; a Mac's
                // Control+click is one, and its click is then
                // not also a click.
                tt := TouchArea {
                    property <bool> ctrl;
                    property <bool> shift;
                    property <bool> menu;
                    mouse-cursor: MouseCursor.pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            let closing = root.menu-shown();
                            self.menu = closing || e.button == PointerEventButton.right
                                || (root.ctrl-click-menu && e.button == PointerEventButton.left
                                    && e.modifiers.meta);
                            if (closing && e.button == PointerEventButton.left
                                && !(root.ctrl-click-menu && e.modifiers.meta)) {
                                // The press closed the menu: nothing more.
                                return;
                            }
                            if (self.menu) {
                                root.focus-keys();
                                root.frame-menu(i, self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                                return;
                            }
                            self.ctrl = e.modifiers.control;
                            self.shift = e.modifiers.shift;
                        }
                    }
                    clicked => {
                        if (self.menu) { return; }
                        root.focus-keys();
                        root.frame-clicked(i, self.ctrl, self.shift);
                    }
                }
            }
        }
    }
    // The scroll bar, the grid's along the strip's foot: in the
    // strip's padding below the cells rather than the grid's wider
    // band, so its track never covers a frame's ring and a frame keeps
    // every pixel of its click. The thumb keeps its 4 px from the foot.
    ScrollBand {
        horizontal: true;
        y: parent.height - root.strip-pad;
        width: parent.width;
        height: root.strip-pad;
        label: "Strip scroll";
        scroll: -strip.content-x;
        max: root.strip-max;
        awake <=> root.bar-awake;
        scroll-to(to) => { root.strip-scroll-to(to); }
        // Either wheel moves the strip along, as over the frames.
        wheel(dx, dy, ctrl) => { root.strip-scroll(dy != 0px ? dy : dx); }
        bar-length(a, b) => { return root.bar-length(a, b); }
        bar-offset(a, b, c) => { return root.bar-offset(a, b, c); }
        bar-drag(a, b, c, d) => { return root.bar-drag(a, b, c, d); }
        menu-shown => { return root.menu-shown(); }
        focus-keys => { root.focus-keys(); }
    }
}
