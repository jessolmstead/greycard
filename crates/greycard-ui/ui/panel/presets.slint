// The PRESETS section, in the left pane under the navigator: the
// presets by name, a click to lay one over the edit, a bin to remove
// one, and the ways to add one. It sat at the top of the develop
// panel's scroll until the left pane had room for it; where Lightroom
// keeps its presets is where a hand looks for them.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Section, PanelButton } from "../controls.slint";

export component PresetsSection inherits Section {
    in-out property <int> selected;
    in-out property <bool> collapsed-presets;
    in-out property <[string]> preset-names;
    callback preset-applied(int);
    callback preset-deleted(int);
    callback preset-import();
    callback preset-save-open();

    title: "PRESETS";
    shrinks: true;
    icon: @image-url("../icons/bookmark.svg");
    collapsed <=> root.collapsed-presets;
    // The list: a click lays the preset over the edit, as one step;
    // the bin at the row's end removes it from the store. A long list
    // scrolls in its own box, as the history does, so the pane below
    // it keeps its place.
    if root.preset-names.length > 0: Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.border;
        // As the history's box: its list up to 200 px, down to two
        // rows when the pane is short of room.
        preferred-height: min(preset-list.preferred-height, 200px);
        max-height: self.preferred-height;
        min-height: min(preset-list.preferred-height, 2 * Theme.control-height);
        vertical-stretch: 1;
        ScrollView {
            preset-list := VerticalLayout {
                padding: 2px;
                spacing: 2px;
                for name[i] in root.preset-names: Rectangle {
                    height: Theme.control-height - 6px;
                    border-radius: Theme.radius-sm;
                    background: preset-row.has-hover ? Theme.hover : transparent;
                    animate background { duration: Theme.quick; }
                    preset-row := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        enabled: root.selected >= 0;
                        clicked => { root.preset-applied(i); }
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-1;
                        spacing: Theme.space-2;
                        Text {
                            text: name;
                            color: preset-row.has-hover ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Rectangle {
                            width: Theme.control-height - 6px;
                            Image {
                                source: @image-url("../icons/trash-2.svg");
                                colorize: preset-bin.has-hover ? Theme.text : Theme.text-muted;
                                width: Theme.icon;
                                height: Theme.icon;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                            preset-bin := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.preset-deleted(i); }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.preset-names.length == 0: Text {
        text: "None yet: save the edit as one, or import a Lightroom preset.";
        font-size: Theme.font-xs;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Theme.space-2;
        PanelButton {
            text: "Import...";
            icon: @image-url("../icons/folder-open.svg");
            clicked => { root.preset-import(); }
        }
        PanelButton {
            text: "Save...";
            icon: @image-url("../icons/save.svg");
            enabled: root.selected >= 0;
            clicked => { root.preset-save-open(); }
        }
    }
}
