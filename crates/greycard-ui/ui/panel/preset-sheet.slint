// The preset sheet: a name and what the preset carries (sections,
// parts of them, masks), until saved or left.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PanelButton } from "../controls.slint";
import { CarryList } from "carry-list.slint";
import { CarryRow } from "../structs.slint";

export component PresetSheet inherits Rectangle {
    in-out property <bool> preset-open;
    in-out property <string> preset-name;
    in property <[CarryRow]> preset-rows;
    in property <int> preset-lines;
    callback preset-row-toggled(int);
    callback preset-all(bool);
    callback preset-join-chosen(bool);
    callback preset-saved();

    background: #000000a0;
    TouchArea { clicked => { root.preset-open = false; } }
    Rectangle {
        width: min(680px, root.width - 2 * Theme.space-5);
        height: preset-sheet.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        TouchArea { }
        // The field has the focus, and a key goes up from it and never
        // reaches the window's keys: Escape is taken here, on the card,
        // so a click beside it still reaches the scrim.
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.preset-open = false;
                    return accept;
                }
                return reject;
            }
            preset-sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: "Save preset";
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                }
                preset-name-edit := LineEdit {
                    text <=> root.preset-name;
                    placeholder-text: "Name";
                    accepted(t) => { root.preset-saved(); }
                    init => { self.focus(); }
                }
                Text {
                    text: "Checked: only what differs from the defaults.";
                    font-size: Theme.font-xs;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                CarryList {
                    rows: root.preset-rows;
                    lines: root.preset-lines;
                    // The window less the sheet's name, words and buttons.
                    max-list-height: root.height - 300px;
                    toggled(i) => { root.preset-row-toggled(i); }
                    all(on) => { root.preset-all(on); }
                    join-chosen(join) => { root.preset-join-chosen(join); }
                }
                Rectangle { height: Theme.space-2; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Cancel";
                        clicked => { root.preset-open = false; }
                    }
                    PanelButton {
                        text: "Save";
                        icon: @image-url("../icons/save.svg");
                        primary: true;
                        enabled: root.preset-name != "";
                        clicked => { root.preset-saved(); }
                    }
                }
            }
        }
    }
}
