// The grid: the folder as a contact sheet over the window, its header
// with the filter, and the cells riding on one scrolled offset, under
// a row of tiles for the folders in the folder open.

import { Theme } from "../theme.slint";
import { Thumb, ThumbCell, FilterChip, FacetRow, FolderTile } from "../structs.slint";
import { PanelButton, ThumbBadges } from "../controls.slint";
import { FilterBar } from "filter.slint";
import { LoadingCard } from "loading.slint";

export component GridSheet inherits Rectangle {
    /// Every row, for the header; the cells are drawn from `cells`,
    /// the rows on screen and a margin, each placed by its row.
    in property <[Thumb]> thumbs;
    in property <[ThumbCell]> cells;
    in-out property <int> selected;
    /// A click on a frame, with Ctrl and Shift as they were held
    /// when it was pressed.
    callback frame-clicked(int, bool, bool);
    /// A right-click on a frame (or, on a Mac, a Control+click), as
    /// the strip has it: the row and where, in the window's pixels.
    callback frame-menu(int, length, length);
    /// Whether the frame menu is up: a press that closes it reaches
    /// the cell under it too, and is not a click there.
    pure callback menu-shown() -> bool;
    in property <bool> ctrl-click-menu;
    /// For a snapshot (`--menu`): the row to open the menu over, as
    /// if right-clicked in its cell's middle; -1 for none.
    in property <int> menu-at: -1;
    changed menu-at => {
        if (self.menu-at >= 0 && self.menu-at < self.thumbs.length) {
            self.frame-menu(self.menu-at,
                grid-sheet.absolute-position.x + self.grid-left
                    + mod(self.menu-at, self.grid-cols) * self.grid-pitch + self.grid-cell / 2,
                grid-sheet.absolute-position.y - self.grid-scroll + self.grid-pad + self.grid-top
                    + floor(self.menu-at / self.grid-cols) * self.grid-row + self.grid-cell / 2);
        }
    }
    /// How many frames the selection holds, for the header.
    in property <int> set-count;
    in property <int> meta-stars;
    in-out property <bool> grid-open;
    in-out property <length> grid-cell;
    in property <length> grid-pad;
    in property <length> grid-label;
    in-out property <length> grid-w;
    in-out property <length> grid-h;
    in property <length> grid-scroll;
    in property <length> grid-gap;
    property <length> grid-pitch: root.grid-cell + root.grid-gap;
    in property <length> grid-row;
    pure callback grid-slack(length, length, int) -> length;
    property <length> grid-left:
        root.grid-pad + root.grid-slack(root.grid-w, root.grid-cell, root.grid-cols);
    in property <int> grid-cols;
    in property <length> grid-max;
    /// The folders in the folder open, as tiles above the cells, which
    /// they push down by `grid-top`: a row of them for each row of the
    /// grid's columns, half a cell tall. Not frames: no selection, no
    /// rating, no frame menu. A click opens the folder as its row in
    /// the tree does; a right-click offers Reveal while the root is
    /// online.
    in property <[FolderTile]> tiles;
    in property <length> grid-top;
    callback tile-picked(int);
    callback tile-reveal(int);
    /// After a pick from the tiles' menu: the keys take the focus back.
    callback menu-done();
    /// The tile the menu is about.
    property <int> menu-tile: -1;
    function open-tile-menu(i: int, x: length, y: length) {
        root.focus-keys();
        root.menu-tile = i;
        tile-menu.show({ x: x - tile-menu.absolute-position.x, y: y - tile-menu.absolute-position.y });
    }
    callback grid-wheel(length, bool);
    callback grid-relay();
    /// The scroll bar: a drag of its thumb or a press in its track
    /// scrolls to an offset, held to the range by the window as the
    /// wheel's scroll is. The thumb's length and top, and where a drag
    /// lands, are asked of the grid's arithmetic.
    callback grid-scroll-to(length);
    pure callback bar-length(length, length) -> length;
    pure callback bar-offset(length, length, length) -> length;
    pure callback bar-drag(length, length, length, length) -> length;
    /// Shown at full strength while the sheet scrolls and a moment
    /// after, then faded: every change of the scroll stamps it, and
    /// the timer below lets it sleep once a tick has passed with no
    /// new stamp. The timer runs only while it is awake, so a sheet
    /// at rest asks for no frame.
    in-out property <bool> bar-awake;
    property <int> bar-stamp;
    property <int> bar-seen;
    function wake-bar() {
        root.bar-stamp += 1;
        root.bar-awake = true;
    }
    changed grid-scroll => { root.wake-bar(); }
    Timer {
        interval: 600ms;
        running: root.bar-awake;
        triggered => {
            if (root.bar-seen == root.bar-stamp && !bar-band.pressed) {
                root.bar-awake = false;
            }
            root.bar-seen = root.bar-stamp;
        }
    }
    in-out property <bool> culling;
    callback cull-toggled();
    in-out property <[FilterChip]> filter-stars;
    in-out property <[FilterChip]> filter-flags;
    in-out property <[FilterChip]> filter-labels;
    in-out property <bool> filter-exact;
    in-out property <string> filter-text;
    in-out property <int> filter-shown;
    in-out property <int> filter-total;
    in-out property <bool> filter-on;
    in-out property <bool> filter-focus;
    in property <[FacetRow]> filter-facets-long;
    in property <[FacetRow]> filter-facets-short;
    in property <string> filter-facet-note;
    callback filter-facet-toggled(int, string);
    callback filter-star-picked(int);
    callback filter-flag-toggled(int);
    callback filter-label-toggled(int);
    callback filter-exact-toggled();
    callback filter-text-edited(string);
    callback filter-cleared();
    /// An import's progress and then its end, said in place of the
    /// selection while the left pane, which says it under Import, is
    /// put away: the grid covers the status plate. Empty for none.
    in property <string> import-line;
    /// The window's status line, which the viewport's plate shows and
    /// the grid covers: said after the selection's name, so what the
    /// header's actions answer ("there is no rejects folder", a move's
    /// clash) is seen from here as it is from the loupe.
    in property <string> status-line;
    /// What waits to go to an archive, beside the status; a click on
    /// it tries now.
    in property <string> sync-note;
    callback sync-retry();
    callback focus-keys();
    /// The header's Back up or Bring back (§216): its words ("3 frames
    /// not on Archive", "Back up...", "Bring back..."), empty for none;
    /// the choices it offers, in full ("Back up to Archive..."), a menu
    /// when more than one.
    in property <string> archive-text;
    in property <[string]> archive-choices;
    callback archive-pressed(int);
    /// The header's Rejects menu: CULLING's ways out for the rejects,
    /// here because the grid covers the panel. The same counts and
    /// the same callbacks as the section's, which the window forwards
    /// to the one handler each: Move rejects (none to move grays it),
    /// Move back over the selection (none in a rejects folder leaves
    /// it out), Delete rejects folder, and Remove rejects from each
    /// archive (no archive, no item).
    in property <int> reject-count;
    callback rejects-asked();
    in property <int> back-count;
    in property <string> back-to;
    callback move-back();
    callback delete-asked(string);
    in property <[string]> archive-rejects-choices;
    callback archive-rejects-asked(int);
    /// A view's sidecars being read, past the moment a fast one takes:
    /// its bar over the sheet, which holds the list before it until
    /// the new one lands.
    in property <bool> loading-shown;
    in property <float> loading-fraction;
    in property <string> loading-line;

    background: Theme.sheet;
    // Nothing may fall through to the viewport behind, the wheel
    // over the header least of all: it would zoom a picture that
    // is not on screen, or size the brush in hand.
    TouchArea {
        scroll-event(e) => { return accept; }
    }
    VerticalLayout {
        // The header: what is selected and how large the cells
        // are, then the filter. Where the frames are (the folder, the
        // roots, the tree) is the left pane's; what is looked for
        // among them is here, over the sheet it narrows.
        Rectangle {
            // Two rows of controls and two of chips: the selection's
            // line, the filter's meta chips with its words, and its
            // facets on two rows, camera and lens first, the rest under
            // them. Spelled out rather than asked of the layout: a
            // header whose height settles a frame late re-flows the
            // sheet twice on the way in, and the second re-flow is a
            // folder's worth of thumbnails asked for again. The
            // facets' rows are there before the index has anything to
            // put in them for the same reason, and a row the folder
            // has no facet for leaves its room empty.
            height: 2 * Theme.control-height + 2 * (Theme.control-height - 4px)
                + 5 * Theme.space-2 + 1px;
            background: Theme.surface;
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }
            header := VerticalLayout {
                padding: Theme.space-2;
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                spacing: Theme.space-2;
                HorizontalLayout {
                    spacing: Theme.space-3;
                    height: Theme.control-height;
                    if root.import-line != "": Text {
                        text: root.import-line;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.import-line == "": Text {
                        text: root.selected >= 0 && root.selected < root.thumbs.length
                            ? root.thumbs[root.selected].name
                                + (root.set-count > 1 ? " and " + (root.set-count - 1)
                                    + (root.set-count == 2 ? " other" : " others") : "")
                            : "";
                        color: Theme.text;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.import-line == "" && root.status-line != "": Text {
                        text: root.status-line;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        horizontal-stretch: 2;
                        overflow: elide;
                    }
                    if root.import-line == "" && root.sync-note != "": Text {
                        text: root.sync-note;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        overflow: elide;
                        TouchArea {
                            clicked => { root.sync-retry(); }
                        }
                    }
                    Text {
                        text: root.thumbs.length + (root.thumbs.length == 1 ? " frame · " : " frames · ")
                            + round(root.grid-cell / 1px) + " px";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                    if root.archive-text != "": archive-button := PanelButton {
                        text: root.archive-text;
                        icon: @image-url("../icons/cloud.svg");
                        clicked => {
                            root.focus-keys();
                            if (root.archive-choices.length > 1) {
                                archive-menu.show({ x: 0, y: self.height });
                            } else {
                                root.archive-pressed(0);
                            }
                        }
                        archive-menu := ContextMenuArea {
                            width: 0px;
                            height: 0px;
                            enabled: false;
                            Menu {
                                for name[i] in root.archive-choices: MenuItem {
                                    title: name;
                                    activated => { root.archive-pressed(i); }
                                }
                            }
                        }
                    }
                    // What CULLING offers for the folder's rejects, which
                    // the grid would otherwise hide: folder-level, so it
                    // sits here beside the archive's button rather than
                    // on the frame menu, which is the selection's. Move
                    // back is in both, as it is in CULLING beside Move
                    // rejects. One menu, so the header keeps its width.
                    PanelButton {
                        text: root.reject-count == 0 ? "Rejects"
                            : root.reject-count == 1 ? "1 reject" : root.reject-count + " rejects";
                        icon: @image-url("../icons/folder-open.svg");
                        clicked => {
                            root.focus-keys();
                            rejects-menu.show({ x: 0, y: self.height });
                        }
                        rejects-menu := ContextMenuArea {
                            width: 0px;
                            height: 0px;
                            enabled: false;
                            Menu {
                                MenuItem {
                                    title: root.reject-count == 0 ? "No rejects to move"
                                        : "Move " + root.reject-count
                                            + (root.reject-count == 1 ? " reject..." : " rejects...");
                                    enabled: root.reject-count > 0;
                                    activated => { root.rejects-asked(); }
                                }
                                if root.back-count > 0: MenuItem {
                                    title: (root.back-count > 1 ? "Move " + root.back-count + " frames back to "
                                        : "Move back to ") + root.back-to;
                                    activated => { root.move-back(); root.menu-done(); }
                                }
                                MenuSeparator { }
                                // These two, and Move rejects above,
                                // open a sheet that takes the
                                // focus itself, so no `menu-done`: its
                                // timer would take the focus back to the
                                // window's keys after the sheet had it,
                                // and Return on the sheet would answer
                                // nothing. The timer is for a pick from
                                // a sub-menu, and this menu has none.
                                MenuItem {
                                    title: "Delete rejects folder...";
                                    activated => { root.delete-asked("rejects"); }
                                }
                                if root.archive-rejects-choices.length > 0: MenuSeparator { }
                                for choice[i] in root.archive-rejects-choices: MenuItem {
                                    title: choice;
                                    activated => { root.archive-rejects-asked(i); }
                                }
                            }
                        }
                    }
                    PanelButton {
                        text: root.culling ? "Culling" : "Cull";
                        icon: @image-url("../icons/flag.svg");
                        primary: root.culling;
                        clicked => { root.focus-keys(); root.cull-toggled(); }
                    }
                    PanelButton {
                        text: "Loupe";
                        icon: @image-url("../icons/image.svg");
                        clicked => { root.focus-keys(); root.grid-open = false; }
                    }
                }
                FilterBar {
                    takes-focus: true;
                    wanted <=> root.filter-focus;
                    stars: root.filter-stars;
                    flags: root.filter-flags;
                    labels: root.filter-labels;
                    facets-long: root.filter-facets-long;
                    facets-short: root.filter-facets-short;
                    facet-note: root.filter-facet-note;
                    facet-toggled(c, k) => { root.filter-facet-toggled(c, k); }
                    exact: root.filter-exact;
                    shown: root.filter-shown;
                    total: root.filter-total;
                    on: root.filter-on;
                    text <=> root.filter-text;
                    star-picked(i) => { root.filter-star-picked(i); }
                    flag-toggled(i) => { root.filter-flag-toggled(i); }
                    label-toggled(i) => { root.filter-label-toggled(i); }
                    exact-toggled => { root.filter-exact-toggled(); }
                    text-edited(t) => { root.filter-text-edited(t); }
                    cleared => { root.filter-cleared(); }
                    released => { root.focus-keys(); }
                }
            }
        }
        grid-sheet := Rectangle {
            clip: true;
            // The first layout, a re-flow, a new folder: put the
            // selection back on screen from the top. Opened by G
            // the sheet is born at its full size, and `changed`
            // says nothing about a first value, so `init` reads
            // it; `changed` is for the window resizing under it.
            init => { root.grid-w = self.width; root.grid-h = self.height; root.grid-relay(); }
            changed width => { root.grid-w = self.width; root.grid-relay(); }
            changed height => { root.grid-h = self.height; root.grid-relay(); }
            // The cells ride on this one, which is also what sees
            // the wheel: a cell's own TouchArea rejects a scroll
            // and it rises to this, its parent, wherever the
            // pointer is. One offset moves the sheet, rather than
            // a binding on every cell.
            TouchArea {
                y: -root.grid-scroll;
                width: parent.width;
                // The sheet, or the window's worth of it when
                // the folder is short: what can be scrolled past
                // is exactly how far it scrolls.
                height: parent.height + root.grid-max;
                scroll-event(e) => {
                    // A sideways wheel is nobody's here, and with
                    // Ctrl it would zoom out on a delta of zero.
                    if (e.delta-y == 0px) { return reject; }
                    root.grid-wheel(e.delta-y, e.modifiers.control);
                    return accept;
                }
                for t[k] in root.tiles: Rectangle {
                    x: root.grid-left + mod(k, root.grid-cols) * root.grid-pitch;
                    y: root.grid-pad + floor(k / root.grid-cols) * (root.grid-cell / 2 + root.grid-gap);
                    width: root.grid-cell;
                    height: root.grid-cell / 2;
                    border-radius: Theme.radius-md;
                    background: tile-ta.has-hover ? Theme.hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    accessible-role: button;
                    accessible-label: "Folder " + t.name;
                    accessible-value: t.count;
                    accessible-action-default => { root.tile-picked(k); }
                    animate background { duration: Theme.quick; }
                    // As a cell's: a left press that closes a menu is
                    // nothing more, and a right-click (a Mac's
                    // Control+click) asks for the tile's menu, which
                    // has an item only while the root is online.
                    tile-ta := TouchArea {
                        property <bool> skip;
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => {
                            if (e.kind != PointerEventKind.down) { return; }
                            let closing = root.menu-shown();
                            let ctrl-menu = root.ctrl-click-menu && e.button == PointerEventButton.left
                                && e.modifiers.meta;
                            let asks = e.button == PointerEventButton.right || ctrl-menu;
                            self.skip = closing || asks || e.button != PointerEventButton.left;
                            if (asks && !t.offline) {
                                root.open-tile-menu(k, self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        clicked => {
                            if (self.skip) { return; }
                            root.focus-keys();
                            root.tile-picked(k);
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        spacing: Theme.space-2;
                        opacity: t.offline ? 0.55 : 1;
                        Image {
                            source: @image-url("../icons/folder-open.svg");
                            colorize: Theme.text-secondary;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: t.name;
                                color: tile-ta.has-hover ? Theme.text : Theme.text-secondary;
                                font-size: Theme.font-xs;
                                overflow: elide;
                            }
                            Text {
                                text: t.count;
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                                overflow: elide;
                            }
                        }
                    }
                }
                for c in root.cells: cell := Rectangle {
                    property <int> i: c.row;
                    property <Thumb> t: c.thumb;
                    // As the strip has it: the set on the
                    // selection's ground, the current frame ringed.
                    property <bool> on: i == root.selected;
                    property <bool> in-set: on || t.chosen;
                    x: root.grid-left + mod(i, root.grid-cols) * root.grid-pitch;
                    y: root.grid-pad + root.grid-top + floor(i / root.grid-cols) * root.grid-row;
                    width: root.grid-cell;
                    height: root.grid-cell + root.grid-label;
                    border-radius: Theme.radius-md;
                    // The plate: the sheet tinted a quarter of the
                    // way toward a color label, or the sheet as it
                    // was (through `transparent`) with none. The
                    // selection's and the hover's ground go over it,
                    // in the sibling below, exactly as they go over
                    // the plain plate: a chosen or hovered labeled
                    // tile keeps the same cue an unlabeled one does,
                    // the tint showing through both, `hover-veil`
                    // (unlike `hover` itself) being translucent too.
                    background: t.label == 0 ? transparent : Theme.plate-tint(Theme.sheet, t.label);
                    border-width: on ? 2px : (in-set ? 1px : 0);
                    border-color: on ? Theme.accent : Theme.accent-muted;
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: in-set ? Theme.selection : (ct.has-hover ? Theme.hover-veil : transparent);
                        animate background { duration: Theme.quick; }
                    }
                    Image {
                        x: Theme.space-1;
                        y: Theme.space-1;
                        width: parent.width - 2 * Theme.space-1;
                        height: root.grid-cell - 2 * Theme.space-1;
                        source: t.image;
                        image-fit: contain;
                        // A frame whose root is offline: there, but
                        // not to be had until the drive is back.
                        opacity: t.offline ? 0.4 : 1;
                    }
                    if t.failed: Rectangle {
                        x: Theme.space-1;
                        y: Theme.space-1;
                        width: parent.width - 2 * Theme.space-1;
                        height: root.grid-cell - 2 * Theme.space-1;
                        border-radius: Theme.radius-sm;
                        // Its own ground, the sheet as it is with no
                        // label, selection or hover: a labeled,
                        // chosen or hovered plate is lighter or more
                        // colorful than `text-muted` and
                        // `border-strong` were chosen against, and a
                        // box drawn straight over one would lose the
                        // border and wash the text out.
                        background: Theme.sheet;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        Text {
                            text: "Unreadable";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        y: root.grid-cell;
                        width: 100%;
                        height: root.grid-label;
                        text: t.name;
                        color: in-set ? Theme.text : Theme.text-secondary;
                        font-size: Theme.font-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // The picture's own box inside the cell.
                    // `contain` leaves a margin on one axis, and
                    // a badge in that margin sits beside the
                    // frame rather than on it; before the
                    // thumbnail arrives there is no aspect to go
                    // on and the box is the cell's.
                    property <length> box: root.grid-cell - 2 * Theme.space-1;
                    property <length> shown-w: t.image.width > 0 && t.image.height > 0
                        ? min(self.box, self.box * t.image.width / t.image.height)
                        : self.box;
                    property <length> shown-h: t.image.width > 0 && t.image.height > 0
                        ? min(self.box, self.box * t.image.height / t.image.width)
                        : self.box;
                    ThumbBadges {
                        // On the picture's bottom left corner,
                        // held inside the cell: a tall frame in a
                        // small cell is narrower than the badge,
                        // and a pill that hangs over the edge
                        // belongs to the frame beside it.
                        x: clamp(
                            Theme.space-1 + (parent.box - parent.shown-w) / 2 + Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box - self.width));
                        y: clamp(
                            Theme.space-1 + (parent.box + parent.shown-h) / 2
                                - self.height - Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box - self.height));
                        rating: t.rating;
                        flag: t.flag;
                        label: t.label;
                        stars: root.meta-stars;
                        // With the cell, within reason: the
                        // smallest cell keeps the size the strip
                        // uses, and the largest does not turn a
                        // quiet mark into a label across the
                        // picture.
                        glyph: clamp(root.grid-cell / 16, 9px, 18px);
                    }
                    // `clicked` carries no modifiers, so the press
                    // says which were held and the click reads them.
                    // A right-click asks for the menu on the press;
                    // a Mac's Control+click is one, and is then not
                    // also a click.
                    ct := TouchArea {
                        property <bool> ctrl;
                        property <bool> shift;
                        property <bool> menu;
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                let closing = root.menu-shown();
                                self.menu = closing || e.button == PointerEventButton.right
                                    || (root.ctrl-click-menu && e.button == PointerEventButton.left
                                        && e.modifiers.meta);
                                if (closing && e.button == PointerEventButton.left
                                    && !(root.ctrl-click-menu && e.modifiers.meta)) {
                                    // The press closed the menu: nothing more.
                                    return;
                                }
                                if (self.menu) {
                                    root.focus-keys();
                                    root.frame-menu(i, self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                    return;
                                }
                                self.ctrl = e.modifiers.control;
                                self.shift = e.modifiers.shift;
                            }
                        }
                        clicked => {
                            if (self.menu) { return; }
                            root.focus-keys();
                            root.frame-clicked(i, self.ctrl, self.shift);
                        }
                        // The frame under the pointer, in the loupe.
                        double-clicked => { if (!self.menu) { root.grid-open = false; } }
                    }
                }
            }
            // The scroll bar, over the cells at the sheet's right edge
            // in the band and the colors the pane's lists have from
            // the fluent style: a thin thumb that widens on a track
            // under the pointer. There whenever the sheet scrolls,
            // faded at rest, so a hover over the band finds it; a
            // press in the band is the bar's and never a cell's.
            bar-band := TouchArea {
                // While the thumb is held it follows the pointer at
                // once, ahead of the sheet, which catches up at the
                // next step below.
                property <length> thumb-y: root.bar-offset(self.height, root.grid-max,
                    self.dragging ? self.want : root.grid-scroll);
                property <length> thumb-h: root.bar-length(self.height, root.grid-max);
                property <bool> lit: self.has-hover || self.pressed;
                property <bool> dragging;
                property <length> from;
                property <length> press-y;
                property <bool> took;
                /// Where the held thumb puts the sheet, and whether the
                /// sheet has yet to be moved there. A fast mouse sends
                /// several moves a frame, and each move that lands the
                /// sheet more than a screen away re-makes every cell
                /// and puts their pictures on again, 6 to 7 ms on a
                /// 2,000-frame folder: the moves only note the scroll,
                /// and the timer below applies the last of them, so the
                /// sheet moves and reports at most once a frame.
                property <length> want;
                property <bool> pending;
                function apply() {
                    self.pending = false;
                    root.grid-scroll-to(self.want);
                }
                x: parent.width - Theme.scrollbar-band;
                width: Theme.scrollbar-band;
                height: parent.height;
                visible: root.grid-max > 0;
                accessible-role: slider;
                accessible-label: "Grid scroll";
                accessible-value-minimum: 0;
                accessible-value-maximum: root.grid-max / 1px;
                accessible-value: round(root.grid-scroll / 1px);
                // Lingers a moment after the pointer leaves, as after
                // a scroll.
                changed has-hover => {
                    if (!self.has-hover) { root.wake-bar(); }
                }
                // A screen reader's step is a page, as a press in the
                // track is.
                accessible-action-increment => { root.grid-scroll-to(root.grid-scroll + self.height); }
                accessible-action-decrement => { root.grid-scroll-to(root.grid-scroll - self.height); }
                pointer-event(e) => {
                    // A press that closes a menu is nothing more, and
                    // leaves the focus to the menu's closing; any other
                    // press in the band gives the keys theirs back, as
                    // the pane's controls do.
                    if (e.kind == PointerEventKind.down) {
                        self.took = !root.menu-shown();
                        if (self.took) { root.focus-keys(); }
                    }
                    if (e.button != PointerEventButton.left) { return; }
                    if (e.kind == PointerEventKind.up) {
                        if (self.pending) { self.apply(); }
                        self.dragging = false;
                        // Again at the release, after a drag: only a
                        // release whose press was the bar's, so a
                        // press that closed a menu is still nothing.
                        if (self.took) { root.focus-keys(); }
                        return;
                    }
                    if (e.kind != PointerEventKind.down) { return; }
                    self.dragging = false;
                    if (!self.took) { return; }
                    // Above the thumb or below it, a page that way;
                    // on it, the thumb taken.
                    if (self.mouse-y < self.thumb-y) {
                        root.grid-scroll-to(root.grid-scroll - self.height);
                    } else if (self.mouse-y >= self.thumb-y + self.thumb-h) {
                        root.grid-scroll-to(root.grid-scroll + self.height);
                    } else {
                        self.dragging = true;
                        self.from = root.grid-scroll;
                        self.want = root.grid-scroll;
                        self.press-y = self.mouse-y;
                    }
                }
                moved => {
                    if (self.dragging && self.pressed) {
                        self.want = root.bar-drag(self.height, root.grid-max, self.from,
                            self.mouse-y - self.press-y);
                        self.pending = true;
                    }
                }
                // Runs only while a step waits, so a held thumb at rest
                // asks for nothing.
                Timer {
                    interval: 16ms;
                    running: bar-band.pending;
                    triggered => { bar-band.apply(); }
                }
                // The wheel over the bar scrolls as anywhere.
                scroll-event(e) => {
                    if (e.delta-y != 0px) { root.grid-wheel(e.delta-y, e.modifiers.control); }
                    return accept;
                }
                Rectangle {
                    opacity: root.bar-awake || parent.lit ? 1 : 0;
                    animate opacity { duration: 200ms; }
                    border-radius: 7px;
                    background: parent.lit ? Theme.scrollbar-track : transparent;
                    Rectangle {
                        // On whole device pixels, so a 2 px thumb is
                        // crisp at a fractional scale.
                        width: round((bar-band.lit ? 6px : 2px) / 1phx) * 1phx;
                        x: round((parent.width - 4px) / 1phx) * 1phx - self.width;
                        y: round(bar-band.thumb-y / 1phx) * 1phx;
                        height: round(bar-band.thumb-h / 1phx) * 1phx;
                        border-radius: self.width / 2;
                        background: bar-band.lit ? Theme.scrollbar-thumb-hover : Theme.scrollbar-thumb;
                        animate width { duration: 150ms; easing: ease-out; }
                    }
                }
            }
            // One menu for the tiles, placed where the right-click was,
            // as the frame menu is one for the window. Zero-sized and
            // never enabled itself, so it takes no click of its own.
            tile-menu := ContextMenuArea {
                width: 0px;
                height: 0px;
                enabled: false;
                Menu {
                    MenuItem {
                        title: "Reveal in file manager";
                        activated => { root.tile-reveal(root.menu-tile); root.menu-done(); }
                    }
                }
            }
            if root.loading-shown: LoadingCard {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                fraction: root.loading-fraction;
                line: root.loading-line;
            }
        }
    }
}
