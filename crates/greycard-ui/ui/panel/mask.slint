// The ADJUSTMENTS section on the Masks tab: the list, the chosen
// one's own controls, its shapes, and the one row that adds another
// to it.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Section, EditSlider, Toggle, PanelButton, Segmented } from "../controls.slint";

export component AdjustmentsSection inherits Section {
    in-out property <[string]> adjustment-names;
    in-out property <int> target;
    in-out property <bool> mask-invert;
    in-out property <bool> has-feather;
    in-out property <float> mask-feather;
    in-out property <float> lum-low;
    in-out property <float> lum-high;
    in-out property <float> lum-low-feather;
    in-out property <float> lum-high-feather;
    in-out property <float> range-hue;
    in-out property <float> range-width;
    in-out property <float> range-hue-feather;
    in-out property <float> range-chroma;
    in-out property <float> range-chroma-feather;
    in property <brush> hue-circle;
    in-out property <string> picking;
    callback pick-started(string);
    in-out property <bool> show-mask;
    callback show-mask-toggled();
    in-out property <bool> collapsed-adjustments;
    in-out property <string> placing;
    in-out property <string> adjustment-name;
    in-out property <[string]> component-names;
    in-out property <[bool]> component-on;
    // One per shape, beside its name: at a glance, not only the
    // chosen row's, in a card the others do not show.
    in-out property <[bool]> shape-invert;
    in-out property <int> component;
    in-out property <bool> placing-into;
    in-out property <string> component-kind;
    in property <string> component-heading;
    in-out property <float> brush-size;
    in-out property <float> brush-feather;
    in-out property <float> brush-flow;
    in-out property <string> brush-op;
    in-out property <string> shape-mode;
    in-out property <[bool]> adjustment-on;
    callback target-changed(int);
    callback adjustment-toggled(int);
    // A mask on its own, with no shape yet: the one way to start one,
    // now that the shape buttons only add to the mask already chosen.
    callback new-mask();
    callback delete-adjustment();
    callback add-shape(string, string);
    // A part from the People menu, by its label, joined by the mode.
    callback add-part(string, string);
    in-out property <bool> parts-menu-shown;
    callback delete-shape-at(int);
    callback shape-toggled(int);
    callback invert-shape-toggled(int);
    callback component-changed(int);
    callback renamed();
    callback view-changed();

    title: "ADJUSTMENTS";
    icon: @image-url("../icons/layers.svg");
    collapsed <=> root.collapsed-adjustments;
    // The list: Global, then each adjustment with its
    // switch. The chosen row is what the panel edits.
    Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 2px;
            spacing: 2px;
            for name[i] in root.adjustment-names: Rectangle {
                property <bool> on: i == root.target;
                property <bool> lit: i == 0 || root.adjustment-on[i - 1];
                height: Theme.control-height;
                border-radius: Theme.radius-sm;
                background: on ? Theme.raised : (row.has-hover ? Theme.hover : transparent);
                animate background { duration: Theme.quick; }
                row := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.target-changed(i); }
                }
                HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-1;
                    spacing: Theme.space-2;
                    if i > 0: Rectangle {
                        width: 14px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: lit ? Theme.accent : transparent;
                            border-width: 1px;
                            border-color: lit ? Theme.accent : Theme.text-secondary;
                        }
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.adjustment-toggled(i - 1); }
                        }
                    }
                    Text {
                        text: name;
                        color: !lit ? Theme.text-secondary : on ? Theme.text : Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if on && i > 0: Rectangle {
                        width: Theme.control-height - 4px;
                        Image {
                            source: @image-url("../icons/trash-2.svg");
                            colorize: bin.has-hover ? Theme.text : Theme.text-secondary;
                            width: Theme.icon;
                            height: Theme.icon;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        bin := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.delete-adjustment(); }
                        }
                    }
                }
            }
        }
    }
    PanelButton {
        text: "New mask";
        icon: @image-url("../icons/plus.svg");
        clicked => { root.new-mask(); }
    }
    // The chosen mask: its name and its own switches, one block: then
    // its shapes as a list under it, each a row that says its kind,
    // has its own invert and reaches its settings by being chosen;
    // then, once, the row that adds another shape to it.
    if root.target > 0: VerticalLayout {
        spacing: Theme.space-2;
        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;
                LineEdit {
                    text <=> root.adjustment-name;
                    placeholder-text: "Name";
                    edited(t) => { root.renamed(); }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Toggle {
                        label: "Show mask";
                        checked <=> root.show-mask;
                        toggled => { root.show-mask-toggled(); root.view-changed(); }
                    }
                    Toggle {
                        label: "Invert";
                        checked <=> root.mask-invert;
                        toggled => { root.view-changed(); }
                    }
                }
            }
        }
        Text {
            text: "Shapes";
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            height: Theme.control-height - Theme.space-2;
        }
        VerticalLayout {
            padding-left: Theme.space-2;
            spacing: Theme.space-2;
            Rectangle {
                border-radius: Theme.radius-md;
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for name[i] in root.component-names: Rectangle {
                        property <bool> on: i == root.component;
                        property <bool> lit: root.component-on[i];
                        property <bool> inverted: root.shape-invert[i];
                        height: Theme.control-height;
                        border-radius: Theme.radius-sm;
                        // Chosen as a history step is, so it stands out
                        // among shapes of one kind; its settings are
                        // the card just under this list.
                        background: on ? Theme.selection : (shape-row.has-hover ? Theme.hover : transparent);
                        animate background { duration: Theme.quick; }
                        shape-row := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.component-changed(i); }
                        }
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-1;
                            spacing: Theme.space-2;
                            // The shape's switch, as an adjustment's.
                            Rectangle {
                                width: 14px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: lit ? Theme.accent : transparent;
                                    border-width: 1px;
                                    border-color: lit ? Theme.accent : Theme.text-secondary;
                                }
                                TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.shape-toggled(i); }
                                }
                            }
                            Text {
                                text: name;
                                color: !lit ? Theme.text-secondary : on ? Theme.text : Theme.text-secondary;
                                opacity: lit ? 1.0 : 0.5;
                                font-size: Theme.font-xs;
                                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            // The shape's own invert, beside it here
                            // rather than only in the card below for
                            // whichever row happens to be chosen: a
                            // half-filled circle, which reads as
                            // invert rather than mirror.
                            Rectangle {
                                width: Theme.control-height - 4px;
                                border-radius: Theme.radius-sm;
                                border-width: invert-focus.has-focus ? 2px : 0;
                                border-color: Theme.focus-ring;
                                accessible-role: button;
                                accessible-label: "Invert this shape";
                                Image {
                                    source: @image-url("../icons/contrast.svg");
                                    colorize: inverted ? Theme.accent : (invert-hit.has-hover || invert-focus.has-focus ? Theme.text : Theme.text-secondary);
                                    width: Theme.icon;
                                    height: Theme.icon;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                                invert-focus := FocusScope {
                                    key-pressed(e) => {
                                        if (e.text == " " || e.text == Key.Return) {
                                            root.invert-shape-toggled(i);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                                invert-hit := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        invert-focus.focus();
                                        root.invert-shape-toggled(i);
                                    }
                                }
                                if invert-hit.has-hover || invert-focus.has-focus: Rectangle {
                                    y: -self.height - 4px;
                                    x: parent.width - self.width;
                                    width: tip-text.width + Theme.space-2 * 2;
                                    height: Theme.control-height - 6px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.raised;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    tip-text := Text {
                                        text: "Invert this shape";
                                        color: Theme.text;
                                        font-size: Theme.font-xs;
                                        x: Theme.space-2;
                                        vertical-alignment: center;
                                        height: 100%;
                                        wrap: no-wrap;
                                    }
                                }
                            }
                            if root.component-names.length > 1: Rectangle {
                                width: Theme.control-height - 4px;
                                Text {
                                    text: "\u{00d7}";
                                    color: cross.has-hover ? Theme.text : Theme.text-secondary;
                                    font-size: Theme.font-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                cross := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.delete-shape-at(i); }
                                }
                            }
                        }
                    }
                }
            }
            // The chosen shape's own settings, reached by choosing its
            // row above; its invert is there already, not repeated
            // here. Nothing shown for a shape whose only setting is
            // its own invert (Linear, Brush, Subject, Background, Sky,
            // Object) — a card with nothing in it but the row's own
            // name would say it twice.
            if root.component-kind != ""
                && (root.has-feather || root.component-kind == "Luminance" || root.component-kind == "Color"): Rectangle {
                border-radius: Theme.radius-md;
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: Theme.space-2;
                    spacing: Theme.space-2;
                    Text {
                        text: root.component-heading.to-uppercase();
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: 0.8px;
                        overflow: elide;
                    }
                    if root.has-feather: EditSlider {
                        label: "Feather";
                        minimum: 0;
                        maximum: 1;
                        default: 0.5;
                        step: 0.01;
                        value <=> root.mask-feather;
                        scale: 100;
                        text: round(root.mask-feather * 100) + "%";
                        changed(v) => { root.view-changed(); }
                    }
                    // A luminance window: the lightness it takes in full, from
                    // Low to High, and how far past each it fades to nothing.
                    if root.component-kind == "Luminance": VerticalLayout {
                        spacing: Theme.space-2;
                        EditSlider {
                            label: "Low";
                            minimum: 0;
                            maximum: 1;
                            default: 0.7;
                            step: 0.01;
                            value <=> root.lum-low;
                            scale: 100;
                            text: round(root.lum-low * 100);
                            // Low pushes High ahead of it.
                            changed(v) => {
                                if (root.lum-high < v) { root.lum-high = v; }
                                root.view-changed();
                            }
                        }
                        EditSlider {
                            label: "Low fade";
                            minimum: 0;
                            maximum: 0.5;
                            default: 0.1;
                            step: 0.01;
                            value <=> root.lum-low-feather;
                            scale: 100;
                            text: round(root.lum-low-feather * 100);
                            changed(v) => { root.view-changed(); }
                        }
                        EditSlider {
                            label: "High";
                            minimum: 0;
                            maximum: 1;
                            default: 1;
                            step: 0.01;
                            value <=> root.lum-high;
                            scale: 100;
                            text: round(root.lum-high * 100);
                            changed(v) => {
                                if (root.lum-low > v) { root.lum-low = v; }
                                root.view-changed();
                            }
                        }
                        EditSlider {
                            label: "High fade";
                            minimum: 0;
                            maximum: 0.5;
                            default: 0;
                            step: 0.01;
                            value <=> root.lum-high-feather;
                            scale: 100;
                            text: round(root.lum-high-feather * 100);
                            changed(v) => { root.view-changed(); }
                        }
                    }
                    // A color window: the hue it centers on, how wide it is in
                    // full and how far round it fades; the least chroma it
                    // takes in full, and how far under that it fades.
                    if root.component-kind == "Color": VerticalLayout {
                        spacing: Theme.space-2;
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            PanelButton {
                                text: "Pick";
                                icon: @image-url("../icons/pipette.svg");
                                primary: root.picking == "Range";
                                clicked => { root.pick-started("Range"); }
                            }
                        }
                        EditSlider {
                            label: "Hue";
                            label-width: 84px;
                            tinted: true;
                            tint: root.hue-circle;
                            minimum: 0;
                            maximum: 360;
                            default: 55;
                            step: 0.5;
                            value <=> root.range-hue;
                            text: round(root.range-hue) + "\u{00b0}";
                            changed(v) => { root.view-changed(); }
                        }
                        EditSlider {
                            label: "Width";
                            label-width: 84px;
                            minimum: 0;
                            maximum: 180;
                            default: 60;
                            step: 0.5;
                            value <=> root.range-width;
                            text: round(root.range-width) + "\u{00b0}";
                            changed(v) => { root.view-changed(); }
                        }
                        EditSlider {
                            label: "Hue fade";
                            label-width: 84px;
                            minimum: 0;
                            maximum: 90;
                            default: 25;
                            step: 0.5;
                            value <=> root.range-hue-feather;
                            text: round(root.range-hue-feather) + "\u{00b0}";
                            changed(v) => { root.view-changed(); }
                        }
                        EditSlider {
                            label: "Chroma";
                            label-width: 84px;
                            minimum: 0;
                            maximum: 0.2;
                            default: 0.02;
                            step: 0.001;
                            value <=> root.range-chroma;
                            scale: 100;
                            text: round(root.range-chroma * 1000) / 10;
                            // The fade runs down to no chroma at most.
                            changed(v) => {
                                if (root.range-chroma-feather > v) { root.range-chroma-feather = v; }
                                root.view-changed();
                            }
                        }
                        EditSlider {
                            label: "Chroma fade";
                            label-width: 84px;
                            minimum: 0;
                            maximum: 0.1;
                            default: 0.01;
                            step: 0.001;
                            value <=> root.range-chroma-feather;
                            scale: 100;
                            text: round(root.range-chroma-feather * 1000) / 10;
                            changed(v) => {
                                if (v > root.range-chroma) { root.range-chroma-feather = root.range-chroma; }
                                root.view-changed();
                            }
                        }
                    }
                }
            }
            // The brush in hand: its next stroke, wherever "Add a
            // shape" below put it there from — directly under the
            // chosen shape's own settings, since it is the chosen
            // shape's own settings while a brush is chosen.
            if root.placing == "Brush": VerticalLayout {
                spacing: Theme.space-2;
                EditSlider {
                    label: "Size";
                    minimum: 0.002;
                    maximum: 0.5;
                    default: 0.05;
                    step: 0.001;
                    value <=> root.brush-size;
                    scale: 100;
                    text: round(root.brush-size * 1000) / 10 + "%";
                    changed(v) => { }
                }
                EditSlider {
                    label: "Feather";
                    minimum: 0;
                    maximum: 1;
                    default: 0.5;
                    step: 0.01;
                    value <=> root.brush-feather;
                    scale: 100;
                    text: round(root.brush-feather * 100) + "%";
                    changed(v) => { }
                }
                EditSlider {
                    label: "Flow";
                    minimum: 0;
                    maximum: 1;
                    default: 1;
                    step: 0.01;
                    value <=> root.brush-flow;
                    scale: 100;
                    text: round(root.brush-flow * 100) + "%";
                    changed(v) => { }
                }
                Segmented {
                    options: ["Add", "Subtract", "Erase"];
                    current <=> root.brush-op;
                }
            }
            // Add a shape: the row it joins as, then its kind. Under
            // the shapes list and the chosen one's own settings (so
            // the order reads mask, shapes, the chosen shape's
            // settings, then how to add another).
            Text {
                text: "Add a shape";
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                font-weight: Theme.weight-medium;
                vertical-alignment: center;
                height: Theme.control-height - Theme.space-2;
            }
            Rectangle {
                // Dims while a chosen brush, sky or object is the one
                // in hand, so the row it would otherwise duplicate
                // reads as spoken for.
                opacity: root.placing-into && root.placing == root.component-kind
                    && (root.placing == "Brush" || root.placing == "Sky" || root.placing == "Object")
                    ? 0.4 : 1.0;
                VerticalLayout {
                    spacing: Theme.space-2;
                    // A mask with no shape yet has nothing to join,
                    // take from or intersect with: its first shape is
                    // always Add, so the row that picks among them for
                    // a second one is not shown to ask a question a
                    // first shape has no answer to.
                    if root.component-names.length > 0: Segmented {
                        accessible-role: button;
                        accessible-label: "Next shape mode";
                        options: ["Add", "Subtract", "Intersect"];
                        current <=> root.shape-mode;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PanelButton {
                            text: "Linear";
                            icon: @image-url("../icons/plus.svg");
                            primary: root.placing == "Linear" && root.placing-into;
                            clicked => { root.add-shape("Linear", root.shape-mode); }
                        }
                        PanelButton {
                            text: "Radial";
                            icon: @image-url("../icons/plus.svg");
                            primary: root.placing == "Radial" && root.placing-into;
                            clicked => { root.add-shape("Radial", root.shape-mode); }
                        }
                        PanelButton {
                            text: root.component-kind == "Brush" ? "Paint" : "Brush";
                            icon: root.component-kind == "Brush" ? @image-url("../icons/brush.svg") : @image-url("../icons/plus.svg");
                            primary: root.placing == "Brush" && root.placing-into;
                            clicked => { root.add-shape("Brush", root.shape-mode); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PanelButton {
                            text: "Subject";
                            icon: @image-url("../icons/user-round.svg");
                            clicked => { root.add-shape("Subject", root.shape-mode); }
                        }
                        // The Subject model's complement: everything a look
                        // should reach but the subject, with no shape drawn.
                        PanelButton {
                            text: "Background";
                            icon: @image-url("../icons/image.svg");
                            clicked => { root.add-shape("Background", root.shape-mode); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        // On a chosen sky, clicks that correct it.
                        PanelButton {
                            text: root.component-kind == "Sky" ? "Pick" : "Sky";
                            icon: @image-url("../icons/cloud.svg");
                            primary: root.placing == "Sky" && root.placing-into;
                            clicked => { root.add-shape("Sky", root.shape-mode); }
                        }
                        PanelButton {
                            text: root.component-kind == "Object" ? "Pick" : "Object";
                            icon: @image-url("../icons/mouse-pointer-click.svg");
                            primary: root.placing == "Object" && root.placing-into;
                            clicked => { root.add-shape("Object", root.shape-mode); }
                        }
                        // A person whole, or a part of one by name, from
                        // a menu in three groups under the whole person;
                        // the labels are the Rust table's
                        // (`greycard_edit::mask::PARTS`).
                        parts-button := PanelButton {
                            // Raised from Rust, for a snapshot of it.
                            property <bool> want: root.parts-menu-shown;
                            changed want => {
                                if (self.want) {
                                    root.parts-menu-shown = false;
                                    parts-menu.show({ x: 0, y: self.height });
                                }
                            }
                            text: "People";
                            icon: @image-url("../icons/users-round.svg");
                            primary: root.placing == "Part";
                            clicked => { parts-menu.show({ x: 0, y: self.height }); }
                            parts-menu := ContextMenuArea {
                                width: 0px;
                                height: 0px;
                                enabled: false;
                                Menu {
                                    MenuItem { title: "Whole person"; activated => { root.add-part("Whole person", root.shape-mode); } }
                                    MenuSeparator { }
                                    MenuItem { title: "Face"; enabled: false; }
                                    MenuItem { title: "Face"; activated => { root.add-part("Face", root.shape-mode); } }
                                    MenuItem { title: "Facial skin"; activated => { root.add-part("Facial skin", root.shape-mode); } }
                                    MenuItem { title: "Eyebrows"; activated => { root.add-part("Eyebrows", root.shape-mode); } }
                                    MenuItem { title: "Eyes"; activated => { root.add-part("Eyes", root.shape-mode); } }
                                    MenuItem { title: "Iris"; activated => { root.add-part("Iris", root.shape-mode); } }
                                    MenuItem { title: "Lips"; activated => { root.add-part("Lips", root.shape-mode); } }
                                    MenuItem { title: "Teeth"; activated => { root.add-part("Teeth", root.shape-mode); } }
                                    MenuSeparator { }
                                    MenuItem { title: "Body"; enabled: false; }
                                    MenuItem { title: "Skin"; activated => { root.add-part("Skin", root.shape-mode); } }
                                    MenuItem { title: "Hair"; activated => { root.add-part("Hair", root.shape-mode); } }
                                    MenuItem { title: "Hands"; activated => { root.add-part("Hands", root.shape-mode); } }
                                    MenuSeparator { }
                                    MenuItem { title: "Clothing"; enabled: false; }
                                    MenuItem { title: "Top"; activated => { root.add-part("Top", root.shape-mode); } }
                                    MenuItem { title: "Bottoms"; activated => { root.add-part("Bottoms", root.shape-mode); } }
                                    MenuItem { title: "Shoes"; activated => { root.add-part("Shoes", root.shape-mode); } }
                                    MenuItem { title: "All clothing"; activated => { root.add-part("All clothing", root.shape-mode); } }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PanelButton {
                            text: "Luminance";
                            icon: @image-url("../icons/sun.svg");
                            clicked => { root.add-shape("Luminance", root.shape-mode); }
                        }
                        PanelButton {
                            text: "Color";
                            icon: @image-url("../icons/palette.svg");
                            clicked => { root.add-shape("Color", root.shape-mode); }
                        }
                    }
                }
            }
        }
    }
}
