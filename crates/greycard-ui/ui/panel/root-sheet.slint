// The root sheet: a name for one of the library's roots, from its
// chip's menu. The name is only what the editor calls the root; the
// folder is not renamed or moved, and an empty name goes back to the
// folder's own. The path is shown in full, so two roots named alike
// can be told apart.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PanelButton } from "../controls.slint";

export component RootSheet inherits Rectangle {
    in-out property <bool> open;
    in property <string> path;
    /// The folder's own name: what the root goes by with no name.
    in property <string> folder;
    in-out property <string> name;
    callback done();

    background: #000000a0;
    TouchArea { clicked => { root.open = false; } }
    Rectangle {
        width: 480px;
        height: sheet.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        TouchArea { }
        // The field has the focus, and a key goes up from it and never
        // reaches the window's keys: Escape is taken here, on the card,
        // so a click beside it still reaches the scrim.
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.open = false;
                    return accept;
                }
                return reject;
            }
            sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: "Name this library folder";
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                }
                Text {
                    text: root.path;
                    font-size: Theme.font-xs;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                LineEdit {
                    text <=> root.name;
                    placeholder-text: root.folder;
                    accepted(t) => { root.done(); }
                    // The name there, chosen: typed over, or kept with Enter.
                    init => { self.focus(); self.select-all(); }
                }
                Text {
                    text: "A name for the library to show in place of \"" + root.folder
                        + "\". Leave it empty to use the folder's name. The folder itself is not renamed or moved.";
                    font-size: Theme.font-xs;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                Rectangle { height: Theme.space-2; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Cancel";
                        clicked => { root.open = false; }
                    }
                    PanelButton {
                        text: "Save";
                        primary: true;
                        clicked => { root.done(); }
                    }
                }
            }
        }
    }
}
