// The sync sheet: which of the current frame's sections go over the
// rest of the selection, until applied or left. The preset sheet's
// twin, with no name to give: nothing is kept but the frames' own
// sidecars. A paste opens the same sheet, the sections of the frame
// copied going over the whole selection.

import { Theme } from "../theme.slint";
import { PanelButton } from "../controls.slint";
import { SectionToggles } from "section-toggles.slint";

export component SyncSheet inherits Rectangle {
    in-out property <bool> sync-open;
    /// What the sync will do, in words: from which frame onto how
    /// many.
    in property <string> sync-text;
    /// A paste rather than a sync: the settings copied from
    /// `paste-from`, over the selection.
    in property <bool> paste;
    in property <string> paste-from;
    in-out property <[string]> sync-section-names;
    in-out property <[bool]> sync-section-on;
    callback sync-section-toggled(int, bool);
    callback sync-applied();

    background: #000000a0;
    TouchArea { clicked => { root.sync-open = false; } }
    Rectangle {
        width: 560px;
        height: sync-sheet.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        TouchArea { }
        sync-sheet := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-3;
            Text {
                text: root.paste ? "Paste settings from " + root.paste-from : "Sync settings";
                font-size: Theme.font-lg;
                font-weight: Theme.weight-medium;
                color: Theme.text;
            }
            Text {
                text: root.sync-text;
                font-size: Theme.font-sm;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: (root.paste ? "What goes across: as the last sync or paste this session chose, or else all but the masks. "
                    : "What goes across; on, all but the masks. ")
                    + "Noise brings the learned denoiser with it. The camera profile goes only to frames of the camera it was made for. The crop and the retouch are each frame's own and never go.";
                font-size: Theme.font-xs;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            SectionToggles {
                names: root.sync-section-names;
                on: root.sync-section-on;
                toggled(i, on) => { root.sync-section-toggled(i, on); }
            }
            Rectangle { height: Theme.space-2; }
            HorizontalLayout {
                spacing: Theme.space-2;
                PanelButton {
                    text: "Cancel";
                    clicked => { root.sync-open = false; }
                }
                PanelButton {
                    text: root.paste ? "Paste" : "Apply";
                    icon: @image-url("../icons/layers.svg");
                    primary: true;
                    clicked => { root.sync-applied(); }
                }
            }
        }
    }
}
