// A view's load, said while it is under way: a thin bar filled to the
// share of the sidecars read, and the words under it. Shown over the
// grid's sheet or the loupe's viewport, never as a sheet of its own:
// it takes no clicks and no keys, which go on to whatever is under it.

import { Theme } from "../theme.slint";

export component LoadingCard inherits Rectangle {
    /// How much of the load is done, 0 to 1.
    in property <float> fraction;
    /// What is being read, and how far along, in words.
    in property <string> line;
    /// The dark plate under the bar and its words; off where the card
    /// sits in a sheet that has its own ground.
    in property <bool> plate: true;
    in property <color> words-color: Theme.text-secondary;
    in property <length> words-size: Theme.font-xs;
    in property <TextHorizontalAlignment> words-align: center;
    /// Wrap the words rather than cut them at the end.
    in property <bool> wrap: false;
    /// The space at each side of the bar and the words.
    in property <length> side: Theme.space-3;

    /// Lines of words to keep room for, cutting what runs past them; 0
    /// for as many as there are.
    in property <int> words-lines: 0;

    height: 2 * Theme.space-3 + 3px + Theme.space-2 + words.height;
    border-radius: Theme.radius-md;
    // The status plate's ground: the frames under it stay visible,
    // the words readable over any of them.
    background: root.plate ? #000000b3 : transparent;
    track := Rectangle {
        // A fraction below nothing says there is nothing to count: the
        // words stand and the bar's place is kept.
        opacity: root.fraction < 0 ? 0 : 1;
        x: root.side;
        y: Theme.space-3;
        width: parent.width - 2 * root.side;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.border-strong;
        clip: true;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.fraction, 0, 1);
            height: 100%;
            border-radius: 1.5px;
            background: Theme.accent;
        }
    }
    words := Text {
        x: root.side;
        y: track.y + track.height + Theme.space-2;
        width: parent.width - 2 * root.side;
        height: root.words-lines > 0 ? root.words-lines * root.words-size * 1.35 : self.preferred-height;
        vertical-alignment: top;
        // A space keeps a line's height when there is nothing to say.
        text: root.line == "" ? " " : root.line;
        color: root.words-color;
        font-size: root.words-size;
        horizontal-alignment: root.words-align;
        wrap: root.wrap ? word-wrap : no-wrap;
        overflow: elide;
    }
}
