// The structs App's properties carry, which Rust reads and writes
// as generated types; here so the panel's files can name them too.

/// A point on the view, logical pixels.
export struct Pt {
    x: float,
    y: float,
}

export struct Thumb {
    name: string,
    image: image,
    /// The frame's meta, as the badges want it: stars, the flag (1 a
    /// pick, 2 a reject) and the color label (1 to 5). Rust owns what
    /// the numbers mean; see `greycard_edit::meta`.
    rating: int,
    flag: int,
    label: int,
    /// In the selection's set. The current frame, the one the
    /// viewport shows, is `selected`'s row and is always in it.
    chosen: bool,
    /// No picture could be made of the file (damaged, truncated, a
    /// format the decoder refuses): the cell says so rather than
    /// staying empty as if one were on its way.
    failed: bool,
    /// The frame is under a root of the library that is offline (a
    /// drive unplugged): listed from the index, drawn dimmed, its
    /// picture from the cache if one is there.
    offline: bool,
}

/// One of the strip's or the grid's cells: the browser's row it
/// shows, and that row. A view has cells only for the rows on screen
/// and a margin round them (`cells.rs`).
export struct ThumbCell {
    row: int,
    thumb: Thumb,
}

/// A box drawn for an object, on the view, logical pixels.
export struct MaskBox {
    x: float,
    y: float,
    w: float,
    h: float,
}

/// A person a part may be of, outlined on the view while one is to
/// be picked: their face's box, logical pixels, and whether it is the
/// guess, drawn more strongly (a highlight, never a pick).
export struct PersonBox {
    x: float,
    y: float,
    w: float,
    h: float,
    guess: bool,
}

/// A pick for an object on the view: on it, or not on it.
export struct MaskPick {
    x: float,
    y: float,
    positive: bool,
}

/// One frame of the culling loupe's compare view: its box on the
/// view, logical pixels, its name, whether it is the selection, and
/// its stars, flag and label as `Thumb` has them, for its badge.
export struct CompareTile {
    x: float,
    y: float,
    w: float,
    h: float,
    name: string,
    on: bool,
    rating: int,
    flag: int,
    label: int,
}

/// One chip of the browser's filter: what it asks, how many frames
/// would be left if it were the only thing that changed, whether it
/// is on, and which flag or color it stands for. Rust owns what the
/// number means; see `greycard_ui::filter`.
export struct FilterChip {
    text: string,
    count: int,
    on: bool,
    code: int,
}

/// One chip of an EXIF facet: what it shows, the value it hands
/// back when pressed, how many frames hold that value among the
/// frames the other tests leave, and whether it is on. The count is
/// the index's, one GROUP BY a facet; see `greycard_ui::library`.
export struct FacetChip {
    text: string,
    key: string,
    count: int,
    on: bool,
}

/// One of the library's roots, as the grid's left pane lists it: the
/// folder's name, its path (what a press hands back), how many files
/// the index holds under it, and whether the browser shows it.
export struct RootChip {
    name: string,
    path: string,
    count: int,
    on: bool,
    /// Not there now: a drive unplugged. Its files are left out of
    /// the view and its rows as they were.
    offline: bool,
    /// Marked as an archive (§197): a mark on its row, and its menu's
    /// toggle checked.
    archive: bool,
}

/// A folder in Recently opened: how the list says it (its name, and
/// the root it is under or the folder it is in), its path, and whether
/// it is the one open.
export struct RecentFolder {
    title: string,
    path: string,
    open: bool,
}

/// A folder in the open root's tree, as the left pane shows it: its
/// name and path, how deep under the root, its count (the frames
/// directly in it, or folded, all those under it; -1 for none shown),
/// whether it has folders under it and shows them, and whether it is
/// the one open.
export struct FolderRow {
    name: string,
    path: string,
    depth: int,
    count: int,
    children: bool,
    expanded: bool,
    open: bool,
}

/// A folder under the one open, as a tile at the top of the grid: its
/// name, the frames under it as the tree counts them, and whether its
/// root is offline (dimmed, and no reveal).
export struct FolderTile {
    name: string,
    count: int,
    offline: bool,
}

/// A facet's row of chips: its caption, which facet it is (its place
/// in `greycard_library::Facet::ALL`), and the chips.
export struct FacetRow {
    name: string,
    code: int,
    chips: [FacetChip],
}

/// One row of the history, newest first: a state, named for what it
/// changed, or an export made from the state below it, marked as a
/// record with when it was written. `undone` when its state is one
/// undone and waiting to be redone. Rust owns the order; see
/// `greycard_edit::Sidecar::rows`.
export struct HistoryRow {
    name: string,
    exported: bool,
    time: string,
    undone: bool,
}

/// One group on the camera match sheet: its look's name, the line that
/// says what the fit will do with it, and whether it is checked.
export struct MatchGroup {
    name: string,
    text: string,
    checked: bool,
}

/// One row of the LOOK section's list: a group's heading (a body, or
/// the general looks) or a look. Rust builds them
/// (`greycard_edit::look::grouped`).
export struct LookRow {
    heading: bool,
    /// A look: what the edit stores. A heading: the group's key, which
    /// a click toggles.
    name: string,
    label: string,
    /// A look: the display curves it has a table for, "per channel ·
    /// AgX", when it is made per curve. A heading: its count of looks.
    note: string,
    /// A look with no table for this picture's curve, drawn dimmed.
    off: bool,
    /// A heading folded.
    folded: bool,
    /// A heading for the open frame's own body.
    own: bool,
    /// A look under a heading, set in under its text.
    indented: bool,
}
