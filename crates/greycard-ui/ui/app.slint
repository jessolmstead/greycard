                        }
                        if root.panel-tab == "Develop": NoiseSection {
                            noise-enabled <=> root.noise-enabled;
                            collapsed-noise <=> root.collapsed-noise;
                            denoise <=> root.denoise;
                            denoise-strength <=> root.denoise-strength;
                            denoise-learned <=> root.denoise-learned;
                            denoise-tiers: root.denoise-tiers;
                            denoise-learned-strength <=> root.denoise-learned-strength;
                            unavailable: root.noise-unavailable;
                            learned-unavailable: root.learned-unavailable;
                            develop-changed => { root.develop-changed(); }
                        }
                        if root.panel-tab == "Develop": LensSection {
                            lens-enabled <=> root.lens-enabled;
                            collapsed-lens <=> root.collapsed-lens;
                            picking <=> root.picking;
                            pick-started(a) => { root.pick-started(a); }
                            hue-circle: root.hue-circle;
                            lens-profile: root.lens-profile;
                            lens-available: root.lens-available;
                            lens-database: root.lens-database;
                            lens-profile-on <=> root.lens-profile-on;
                            lens-distortion <=> root.lens-distortion;
                            lens-ca <=> root.lens-ca;
                            lens-vignetting <=> root.lens-vignetting;
                            lens-manual <=> root.lens-manual;
                            lens-ca-red <=> root.lens-ca-red;
                            lens-ca-blue <=> root.lens-ca-blue;
                            lens-auto-scale <=> root.lens-auto-scale;
                            lens-scale <=> root.lens-scale;
                            lens-defringe <=> root.lens-defringe;
                            lens-defringe-radius <=> root.lens-defringe-radius;
                            lens-defringe-threshold <=> root.lens-defringe-threshold;
                            lens-defringe-purple-center <=> root.lens-defringe-purple-center;
                            lens-defringe-purple-width <=> root.lens-defringe-purple-width;
                            lens-defringe-purple-amount <=> root.lens-defringe-purple-amount;
                            lens-defringe-green-center <=> root.lens-defringe-green-center;
                            lens-defringe-green-width <=> root.lens-defringe-green-width;
                            lens-defringe-green-amount <=> root.lens-defringe-green-amount;
                            fetch-lenses => { root.fetch-lenses(); }
                            develop-changed => { root.develop-changed(); }
                        }
                        // Local contrast, the Texture and Clarity of the
                        // engine's guided filter: a develop op, so the
                        // worker runs it, after the retouch and before
                        // the sharpen.
                        if root.panel-tab == "Develop": DetailSection {
                            collapsed-detail <=> root.collapsed-detail;
                            detail-enabled <=> root.detail-enabled;
                            detail-texture <=> root.detail-texture;
                            detail-clarity <=> root.detail-clarity;
                            detail-dehaze <=> root.detail-dehaze;
                            develop-changed => { root.develop-changed(); }
                        }
                        if root.panel-tab == "Develop": SharpenSection {
                            collapsed-sharpen <=> root.collapsed-sharpen;
                            show-sharpen-mask <=> root.show-sharpen-mask;
                            sharpen <=> root.sharpen;
                            sharpen-auto-radius <=> root.sharpen-auto-radius;
                            sharpen-radius <=> root.sharpen-radius;
                            sharpen-iterations <=> root.sharpen-iterations;
                            sharpen-auto-threshold <=> root.sharpen-auto-threshold;
                            sharpen-threshold <=> root.sharpen-threshold;
