    in-out property <int> canvas-choice: 0;
    property <[color]> canvas-colors: [#0f0f0f, #262626, #2e2e2e, #444444];
    callback canvas-changed();
    /// A develop is on its way.
    in property <bool> busy;
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();
    callback export();
    // Retouching: the tool in hand ("", "Heal" or "Clone"), the next
    // or chosen patch's size (of the picture's width), feather and
    // opacity, the patches by name, the chosen one, and its pins on the
    // view: its center, then its source.
    in-out property <string> retouch-mode: "";
    in-out property <float> patch-size: 0.02;
    in-out property <float> patch-feather: 0.3;
    in-out property <float> patch-opacity: 1.0;
    in-out property <[string]> patch-names: [];
    in-out property <int> patch: -1;
    in-out property <[Pt]> patch-handles: [];
    // The chosen patch's edge on the view, and where its feather
    // begins, as a Path's commands; empty when there is none to show.
    in property <string> patch-outline: "";
    in property <string> patch-feather-outline: "";
    callback retouch-toggled(string);
    callback patch-changed(int);
    callback delete-patch();
    callback patch-edited();
    callback patch-grabbed(int);
    callback patch-dragged(int, length, length);
    callback patch-dropped();
    // The model sheet: a model to fetch, offered with its license.
    in-out property <bool> fetch-open: false;
    in-out property <string> fetch-title: "";
    in-out property <string> fetch-text: "";
    in-out property <string> fetch-note: "";
    callback fetch-answered(bool);
    // The export sheet.
    in-out property <bool> export-open: false;
    in-out property <string> export-format: "JPEG";
    in-out property <float> export-quality: 92;
    in-out property <string> export-size: "Full";
    /// The long edge typed for the Custom size, as typed.
    in-out property <string> export-custom: "1600";
    /// The picture's size as an export writes it at Full: the frame
    /// after the crop, in pixels.
    in-out property <int> frame-width: 0;
    in-out property <int> frame-height: 0;
    /// The typed text as a long edge, or 0 when it is not a size.
    pure callback custom-edge(string) -> int;
    /// The long edge the sheet asks for; 0 is the picture's own.
    pure function export-edge() -> int {
        if (root.export-size == "Full") { return 0; }
        if (root.export-size == "Custom") { return root.custom-edge(root.export-custom); }
        return root.export-size.to-float();
    }
    /// Whether the export comes out smaller than the picture.
    pure function export-resizes() -> bool {
        return root.export-edge() > 0 && root.export-edge() < max(root.frame-width, root.frame-height);
    }
    pure function export-width() -> int {
        return root.export-resizes() ? round(root.frame-width * root.export-edge() / max(root.frame-width, root.frame-height)) : root.frame-width;
    }
    pure function export-height() -> int {
        return root.export-resizes() ? round(root.frame-height * root.export-edge() / max(root.frame-width, root.frame-height)) : root.frame-height;
    }
    in-out property <string> export-space: "sRGB";
    in-out property <bool> export-embed: true;
    in-out property <string> export-sharpen: "Standard";
    /// What an export does when a file of that name is already there.
    in-out property <string> export-on-exists: "Increment";
    /// Move to the file `by` places along the strip.
    callback step(int);
    /// Ask the desktop for a folder, and open it in place of the
    /// current file list.
    callback open-folder();
    /// Open the bug report form in the browser, filled in, and the
    /// log's folder beside it.
    callback report-asked();
    /// Whether a sheet is over everything. The sheets are declared
    /// after the grid and draw over it, so the keys belong to them.
    pure function sheet-open() -> bool {
        return root.export-open || root.fetch-open || root.preset-open || root.rejects-open;
    }

    // Keys that are nobody's: arrows step files, ctrl+z undoes.
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape && root.export-open) { root.export-open = false; return accept; }
            if (e.text == Key.Escape && root.fetch-open) { root.fetch-answered(false); return accept; }
            if (e.text == Key.Escape && root.preset-open) { root.preset-open = false; return accept; }
            if (e.text == Key.Escape && root.rejects-open) { root.rejects-answered(false); return accept; }
            if (e.text == Key.Escape && (root.placing != "" || root.picking != "")) { root.stop-placing(); return accept; }
            // A repair chosen for editing, not one just drawn: Esc
            // lets go of it, so the sliders go back to the brush.
            if (e.text == Key.Escape && root.patch != -1) { root.patch-changed(-1); return accept; }
            if (e.text == Key.Escape && root.guide-mode != "") { root.guide-mode = ""; root.guide-dropped(); return accept; }
            if (e.text == Key.Escape && root.level-mode) { root.level-mode = false; return accept; }
            // The grid takes the window: its own arrows, its own
            // zoom, and three ways back to the loupe.
            if (root.grid-open && !root.sheet-open()) {
                if (e.text == Key.Escape || e.text == Key.Return) { root.grid-open = false; return accept; }
                if (e.text == Key.LeftArrow) { root.grid-step(-1, 0, root.grid-cols); return accept; }
                if (e.text == Key.RightArrow) { root.grid-step(1, 0, root.grid-cols); return accept; }
                if (e.text == Key.UpArrow) { root.grid-step(0, -1, root.grid-cols); return accept; }
                if (e.text == Key.DownArrow) { root.grid-step(0, 1, root.grid-cols); return accept; }
                if (e.text == "+" || e.text == "=") { root.grid-zoom(1); return accept; }
                if (e.text == "-" || e.text == "_") { root.grid-zoom(-1); return accept; }
            }
            if ((e.text == "g" || e.text == "G") && !e.modifiers.control && !root.sheet-open()) {
                root.grid-open = !root.grid-open;
                return accept;
            }
            // Culling: Return or Escape leaves it on the frame the
            // selection is on and develops that; V cycles the compare
            // view; C is the way in and out.
            if (root.culling && !root.sheet-open() && (e.text == Key.Return || e.text == Key.Escape)) {
                root.cull-leave();
                return accept;
            }
            if (root.culling && !root.sheet-open() && !e.modifiers.control && (e.text == "v" || e.text == "V")) {
                root.compare-changed(root.compare == 1 ? 2 : root.compare == 2 ? 4 : 1);
                return accept;
            }
            if ((e.text == "c" || e.text == "C") && !e.modifiers.control && !root.sheet-open()) {
                root.cull-toggled();
                return accept;
            }
            if (e.modifiers.control && (e.text == "z" || e.text == "Z")) {
                if (e.modifiers.shift) { root.redo(); } else { root.undo(); }
                return accept;
            }
            if (e.modifiers.control && (e.text == "y" || e.text == "Y")) {
                root.redo();
                return accept;
            }
            if (e.modifiers.control && e.modifiers.shift && (e.text == "e" || e.text == "E")) {
                if (!root.export-open && !root.busy && root.selected >= 0 && !root.culling) { root.export-open = true; }
                return accept;
            }
            if (e.modifiers.control && (e.text == "o" || e.text == "O")) {
                root.open-folder();
                return accept;
            }
            // The filter's text field, two ways in. Ctrl+F is what
            // every application means by find and nothing here bound
            // it; / is the one-key reach for a hand already on the
            // arrows and the rating keys, and is what less, vim and
            // a browser's quick find mean by search. Neither is
            // typed into anything, since the field itself has the
            // keys once it has the focus, and Esc there clears it
            // and gives them back.
            if (e.modifiers.control && (e.text == "f" || e.text == "F") && !root.sheet-open()) {
                root.filter-asked();
                return accept;
            }
            if (e.text == "/" && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
                && !root.sheet-open()) {
                root.filter-asked();
                return accept;
            }
            // The culling keys: stars, the flag, the color label. They
            // belong to the browser, and the strip is the browser in
            // the loupe, so they work in both views. Nothing here is
            // modified, so a Ctrl or an Alt shortcut is not eaten.
            if (!e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
                && !root.sheet-open() && root.meta-key(e.text)) {
                return accept;
            }
            // The frame's own turn, a quarter left and a quarter
            // right. Unmodified, as the culling keys are: nothing
            // else in the window binds a bracket, so Lightroom's
            // Ctrl+[ and Ctrl+] are not needed to keep out of the
            // way, and a hand on the arrows reaches these.
            if (!e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
                && !root.sheet-open() && (e.text == "[" || e.text == "]")) {
                root.frame-turned(e.text == "[" ? -1 : 1);
                return accept;
            }
            if (e.text == Key.LeftArrow) { root.step(-1); return accept; }
            if (e.text == Key.RightArrow) { root.step(1); return accept; }
            if (e.text == " " && !e.modifiers.control && !root.grid-open) { root.zoom-key(1); return accept; }
            if ((e.text == "z" || e.text == "Z") && !e.modifiers.control && !root.grid-open) { root.zoom-key(3); return accept; }
            if ((e.text == "s" || e.text == "S") && !e.modifiers.control && !root.grid-open) {
                root.proofing = !root.proofing;
                root.proof-changed();
                return accept;
            }
            if ((e.text == "j" || e.text == "J") && !e.modifiers.control && !root.grid-open) {
                // Both on, unless either is: then both off.
                let on = !(root.warn-shadows || root.warn-highlights);
                root.warn-shadows = on;
                root.warn-highlights = on;
                root.warn-changed();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        HorizontalLayout {
            // The left panel: the navigator, and room for what else an
            // editor keeps on its left; at its foot, the way to report
            // a problem, found where it is looked for and nowhere near
            // the work.
            Rectangle {
                width: 240px;
                background: Theme.surface;
                Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.border; }
                VerticalLayout {
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    padding: Theme.space-4;
                    padding-top: Theme.space-2;
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Open folder...";
                        icon: @image-url("icons/folder-open.svg");
                        clicked => { root.open-folder(); }
                    }
                    Section {
                        title: "NAVIGATOR";
                        icon: @image-url("icons/maximize.svg");
                        note: root.zoom-text;
                        collapsed <=> root.collapsed-navigator;
                    if root.navigator.width > 0: Rectangle {
                        // The frame at the panel's width, or no
                        // taller than it is wide, centered.
                        property <float> aspect: root.navigator.width / max(1, root.navigator.height);
                        height: min(self.width, self.width / self.aspect);
                        property <length> shown-w: min(self.width, self.height * self.aspect);
                        property <length> shown-h: self.shown-w / self.aspect;
                        border-radius: Theme.radius-md;
                        background: Theme.base;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;
                        shown := Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: parent.shown-w;
                            height: parent.shown-h;
                            Image {
                                source: root.navigator;
                                width: 100%;
                                height: 100%;
                                image-fit: fill;
                                image-rendering: smooth;
                            }
                            // Always here, drawn only when the view
                            // shows less than the frame: a conditional
                            // element appearing under this clip's
                            // rounded corners would not refresh the
                            // renderer's cached layer of them.
                            Rectangle {
                                x: root.nav-left * parent.width;
                                y: root.nav-top * parent.height;
                                width: root.nav-width * parent.width;
                                height: root.nav-height * parent.height;
                                border-width: root.nav-partial ? 1px : 0px;
                                border-color: Theme.text;
                                background: root.nav-partial ? #ffffff1a : transparent;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                        keys.focus();
                                        root.navigate(self.mouse-x / self.width, self.mouse-y / self.height);
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.navigate(self.mouse-x / self.width, self.mouse-y / self.height);
                                    }
                                }
                            }
                        }
                    }
                    }
                    // The snapshots: whole states kept by name. A
                    // click restores one as a step; a double-click
                    // renames it; the bin removes it.
                    // Not in culling, where the panel is not the
                    // frame's and a step is the way out of the mode.
                    if !root.culling: Section {
                        title: "SNAPSHOTS";
                        icon: @image-url("icons/image.svg");
                        collapsed <=> root.collapsed-snapshots;
                        if root.snapshot-names.length > 0: Rectangle {
                            border-radius: Theme.radius-md;
                            background: Theme.base;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 2px;
                                spacing: 2px;
                                for name[i] in root.snapshot-names: Rectangle {
                                    height: Theme.control-height;
                                    border-radius: Theme.radius-sm;
                                    background: snapshot-row.has-hover ? Theme.hover : transparent;
                                    animate background { duration: Theme.quick; }
                                    snapshot-row := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        enabled: root.selected >= 0 && root.snapshot-editing != i;
                                        clicked => { root.snapshot-restored(i); }
                                        double-clicked => { root.snapshot-editing = i; }
                                        changed has-hover => { root.snapshot-hovered(self.has-hover ? i : -1); }
                                    }
                                    HorizontalLayout {
                                        padding-left: Theme.space-2;
                                        padding-right: Theme.space-1;
                                        spacing: Theme.space-2;
                                        if root.snapshot-editing == i: LineEdit {
                                            text: name;
                                            font-size: Theme.font-xs;
                                            horizontal-stretch: 1;
                                            accepted(t) => {
                                                root.snapshot-editing = -1;
                                                root.snapshot-renamed(i, t);
                                            }
                                            key-pressed(e) => {
                                                if (e.text == Key.Escape) { root.snapshot-editing = -1; return accept; }
                                                return reject;
                                            }
                                            init => { self.focus(); self.select-all(); }
                                        }
                                        if root.snapshot-editing != i: Text {
                                            text: name;
                                            color: snapshot-row.has-hover ? Theme.text : Theme.text-secondary;
                                            font-size: Theme.font-xs;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            width: Theme.control-height - 4px;
                                            Image {
                                                source: @image-url("icons/trash-2.svg");
                                                colorize: snapshot-bin.has-hover ? Theme.text : Theme.text-muted;
                                                width: Theme.icon;
                                                height: Theme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            snapshot-bin := TouchArea {
                                                mouse-cursor: MouseCursor.pointer;
                                                clicked => { root.snapshot-deleted(i); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.snapshot-names.length == 0: Text {
                            text: "None yet: take one to keep this state by name.";
                            font-size: Theme.font-xs;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        PanelButton {
                            text: "Take";
                            icon: @image-url("icons/plus.svg");
                            enabled: root.selected >= 0;
                            clicked => { root.snapshot-taken(); }
                        }
                    }
                    // The history: every step, newest first, the
                    // current one lit and the undone ones muted. A
                    // click makes a step current; what lies past it
                    // stays until the next change.
                    if !root.culling: Section {
                        title: "HISTORY";
                        icon: @image-url("icons/undo-2.svg");
                        collapsed <=> root.collapsed-history;
                        if root.history-names.length > 0: Rectangle {
                            border-radius: Theme.radius-md;
                            background: Theme.base;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: min(history-list.preferred-height, 260px);
                            ScrollView {
                                history-list := VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for name[i] in root.history-names: Rectangle {
                                        height: Theme.control-height - 6px;
                                        border-radius: Theme.radius-sm;
                                        background: i == root.history-current ? Theme.selection
                                            : history-row.has-hover ? Theme.hover : transparent;
                                        animate background { duration: Theme.quick; }
                                        history-row := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.history-clicked(i); }
                                            changed has-hover => { root.history-hovered(self.has-hover ? i : -1); }
                                        }
                                        HorizontalLayout {
                                            padding-left: Theme.space-2;
                                            padding-right: Theme.space-2;
                                            Text {
                                                text: name;
                                                color: i < root.history-current ? Theme.text-muted
                                                    : i == root.history-current ? Theme.text
                                                    : history-row.has-hover ? Theme.text : Theme.text-secondary;
                                                font-size: Theme.font-xs;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.history-names.length == 0: Text {
                            text: "Nothing yet: each change is a step here.";
                            font-size: Theme.font-xs;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }
                }
                VerticalLayout {
                    padding: Theme.space-4;
                    padding-top: Theme.space-2;
                    PanelButton {
                        text: "Report a problem...";
                        icon: @image-url("icons/bug.svg");
                        clicked => { root.report-asked(); }
                    }
                }
                }
            }
            // Viewport. Everything drawn over the picture — a mask's
            // outline and handles, the brush under the pointer, the
            // crop's shade — is placed in view pixels off a geometry
            // that is free to run past the edge: a gradient's line is
            // deliberately longer than any window, and a handle sits
            // wherever the shape does, zoomed and panned. So the
            // viewport clips, or that work is drawn over the left bar
            // and the filmstrip and takes their clicks besides.
            Rectangle {
                clip: true;
                background: root.canvas-colors[root.canvas-choice];
                view := Image {
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                }
                ta := TouchArea {
                    property <length> last-x;
                    property <length> last-y;
                    // Where the press was, and whether it has become a drag.
                    property <length> down-x;
                    property <length> down-y;
                    property <bool> dragged;
                    mouse-cursor: root.picking != "" ? (root.dropper.width > 0 ? MouseCursor.none : MouseCursor.crosshair)
                        : root.placing != "" || root.retouch-mode != "" ? MouseCursor.crosshair
                        : self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    // The keys belong to the picture whenever the pointer is
                    // on it, or the last press was: a clicked slider keeps
                    // them while the pointer stays on the panel.
                    changed has-hover => {
                        if (self.has-hover) { keys.focus(); }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            keys.focus();
                            // While the camera's JPEG stands in for the
                            // develop there is nothing here to place a
                            // shape on or read a color off; the pan and
                            // the zoom still work, as in culling.
                            if (root.placeholder) {
                            } else if (root.picking != "") {
                                if (e.button == PointerEventButton.left) {
                                    root.pick-pressed(self.mouse-x, self.mouse-y);
                                }
                            } else if (root.placing != "" || root.retouch-mode != "") {
                                root.place-pressed(self.mouse-x, self.mouse-y, e.button == PointerEventButton.right);
                            }
                            self.last-x = self.mouse-x;
                            self.last-y = self.mouse-y;
                            self.down-x = self.mouse-x;
                            self.down-y = self.mouse-y;
                            self.dragged = false;
                        } else if (e.kind == PointerEventKind.up) {
                            if (root.picking != "") {
                                root.pick-released();
                            } else if (root.placing != "" || root.retouch-mode != "") {
                                root.place-released();
                            } else if (!self.dragged && e.button == PointerEventButton.left) {
                                // A click on the empty picture lets go
                                // of a chosen repair, as Esc does.
                                if (root.patch != -1) { root.patch-changed(-1); }
                                // A click that did not drag: zoom in here, or back out.
                                root.toggle-zoom(self.mouse-x, self.mouse-y);
                            }
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            if (abs(self.mouse-x - self.down-x) > 4px || abs(self.mouse-y - self.down-y) > 4px) {
                                self.dragged = true;
                            }
                            if (root.picking != "") {
                                root.pick-dragged(self.mouse-x, self.mouse-y);
                            } else if (root.placing != "" || root.retouch-mode != "") {
                                root.place-dragged(self.mouse-x, self.mouse-y);
                            } else if (self.dragged) {
                                root.pan(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
                            }
                            self.last-x = self.mouse-x;
                            self.last-y = self.mouse-y;
                        }
                    }
                    scroll-event(e) => {
                        // With the brush in hand the wheel sizes it.
                        if (root.placing == "Brush") {
                            root.brush-size = clamp(root.brush-size * (e.delta-y > 0 ? 1.1 : 1 / 1.1), 0.002, 0.5);
                            return accept;
                        }
                        if (root.retouch-mode != "") {
                            root.patch-size = clamp(root.patch-size * (e.delta-y > 0 ? 1.1 : 1 / 1.1), 0.002, 0.3);
                            root.patch-edited();
                            return accept;
                        }
                        root.zoom(e.delta-y > 0 ? 1.25 : 0.8, self.mouse-x, self.mouse-y);
                        return accept;
                    }
                }
                // The brush under the pointer: its radius, and where
                // its feather begins.
                if root.placing == "Brush" && ta.has-hover && !root.placeholder: Rectangle {
                    for s in [1.0, root.brush-op == "Erase" ? 1.0 : 1.0 - root.brush-feather]: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        stroke: s == 1.0 ? (root.brush-op == "Erase" ? #ff6060cc : root.brush-op == "Subtract" ? #ffb860cc : #ffffffcc) : #ffffff50;
                        stroke-width: 1px;
                        property <float> cx: ta.mouse-x / 1px;
                        property <float> cy: ta.mouse-y / 1px;
                        property <float> r: max(root.brush-size * root.brush-scale * s, 0.5);
                        MoveTo { x: cx + r; y: cy; }
                        ArcTo { x: cx - r; y: cy; radius-x: r; radius-y: r; large-arc: false; sweep: true; }
                        ArcTo { x: cx + r; y: cy; radius-x: r; radius-y: r; large-arc: false; sweep: true; }
                    }
                }
                // The word for the camera's JPEG standing in for a
                // develop, in the corner of the picture it is over:
                // the status line says the rest, and both go the
                // moment the develop lands.
                if root.placeholder: Rectangle {
                    x: Theme.space-3;
                    y: Theme.space-3;
                    width: placeholder-word.width + 2 * Theme.space-3;
                    height: 24px;
                    border-radius: Theme.radius-sm;
                    background: #00000099;
                    placeholder-word := Text {
                        text: "camera preview";
                        color: Theme.text;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                }
                // The compare view's frames: a rule round the one the
                // selection is on, and each one's name at its top.
                for t in root.compare-tiles: Rectangle {
                    x: t.x * 1px;
                    y: t.y * 1px;
                    width: t.w * 1px;
                    height: t.h * 1px;
                    border-width: t.on ? 2px : 0;
                    border-color: Theme.accent;
                    Rectangle {
                        x: Theme.space-2;
                        y: Theme.space-2;
                        width: tile-name.width + 2 * Theme.space-2;
                        height: 20px;
                        border-radius: Theme.radius-sm;
                        background: #00000099;
                        tile-name := Text {
                            text: t.name;
                            color: t.on ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                    }
                }
                // The dropper under the pointer, in place of a cursor:
                // Lucide's pipette has its tip at (2, 22) of a 24 box,
                // so the icon hangs up and to the right of the point. A
                // dark copy behind it, spread by a pixel, reads on light
                // and on dark alike.
                if root.picking != "" && root.dropper.width > 0 && ta.has-hover && !root.placeholder: Rectangle {
                    property <length> size: 22px;
                    x: ta.mouse-x - 2 / 24 * self.size;
                    y: ta.mouse-y - 22 / 24 * self.size;
                    width: self.size;
                    height: self.size;
                    for o in [
                        { dx: -1.0, dy: 0.0 }, { dx: 1.0, dy: 0.0 },
                        { dx: 0.0, dy: -1.0 }, { dx: 0.0, dy: 1.0 },
                    ]: Image {
                        source: root.dropper;
                        colorize: #000000cc;
                        x: o.dx * 1px;
                        y: o.dy * 1px;
                        width: parent.width;
                        height: parent.height;
                    }
                    Image {
                        source: root.dropper;
                        colorize: #ffffff;
                        width: 100%;
                        height: 100%;
                    }
                }
                // The repair tool under the pointer: its radius and feather.
                if root.retouch-mode != "" && ta.has-hover && !root.placeholder: Rectangle {
                    for s in [1.0, 1.0 - root.patch-feather]: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        stroke: s == 1.0 ? #7fd0ffcc : #7fd0ff50;
                        stroke-width: 1px;
                        property <float> cx: ta.mouse-x / 1px;
                        property <float> cy: ta.mouse-y / 1px;
                        property <float> r: max(root.patch-size * root.brush-scale * s, 0.5);
                        MoveTo { x: cx + r; y: cy; }
                        ArcTo { x: cx - r; y: cy; radius-x: r; radius-y: r; large-arc: false; sweep: true; }
                        ArcTo { x: cx + r; y: cy; radius-x: r; radius-y: r; large-arc: false; sweep: true; }
                    }
                }
                // The chosen patch's shape while the Retouch tab shows:
                // its edge, and where its feather begins. A heal or a
                // clone shows its result at once and so implies its
                // shape; a fill shows nothing until the model answers,
                // and this is where it was drawn meanwhile and after.
                if root.panel-tab == "Retouch" && root.patch-outline != "" && !root.placeholder: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: root.patch-outline;
                    stroke: #7fd0ffaa;
                    stroke-width: 1px;
                }
                if root.panel-tab == "Retouch" && root.patch-feather-outline != "" && !root.placeholder: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    commands: root.patch-feather-outline;
                    stroke: #7fd0ff40;
                    stroke-width: 1px;
                }
                // The chosen patch's pins: its center and its source,
                // joined by a line.
                if root.retouch-mode != "" && root.patch-handles.length == 2 && !root.placeholder: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: self.width / 1px;
                    viewbox-height: self.height / 1px;
                    stroke: #7fd0ff99;
                    stroke-width: 1px;
                    MoveTo { x: root.patch-handles[0].x; y: root.patch-handles[0].y; }
                    LineTo { x: root.patch-handles[1].x; y: root.patch-handles[1].y; }
                }
                if root.retouch-mode != "" && !root.placeholder: Rectangle {
                    for h[i] in root.patch-handles: CropHandle {
                        id: i;
                        x: h.x * 1px - 10px;
                        y: h.y * 1px - 10px;
                        width: 20px;
                        height: 20px;
                        cursor: MouseCursor.move;
                        Rectangle {
                            x: 4px; y: 4px;
                            width: 12px; height: 12px;
                            background: i == 0 ? #7fd0ff : #ffffff;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #00000080;
                        }
                        grabbed(k) => { root.patch-grabbed(k); }
                        dragged(k, dx, dy) => { root.patch-dragged(k, dx, dy); }
                        dropped => { root.patch-dropped(); }
                    }
                }
                // The crop: shade outside, a rule of thirds inside, eight
                // handles and the whole to move.
                if root.crop-mode && !root.placeholder: Rectangle {
                    property <length> cl: root.crop-left;
                    property <length> ct: root.crop-top;
                    property <length> cw: root.crop-width;
                    property <length> ch: root.crop-height;
                    Rectangle { x: 0; y: 0; width: 100%; height: ct; background: #00000099; }
                    Rectangle { x: 0; y: ct + ch; width: 100%; height: parent.height - ct - ch; background: #00000099; }
                    Rectangle { x: 0; y: ct; width: cl; height: ch; background: #00000099; }
                    Rectangle { x: cl + cw; y: ct; width: parent.width - cl - cw; height: ch; background: #00000099; }
                    CropHandle {
                        id: 8;
                        x: cl; y: ct; width: cw; height: ch;
                        cursor: MouseCursor.move;
                        grabbed(i) => { root.crop-pressed(i); }
                        dragged(i, dx, dy) => { root.crop-dragged(i, dx, dy); }
                        dropped => { root.crop-released(); }
                    }
                    Rectangle { x: cl; y: ct; width: cw; height: ch; border-width: 1px; border-color: #ffffffcc; }
                    Rectangle { x: cl + cw / 3; y: ct; width: 1px; height: ch; background: #ffffff40; }
                    Rectangle { x: cl + 2 * cw / 3; y: ct; width: 1px; height: ch; background: #ffffff40; }
                    Rectangle { x: cl; y: ct + ch / 3; width: cw; height: 1px; background: #ffffff40; }
                    Rectangle { x: cl; y: ct + 2 * ch / 3; width: cw; height: 1px; background: #ffffff40; }
                    for h in [
                        { id: 0, fx: 0.0, fy: 0.0, cursor: MouseCursor.nwse-resize },
                        { id: 1, fx: 0.5, fy: 0.0, cursor: MouseCursor.ns-resize },
                        { id: 2, fx: 1.0, fy: 0.0, cursor: MouseCursor.nesw-resize },
                        { id: 3, fx: 1.0, fy: 0.5, cursor: MouseCursor.ew-resize },
                        { id: 4, fx: 1.0, fy: 1.0, cursor: MouseCursor.nwse-resize },
                        { id: 5, fx: 0.5, fy: 1.0, cursor: MouseCursor.ns-resize },
                        { id: 6, fx: 0.0, fy: 1.0, cursor: MouseCursor.nesw-resize },
                        { id: 7, fx: 0.0, fy: 0.5, cursor: MouseCursor.ew-resize },
                    ]: CropHandle {
                        id: h.id;
                        x: cl + h.fx * cw - 10px;
                        y: ct + h.fy * ch - 10px;
                        width: 20px;
                        height: 20px;
                        cursor: h.cursor;
                        Rectangle {
                            x: 5px; y: 5px; width: 10px; height: 10px;
                            background: #ffffff;
                            border-radius: 2px;
                        }
                        grabbed(i) => { root.crop-pressed(i); }
                        dragged(i, dx, dy) => { root.crop-dragged(i, dx, dy); }
                        dropped => { root.crop-released(); }
                    }
                }
                // The chosen mask shape: its outline and its handles.
                if root.mask-kind == "Linear" && root.mask-handles.length == 3 && !root.placeholder: Rectangle {
                    for h[i] in root.mask-handles: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        stroke: i == 0 ? #ffffff60 : #ffffffcc;
                        stroke-width: 1px;
                        property <float> dx: cos(root.mask-angle * 1deg) * 4000;
                        property <float> dy: sin(root.mask-angle * 1deg) * 4000;
                        MoveTo { x: h.x - dx; y: h.y - dy; }
                        LineTo { x: h.x + dx; y: h.y + dy; }
                    }
                }
                if root.mask-kind == "Radial" && root.mask-handles.length == 5 && !root.placeholder: Rectangle {
                    for s in [1.0, root.mask-feather-scale]: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        stroke: s == 1.0 ? #ffffffcc : #ffffff50;
                        stroke-width: 1px;
                        property <float> cx: root.mask-handles[0].x;
                        property <float> cy: root.mask-handles[0].y;
                        property <float> rx: max(root.mask-rx * s, 0.5);
                        property <float> ry: max(root.mask-ry * s, 0.5);
                        property <float> ca: cos(root.mask-angle * 1deg);
                        property <float> sa: sin(root.mask-angle * 1deg);
                        MoveTo { x: cx + rx * ca; y: cy + rx * sa; }
                        ArcTo { x: cx - rx * ca; y: cy - rx * sa; radius-x: rx; radius-y: ry; x-rotation: root.mask-angle; large-arc: false; sweep: true; }
                        ArcTo { x: cx + rx * ca; y: cy + rx * sa; radius-x: rx; radius-y: ry; x-rotation: root.mask-angle; large-arc: false; sweep: true; }
                    }
                }
                // An object's boxes, and its picks: a dot, green for
                // the object and red for what is not it.
                if !root.placeholder: Rectangle {
                    for b in root.mask-boxes: Rectangle {
                        x: b.x * 1px;
                        y: b.y * 1px;
                        width: b.w * 1px;
                        height: b.h * 1px;
                        border-width: 1px;
                        border-color: #ffffffcc;
                        Rectangle {
                            x: 1px; y: 1px;
                            width: parent.width - 2px;
                            height: parent.height - 2px;
                            border-width: 1px;
                            border-color: #00000066;
                        }
                    }
                    for k in root.mask-picks: Rectangle {
                        x: k.x * 1px - 6px;
                        y: k.y * 1px - 6px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: k.positive ? #4cd964 : #ff5252;
                        border-width: 1px;
                        border-color: #000000a0;
                    }
                }
                if root.mask-kind != "" && !root.placeholder: Rectangle {
                    for h[i] in root.mask-handles: CropHandle {
                        id: i;
                        x: h.x * 1px - 10px;
                        y: h.y * 1px - 10px;
                        width: 20px;
                        height: 20px;
                        cursor: i == 0 ? MouseCursor.move : MouseCursor.crosshair;
                        Rectangle {
                            x: i == 0 ? 4px : 5px; y: i == 0 ? 4px : 5px;
                            width: i == 0 ? 12px : 10px; height: i == 0 ? 12px : 10px;
                            background: i == 0 ? Theme.accent : #ffffff;
                            border-radius: i == 0 ? 6px : 2px;
                            border-width: 1px;
                            border-color: #00000080;
                        }
                        grabbed(k) => { root.mask-grabbed(k); }
                        dragged(k, dx, dy) => { root.mask-dragged(k, dx, dy); }
                        dropped => { root.mask-dropped(); }
                    }
                }
                // The level tool: drag along a line that should be
                // horizontal or vertical.
                if root.level-mode && !root.placeholder: leveler := Rectangle {
                    property <length> x0;
                    property <length> y0;
                    property <length> x1;
                    property <length> y1;
                    property <bool> dragging: false;
                    level := TouchArea {
                        mouse-cursor: MouseCursor.crosshair;
                        pointer-event(e) => {
                            if (e.button != PointerEventButton.left) { return; }
                            if (e.kind == PointerEventKind.down) {
                                leveler.x0 = self.mouse-x; leveler.y0 = self.mouse-y;
                                leveler.x1 = self.mouse-x; leveler.y1 = self.mouse-y;
                                leveler.dragging = true;
                            } else if (e.kind == PointerEventKind.up) {
                                leveler.dragging = false;
                                root.level-end(leveler.x0, leveler.y0, self.mouse-x, self.mouse-y);
                            }
                        }
                        moved => {
                            if (self.pressed) { leveler.x1 = self.mouse-x; leveler.y1 = self.mouse-y; }
                        }
                    }
                    if leveler.dragging: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        stroke: Theme.accent;
                        stroke-width: 2px;
                        MoveTo { x: leveler.x0 / 1px; y: leveler.y0 / 1px; }
                        LineTo { x: leveler.x1 / 1px; y: leveler.y1 / 1px; }
                    }
                }
                // The perspective guide: two strokes along lines that
                // should stand up, or lie flat. The first is kept in
                // source pixels by Rust and drawn back through the view
                // each frame, so a zoom or a pan between the strokes
                // moves the line with the picture rather than under it;
                // the pair gives the turn and the keystone at once, and
                // the tool lets go.
                if root.guide-mode != "" && !root.placeholder: guider := Rectangle {
                    // The stroke in hand.
                    property <length> x0;
                    property <length> y0;
                    property <length> x1;
                    property <length> y1;
                    property <bool> dragging: false;
                    guide := TouchArea {
                        mouse-cursor: MouseCursor.crosshair;
                        changed has-hover => {
                            if (self.has-hover) { keys.focus(); }
                        }
                        pointer-event(e) => {
                            if (e.button != PointerEventButton.left) { return; }
                            if (e.kind == PointerEventKind.down) {
                                keys.focus();
                                guider.x0 = self.mouse-x; guider.y0 = self.mouse-y;
                                guider.x1 = self.mouse-x; guider.y1 = self.mouse-y;
                                guider.dragging = true;
                            } else if (e.kind == PointerEventKind.up) {
                                guider.dragging = false;
                                // A stroke too short to say which way a
                                // line runs is no stroke at all.
                                if (abs(self.mouse-x - guider.x0) + abs(self.mouse-y - guider.y0) < 12px) { return; }
                                // Which of the two this is, Rust says:
                                // it holds the first one.
                                root.guide-stroke(guider.x0, guider.y0, self.mouse-x, self.mouse-y);
                            }
                        }
                        moved => {
                            if (self.pressed) { guider.x1 = self.mouse-x; guider.y1 = self.mouse-y; }
                        }
                    }
                    if root.guide-kept.length == 2: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        stroke: Theme.accent;
                        stroke-width: 2px;
                        MoveTo { x: root.guide-kept[0].x; y: root.guide-kept[0].y; }
                        LineTo { x: root.guide-kept[1].x; y: root.guide-kept[1].y; }
                    }
                    if guider.dragging: Path {
                        width: 100%;
                        height: 100%;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: self.width / 1px;
                        viewbox-height: self.height / 1px;
                        stroke: Theme.accent;
                        stroke-width: 2px;
                        MoveTo { x: guider.x0 / 1px; y: guider.y0 / 1px; }
                        LineTo { x: guider.x1 / 1px; y: guider.y1 / 1px; }
                    }
                    // What to do, while the tool is in hand.
                    Rectangle {
                        y: Theme.space-3;
                        width: hint.width + 2 * Theme.space-3;
                        height: 24px;
                        border-radius: Theme.radius-md;
                        background: #00000099;
                        hint := Text {
                            text: root.guide-kept.length == 2
                                ? "Now the second line"
                                : root.guide-mode == "Vertical"
                                    ? "Drag along two lines that should stand upright"
                                    : "Drag along two lines that should lie flat";
                            color: #ffffff;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                    }
                }
                // Status, bottom left, on a soft plate; a bar runs while
                // a develop is on its way.
                plate := Rectangle {
                    x: Theme.space-3;
                    y: parent.height - self.height - Theme.space-3;
                    width: status-text.width + 2 * Theme.space-3 + (root.busy ? 72px : 0);
                    height: 24px;
                    border-radius: Theme.radius-md;
                    background: #00000099;
                    property <float> phase: 0;
                    Timer {
                        interval: 16ms;
                        running: root.busy;
                        triggered => { plate.phase = mod(plate.phase + 0.015, 1); }
                    }
                    if root.busy: Rectangle {
                        x: Theme.space-3;
                        y: (parent.height - self.height) / 2;
                        width: 60px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.border-strong;
                        clip: true;
                        Rectangle {
                            x: (parent.width + 24px) * plate.phase - 24px;
                            width: 24px;
                            height: 100%;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }
                    }
                    status-text := Text {
                        text: root.placeholder && root.placeholder-status != "" ? root.placeholder-status : root.status;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        x: Theme.space-3 + (root.busy ? 72px : 0);
                        height: 100%;
                    }
                }
            }

            // Panel.
            Rectangle {
                width: 320px;
                background: Theme.surface;
                Rectangle { x: 0; width: 1px; height: 100%; background: Theme.border; }
                // The sections scroll; the view and export buttons stay
                // put under them, so a long tab never hides them.
                VerticalLayout {
                ScrollView {
                    content-y <=> root.panel-scroll;
                    VerticalLayout {
                        alignment: start;
                        padding: Theme.space-4;
                        spacing: Theme.space-2;
                        // The file and what it was shot at, as one
                        // caption: the name, then the body and its
                        // lens, then the exposure triangle, which
                        // wants two lines since the whole of it does
                        // not fit the panel's width. Both lines keep
                        // their height when the file says nothing, so
                        // the panel below does not jump between one
                        // picture and the next.
                        VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: root.file-name;
                                    color: Theme.text;
                                    font-size: Theme.font-lg;
                                    font-weight: Theme.weight-semibold;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                PanelButton {
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    enabled: root.can-undo;
                                    width: Theme.control-height + Theme.space-2;
                                    clicked => { root.undo(); }
                                }
                                PanelButton {
                                    icon: @image-url("icons/rotate-cw.svg");
                                    enabled: root.can-redo;
                                    width: Theme.control-height + Theme.space-2;
                                    clicked => { root.redo(); }
                                }
                            }
                            Text {
                                text: root.shot-camera;
                                height: 16px;
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                                overflow: elide;
                            }
                            Text {
                                text: root.shot-exposure;
                                height: 16px;
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                                overflow: elide;
                            }
                            Text {
                                text: root.shot-size;
                                height: 16px;
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                                overflow: elide;
                            }
                        }
                        // The scopes read the develop; in culling
                        // there is none, and they are not shown.
                        if !root.culling: VerticalLayout {
                            spacing: Theme.space-1;
                            Rectangle {
                                // The vectorscope is square, so its
                                // circle is round however wide the
                                // panel is. A waveform wants height to
                                // hold its trace apart; the histogram
                                // is low.
                                height: root.scope == "Vector" ? self.width
                                    : (root.scope == "RGB" ? 84px : 144px);
                                border-radius: Theme.radius-md;
                                background: Theme.base;
                                border-width: 1px;
                                border-color: Theme.border;
                                clip: true;
                                Image {
                                    source: root.scope-picture;
                                    width: parent.width - 2px;
                                    height: parent.height - 2px;
                                    image-fit: fill;
                                    image-rendering: smooth;
                                }
                                if root.scope == "RGB": ClipMark {
                                    x: 1px;
                                    y: 1px;
                                    lit: root.clip-shadows-lit;
                                    mark: root.clip-shadows-mark;
                                    on: root.warn-shadows;
                                    clicked => {
                                        root.warn-shadows = !root.warn-shadows;
                                        root.warn-changed();
                                    }
                                }
                                if root.scope == "RGB": ClipMark {
                                    x: parent.width - self.width - 1px;
                                    y: 1px;
                                    lit: root.clip-highlights-lit;
                                    mark: root.clip-highlights-mark;
                                    on: root.warn-highlights;
                                    clicked => {
                                        root.warn-highlights = !root.warn-highlights;
                                        root.warn-changed();
                                    }
                                }
                            }
                            Segmented {
                                options: root.scopes;
                                current <=> root.scope;
                                selected(name) => { root.scope-changed(name); }
                            }
                        }
                        // The panel in the order a photo is developed;
                        // the masks and the retouch on tabs of their own.
                        Segmented {
                            options: ["Develop", "Crop", "Masks", "Retouch"];
                            current <=> root.panel-tab;
                            selected(t) => {
                                // Away from Crop the frame is shown whole again.
                                if (t != "Crop" && root.crop-mode) {
                                    root.crop-mode = false;
                                    root.level-mode = false;
                                    root.guide-mode = "";
                                    root.guide-dropped();
                                    root.crop-toggled();
                                }
                                root.tab-changed(t);
                            }
                        }
                        // Culling: what the mode is, the browser's
                        // filter, the compare view, and the two ways
                        // out of it, one of them for the rejects.
                        if root.panel-tab == "Cull": Section {
                            title: "CULLING";
                            icon: @image-url("icons/image.svg");
                            hint: "C";
                            collapsed <=> root.collapsed-culling;
                            Text {
                                text: "The camera's JPEG, through the monitor profile and nothing else. Nothing is developed until Enter, or a develop tab.";
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Arrows move. 1 to 5 stars, 0 none; P pick, X reject, U neither; 6 to 9 a label. Space is 1:1 on the JPEG; V compares two, then four.";
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            // The frame's own turn, for the shot the
                            // camera's tag got wrong. Nothing develops.
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: "Turn"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                PanelButton {
                                    text: "[";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    clicked => { root.frame-turned(-1); }
                                }
                                PanelButton {
                                    text: "]";
                                    icon: @image-url("icons/rotate-cw.svg");
                                    clicked => { root.frame-turned(1); }
                                }
                            }
                            // The same filter the grid's header holds,
                            // a group of chips to a row: the panel is
                            // 320px wide and the header's one row
                            // would not fit in it.
                            Text {
                                text: "Show";
                                color: Theme.text;
                                font-size: Theme.font-sm;
                                vertical-alignment: center;
                            }
                            FilterBar {
                                stacked: true;
                                takes-focus: !root.grid-open;
                                wanted <=> root.filter-focus;
                                stars: root.filter-stars;
                                flags: root.filter-flags;
                                labels: root.filter-labels;
                                exact: root.filter-exact;
                                shown: root.filter-shown;
                                total: root.filter-total;
                                on: root.filter-on;
                                text <=> root.filter-text;
                                star-picked(i) => { root.filter-star-picked(i); }
                                flag-toggled(i) => { root.filter-flag-toggled(i); }
                                label-toggled(i) => { root.filter-label-toggled(i); }
                                exact-toggled => { root.filter-exact-toggled(); }
                                text-edited(t) => { root.filter-text-edited(t); }
                                cleared => { root.filter-cleared(); }
                                released => { keys.focus(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: "Compare"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                Segmented {
                                    options: ["1", "2", "4"];
                                    current <=> root.compare-text;
                                    selected(c) => { root.compare-changed(c == "2" ? 2 : c == "4" ? 4 : 1); }
                                }
                            }
                            PanelButton {
                                text: root.reject-count == 0 ? "No rejects to move"
                                    : "Move " + root.reject-count + (root.reject-count == 1 ? " reject..." : " rejects...");
                                icon: @image-url("icons/folder-open.svg");
                                enabled: root.reject-count > 0;
                                clicked => { root.rejects-asked(); }
                            }
                            PanelButton {
                                text: "Develop";
                                icon: @image-url("icons/sliders-horizontal.svg");
                                primary: true;
                                clicked => { root.cull-leave(); }
                            }
                        }
                        if root.panel-tab == "Masks": Section {
                            title: "ADJUSTMENTS";
                            icon: @image-url("icons/layers.svg");
                            collapsed <=> root.collapsed-adjustments;
                            // The list: Global, then each adjustment with its
                            // switch. The chosen row is what the panel edits.
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.base;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for name[i] in root.adjustment-names: Rectangle {
                                        property <bool> on: i == root.target;
                                        property <bool> lit: i == 0 || root.adjustment-on[i - 1];
                                        height: Theme.control-height;
                                        border-radius: Theme.radius-sm;
                                        background: on ? Theme.raised : (row.has-hover ? Theme.hover : transparent);
                                        animate background { duration: Theme.quick; }
                                        row := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.target-changed(i); }
                                        }
                                        HorizontalLayout {
                                            padding-left: Theme.space-2;
                                            padding-right: Theme.space-1;
                                            spacing: Theme.space-2;
                                            if i > 0: Rectangle {
                                                width: 14px;
                                                Rectangle {
                                                    width: 8px;
                                                    height: 8px;
                                                    border-radius: 4px;
                                                    background: lit ? Theme.accent : transparent;
                                                    border-width: 1px;
                                                    border-color: lit ? Theme.accent : Theme.text-secondary;
                                                }
                                                TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => { root.adjustment-toggled(i - 1); }
                                                }
                                            }
                                            Text {
                                                text: name;
                                                color: !lit ? Theme.text-secondary : on ? Theme.text : Theme.text-secondary;
                                                font-size: Theme.font-xs;
                                                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            if on && i > 0: Rectangle {
                                                width: Theme.control-height - 4px;
                                                Image {
                                                    source: @image-url("icons/trash-2.svg");
                                                    colorize: bin.has-hover ? Theme.text : Theme.text-secondary;
                                                    width: Theme.icon;
                                                    height: Theme.icon;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                bin := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => { root.delete-adjustment(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                PanelButton {
                                    text: "Linear";
                                    icon: @image-url("icons/plus.svg");
                                    primary: root.placing == "Linear" && !root.placing-into;
                                    clicked => { root.add-adjustment("Linear"); }
                                }
                                PanelButton {
                                    text: "Radial";
                                    icon: @image-url("icons/plus.svg");
                                    primary: root.placing == "Radial" && !root.placing-into;
                                    clicked => { root.add-adjustment("Radial"); }
                                }
                                PanelButton {
                                    text: "Brush";
                                    icon: @image-url("icons/plus.svg");
                                    primary: root.placing == "Brush" && !root.placing-into;
                                    clicked => { root.add-adjustment("Brush"); }
                                }
                            }
                            // The learned masks: the subject found, or things picked.
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                PanelButton {
                                    text: "Subject";
                                    icon: @image-url("icons/user-round.svg");
                                    clicked => { root.add-adjustment("Subject"); }
                                }
                                PanelButton {
                                    text: "Object";
                                    icon: @image-url("icons/mouse-pointer-click.svg");
                                    primary: root.placing == "Object" && !root.placing-into;
                                    clicked => { root.add-adjustment("Object"); }
                                }
                            }
                            // The brush in hand: its next stroke.
                            if root.placing == "Brush": VerticalLayout {
                                spacing: Theme.space-2;
                                EditSlider {
                                    label: "Size";
                                    minimum: 0.002;
                                    maximum: 0.5;
                                    default: 0.05;
                                    step: 0.001;
                                    value <=> root.brush-size;
                                    text: round(root.brush-size * 1000) / 10 + "%";
                                    changed(v) => { }
                                }
                                EditSlider {
                                    label: "Feather";
                                    minimum: 0;
                                    maximum: 1;
                                    default: 0.5;
                                    step: 0.01;
                                    value <=> root.brush-feather;
                                    text: round(root.brush-feather * 100) + "%";
                                    changed(v) => { }
                                }
                                EditSlider {
                                    label: "Flow";
                                    minimum: 0;
                                    maximum: 1;
                                    default: 1;
                                    step: 0.01;
                                    value <=> root.brush-flow;
                                    text: round(root.brush-flow * 100) + "%";
                                    changed(v) => { }
                                }
                                Segmented {
                                    options: ["Add", "Subtract", "Erase"];
                                    current <=> root.brush-op;
                                }
                            }
                            // The chosen adjustment: its name, its switches,
                            // and its shapes behind a fold.
                            if root.target > 0: VerticalLayout {
                                spacing: Theme.space-2;
                                LineEdit {
                                    text <=> root.adjustment-name;
                                    placeholder-text: "Name";
                                    edited(t) => { root.renamed(); }
                                }
                                HorizontalLayout {
                                    spacing: Theme.space-2;
                                    Toggle {
                                        label: "Show mask";
                                        checked <=> root.show-mask;
                                        toggled => { root.show-mask-toggled(); root.view-changed(); }
                                    }
                                    Toggle {
                                        label: "Invert";
                                        checked <=> root.mask-invert;
                                        toggled => { root.view-changed(); }
                                    }
                                }
                                Rectangle {
                                    height: Theme.control-height;
                                    border-radius: Theme.radius-sm;
                                    background: fold.has-hover ? Theme.hover : transparent;
                                    fold := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.shapes-open = !root.shapes-open; }
                                    }
                                    HorizontalLayout {
                                        padding-left: Theme.space-2;
                                        spacing: Theme.space-2;
                                        Text {
                                            text: root.shapes-open ? "\u{25be}" : "\u{25b8}";
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-xs;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Shapes (" + root.component-names.length + ")";
                                            color: Theme.text-secondary;
                                            font-size: Theme.font-xs;
                                            font-weight: Theme.weight-medium;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                                if root.shapes-open: VerticalLayout {
                                    spacing: Theme.space-2;
                                    Rectangle {
                                        border-radius: Theme.radius-md;
                                        background: Theme.base;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        VerticalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            for name[i] in root.component-names: Rectangle {
                                                property <bool> on: i == root.component;
                                                property <bool> lit: root.component-on[i];
                                                height: Theme.control-height;
                                                border-radius: Theme.radius-sm;
                                                background: on ? Theme.raised : (shape-row.has-hover ? Theme.hover : transparent);
                                                animate background { duration: Theme.quick; }
                                                shape-row := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => { root.component-changed(i); }
                                                }
                                                HorizontalLayout {
                                                    padding-left: Theme.space-2;
                                                    padding-right: Theme.space-1;
                                                    spacing: Theme.space-2;
                                                    // The shape's switch, as an adjustment's.
                                                    Rectangle {
                                                        width: 14px;
                                                        Rectangle {
                                                            width: 8px;
                                                            height: 8px;
                                                            border-radius: 4px;
                                                            background: lit ? Theme.accent : transparent;
                                                            border-width: 1px;
                                                            border-color: lit ? Theme.accent : Theme.text-secondary;
                                                        }
                                                        TouchArea {
                                                            mouse-cursor: MouseCursor.pointer;
                                                            clicked => { root.shape-toggled(i); }
                                                        }
                                                    }
                                                    Text {
                                                        text: name;
                                                        color: !lit ? Theme.text-secondary : on ? Theme.text : Theme.text-secondary;
                                                        opacity: lit ? 1.0 : 0.5;
                                                        font-size: Theme.font-xs;
                                                        font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                    if root.component-names.length > 1: Rectangle {
                                                        width: Theme.control-height - 4px;
                                                        Text {
                                                            text: "\u{00d7}";
                                                            color: cross.has-hover ? Theme.text : Theme.text-secondary;
                                                            font-size: Theme.font-sm;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                            width: 100%;
                                                            height: 100%;
                                                        }
                                                        cross := TouchArea {
                                                            mouse-cursor: MouseCursor.pointer;
                                                            clicked => { root.delete-shape-at(i); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    Segmented {
                                        options: ["Add", "Subtract", "Intersect"];
                                        current <=> root.shape-mode;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        PanelButton {
                                            text: "Linear";
                                            icon: @image-url("icons/plus.svg");
                                            primary: root.placing == "Linear" && root.placing-into;
                                            clicked => { root.add-shape("Linear", root.shape-mode); }
                                        }
                                        PanelButton {
                                            text: "Radial";
                                            icon: @image-url("icons/plus.svg");
                                            primary: root.placing == "Radial" && root.placing-into;
                                            clicked => { root.add-shape("Radial", root.shape-mode); }
                                        }
                                        PanelButton {
                                            text: root.component-kind == "Brush" ? "Paint" : "Brush";
                                            icon: root.component-kind == "Brush" ? @image-url("icons/brush.svg") : @image-url("icons/plus.svg");
                                            primary: root.placing == "Brush" && root.placing-into;
                                            clicked => { root.add-shape("Brush", root.shape-mode); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        PanelButton {
                                            text: "Subject";
                                            icon: @image-url("icons/user-round.svg");
                                            clicked => { root.add-shape("Subject", root.shape-mode); }
                                        }
                                        PanelButton {
                                            text: root.component-kind == "Object" ? "Pick" : "Object";
                                            icon: @image-url("icons/mouse-pointer-click.svg");
                                            primary: root.placing == "Object" && root.placing-into;
                                            clicked => { root.add-shape("Object", root.shape-mode); }
                                        }
                                    }
                                    Toggle {
                                        label: "Invert shape";
                                        checked <=> root.component-invert;
                                        toggled => { root.view-changed(); }
                                    }
                                    if root.has-feather: EditSlider {
                                        label: "Feather";
                                        minimum: 0;
                                        maximum: 1;
                                        default: 0.5;
                                        step: 0.01;
                                        value <=> root.mask-feather;
                                        text: round(root.mask-feather * 100) + "%";
                                        changed(v) => { root.view-changed(); }
                                    }
                                }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "PRESETS";
                            icon: @image-url("icons/bookmark.svg");
                            collapsed <=> root.collapsed-presets;
                            // The list: a click lays the preset over the
                            // edit, as one step; the bin at the row's end
                            // removes it from the store.
                            if root.preset-names.length > 0: Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.base;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for name[i] in root.preset-names: Rectangle {
                                        height: Theme.control-height;
                                        border-radius: Theme.radius-sm;
                                        background: preset-row.has-hover ? Theme.hover : transparent;
                                        animate background { duration: Theme.quick; }
                                        preset-row := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            enabled: root.selected >= 0;
                                            clicked => { root.preset-applied(i); }
                                        }
                                        HorizontalLayout {
                                            padding-left: Theme.space-2;
                                            padding-right: Theme.space-1;
                                            spacing: Theme.space-2;
                                            Text {
                                                text: name;
                                                color: preset-row.has-hover ? Theme.text : Theme.text-secondary;
                                                font-size: Theme.font-xs;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                            Rectangle {
                                                width: Theme.control-height - 4px;
                                                Image {
                                                    source: @image-url("icons/trash-2.svg");
                                                    colorize: preset-bin.has-hover ? Theme.text : Theme.text-muted;
                                                    width: Theme.icon;
                                                    height: Theme.icon;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                preset-bin := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => { root.preset-deleted(i); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.preset-names.length == 0: Text {
                                text: "None yet: save the edit as one, or import a Lightroom preset.";
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                PanelButton {
                                    text: "Import...";
                                    icon: @image-url("icons/folder-open.svg");
                                    clicked => { root.preset-import(); }
                                }
                                PanelButton {
                                    text: "Save...";
                                    icon: @image-url("icons/save.svg");
                                    enabled: root.selected >= 0;
                                    clicked => { root.preset-save-open(); }
                                }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "WHITE BALANCE";
                            icon: @image-url("icons/thermometer.svg");
                            hint: root.raw-input ? "" : "raw only";
                            collapsed <=> root.collapsed-wb;
                            Toggle {
                                label: "As shot";
                                enabled: root.raw-input;
                                checked <=> root.as-shot;
                                toggled => { root.develop-changed(); }
                            }
                            // The tracks show what the picture becomes: a
                            // higher temperature renders warmer, a positive
                            // tint (a green white point) renders magenta.
                            EditSlider {
                                label: "Temperature";
                                enabled: root.raw-input && !root.as-shot;
                                tinted: true;
                                tint: @linear-gradient(90deg, #4d86e8 0%, #cfd6dc 50%, #f0b24a 100%);
                                minimum: 2000;
                                maximum: 12000;
                                default: 5500;
                                step: 50;
                                value <=> root.temperature;
                                text: round(root.temperature) + " K";
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Tint";
                                enabled: root.raw-input && !root.as-shot;
                                tinted: true;
                                tint: @linear-gradient(90deg, #5fbf5f 0%, #cfd6dc 50%, #d65fd6 100%);
                                minimum: -0.05;
                                maximum: 0.05;
                                default: 0;
                                step: 0.001;
                                value <=> root.tint;
                                text: round(root.tint * 1000) / 1000;
                                changed(v) => { root.develop-changed(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: end;
                                PanelButton {
                                    text: "Neutral";
                                    icon: @image-url("icons/pipette.svg");
                                    enabled: root.raw-input;
                                    primary: root.picking == "White";
                                    clicked => { root.pick-started("White"); }
                                }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "CAMERA PROFILE";
                            icon: @image-url("icons/camera.svg");
                            hint: root.raw-input ? "" : "raw only";
                            collapsed <=> root.collapsed-camera;
                            // The list: the file's own calibrations
                            // first, then the profiles in the profile
                            // directory that fit this camera.
                            if root.raw-input: Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.base;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for label[i] in root.camera-profile-labels: Rectangle {
                                        property <bool> on: root.camera-profile-names[i] == root.camera-profile;
                                        height: Theme.control-height;
                                        border-radius: Theme.radius-sm;
                                        background: on ? Theme.raised : (profile-row.has-hover ? Theme.hover : transparent);
                                        animate background { duration: Theme.quick; }
                                        profile-row := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.camera-profile = root.camera-profile-names[i];
                                                root.camera-profile-picked();
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: Theme.space-2;
                                            padding-right: Theme.space-2;
                                            Text {
                                                text: label;
                                                color: on ? Theme.text : (profile-row.has-hover ? Theme.text : Theme.text-secondary);
                                                font-size: Theme.font-xs;
                                                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                            if root.raw-input && root.camera-profile-warning != "": Text {
                                text: root.camera-profile-warning;
                                color: Theme.label-yellow;
                                font-size: Theme.font-xs;
                                wrap: word-wrap;
                            }
                            if root.raw-input && root.camera-profile-note != "": Text {
                                text: root.camera-profile-note;
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                                wrap: word-wrap;
                            }
                            if !root.raw-input: Text {
                                text: root.source-note;
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                                wrap: word-wrap;
                            }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): Section {
                            title: "LIGHT" + (root.target-name == "" ? "" : "  \u{00b7}  " + root.target-name);
                            icon: @image-url("icons/sun.svg");
                            collapsed <=> root.collapsed-light;
                            switchable: true;
                            on <=> root.light-enabled;
                            switched => { root.view-changed(); }
                            EditSlider {
                                label: "Exposure";
                                minimum: -5;
                                maximum: 5;
                                default: 0;
                                step: 0.05;
                                value <=> root.exposure;
                                text: (root.exposure >= 0 ? "+" : "") + round(root.exposure * 100) / 100 + " EV";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Contrast";
                                enabled: root.tone-curve;
                                logarithmic: true;
                                minimum: 0.5;
                                maximum: 2;
                                default: 1;
                                step: 0.02;
                                value <=> root.contrast;
                                text: round(root.contrast * 100) / 100;
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Highlights";
                                enabled: root.tone-curve;
                                minimum: -2;
                                maximum: 2;
                                default: 0;
                                step: 0.05;
                                value <=> root.highlights;
                                text: (root.highlights >= 0 ? "+" : "") + round(root.highlights * 100) / 100 + " EV";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Shadows";
                                enabled: root.tone-curve;
                                minimum: -2;
                                maximum: 2;
                                default: 0;
                                step: 0.05;
                                value <=> root.shadows;
                                text: (root.shadows >= 0 ? "+" : "") + round(root.shadows * 100) / 100 + " EV";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Whites";
                                enabled: root.tone-curve;
                                minimum: -2;
                                maximum: 2;
                                default: 0;
                                step: 0.05;
                                value <=> root.whites;
                                text: (root.whites >= 0 ? "+" : "") + round(root.whites * 100) / 100 + " EV";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Blacks";
                                enabled: root.tone-curve;
                                minimum: -0.3;
                                maximum: 0.3;
                                default: 0;
                                step: 0.01;
                                value <=> root.blacks;
                                text: (root.blacks >= 0 ? "+" : "") + round(root.blacks * 100) + "%";
                                changed(v) => { root.view-changed(); }
                            }
                            Toggle {
                                label: "Tone curve";
                                checked <=> root.tone-curve;
                                toggled => { root.view-changed(); }
                            }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): Section {
                            title: "COLOR" + (root.target-name == "" ? "" : "  \u{00b7}  " + root.target-name);
                            icon: @image-url("icons/palette.svg");
                            collapsed <=> root.collapsed-color;
                            switchable: true;
                            on <=> root.color-enabled;
                            switched => { root.view-changed(); }
                            EditSlider {
                                label: "Vibrance";
                                enabled: root.color-enabled;
                                tinted: true;
                                tint: root.spectrum;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.vibrance;
                                text: (root.vibrance >= 0 ? "+" : "") + round(root.vibrance * 100) + "%";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Saturation";
                                enabled: root.color-enabled;
                                tinted: true;
                                tint: root.spectrum;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.saturation;
                                text: (root.saturation >= 0 ? "+" : "") + round(root.saturation * 100) + "%";
                                changed(v) => { root.view-changed(); }
                            }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): Section {
                            title: "CURVES" + (root.target-name == "" ? "" : "  \u{00b7}  " + root.target-name);
                            icon: @image-url("icons/spline.svg");
                            collapsed <=> root.collapsed-curves;
                            switchable: true;
                            on <=> root.curves-enabled;
                            switched => { root.view-changed(); }
                            Segmented {
                                options: ["Parametric", "Point"];
                                current <=> root.curve-mode;
                                selected(v) => { root.curve-mode-changed(); }
                            }
                            if root.curve-mode == "Point": Segmented {
                                options: ["RGB", "Red", "Green", "Blue", "R/G", "B/Y"];
                                current <=> root.curve-channel;
                                selected(v) => { root.curve-channel-changed(); }
                            }
                            CurveEditor {
                                picture: root.curve-image;
                                enabled: root.curves-enabled;
                                pressed(x, y) => { root.curve-press(x, y); }
                                moved(x, y) => { root.curve-move(x, y); }
                                released => { root.curve-release(); }
                                double-clicked(x, y) => { root.curve-double(x, y); }
                            }
                            if root.curve-mode == "Parametric": EditSlider {
                                label: "Highlights";
                                enabled: root.curves-enabled;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.para-highlights;
                                text: (root.para-highlights >= 0 ? "+" : "") + round(root.para-highlights * 100);
                                changed(v) => { root.parametric-changed(); }
                            }
                            if root.curve-mode == "Parametric": EditSlider {
                                label: "Lights";
                                enabled: root.curves-enabled;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.para-lights;
                                text: (root.para-lights >= 0 ? "+" : "") + round(root.para-lights * 100);
                                changed(v) => { root.parametric-changed(); }
                            }
                            if root.curve-mode == "Parametric": EditSlider {
                                label: "Darks";
                                enabled: root.curves-enabled;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.para-darks;
                                text: (root.para-darks >= 0 ? "+" : "") + round(root.para-darks * 100);
                                changed(v) => { root.parametric-changed(); }
                            }
                            if root.curve-mode == "Parametric": EditSlider {
                                label: "Shadows";
                                enabled: root.curves-enabled;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.para-shadows;
                                text: (root.para-shadows >= 0 ? "+" : "") + round(root.para-shadows * 100);
                                changed(v) => { root.parametric-changed(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: end;
                                if root.curve-mode == "Point": PanelButton {
                                    text: "Pick";
                                    icon: @image-url("icons/pipette.svg");
                                    enabled: root.curves-enabled;
                                    primary: root.picking == "Curve";
                                    clicked => { root.pick-started("Curve"); }
                                }
                                PanelButton {
                                    text: "Reset";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    clicked => { root.curve-reset(); }
                                }
                            }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): Section {
                            title: "COLOR MIXER" + (root.target-name == "" ? "" : "  \u{00b7}  " + root.target-name);
                            icon: @image-url("icons/palette.svg");
                            collapsed <=> root.collapsed-mixer;
                            switchable: true;
                            on <=> root.mixer-enabled;
                            // The picture's mixer does not act under
                            // a mono conversion, so the black and
                            // white takes the section over while it
                            // is on. What the switch and the sliders
                            // say is kept, and comes back as it was.
                            superseded: root.mixer-superseded;
                            switched => { root.view-changed(); }
                            Swatches {
                                colors: root.band-colors;
                                enabled: root.mixer-acts;
                                current <=> root.mixer-band;
                                selected(i) => { root.mixer-band-changed(); }
                            }
                            EditSlider {
                                label: "Hue";
                                enabled: root.mixer-acts;
                                // Which way each way goes: the band's
                                // own color in the middle, its
                                // neighbors at the ends.
                                tinted: true;
                                tint: @linear-gradient(90deg,
                                    root.band-colors[root.mixer-band == 0 ? 7 : root.mixer-band - 1],
                                    root.band-colors[root.mixer-band],
                                    root.band-colors[root.mixer-band == 7 ? 0 : root.mixer-band + 1]);
                                minimum: -30;
                                maximum: 30;
                                default: 0;
                                step: 1;
                                value <=> root.mixer-hue;
                                text: (root.mixer-hue >= 0 ? "+" : "") + round(root.mixer-hue) + "°";
                                changed(v) => { root.mixer-changed(); }
                            }
                            EditSlider {
                                label: "Saturation";
                                enabled: root.mixer-acts;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.02;
                                value <=> root.mixer-saturation;
                                text: (root.mixer-saturation >= 0 ? "+" : "") + round(root.mixer-saturation * 100) + "%";
                                changed(v) => { root.mixer-changed(); }
                            }
                            EditSlider {
                                label: "Luminance";
                                enabled: root.mixer-acts;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.05;
                                value <=> root.mixer-luminance;
                                text: (root.mixer-luminance >= 0 ? "+" : "") + round(root.mixer-luminance * 100) / 100 + " EV";
                                changed(v) => { root.mixer-changed(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: end;
                                PanelButton {
                                    text: "Pick";
                                    icon: @image-url("icons/pipette.svg");
                                    enabled: root.mixer-acts;
                                    primary: root.picking == "Mixer";
                                    clicked => { root.pick-started("Mixer"); }
                                }
                                PanelButton {
                                    text: "Reset";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    // Dead while the black and white
                                    // has the section: a section
                                    // drawn as not acting must not
                                    // clear the settings it is
                                    // holding on to, nor write a
                                    // history entry for doing it.
                                    enabled: !root.mixer-superseded;
                                    clicked => { root.mixer-reset(); }
                                }
                            }
                        }
                        // Global only: a mask carries a look, and a
                        // picture is mono or it is not, so this one
                        // is not offered on the Masks tab.
                        if root.panel-tab == "Develop": Section {
                            title: "BLACK & WHITE";
                            icon: @image-url("icons/contrast.svg");
                            collapsed <=> root.collapsed-bw;
                            switchable: true;
                            on <=> root.bw-enabled;
                            switched => { root.view-changed(); }
                            // Not gated on the switch: picking a
                            // filter is a choice of conversion, so it
                            // turns the section on rather than
                            // needing the switch thrown first.
                            Segmented {
                                options: ["None", "Red", "Orange", "Yellow", "Green", "Blue"];
                                current <=> root.bw-filter;
                                selected(v) => { root.bw-filter-changed(); }
                            }
                            Swatches {
                                colors: root.band-colors;
                                enabled: root.bw-enabled;
                                current <=> root.bw-band;
                                selected(i) => { root.bw-band-changed(); }
                            }
                            EditSlider {
                                label: "Weight";
                                enabled: root.bw-enabled;
                                // Dark at the left, the band's own
                                // color at the right: which way the
                                // band's grey goes.
                                tinted: true;
                                tint: @linear-gradient(90deg, #1a1a1a, root.dull, root.band-colors[root.bw-band]);
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.05;
                                value <=> root.bw-weight;
                                // What the band's grey actually
                                // moves by, the strength in it: at
                                // 3.00x a weight of -1 is -3 EV, and
                                // a reading of -1 EV there would be
                                // a lie about the picture.
                                text: (root.bw-applied >= 0 ? "+" : "") + round(root.bw-applied * 100) / 100 + " EV";
                                changed(v) => { root.bw-changed(); }
                            }
                            // One scalar over the whole set, so a
                            // filter keeps its shape and only its
                            // depth changes: the row still says Red.
                            EditSlider {
                                label: "Strength";
                                enabled: root.bw-enabled;
                                minimum: 0;
                                // `bw::STRENGTH_MAX`, which
                                // `read_edit` clamps to.
                                maximum: 3;
                                default: 1;
                                step: 0.05;
                                value <=> root.bw-strength;
                                text: floor(root.bw-strength-cents / 100) + "."
                                    + (mod(root.bw-strength-cents, 100) < 10 ? "0" : "")
                                    + mod(root.bw-strength-cents, 100) + "x";
                                changed(v) => { root.view-changed(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: end;
                                PanelButton {
                                    text: "Reset";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    clicked => { root.bw-reset(); }
                                }
                            }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): Section {
                            title: "COLOR GRADING" + (root.target-name == "" ? "" : "  \u{00b7}  " + root.target-name);
                            icon: @image-url("icons/palette.svg");
                            collapsed <=> root.collapsed-grading;
                            switchable: true;
                            on <=> root.grading-enabled;
                            switched => { root.view-changed(); }
                            // One wheel enlarged, for a finer hand, above the row;
                            // a wheel's name toggles it. A double click puts a
                            // wheel back to nothing.
                            if root.grade-big >= 0 && root.grade-big < root.grade-images.length: CurveEditor {
                                picture: root.grade-images[root.grade-big];
                                enabled: root.grading-enabled;
                                background: transparent;
                                pressed(x, y) => { root.grade-press(root.grade-big, x, y); }
                                moved(x, y) => { root.grade-move(root.grade-big, x, y); }
                                released => { root.grade-release(); }
                                double-clicked(x, y) => { root.grade-double(root.grade-big); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                for name[i] in ["Shadows", "Mid-tones", "Highlights"]: VerticalLayout {
                                    spacing: Theme.space-1;
                                    alignment: end;
                                    if root.grade-big != i && i < root.grade-images.length: CurveEditor {
                                        picture: root.grade-images[i];
                                        enabled: root.grading-enabled;
                                        background: transparent;
                                        pressed(x, y) => { root.grade-press(i, x, y); }
                                        moved(x, y) => { root.grade-move(i, x, y); }
                                        released => { root.grade-release(); }
                                        double-clicked(x, y) => { root.grade-double(i); }
                                    }
                                    Rectangle {
                                        height: Theme.control-height - 6px;
                                        border-radius: Theme.radius-sm;
                                        background: name-area.has-hover ? Theme.hover : transparent;
                                        name-area := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.grade-big = root.grade-big == i ? -1 : i;
                                                root.grade-resized();
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: Theme.space-1;
                                            Text {
                                                text: name;
                                                color: root.grade-range == i ? Theme.text : Theme.text-secondary;
                                                font-size: Theme.font-xs;
                                                vertical-alignment: center;
                                            }
                                            Image {
                                                source: @image-url("icons/maximize.svg");
                                                colorize: root.grade-big == i ? Theme.accent : Theme.text-muted;
                                                width: 10px;
                                                height: 10px;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }
                                }
                            }
                            EditSlider {
                                label: "Hue";
                                enabled: root.grading-enabled;
                                minimum: 0;
                                maximum: 360;
                                default: 0;
                                step: 1;
                                value <=> root.grade-hue;
                                text: round(root.grade-hue) + "°";
                                changed(v) => { root.grade-changed(); }
                            }
                            EditSlider {
                                label: "Strength";
                                enabled: root.grading-enabled;
                                minimum: 0;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.grade-saturation;
                                text: round(root.grade-saturation * 100) + "%";
                                changed(v) => { root.grade-changed(); }
                            }
                            EditSlider {
                                label: "Balance";
                                enabled: root.grading-enabled;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.02;
                                value <=> root.grade-balance;
                                text: (root.grade-balance >= 0 ? "+" : "") + round(root.grade-balance * 100);
                                changed(v) => { root.view-changed(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: end;
                                PanelButton {
                                    text: "Reset";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    clicked => { root.grade-reset(); }
                                }
                            }
                        }
                        // A tint toward one hue, the last thing the
                        // Oklab pass does: Lightroom's local Color,
                        // and a look's, so the global picture and
                        // every mask can carry one. No switch: the
                        // amount at nothing is off.
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): Section {
                            title: "TINT" + (root.target-name == "" ? "" : "  \u{00b7}  " + root.target-name);
                            icon: @image-url("icons/palette.svg");
                            collapsed <=> root.collapsed-tint;
                            // The hue ring: a drag sets the hue by
                            // the angle and the amount by the
                            // distance from the center, which is a
                            // finer hand on the hue than a slider
                            // 360 degrees long. A double click is
                            // off. The two sliders are the same two
                            // numbers and stay in step. Nothing is
                            // drawn until a file opens, so the ring
                            // is absent until then rather than a gap,
                            // as the wheels' row is.
                            if root.tint-image.width > 0: HorizontalLayout {
                                alignment: center;
                                CurveEditor {
                                    width: 176px;
                                    picture: root.tint-image;
                                    background: transparent;
                                    pressed(x, y) => { root.tint-press(x, y); }
                                    moved(x, y) => { root.tint-move(x, y); }
                                    released => { root.tint-release(); }
                                    // Off, which is what Reset is.
                                    double-clicked(x, y) => { root.tint-reset(); }
                                }
                            }
                            EditSlider {
                                label: "Hue";
                                // The Oklab hue circle along the
                                // track: which color each way is,
                                // the ring's own rim unrolled.
                                tinted: true;
                                tint: root.hue-circle;
                                minimum: 0;
                                maximum: 360;
                                default: 0;
                                // A tenth of a degree to the arrow
                                // keys and the wheel: the ring is
                                // the coarse hand, this the fine one.
                                step: 0.1;
                                value <=> root.tint-hue;
                                text: root.tint-hue-text;
                                changed(v) => { root.tint-changed(); }
                            }
                            EditSlider {
                                label: "Amount";
                                minimum: 0;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.tint-amount;
                                text: round(root.tint-amount * 100) + "%";
                                changed(v) => { root.tint-changed(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: end;
                                // What a mid grey becomes under the
                                // tint as it stands.
                                Rectangle {
                                    width: Theme.control-height;
                                    height: Theme.control-height - 6px;
                                    y: 3px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    background: root.tint-color;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                PanelButton {
                                    text: "Reset";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    clicked => { root.tint-reset(); }
                                }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "LOOK";
                            icon: @image-url("icons/film.svg");
                            collapsed <=> root.collapsed-look;
                            // The list: no look first, then the tables
                            // the look directory holds.
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.base;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for label[i] in root.look-labels: Rectangle {
                                        property <bool> on: root.look-names[i] == root.look-name;
                                        height: Theme.control-height;
                                        border-radius: Theme.radius-sm;
                                        background: on ? Theme.raised : (look-row.has-hover ? Theme.hover : transparent);
                                        animate background { duration: Theme.quick; }
                                        look-row := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                root.look-name = root.look-names[i];
                                                root.look-picked();
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: Theme.space-2;
                                            padding-right: Theme.space-2;
                                            Text {
                                                text: label;
                                                color: on ? Theme.text : (look-row.has-hover ? Theme.text : Theme.text-secondary);
                                                font-size: Theme.font-xs;
                                                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                            }
                            EditSlider {
                                label: "Strength";
                                enabled: root.look-name != "none";
                                minimum: 0;
                                maximum: 1;
                                default: 1;
                                step: 0.01;
                                value <=> root.look-strength;
                                text: round(root.look-strength * 100) + "%";
                                changed(v) => { root.view-changed(); }
                            }
                            if root.look-warning != "": Text {
                                text: root.look-warning;
                                color: Theme.label-yellow;
                                font-size: Theme.font-xs;
                                wrap: word-wrap;
                            }
                            if root.look-note != "": Text {
                                text: root.look-note;
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: end;
                                // Back to no look at a full strength,
                                // which is what the section opens at.
                                PanelButton {
                                    text: "Reset";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    clicked => {
                                        root.look-name = "none";
                                        root.look-strength = 1.0;
                                        root.look-picked();
                                    }
                                }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "NOISE";
                            icon: @image-url("icons/sparkles.svg");
                            hint: root.raw-input ? "" : "raw only";
                            collapsed <=> root.collapsed-noise;
                            switchable: true;
                            on <=> root.noise-enabled;
                            switched => { root.develop-changed(); }
                            // The learned denoiser stands in for the
                            // demosaic and the profiled denoise both.
                            Segmented {
                                options: root.denoise-tiers;
                                enabled: root.raw-input;
                                current <=> root.denoise-learned;
                                selected(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Blend";
                                enabled: root.raw-input && root.denoise-learned != "off";
                                minimum: 0;
                                maximum: 1;
                                default: 1;
                                step: 0.05;
                                value <=> root.denoise-learned-strength;
                                text: round(root.denoise-learned-strength * 100) + "%";
                                changed(v) => { root.develop-changed(); }
                            }
                            Toggle {
                                label: "Denoise";
                                enabled: root.raw-input && root.denoise-learned == "off";
                                checked <=> root.denoise;
                                toggled => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Strength";
                                enabled: root.raw-input && root.denoise && root.denoise-learned == "off";
                                minimum: 0.5;
                                maximum: 3;
                                default: 1.5;
                                step: 0.05;
                                value <=> root.denoise-strength;
                                text: round(root.denoise-strength * 100) / 100;
                                changed(v) => { root.develop-changed(); }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "LENS";
                            icon: @image-url("icons/aperture.svg");
                            collapsed <=> root.collapsed-lens;
                            switchable: true;
                            on <=> root.lens-enabled;
                            switched => { root.develop-changed(); }
                            Text {
                                text: root.lens-profile;
                                color: root.lens-available ? Theme.text : Theme.text-secondary;
                                font-size: Theme.font-sm;
                                wrap: word-wrap;
                            }
                            if !root.lens-database: PanelButton {
                                text: "Get lens profiles";
                                icon: @image-url("icons/image-down.svg");
                                clicked => { root.fetch-lenses(); }
                            }
                            Toggle {
                                label: "Profile";
                                enabled: root.lens-available;
                                checked <=> root.lens-profile-on;
                                toggled => { root.develop-changed(); }
                            }
                            Toggle {
                                label: "Distortion";
                                enabled: root.lens-available && root.lens-profile-on;
                                checked <=> root.lens-distortion;
                                toggled => { root.develop-changed(); }
                            }
                            Toggle {
                                label: "Chromatic aberration";
                                enabled: root.lens-available && root.lens-profile-on;
                                checked <=> root.lens-ca;
                                toggled => { root.develop-changed(); }
                            }
                            Toggle {
                                label: "Vignetting";
                                enabled: root.lens-available && root.lens-profile-on;
                                checked <=> root.lens-vignetting;
                                toggled => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Manual";
                                minimum: -0.5;
                                maximum: 0.5;
                                default: 0;
                                step: 0.005;
                                value <=> root.lens-manual;
                                text: (root.lens-manual >= 0 ? "+" : "") + round(root.lens-manual * 1000) / 10;
                                changed(v) => { root.develop-changed(); }
                            }
                            // The aberration by hand: each channel's
                            // radius scaled beyond the green's, in
                            // tenths of a percent.
                            EditSlider {
                                label: "Red / cyan";
                                minimum: -0.01;
                                maximum: 0.01;
                                default: 0;
                                step: 0.0001;
                                value <=> root.lens-ca-red;
                                text: (root.lens-ca-red >= 0 ? "+" : "") + round(root.lens-ca-red * 10000) / 10 + "\u{2030}";
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Blue / yellow";
                                minimum: -0.01;
                                maximum: 0.01;
                                default: 0;
                                step: 0.0001;
                                value <=> root.lens-ca-blue;
                                text: (root.lens-ca-blue >= 0 ? "+" : "") + round(root.lens-ca-blue * 10000) / 10 + "\u{2030}";
                                changed(v) => { root.develop-changed(); }
                            }
                            Toggle {
                                label: "Auto scale";
                                checked <=> root.lens-auto-scale;
                                toggled => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Scale";
                                enabled: !root.lens-auto-scale;
                                minimum: 0.5;
                                maximum: 2;
                                default: 1;
                                step: 0.01;
                                value <=> root.lens-scale;
                                text: round(root.lens-scale * 100) + "%";
                                changed(v) => { root.develop-changed(); }
                            }
                            // Axial aberration and purple fringing: a
                            // different fault from the lateral one the
                            // profile and the two sliders above correct.
                            Toggle {
                                label: "Defringe";
                                checked <=> root.lens-defringe;
                                toggled => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Radius";
                                enabled: root.lens-defringe;
                                minimum: 0.5;
                                maximum: 5;
                                default: 2;
                                step: 0.1;
                                value <=> root.lens-defringe-radius;
                                text: round(root.lens-defringe-radius * 10) / 10 + " px";
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Threshold";
                                enabled: root.lens-defringe;
                                minimum: 0;
                                maximum: 100;
                                default: 13;
                                step: 1;
                                value <=> root.lens-defringe-threshold;
                                text: round(root.lens-defringe-threshold);
                                changed(v) => { root.develop-changed(); }
                            }
                            // Which hues count as a fringe. The two
                            // windows are the two sides of an axial
                            // aberration; a chroma that departs from
                            // its neighborhood in any other direction
                            // is a red berry on a grey wall, and is
                            // left alone. The dropper reads a click's
                            // deviation hue and moves the nearer
                            // window's center to it.
                            Text {
                                text: "Purple";
                                color: root.lens-defringe ? Theme.text-secondary : Theme.text-muted;
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-semibold;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }
                            EditSlider {
                                label: "Center";
                                enabled: root.lens-defringe;
                                tinted: true;
                                tint: root.hue-circle;
                                minimum: 0;
                                maximum: 360;
                                default: 310;
                                step: 1;
                                value <=> root.lens-defringe-purple-center;
                                text: round(root.lens-defringe-purple-center) + "\u{00b0}";
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Width";
                                enabled: root.lens-defringe;
                                minimum: 10;
                                maximum: 360;
                                default: 120;
                                step: 5;
                                value <=> root.lens-defringe-purple-width;
                                text: round(root.lens-defringe-purple-width) + "\u{00b0}";
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Amount";
                                enabled: root.lens-defringe;
                                minimum: 0;
                                maximum: 1;
                                default: 1;
                                step: 0.05;
                                value <=> root.lens-defringe-purple-amount;
                                text: round(root.lens-defringe-purple-amount * 100) + "%";
                                changed(v) => { root.develop-changed(); }
                            }
                            Text {
                                text: "Green";
                                color: root.lens-defringe ? Theme.text-secondary : Theme.text-muted;
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-semibold;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }
                            EditSlider {
                                label: "Center";
                                enabled: root.lens-defringe;
                                tinted: true;
                                tint: root.hue-circle;
                                minimum: 0;
                                maximum: 360;
                                default: 130;
                                step: 1;
                                value <=> root.lens-defringe-green-center;
                                text: round(root.lens-defringe-green-center) + "\u{00b0}";
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Width";
                                enabled: root.lens-defringe;
                                minimum: 10;
                                maximum: 360;
                                default: 120;
                                step: 5;
                                value <=> root.lens-defringe-green-width;
                                text: round(root.lens-defringe-green-width) + "\u{00b0}";
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Amount";
                                enabled: root.lens-defringe;
                                minimum: 0;
                                maximum: 1;
                                default: 1;
                                step: 0.05;
                                value <=> root.lens-defringe-green-amount;
                                text: round(root.lens-defringe-green-amount * 100) + "%";
                                changed(v) => { root.develop-changed(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                alignment: end;
                                PanelButton {
                                    text: "Pick hue";
                                    icon: @image-url("icons/pipette.svg");
                                    enabled: root.lens-defringe;
                                    primary: root.picking == "Defringe";
                                    clicked => { root.pick-started("Defringe"); }
                                }
                            }
                        }
                        // Local contrast, the Texture and Clarity of the
                        // engine's guided filter: a develop op, so the
                        // worker runs it, after the retouch and before
                        // the sharpen.
                        if root.panel-tab == "Develop": Section {
                            title: "DETAIL";
                            icon: @image-url("icons/blend.svg");
                            collapsed <=> root.collapsed-detail;
                            switchable: true;
                            on <=> root.detail-enabled;
                            switched => { root.develop-changed(); }
                            EditSlider {
                                label: "Texture";
                                enabled: root.detail-enabled;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.detail-texture;
                                text: (root.detail-texture >= 0 ? "+" : "") + round(root.detail-texture * 100);
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Clarity";
                                enabled: root.detail-enabled;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.detail-clarity;
                                text: (root.detail-clarity >= 0 ? "+" : "") + round(root.detail-clarity * 100);
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Dehaze";
                                enabled: root.detail-enabled;
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.detail-dehaze;
                                text: (root.detail-dehaze >= 0 ? "+" : "") + round(root.detail-dehaze * 100);
                                changed(v) => { root.develop-changed(); }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "SHARPEN";
                            icon: @image-url("icons/focus.svg");
                            collapsed <=> root.collapsed-sharpen;
                            switchable: true;
                            on <=> root.sharpen;
                            switched => { root.develop-changed(); }
                            Toggle {
                                label: "Auto radius";
                                enabled: root.sharpen;
                                checked <=> root.sharpen-auto-radius;
                                toggled => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Radius";
                                enabled: root.sharpen && !root.sharpen-auto-radius;
                                minimum: 0.4;
                                maximum: 2;
                                default: 0.75;
                                step: 0.01;
                                value <=> root.sharpen-radius;
                                text: root.sharpen-auto-radius
                                    ? (root.sharpen-measured-radius > 0 ? "auto " + round(root.sharpen-measured-radius * 100) / 100 : "auto")
                                    : round(root.sharpen-radius * 100) / 100;
                                changed(v) => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Iterations";
                                enabled: root.sharpen;
                                minimum: 5;
                                maximum: 50;
                                default: 20;
                                step: 1;
                                value <=> root.sharpen-iterations;
                                text: round(root.sharpen-iterations);
                                changed(v) => { root.develop-changed(); }
                            }
                            Toggle {
                                label: "Auto threshold";
                                enabled: root.sharpen;
                                checked <=> root.sharpen-auto-threshold;
                                toggled => { root.develop-changed(); }
                            }
                            EditSlider {
                                label: "Threshold";
                                enabled: root.sharpen && !root.sharpen-auto-threshold;
                                minimum: 0;
                                maximum: 0.5;
                                default: 0.1;
                                step: 0.01;
                                value <=> root.sharpen-threshold;
                                text: root.sharpen-auto-threshold
                                    ? "auto " + round(root.sharpen-measured-threshold * 100) + "%"
                                    : round(root.sharpen-threshold * 100) + "%";
                                changed(v) => { root.develop-changed(); }
                            }
                            Toggle {
                                label: "Show mask";
                                enabled: root.sharpen;
                                checked <=> root.show-sharpen-mask;
                                toggled => { root.view-changed(); }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "VIGNETTE";
                            icon: @image-url("icons/circle-dashed.svg");
                            collapsed <=> root.collapsed-vignette;
                            switchable: true;
                            on <=> root.vignette-enabled;
                            switched => { root.view-changed(); }
                            EditSlider {
                                label: "Amount";
                                minimum: -5;
                                maximum: 5;
                                default: 0;
                                step: 0.05;
                                value <=> root.vignette-amount;
                                text: (root.vignette-amount >= 0 ? "+" : "") + round(root.vignette-amount * 100) / 100 + " EV";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Midpoint";
                                minimum: 0;
                                maximum: 1;
                                default: 0.5;
                                step: 0.01;
                                value <=> root.vignette-midpoint;
                                text: round(root.vignette-midpoint * 100) + "%";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Feather";
                                minimum: 0;
                                maximum: 1;
                                default: 0.5;
                                step: 0.01;
                                value <=> root.vignette-feather;
                                text: round(root.vignette-feather * 100) + "%";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Roundness";
                                minimum: -1;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.vignette-roundness;
                                text: (root.vignette-roundness >= 0 ? "+" : "") + round(root.vignette-roundness * 100);
                                changed(v) => { root.view-changed(); }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "GRAIN";
                            icon: @image-url("icons/grip.svg");
                            collapsed <=> root.collapsed-grain;
                            switchable: true;
                            on <=> root.grain-enabled;
                            switched => { root.view-changed(); }
                            EditSlider {
                                label: "Amount";
                                minimum: 0;
                                maximum: 1;
                                default: 0;
                                step: 0.01;
                                value <=> root.grain-amount;
                                text: round(root.grain-amount * 100) + "%";
                                changed(v) => { root.view-changed(); }
                            }
                            EditSlider {
                                label: "Size";
                                minimum: 0.1;
                                maximum: 2;
                                default: 0.5;
                                step: 0.01;
                                value <=> root.grain-size;
                                text: round(root.grain-size * 100) / 100 + "\u{2030}";
                                changed(v) => { root.view-changed(); }
                            }
                            Segmented {
                                options: ["Cubic", "Tabular"];
                                current <=> root.grain-kind;
                                selected(k) => { root.view-changed(); }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "SOFT PROOF";
                            icon: @image-url("icons/image.svg");
                            collapsed <=> root.collapsed-proof;
                            hint: "S";
                            switchable: true;
                            on <=> root.proofing;
                            switched => { root.proof-changed(); }
                            Segmented {
                                options: ["sRGB", "Display P3", "Rec.2020", "File"];
                                current <=> root.proof-profile;
                                selected(p) => { root.proof-changed(); }
                            }
                            if root.proof-profile == "File": HorizontalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: root.proof-file == "" ? "No profile chosen" : root.proof-file;
                                    color: root.proof-file == "" ? Theme.text-muted : Theme.text-secondary;
                                    font-size: Theme.font-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                PanelButton {
                                    text: "Choose...";
                                    clicked => { root.choose-proof-file(); }
                                }
                            }
                            Segmented {
                                options: ["Perceptual", "Relative"];
                                current <=> root.proof-intent;
                                selected(i) => { root.proof-changed(); }
                            }
                            Toggle {
                                label: "Gamut warning";
                                enabled: root.proofing;
                                checked <=> root.gamut-warning;
                                toggled => { root.proof-changed(); }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "MONITOR";
                            icon: @image-url("icons/maximize.svg");
                            collapsed <=> root.collapsed-monitor;
                            Segmented {
                                options: ["System", "sRGB", "Adobe RGB", "Display P3", "File"];
                                current <=> root.display-profile;
                                selected(p) => { root.display-changed(); }
                            }
                            if root.display-profile == "System" && root.monitors.length > 1: Segmented {
                                options: root.monitors;
                                current <=> root.display-monitor;
                                selected(m) => { root.display-changed(); }
                            }
                            if root.display-profile == "File": HorizontalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: root.display-file == "" ? "No profile chosen" : root.display-file;
                                    color: root.display-file == "" ? Theme.text-muted : Theme.text-secondary;
                                    font-size: Theme.font-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                PanelButton {
                                    text: "Choose...";
                                    clicked => { root.choose-display-file(); }
                                }
                            }
                            Text {
                                text: root.display-note;
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: "Canvas"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                Swatches {
                                    colors: root.canvas-colors;
                                    current <=> root.canvas-choice;
                                    selected(i) => { root.canvas-changed(); }
                                }
                            }
                        }
                        // The Crop tab in three: what is kept, which way
                        // up it is, and the keystone. One section held
                        // them all until the guide's buttons arrived and
                        // the perspective's own heading began to read as
                        // a second section inside the first.
                        if root.panel-tab == "Crop": Section {
                            title: "CROP";
                            icon: @image-url("icons/crop.svg");
                            collapsed <=> root.collapsed-crop;
                            PanelButton {
                                text: root.crop-mode ? "Done" : "Crop";
                                icon: @image-url("icons/crop.svg");
                                primary: root.crop-mode;
                                clicked => {
                                    root.crop-mode = !root.crop-mode;
                                    root.level-mode = false;
                                    root.guide-mode = "";
                                    root.guide-dropped();
                                    root.crop-toggled();
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: "Aspect"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                ComboBox {
                                    model: ["Free", "Original", "1:1", "3:2", "4:3", "5:4", "16:9", "65:24", "Custom"];
                                    current-value <=> root.aspect-name;
                                    selected(v) => { root.geometry-changed(); }
                                }
                            }
                            if root.aspect-name == "Custom": HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: "Custom"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.aspect-custom;
                                    placeholder-text: "W:H";
                                    accepted(t) => { root.geometry-changed(); }
                                    edited(t) => { root.geometry-changed(); }
                                }
                            }
                            Toggle {
                                label: "Portrait";
                                checked <=> root.portrait;
                                toggled => { root.geometry-changed(); }
                            }
                        }
                        if root.panel-tab == "Crop": Section {
                            title: "ROTATE";
                            icon: @image-url("icons/rotate-cw.svg");
                            collapsed <=> root.collapsed-rotate;
                            PanelButton {
                                text: "Level";
                                icon: @image-url("icons/ruler.svg");
                                primary: root.level-mode;
                                clicked => {
                                    if (!root.crop-mode) { root.crop-mode = true; root.crop-toggled(); }
                                    root.guide-mode = "";
                                    root.guide-dropped();
                                    root.level-mode = !root.level-mode;
                                }
                            }
                            // Quarter turns and mirrors.
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                PanelButton {
                                    text: "";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    clicked => { root.geometry-turned(1); }
                                }
                                PanelButton {
                                    text: "";
                                    icon: @image-url("icons/rotate-cw.svg");
                                    clicked => { root.geometry-turned(-1); }
                                }
                                PanelButton {
                                    text: "";
                                    icon: @image-url("icons/flip-horizontal.svg");
                                    clicked => { root.geometry-flipped(false); }
                                }
                                PanelButton {
                                    text: "";
                                    icon: @image-url("icons/flip-vertical.svg");
                                    clicked => { root.geometry-flipped(true); }
                                }
                            }
                            EditSlider {
                                label: "Angle";
                                minimum: -45;
                                maximum: 45;
                                default: 0;
                                step: 0.1;
                                value <=> root.geo-angle;
                                text: (root.geo-angle >= 0 ? "+" : "") + round(root.geo-angle * 10) / 10 + "°";
                                changed(v) => { root.geometry-changed(); }
                            }
                            // The frame's own turn, under the edit's.
                            // The four above are a step in developing
                            // the picture; these two say the camera
                            // recorded the wrong way up, so they are
                            // no part of the edit.
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                PanelButton {
                                    text: "Turn left";
                                    icon: @image-url("icons/rotate-ccw.svg");
                                    clicked => { root.frame-turned(-1); }
                                }
                                PanelButton {
                                    text: "Turn right";
                                    icon: @image-url("icons/rotate-cw.svg");
                                    clicked => { root.frame-turned(1); }
                                }
                            }
                            Text {
                                text: "Turn the frame itself ([ and ], in culling too): the orientation the camera recorded, put right. It is not an edit, so undo, snapshots and presets leave it where it is.";
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }
                        // The keystone: the camera's tilt, up or to the
                        // right positive, for a lens whose focal length
                        // is the frame's half side.
                        if root.panel-tab == "Crop": Section {
                            title: "PERSPECTIVE";
                            icon: @image-url("icons/keystone.svg");
                            collapsed <=> root.collapsed-perspective;
                            // The guide: two strokes along lines of the
                            // picture that should run one way give the
                            // turn and that way's keystone at once.
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                PanelButton {
                                    text: "Verticals";
                                    icon: @image-url("icons/ruler.svg");
                                    primary: root.guide-mode == "Vertical";
                                    clicked => {
                                        if (!root.crop-mode) { root.crop-mode = true; root.crop-toggled(); }
                                        root.level-mode = false;
                                        root.guide-dropped();
                                        root.guide-mode = root.guide-mode == "Vertical" ? "" : "Vertical";
                                    }
                                }
                                PanelButton {
                                    text: "Horizontals";
                                    icon: @image-url("icons/ruler.svg");
                                    primary: root.guide-mode == "Horizontal";
                                    clicked => {
                                        if (!root.crop-mode) { root.crop-mode = true; root.crop-toggled(); }
                                        root.level-mode = false;
                                        root.guide-dropped();
                                        root.guide-mode = root.guide-mode == "Horizontal" ? "" : "Horizontal";
                                    }
                                }
                            }
                            EditSlider {
                                label: "Vertical";
                                minimum: -40;
                                maximum: 40;
                                default: 0;
                                step: 0.1;
                                value <=> root.geo-vertical;
                                text: (root.geo-vertical >= 0 ? "+" : "") + round(root.geo-vertical * 10) / 10 + "°";
                                changed(v) => { root.geometry-changed(); }
                            }
                            EditSlider {
                                label: "Horizontal";
                                minimum: -40;
                                maximum: 40;
                                default: 0;
                                step: 0.1;
                                value <=> root.geo-horizontal;
                                text: (root.geo-horizontal >= 0 ? "+" : "") + round(root.geo-horizontal * 10) / 10 + "°";
                                changed(v) => { root.geometry-changed(); }
                            }
                            // The whole of the Crop tab goes back at
                            // once, from the end of it: the three
                            // sections are one edit, and a Reset inside
                            // any one of them would read as that one's.
                            PanelButton {
                                text: "Reset all";
                                icon: @image-url("icons/undo-2.svg");
                                clicked => { root.geometry-reset(); }
                            }
                        }
                        if root.panel-tab == "Develop": Section {
                            title: "DEMOSAIC";
                            icon: @image-url("icons/grid-2x2.svg");
                            hint: root.raw-input ? "" : "raw only";
                            collapsed <=> root.collapsed-demosaic;
                            if root.raw-input: Segmented {
                                options: root.demosaics;
                                current <=> root.demosaic;
                                selected(v) => { root.develop-changed(); }
                            }
                            if !root.raw-input: Text {
                                text: root.source-note;
                                color: Theme.text-secondary;
                                font-size: Theme.font-sm;
                                wrap: word-wrap;
                            }
                        }
                        if root.panel-tab == "Retouch": Section {
                            title: "RETOUCH";
                            icon: @image-url("icons/bandage.svg");
                            collapsed <=> root.collapsed-retouch;
                            switchable: true;
                            on <=> root.retouch-enabled;
                            switched => { root.develop-changed(); }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                PanelButton {
                                    text: "Heal";
                                    icon: @image-url("icons/bandage.svg");
                                    primary: root.retouch-mode == "Heal";
                                    clicked => { root.retouch-toggled("Heal"); }
                                }
                                PanelButton {
                                    text: "Clone";
                                    icon: @image-url("icons/stamp.svg");
                                    primary: root.retouch-mode == "Clone";
                                    clicked => { root.retouch-toggled("Clone"); }
                                }
                                PanelButton {
                                    text: "Fill";
                                    icon: @image-url("icons/sparkles.svg");
                                    primary: root.retouch-mode == "Fill";
                                    clicked => { root.retouch-toggled("Fill"); }
                                }
                            }
                            if root.retouch-mode != "": VerticalLayout {
                                spacing: Theme.space-2;
                                EditSlider {
                                    label: "Size";
                                    minimum: 0.002;
                                    maximum: 0.3;
                                    default: 0.02;
                                    step: 0.001;
                                    value <=> root.patch-size;
                                    text: round(root.patch-size * 1000) / 10 + "%";
                                    changed(v) => { root.patch-edited(); }
                                }
                                EditSlider {
                                    label: "Feather";
                                    minimum: 0;
                                    maximum: 1;
                                    default: 0.3;
                                    step: 0.01;
                                    value <=> root.patch-feather;
                                    text: round(root.patch-feather * 100) + "%";
                                    changed(v) => { root.patch-edited(); }
                                }
                                EditSlider {
                                    label: "Opacity";
                                    minimum: 0;
                                    maximum: 1;
                                    default: 1;
                                    step: 0.01;
                                    value <=> root.patch-opacity;
                                    text: round(root.patch-opacity * 100) + "%";
                                    changed(v) => { root.patch-edited(); }
                                }
                            }
                            if root.patch-names.length > 0: Rectangle {
                                border-radius: Theme.radius-md;
                                border-width: 1px;
                                border-color: Theme.border;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for name[i] in root.patch-names: Rectangle {
                                        property <bool> on: i == root.patch;
                                        height: Theme.control-height;
                                        border-radius: Theme.radius-sm;
                                        background: on ? Theme.raised : (prow.has-hover ? Theme.hover : transparent);
                                        animate background { duration: Theme.quick; }
                                        prow := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.patch-changed(i); }
                                        }
                                        HorizontalLayout {
                                            padding-left: Theme.space-2;
                                            padding-right: Theme.space-1;
                                            spacing: Theme.space-2;
                                            Text {
                                                text: name;
                                                color: on ? Theme.text : Theme.text-secondary;
                                                font-size: Theme.font-xs;
                                                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                            if on: Rectangle {
                                                width: Theme.control-height - 4px;
                                                Image {
                                                    source: @image-url("icons/trash-2.svg");
                                                    colorize: pbin.has-hover ? Theme.text : Theme.text-secondary;
                                                    width: Theme.icon;
                                                    height: Theme.icon;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                pbin := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => { root.delete-patch(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: Theme.control-height + 2 * Theme.space-3 + 1px;
                    background: Theme.surface;
                    Rectangle { y: 0; height: 1px; width: 100%; background: Theme.border; }
                    HorizontalLayout {
                        padding: Theme.space-3;
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-4;
                        spacing: Theme.space-2;
                        PanelButton {
                            text: "Fit";
                            icon: @image-url("icons/maximize.svg");
                            clicked => { root.reset-view(); }
                        }
                        PanelButton {
                            text: "Export...";
                            icon: @image-url("icons/image-down.svg");
                            primary: true;
                            enabled: !root.busy && root.selected >= 0 && !root.culling;
                            clicked => { root.export-open = true; }
                        }
                    }
                }
                }
            }
        }

        // Filmstrip.
        Rectangle {
            height: 148px;
            background: Theme.surface;
            Rectangle { y: 0; height: 1px; width: 100%; background: Theme.border; }
            // A wheel over the strip scrolls it sideways. Slint's
            // Flickable only takes a wheel along an axis it can
            // move, and this one moves in x alone, so the vertical
            // wheel is turned here: this TouchArea encloses the
            // strip and sees what the thumbnails and the Flickable
            // reject. Dragging is the Flickable's own, and it
            // cancels the thumbnail's click once it takes over.
            TouchArea {
                scroll-event(e) => {
                    // Only the vertical wheel: one with a sideways
                    // component is the Flickable's, which has the
                    // room for it and takes it before this is asked.
                    if (e.delta-y == 0px) { return reject; }
                    root.strip-scroll(e.delta-y);
                    return accept;
                }
                strip := Flickable {
                    content-width: max(self.width, root.thumbs.length * root.strip-pitch + 2 * root.strip-pad);
                    // No room to move in y, or the Flickable takes the
                    // vertical wheel for itself: its content would
                    // otherwise be the row's preferred height, a few
                    // pixels taller than the strip, and a wheel would
                    // nudge the thumbnails up instead of along.
                    content-height: self.height;
                    changed content-x => { root.strip-report(); }
                    // The first layout, and a folder swapped in.
                    changed width => { root.strip-relay(); }
                    changed content-width => { root.strip-relay(); }
                    HorizontalLayout {
                        padding: root.strip-pad;
                        spacing: root.strip-pitch - root.strip-item;
                        alignment: start;
                        for t[i] in root.thumbs: Rectangle {
                            property <bool> on: i == root.selected;
                            width: root.strip-item;
                            border-radius: Theme.radius-md;
                            background: on ? Theme.selection : (tt.has-hover ? Theme.hover : transparent);
                            border-width: on ? 1px : 0;
                            border-color: Theme.accent-muted;
                            animate background { duration: Theme.quick; }
                            VerticalLayout {
                                padding: Theme.space-2;
                                spacing: Theme.space-1;
                                Image {
                                    source: t.image;
                                    height: 96px;
                                    image-fit: contain;
                                }
                                Text {
                                    text: t.name;
                                    color: on ? Theme.text : Theme.text-secondary;
                                    font-size: Theme.font-xs;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                            }
                            // Over the picture's bottom corner, not in
                            // the row with the name: the badges must
                            // not push the name out of the middle, and
                            // the cell's height is the strip's.
                            ThumbBadges {
                                x: Theme.space-2 + Theme.space-1;
                                y: Theme.space-2 + 96px - self.height - Theme.space-1;
                                rating: t.rating;
                                flag: t.flag;
                                label: t.label;
                                stars: root.meta-stars;
                            }
                            tt := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { keys.focus(); root.select(i); }
                            }
                        }
                    }
                }
            }
        }
    }

    // The grid, over the window: the folder as a contact sheet, in
    // place of the viewport, the strip and both panels. It is drawn
    // over them rather than swapped in for them so the viewport's
    // texture, and everything named inside it, stays where the rest
    // of the window can reach it.
    if root.grid-open: Rectangle {
        background: Theme.sheet;
        // Nothing may fall through to the viewport behind, the wheel
        // over the header least of all: it would zoom a picture that
        // is not on screen, or size the brush in hand.
        TouchArea {
            scroll-event(e) => { return accept; }
        }
        VerticalLayout {
            // The header: what is selected and how large the cells
            // are, then the filter, where the three-way Show used to
            // be. It takes two rows now, because the chips and the
            // words being looked for do not fit on one at a window
            // narrow enough to work on.
            Rectangle {
                // Two rows of controls and a row of chips, which is
                // the filter bar's own two. Spelled out rather than
                // asked of the layout: a header whose height settles
                // a frame late re-flows the sheet twice on the way
                // in, and the second re-flow is a folder's worth of
                // thumbnails asked for again.
                height: 2 * Theme.control-height + (Theme.control-height - 4px)
                    + 4 * Theme.space-2 + 1px;
                background: Theme.surface;
                Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }
                header := VerticalLayout {
                    padding: Theme.space-2;
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    spacing: Theme.space-2;
                    HorizontalLayout {
                        spacing: Theme.space-3;
                        // The left panel's first button, here where the
                        // grid covers it: the grid is where a folder is
                        // looked over, so it is where the next is asked
                        // for. Ctrl+O reaches the same callback.
                        PanelButton {
                            text: "Open folder...";
                            icon: @image-url("icons/folder-open.svg");
                            clicked => { keys.focus(); root.open-folder(); }
                        }
                        Text {
                            text: root.selected >= 0 && root.selected < root.thumbs.length
                                ? root.thumbs[root.selected].name : "";
                            color: Theme.text;
                            font-size: Theme.font-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: root.thumbs.length + (root.thumbs.length == 1 ? " frame · " : " frames · ")
                                + round(root.grid-cell / 1px) + " px";
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                        PanelButton {
                            text: root.culling ? "Culling" : "Cull";
                            icon: @image-url("icons/flag.svg");
                            primary: root.culling;
                            clicked => { keys.focus(); root.cull-toggled(); }
                        }
                        PanelButton {
                            text: "Loupe";
                            icon: @image-url("icons/image.svg");
                            clicked => { keys.focus(); root.grid-open = false; }
                        }
                    }
                    FilterBar {
                        takes-focus: true;
                        wanted <=> root.filter-focus;
                        stars: root.filter-stars;
                        flags: root.filter-flags;
                        labels: root.filter-labels;
                        exact: root.filter-exact;
                        shown: root.filter-shown;
                        total: root.filter-total;
                        on: root.filter-on;
                        text <=> root.filter-text;
                        star-picked(i) => { root.filter-star-picked(i); }
                        flag-toggled(i) => { root.filter-flag-toggled(i); }
                        label-toggled(i) => { root.filter-label-toggled(i); }
                        exact-toggled => { root.filter-exact-toggled(); }
                        text-edited(t) => { root.filter-text-edited(t); }
                        cleared => { root.filter-cleared(); }
                        released => { keys.focus(); }
                    }
                }
            }
            grid-sheet := Rectangle {
                clip: true;
                // The first layout, a re-flow, a new folder: put the
                // selection back on screen from the top. Opened by G
                // the sheet is born at its full size, and `changed`
                // says nothing about a first value, so `init` reads
                // it; `changed` is for the window resizing under it.
                init => { root.grid-w = self.width; root.grid-h = self.height; root.grid-relay(); }
                changed width => { root.grid-w = self.width; root.grid-relay(); }
                changed height => { root.grid-h = self.height; root.grid-relay(); }
                // The cells ride on this one, which is also what sees
                // the wheel: a cell's own TouchArea rejects a scroll
                // and it rises to this, its parent, wherever the
                // pointer is. One offset moves the sheet, rather than
                // a binding on every cell.
                TouchArea {
                    y: -root.grid-scroll;
                    width: parent.width;
                    // The sheet, or the window's worth of it when
                    // the folder is short: what can be scrolled past
                    // is exactly how far it scrolls.
                    height: parent.height + root.grid-max;
                    scroll-event(e) => {
                        // A sideways wheel is nobody's here, and with
                        // Ctrl it would zoom out on a delta of zero.
                        if (e.delta-y == 0px) { return reject; }
                        root.grid-wheel(e.delta-y, e.modifiers.control);
                        return accept;
                    }
                    for t[i] in root.thumbs: Rectangle {
                        property <bool> on: i == root.selected;
                        x: root.grid-left + mod(i, root.grid-cols) * root.grid-pitch;
                        y: root.grid-pad + floor(i / root.grid-cols) * root.grid-row;
                        width: root.grid-cell;
                        height: root.grid-cell + root.grid-label;
                        border-radius: Theme.radius-md;
                        background: on ? Theme.selection : (ct.has-hover ? Theme.hover : transparent);
                        border-width: on ? 2px : 0;
                        border-color: Theme.accent;
                        animate background { duration: Theme.quick; }
                        Image {
                            x: Theme.space-1;
                            y: Theme.space-1;
                            width: parent.width - 2 * Theme.space-1;
                            height: root.grid-cell - 2 * Theme.space-1;
                            source: t.image;
                            image-fit: contain;
                        }
                        Text {
                            y: root.grid-cell;
                            width: 100%;
                            height: root.grid-label;
                            text: t.name;
                            color: on ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // The picture's own box inside the cell.
                        // `contain` leaves a margin on one axis, and
                        // a badge in that margin sits beside the
                        // frame rather than on it; before the
                        // thumbnail arrives there is no aspect to go
                        // on and the box is the cell's.
                        property <length> box: root.grid-cell - 2 * Theme.space-1;
                        property <length> shown-w: t.image.width > 0 && t.image.height > 0
                            ? min(self.box, self.box * t.image.width / t.image.height)
                            : self.box;
                        property <length> shown-h: t.image.width > 0 && t.image.height > 0
                            ? min(self.box, self.box * t.image.height / t.image.width)
                            : self.box;
                        ThumbBadges {
                            // On the picture's bottom left corner,
                            // held inside the cell: a tall frame in a
                            // small cell is narrower than the badge,
                            // and a pill that hangs over the edge
                            // belongs to the frame beside it.
                            x: clamp(
                                Theme.space-1 + (parent.box - parent.shown-w) / 2 + Theme.space-1,
                                Theme.space-1,
                                max(Theme.space-1, Theme.space-1 + parent.box - self.width));
                            y: clamp(
                                Theme.space-1 + (parent.box + parent.shown-h) / 2
                                    - self.height - Theme.space-1,
                                Theme.space-1,
                                max(Theme.space-1, Theme.space-1 + parent.box - self.height));
                            rating: t.rating;
                            flag: t.flag;
                            label: t.label;
                            stars: root.meta-stars;
                            // With the cell, within reason: the
                            // smallest cell keeps the size the strip
                            // uses, and the largest does not turn a
                            // quiet mark into a label across the
                            // picture.
                            glyph: clamp(root.grid-cell / 16, 9px, 18px);
                        }
                        ct := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { keys.focus(); root.select(i); }
                            // The frame under the pointer, in the loupe.
                            double-clicked => { root.grid-open = false; }
                        }
                    }
                }
            }
        }
    }

    // The model sheet: a download offered, with its license, until
    // answered.
    if root.fetch-open: Rectangle {
        background: #000000a0;
        TouchArea { clicked => { root.fetch-answered(false); } }
        Rectangle {
            width: 440px;
            height: fetch-sheet.preferred-height;
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000099;
            TouchArea { }
            fetch-sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: root.fetch-title;
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.fetch-text;
                    font-size: Theme.font-sm;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text {
                    text: root.fetch-note;
                    font-size: Theme.font-sm;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Rectangle { height: Theme.space-2; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Not now";
                        clicked => { root.fetch-answered(false); }
                    }
                    PanelButton {
                        text: "Download";
                        icon: @image-url("icons/image-down.svg");
                        primary: true;
                        clicked => { root.fetch-answered(true); }
                    }
                }
            }
        }
    }

    // The move-rejects sheet: how many and where, until answered.
    // Never a delete, and no undo but a move back by hand, which it
    // says.
    if root.rejects-open: Rectangle {
        background: #000000a0;
        TouchArea { clicked => { root.rejects-answered(false); } }
        Rectangle {
            width: 440px;
            height: rejects-sheet.preferred-height;
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000099;
            TouchArea { }
            rejects-sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: "Move the rejects?";
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                }
                Text {
                    text: root.rejects-text;
                    font-size: Theme.font-sm;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Text {
                    text: "Nothing is deleted. There is no undo for this: to bring a frame back, move it out of that folder by hand.";
                    font-size: Theme.font-sm;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Rectangle { height: Theme.space-2; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Cancel";
                        clicked => { root.rejects-answered(false); }
                    }
                    PanelButton {
                        text: "Move";
                        icon: @image-url("icons/folder-open.svg");
                        primary: true;
                        clicked => { root.rejects-answered(true); }
                    }
                }
            }
        }
    }

    // The preset sheet: a name and what the preset carries, until
    // saved or left.
    if root.preset-open: Rectangle {
        background: #000000a0;
        TouchArea { clicked => { root.preset-open = false; } }
        Rectangle {
            width: 400px;
            height: preset-sheet.preferred-height;
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000099;
            TouchArea { }
            preset-sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: "Save preset";
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                }
                preset-name-edit := LineEdit {
                    text <=> root.preset-name;
                    placeholder-text: "Name";
                    accepted(t) => { root.preset-saved(); }
                    init => { self.focus(); }
                }
                Text {
                    text: "What it carries; on, what the edit changed from the default.";
                    font-size: Theme.font-xs;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                for name[i] in root.preset-section-names: Toggle {
                    label: name;
                    checked: root.preset-section-on[i];
                    toggled => { root.preset-section-toggled(i, self.checked); }
                }
                Rectangle { height: Theme.space-2; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Cancel";
                        clicked => { root.preset-open = false; }
                    }
                    PanelButton {
                        text: "Save";
                        icon: @image-url("icons/save.svg");
                        primary: true;
                        enabled: root.preset-name != "";
                        clicked => { root.preset-saved(); }
                    }
                }
            }
        }
    }

    // The export sheet, over everything, until a choice is made.
    if root.export-open: Rectangle {
        background: #000000a0;
        TouchArea { clicked => { root.export-open = false; } }
        Rectangle {
            width: 400px;
            height: sheet.preferred-height;
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000099;
            TouchArea { }
            sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: "Export";
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                }
                Text {
                    text: root.file-name;
                    font-size: Theme.font-sm;
                    color: Theme.text-secondary;
                }
                Rectangle { height: Theme.space-1; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Format"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                    Segmented { options: ["JPEG", "PNG", "TIFF 16-bit"]; current <=> root.export-format; }
                }
                EditSlider {
                    label: "Quality";
                    enabled: root.export-format == "JPEG";
                    minimum: 50;
                    maximum: 100;
                    default: 92;
                    step: 1;
                    value <=> root.export-quality;
                    text: round(root.export-quality);
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Long edge"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                    Segmented { options: ["Full", "4096", "2048", "1024", "Custom"]; current <=> root.export-size; }
                }
                if root.export-size == "Custom": HorizontalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Pixels"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                    LineEdit {
                        width: 96px;
                        text <=> root.export-custom;
                        placeholder-text: "1600";
                        input-type: number;
                    }
                    // What comes out at that edge, or the picture's
                    // own when the number is no smaller, or no size.
                    Text {
                        text: root.frame-width > 0
                            ? (root.export-resizes()
                                ? root.export-width() + " × " + root.export-height()
                                : root.frame-width + " × " + root.frame-height + ", as it is")
                            : "";
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Sharpen"; width: 68px; color: root.export-resizes() ? Theme.text : Theme.text-muted; font-size: Theme.font-sm; vertical-alignment: center; }
                    Segmented { options: ["Off", "Low", "Standard", "High"]; current <=> root.export-sharpen; }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text { text: "Color"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                    Segmented { options: ["sRGB", "Display P3", "Rec.2020"]; current <=> root.export-space; }
                }
                Toggle {
                    label: "Embed profile";
                    checked <=> root.export-embed;
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text { text: "If it exists"; width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                    Segmented { options: ["Increment", "Overwrite", "Skip"]; current <=> root.export-on-exists; }
                }
                Rectangle { height: Theme.space-2; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Cancel";
                        clicked => { root.export-open = false; }
                    }
                    PanelButton {
                        text: "Choose file...";
                        icon: @image-url("icons/image-down.svg");
                        primary: true;
                        clicked => { root.export-open = false; root.export(); }
                    }
                }
            }
        }
    }

}
