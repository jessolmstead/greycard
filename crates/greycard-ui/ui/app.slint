                        if root.panel-tab == "Masks" && root.target > 0: WhiteBalanceSection {
                            local: true;
                            owner: root.target-name;
                            switchable: true;
                            on <=> root.local-wb-on;
                            switched => { root.local-wb-toggled(); }
                            local-reset => { root.local-wb-reset(); }
                            collapsed-wb <=> root.collapsed-wb;
                            picking <=> root.picking;
                            pick-started(a) => { root.pick-started(a); }
                            temperature <=> root.local-temperature;
                            tint <=> root.local-tint;
                            raw-input: root.raw-input;
                            develop-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": CameraSection {
                            collapsed-camera <=> root.collapsed-camera;
                            raw-input: root.raw-input;
                            source-note: root.source-note;
