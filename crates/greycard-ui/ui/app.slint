// The editor's window: a filmstrip along the bottom, a viewport
// drawn by the engine into a wgpu texture, and a panel of controls bound
// to the edit state on the Rust side. Everything reads the tokens in
// theme.slint; the controls are in controls.slint.

import { ScrollView, ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Section, Switch, EditSlider, Toggle, PanelButton, Segmented, CurveEditor, Swatches, CropHandle, ClipMark, ThumbBadges } from "controls.slint";

/// A point on the view, logical pixels.
export struct Pt {
    x: float,
    y: float,
}

export struct Thumb {
    name: string,
    image: image,
    /// The frame's meta, as the badges want it: stars, the flag (1 a
    /// pick, 2 a reject) and the color label (1 to 5). Rust owns what
    /// the numbers mean; see `greycard_edit::meta`.
    rating: int,
    flag: int,
    label: int,
}

/// A box drawn for an object, on the view, logical pixels.
export struct MaskBox {
    x: float,
    y: float,
    w: float,
    h: float,
}

/// A pick for an object on the view: on it, or not on it.
export struct MaskPick {
    x: float,
    y: float,
    positive: bool,
}

/// One frame of the culling loupe's compare view: its box on the
/// view, logical pixels, its name, and whether it is the selection.
export struct CompareTile {
    x: float,
    y: float,
    w: float,
    h: float,
    name: string,
    on: bool,
}

/// One chip of the browser's filter: what it asks, how many frames
/// would be left if it were the only thing that changed, whether it
/// is on, and which flag or color it stands for. Rust owns what the
/// number means; see `greycard_ui::filter`.
export struct FilterChip {
    text: string,
    count: int,
    on: bool,
    code: int,
}

// A chip of the filter: a pill that says what it asks and how many
// frames it would leave. A chip that leads nowhere is dimmed rather
// than dropped, so the row does not move about under the pointer as
// a cull goes on.
component Chip inherits Rectangle {
    in property <string> text;
    in property <int> count;
    in property <bool> on;
    in property <bool> has-dot: false;
    in property <bool> outlined: false;
    /// A chip that is a toggle rather than a question about the
    /// folder has nothing to count.
    in property <bool> shows-count: true;
    /// The panel is 320px wide and the header is not, so a chip on
    /// the panel is spelled closer.
    in property <bool> tight: false;
    in property <color> dot: Theme.text-muted;
    callback clicked();
    property <bool> nowhere: root.shows-count && root.count == 0 && !root.on;
    height: Theme.control-height - 4px;
    border-radius: (Theme.control-height - 4px) / 2;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    background: root.on ? Theme.selection : (ta.has-hover ? Theme.hover : Theme.base);
    opacity: root.nowhere ? 0.45 : 1;
    animate background { duration: Theme.quick; }
    HorizontalLayout {
        padding-left: root.tight ? Theme.space-1 : Theme.space-2;
        padding-right: root.tight ? Theme.space-1 : Theme.space-2;
        spacing: root.tight ? 3px : Theme.space-1;
        alignment: center;
        if root.has-dot: Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            background: root.dot;
            border-width: root.outlined ? 1px : 0;
            border-color: Theme.text-muted;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.on ? Theme.text : Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: root.on ? Theme.weight-medium : Theme.weight-regular;
            vertical-alignment: center;
        }
        if root.shows-count: Text {
            text: root.count;
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A label chip, which says its color rather than its name.
component LabelChip inherits Chip {
    in property <int> label-code;
    has-dot: true;
    outlined: root.label-code == 0;
    dot: root.label-code == 1 ? Theme.label-red
        : root.label-code == 2 ? Theme.label-yellow
        : root.label-code == 3 ? Theme.label-green
        : root.label-code == 4 ? Theme.label-blue
        : root.label-code == 5 ? Theme.label-purple
        : transparent;
}

// The browser's filter: the rating chips and how they read, the flag
// chips, the label chips, and a word looked for in the file name and
// the keywords. One row of chips in the grid's header, and the same
// chips a group to a row in the CULLING section, where the panel is
// 320px wide and the header's row would not fit.
component FilterBar inherits Rectangle {
    in property <[FilterChip]> stars;
    in property <[FilterChip]> flags;
    in property <[FilterChip]> labels;
    in property <bool> exact;
    in property <int> shown;
    in property <int> total;
    in property <bool> on;
    in property <bool> stacked: false;
    /// A key has asked for the text field. The bar on screen takes
    /// the focus and puts this back to false, so that one press is
    /// answered once: the grid's header is built when the grid
    /// opens, which is a moment after the key, and a bar built later
    /// for some other reason must not take the keys off whatever
    /// has them.
    in-out property <bool> wanted;
    /// Whether this bar is the one on screen: the grid's header and
    /// the CULLING section both hold one, and only one of them may
    /// answer the key.
    in property <bool> takes-focus: true;
    in-out property <string> text;
    callback star-picked(int);
    callback flag-toggled(int);
    callback label-toggled(int);
    callback exact-toggled();
    callback text-edited(string);
    callback cleared();
    /// The field is done with: the window's keys want it back.
    callback released();
    function grab() {
        root.wanted = false;
        field.focus();
        // A query already in the field is selected, so the next
        // character replaces it: the key is usually pressed to look
        // for something else.
        field.select-all();
    }
    // Answered here when the bar was already up, and on `init` when
    // it was built by the same press.
    changed wanted => { if (root.wanted && root.takes-focus) { root.grab(); } }
    init => { if (root.wanted && root.takes-focus) { root.grab(); } }
    VerticalLayout {
        spacing: Theme.space-2;
        // The header's one row: every group of chips along it, with
        // a rule between the groups, clipped rather than wrapped at
        // a narrow window.
        if !root.stacked: Rectangle {
            clip: true;
            height: Theme.control-height - 4px;
            HorizontalLayout {
                spacing: Theme.space-1;
                alignment: start;
                for chip[i] in root.stars: Chip {
                    text: chip.text;
                    count: chip.count;
                    on: chip.on;
                    clicked => { root.star-picked(i); }
                }
                Chip {
                    text: root.exact ? "exactly" : "or more";
                    shows-count: false;
                    on: root.exact;
                    clicked => { root.exact-toggled(); }
                }
                Rectangle { width: Theme.space-2; }
                Rectangle { width: 1px; background: Theme.border; }
                Rectangle { width: Theme.space-2; }
                for chip[i] in root.flags: Chip {
                    text: chip.text;
                    count: chip.count;
                    on: chip.on;
                    clicked => { root.flag-toggled(i); }
                }
                Rectangle { width: Theme.space-2; }
                Rectangle { width: 1px; background: Theme.border; }
                Rectangle { width: Theme.space-2; }
                for chip[i] in root.labels: LabelChip {
                    text: chip.text;
                    count: chip.count;
                    on: chip.on;
                    label-code: chip.code;
                    clicked => { root.label-toggled(i); }
                }
            }
        }
        // The panel's, a group to a row with its name over it: at
        // 320px the header's row runs off the side, and a caption
        // beside each row would take the width three chips need.
        if root.stacked: VerticalLayout {
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-2;
                Text {
                    text: "Stars";
                    color: Theme.text-secondary;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Chip {
                    text: root.exact ? "exactly" : "or more";
                    shows-count: false;
                    tight: true;
                    on: root.exact;
                    clicked => { root.exact-toggled(); }
                }
            }
            HorizontalLayout {
                spacing: 3px;
                alignment: start;
                for chip[i] in root.stars: Chip {
                    text: chip.text;
                    count: chip.count;
                    on: chip.on;
                    tight: true;
                    clicked => { root.star-picked(i); }
                }
            }
            Text {
                text: "Flag";
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 3px;
                alignment: start;
                for chip[i] in root.flags: Chip {
                    text: chip.text;
                    count: chip.count;
                    on: chip.on;
                    tight: true;
                    clicked => { root.flag-toggled(i); }
                }
            }
            Text {
                text: "Label";
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 3px;
                alignment: start;
                for chip[i] in root.labels: LabelChip {
                    text: chip.text;
                    count: chip.count;
                    on: chip.on;
                    tight: true;
                    label-code: chip.code;
                    clicked => { root.label-toggled(i); }
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            field := LineEdit {
                text <=> root.text;
                placeholder-text: "Name or keyword";
                // Wide enough for a few words and no wider: a field
                // the width of the window reads as the header rather
                // than as one control in it.
                max-width: root.stacked ? 100000px : 360px;
                horizontal-stretch: 1;
                edited(t) => { root.text-edited(t); }
                accepted(t) => { root.released(); }
                key-pressed(e) => {
                    // Esc undoes the whole excursion in one press:
                    // the words go and the window's keys have the
                    // focus back, so the next 1 to 5 is a rating
                    // again and not a character.
                    if (e.text == Key.Escape) {
                        self.text = "";
                        root.text-edited("");
                        root.released();
                        return accept;
                    }
                    return reject;
                }
            }
            if !root.stacked: Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.shown + " of " + root.total;
                color: root.on ? Theme.text : Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            PanelButton {
                text: "Clear";
                enabled: root.on;
                clicked => { root.cleared(); root.released(); }
            }
        }
    }
}

export component App inherits Window {
    title: "greycard";
    icon: @image-url("../../../assets/icon/greycard.svg");
    preferred-width: 1500px;
    preferred-height: 950px;
    background: Theme.canvas;
    default-font-size: Theme.font-md;

    // The viewport: the texture the engine renders, at the size of the
    // element in physical pixels, and the interaction on it.
    in property <image> texture <=> view.source;
    out property <int> view-width: view.width / 1phx;
    out property <int> view-height: view.height / 1phx;
    callback zoom(float, length, length);
    callback pan(length, length);
    callback reset-view();
    /// Zoom to a level (0 fits) with the image pixel at the point held.
    callback zoom-to(float, length, length);
    /// Fit if zoomed, else 1:1 at the point.
    callback toggle-zoom(length, length);
    /// Fit if at this level, else this level about the view's center.
    callback zoom-key(float);
    /// The effective zoom in words: "Fit", or a percentage.
    in property <string> zoom-text: "Fit";
    /// The dropper drawn at the pointer while picking. Empty if the
    /// icon is missing, and then the cursor stays a crosshair.
    property <image> dropper: @image-url("icons/pipette.svg");

    // The filmstrip.
    in property <[Thumb]> thumbs;
    in-out property <int> selected: -1;
    callback select(int);
    /// A culling key over the browser: the text of it, and true when
    /// it meant something. Rust reads the key, applies it to the
    /// whole selection and writes the sidecars; the badges follow.
    callback meta-key(string) -> bool;
    /// The frame's own quarter turns, clockwise: the camera's
    /// orientation tag put right. Not an edit, so undo, the history
    /// and a preset leave it alone; see the sidecar's `turn`.
    callback frame-turned(int);
    /// The most stars a badge draws, set from `meta::STARS` so this
    /// file and that module cannot drift apart.
    in property <int> meta-stars: 5;
    // The strip's geometry, shared by its layout and its scrolling.
    property <length> strip-item: 178px;
    property <length> strip-pitch: root.strip-item + Theme.space-2;
    property <length> strip-pad: Theme.space-3;
    /// The frames the strip shows now, first and last, so their
    /// pictures are made before the rest of the folder's.
    callback strip-range(int, int);
    changed selected => { root.strip-reveal(); root.grid-reveal(); }
    /// Scroll the strip by a wheel's delta, kept within its ends.
    function strip-scroll(by: length) {
        strip.content-x = min(0px, max(strip.width - strip.content-width, strip.content-x + by));
    }
    /// Scroll the strip the least that brings the selected frame into
    /// view, leaving the padding beside it. Called when the selection
    /// moves and when the strip is first laid out or refilled.
    ///
    /// The width guard is the launch case: Slint runs the changed
    /// handlers before the first layout, and with a width of zero
    /// every frame past the first reads as off the right edge and
    /// scrolls to the clamp. `strip-relay` does the real reveal
    /// once the strip has a width.
    function strip-reveal() {
        if (root.selected < 0 || strip.width <= 0px) { return; }
        // The frame's edges in the content's coordinates, and the
        // left edge of what is on screen.
        let left = root.strip-pad + root.selected * root.strip-pitch;
        let right = left + root.strip-item;
        let x = -strip.content-x;
        let wanted = left - root.strip-pad < x
            ? left - root.strip-pad
            : (right + root.strip-pad > x + strip.width
                ? right + root.strip-pad - strip.width
                : x);
        strip.content-x = min(0px, max(strip.width - strip.content-width, -wanted));
        root.strip-report();
    }
    /// Put the strip where the selection is visible, worked out from
    /// the start rather than from where the strip stands. For a new
    /// width or a new folder: the launch runs a layout pass at an
    /// intermediate width, and a least-scroll from that one leaves
    /// the frame at an arbitrary place in the settled strip.
    function strip-relay() {
        strip.content-x = 0px;
        root.strip-reveal();
    }
    /// Tell Rust which frames are on screen. Sent on every move; the
    /// Rust side drops a repeat of the range it last acted on.
    function strip-report() {
        if (root.thumbs.length == 0 || strip.width <= 0px || root.grid-open) { return; }
        let x = -strip.content-x - root.strip-pad;
        root.strip-range(
            max(0, floor(x / root.strip-pitch)),
            min(root.thumbs.length - 1, ceil((x + strip.width) / root.strip-pitch)));
    }

    // The grid: the whole folder at once, over the window, in place
    // of the viewport, the strip and the panels. G opens it; G,
    // Escape or Return leave it on the frame the selection landed on.
    in-out property <bool> grid-open: false;
    /// A cell's side, logical pixels. Rust owns the steps it takes.
    in-out property <length> grid-cell: 176px;
    /// The grid's geometry, set from the Rust side's own constants so
    /// the layout here and the arithmetic there cannot drift apart.
    in property <length> grid-gap: 8px;
    in property <length> grid-pad: 12px;
    in property <length> grid-label: 22px;
    /// The sheet's size, mirrored out of it so the reveal and the
    /// report read the same numbers Rust is given. Writable so a
    /// test can lay the grid out on a backend that never does.
    in-out property <length> grid-w;
    in-out property <length> grid-h;
    /// How far down the sheet is scrolled, logical pixels.
    property <length> grid-scroll: 0px;
    property <length> grid-pitch: root.grid-cell + root.grid-gap;
    property <length> grid-row: root.grid-cell + root.grid-label + root.grid-gap;
    pure callback grid-columns(length, length) -> int;
    /// What is left over beside a full row, halved: the cells sit in
    /// the middle of the window rather than against its left edge.
    pure callback grid-slack(length, length, int) -> length;
    property <length> grid-left:
        root.grid-pad + root.grid-slack(root.grid-w, root.grid-cell, root.grid-cols);
    /// How far the sheet can be scrolled, and the scroll that brings
    /// the selected cell into view: asked of the same arithmetic the
    /// Rust side tests, rather than written out again here.
    pure callback grid-max-scroll(length, length, int, int) -> length;
    pure callback grid-reveal-to(length, length, length, int, int, int) -> length;
    property <int> grid-cols: root.grid-columns(root.grid-w, root.grid-cell);
    property <length> grid-max:
        root.grid-max-scroll(root.grid-h, root.grid-cell, root.grid-cols, root.thumbs.length);
    /// Move the selection a column along or a row down, told how many
    /// columns there are now.
    callback grid-step(int, int, int);
    /// A step up or down the cell sizes.
    callback grid-zoom(int);
    /// The frames the grid shows now, from its scroll and its height:
    /// the same queue ordering the strip's range drives.
    callback grid-range(length, length, int);
    changed grid-open => {
        if (root.grid-open) {
            // Nothing can be placed on a picture that is not on
            // screen: whatever was in hand is put down on the way in,
            // so Escape in the grid is never spent on a stale mode.
            if (root.placing != "" || root.picking != "") { root.stop-placing(); }
            if (root.guide-mode != "") { root.guide-mode = ""; root.guide-dropped(); }
            root.level-mode = false;
            // The sheet's own `init` lays it out and reports.
        } else {
            root.strip-relay();
        }
    }
    changed grid-cell => { root.grid-relay(); }
    // Another folder's frames: the sheet re-flows and reports afresh,
    // as the strip does from its content width.
    changed thumbs => { root.grid-relay(); }
    /// Scroll the sheet, or size the cells when Ctrl is held. A
    /// notch is a third of a row, whatever the row is: 60 logical
    /// pixels against a 542 px row at the largest cell would be a
    /// crawl.
    function grid-wheel(by: length, ctrl: bool) {
        if (ctrl) {
            root.grid-zoom(by > 0px ? 1 : -1);
            return;
        }
        root.grid-scroll = clamp(
            root.grid-scroll - by * (root.grid-row / 3 / 60px), 0px, root.grid-max);
        root.grid-report();
    }
    /// Put the sheet where the selection is visible, worked out from
    /// the top rather than from where it stands: a re-flow at a new
    /// cell size or a new width makes the old offset meaningless, and
    /// §89's lesson is that a least-scroll from an intermediate
    /// layout leaves the frame at an arbitrary place.
    function grid-relay() {
        root.grid-scroll = 0px;
        root.grid-reveal();
    }
    /// Scroll the least that brings the selected cell into view, the
    /// padding left beside it.
    function grid-reveal() {
        if (!root.grid-open || root.grid-h <= 0px) { return; }
        // A folder with nothing chosen in it yet still has to say
        // what it shows, or its pictures wait behind the rest.
        if (root.selected >= 0) {
            root.grid-scroll = root.grid-reveal-to(
                root.grid-scroll, root.grid-h, root.grid-cell,
                root.grid-cols, root.thumbs.length, root.selected);
        }
        root.grid-report();
    }
    /// Tell Rust which frames the grid shows, as the strip does.
    function grid-report() {
        if (!root.grid-open || root.thumbs.length == 0 || root.grid-h <= 0px) { return; }
        root.grid-range(root.grid-scroll, root.grid-h, root.grid-cols);
    }

    // Culling: the camera's own JPEG in the viewport, through the
    // monitor's profile only, and no develop until Enter or a slider.
    // C enters and leaves; V cycles the compare view through one, two
    // and four frames; the panel shows a CULLING section in place of
    // the develop tabs' while it is on.
    in-out property <bool> culling: false;
    // The camera's JPEG standing in for a develop that has not landed,
    // on the frame just selected. It is a placeholder and not a mode:
    // the develop replaces it the moment it lands. Nothing placed in
    // the developed picture's own coordinates is drawn over it — it
    // is neither that size nor that picture — and a word in the
    // corner says what it is.
    in property <bool> placeholder: false;
    callback cull-toggled();
    /// Leave the mode and develop the frame the selection is on.
    callback cull-leave();
    /// How many frames the compare view shows: 1, 2 or 4, and the
    /// same as the panel's row spells it.
    in property <int> compare: 1;
    in-out property <string> compare-text: "1";
    callback compare-changed(int);
    /// The compared frames on the view: each one's box, its name, and
    /// whether it is the selection.
    in property <[CompareTile]> compare-tiles: [];
    /// The browser's filter on the meta: the rating chips and the
    /// reading they are in, the flag chips, the label chips and a
    /// word looked for in the file name and the keywords. It applies
    /// to the strip, the grid and the arrows, in and out of culling.
    /// Rust owns every decision here; the chips are what it says.
    in-out property <[FilterChip]> filter-stars: [];
    in-out property <[FilterChip]> filter-flags: [];
    in-out property <[FilterChip]> filter-labels: [];
    in-out property <bool> filter-exact: false;
    in-out property <string> filter-text: "";
    /// How many frames the filter shows, and how many there are.
    in-out property <int> filter-shown: 0;
    in-out property <int> filter-total: 0;
    /// Whether the filter asks anything of a frame at all.
    in-out property <bool> filter-on: false;
    /// A key has asked for the filter's text field; the bar on
    /// screen answers it and puts it back to false.
    in-out property <bool> filter-focus: false;
    in-out property <bool> collapsed-culling: false;
    callback filter-star-picked(int);
    callback filter-flag-toggled(int);
    callback filter-label-toggled(int);
    callback filter-exact-toggled();
    callback filter-text-edited(string);
    callback filter-cleared();
    /// Ctrl+F or /: put the filter's chips where they can be reached
    /// and the cursor in its text field.
    callback filter-asked();
    /// How many frames of the folder are flagged reject.
    in property <int> reject-count: 0;
    /// The move-rejects sheet: what it will do, until answered.
    in-out property <bool> rejects-open: false;
    in property <string> rejects-text: "";
    callback rejects-asked();
    callback rejects-answered(bool);

    // The edit, mirrored from Rust's state struct.
    in-out property <float> exposure: 0;
    in-out property <bool> tone-curve: true;
    in-out property <float> contrast: 1;
    in-out property <float> highlights: 0;
    in-out property <float> shadows: 0;
    in-out property <float> whites: 0;
    in-out property <float> blacks: 0;
    // Global vibrance and saturation, in the same pass as the mixer.
    in-out property <bool> color-enabled: true;
    in-out property <float> saturation: 0;
    in-out property <float> vibrance: 0;
    in-out property <bool> as-shot: true;
    // The curves: which of the two the section shows, "Parametric" or
    // "Point" (both apply); the parametric curve's four amounts and
    // three splits; the point curves as flat x, y pairs per channel;
    // and the picture of the one being edited.
    in-out property <bool> curves-enabled: true;
    in-out property <string> curve-mode: "Point";
    in-out property <float> para-highlights: 0;
    in-out property <float> para-lights: 0;
    in-out property <float> para-darks: 0;
    in-out property <float> para-shadows: 0;
    in-out property <[float]> para-splits: [0.25, 0.5, 0.75];
    in-out property <string> curve-channel: "RGB";
    in-out property <[float]> curve-rgb: [0, 0, 1, 1];
    in-out property <[float]> curve-red: [0, 0, 1, 1];
    in-out property <[float]> curve-green: [0, 0, 1, 1];
    in-out property <[float]> curve-blue: [0, 0, 1, 1];
    // The color curves against lightness, the neutral at y = 0.5.
    in-out property <[float]> curve-red-green: [0, 0.5, 1, 0.5];
    in-out property <[float]> curve-blue-yellow: [0, 0.5, 1, 0.5];
    in property <image> curve-image;
    // How far the panel's sections are scrolled, the ScrollView's
    // own content-y (so down is negative); set from Rust for a
    // snapshot of a section below the fold, once the sections have
    // their height, as the ScrollView puts an earlier value back to
    // the top when it first lays out.
    in-out property <length> panel-scroll: 0px;
    // Straighten and crop. The crop is fractions of the source; the
    // overlay's rectangle is in view pixels, set by Rust each frame.
    in-out property <bool> crop-mode: false;
    in-out property <bool> level-mode: false;
    // The perspective guide: "" when it is not in hand, else the way
    // the two lines being traced should run, "Vertical" or "Horizontal".
    in-out property <string> guide-mode: "";
    // Local adjustments: the list (Global first), which one the panel
    // edits (0 is global), that one's own controls, and the kind of
    // shape being drawn in the viewport, if any.
    in-out property <[string]> adjustment-names: ["Global"];
    in-out property <int> target: 0;
    // Which tab the panel shows: Develop, Crop, Masks or Retouch.
    in-out property <string> panel-tab: "Develop";
    callback tab-changed(string);
    in-out property <bool> adjustment-enabled: true;
    in-out property <bool> mask-invert: false;
    in-out property <bool> has-feather: false;
    in-out property <float> mask-feather: 0.5;
    in-out property <bool> show-mask: false;
    // Thrown by hand, as against set while a shape is placed.
    callback show-mask-toggled();
    // The sections' switches that are not a part's own.
    in-out property <bool> light-enabled: true;
    in-out property <bool> noise-enabled: true;
    in-out property <bool> lens-enabled: true;
    in-out property <bool> vignette-enabled: true;
    in-out property <bool> grain-enabled: true;
    in-out property <bool> retouch-enabled: true;
    // Which sections are folded away; kept between runs.
    in-out property <bool> collapsed-navigator: false;
    in-out property <bool> collapsed-adjustments: false;
    in-out property <bool> collapsed-wb: false;
    in-out property <bool> collapsed-light: false;
    in-out property <bool> collapsed-curves: false;
    in-out property <bool> collapsed-mixer: false;
    in-out property <bool> collapsed-color: false;
    in-out property <bool> collapsed-bw: false;
    in-out property <bool> collapsed-grading: false;
    in-out property <bool> collapsed-tint: false;
    in-out property <bool> collapsed-noise: false;
    in-out property <bool> collapsed-lens: false;
    in-out property <bool> collapsed-detail: false;
    in-out property <bool> collapsed-sharpen: false;
    in-out property <bool> collapsed-vignette: false;
    in-out property <bool> collapsed-grain: false;
    in-out property <bool> collapsed-proof: false;
    in-out property <bool> collapsed-monitor: false;
    in-out property <bool> collapsed-crop: false;
    in-out property <bool> collapsed-rotate: false;
    in-out property <bool> collapsed-perspective: false;
    in-out property <bool> collapsed-demosaic: false;
    in-out property <bool> collapsed-camera: false;
    in-out property <bool> collapsed-look: false;
    in-out property <bool> collapsed-retouch: false;
    in-out property <bool> collapsed-presets: false;
    // The presets: names to lay over the edit, and the sheet that
    // saves the current edit as one.
    in-out property <[string]> preset-names: [];
    callback preset-applied(int);
    callback preset-deleted(int);
    callback preset-import();
    callback preset-save-open();
    in-out property <bool> preset-open: false;
    in-out property <string> preset-name: "";
    in-out property <[string]> preset-section-names: [];
    in-out property <[bool]> preset-section-on: [];
    callback preset-section-toggled(int, bool);
    callback preset-saved();
    // The states kept by name, and the steps of the edit newest
    // first: hovering a row shows its state in the viewport, a click
    // restores it.
    in-out property <[string]> snapshot-names: [];
    in-out property <int> snapshot-editing: -1;
    callback snapshot-taken();
    callback snapshot-restored(int);
    callback snapshot-hovered(int);
    callback snapshot-renamed(int, string);
    callback snapshot-deleted(int);
    in-out property <[string]> history-names: [];
    in-out property <int> history-current: -1;
    callback history-clicked(int);
    callback history-hovered(int);
    in-out property <bool> collapsed-snapshots: false;
    in-out property <bool> collapsed-history: false;
    /// Paint the capture sharpening's blend mask over the picture.
    in-out property <bool> show-sharpen-mask: false;
    in-out property <string> placing: "";
    // The chosen adjustment's name, its shapes, the chosen shape and
    // its own controls, and how the next shape joins.
    in-out property <string> adjustment-name: "";
    in-out property <[string]> component-names: [];
    // One per shape: whether it counts towards the mask.
    in-out property <[bool]> component-on: [];
    in-out property <int> component: 0;
    in-out property <bool> component-invert: false;
    in-out property <string> shape-mode: "Add";
    in-out property <[bool]> adjustment-on: [];
    in-out property <bool> shapes-open: false;
    // The shape being placed goes into the chosen mask rather than
    // making a new adjustment.
    in-out property <bool> placing-into: false;
    // The chosen shape's kind, and the brush's next stroke: its
    // radius in units of the picture's width, its feather and flow,
    // whether it lifts; and the view's pixels per unit, for the cursor.
    in-out property <string> component-kind: "";
    in-out property <float> brush-size: 0.05;
    in-out property <float> brush-feather: 0.5;
    in-out property <float> brush-flow: 1.0;
    in-out property <string> brush-op: "Add";
    in-out property <float> brush-scale: 0;
    callback stop-placing();
    // A dropper in hand: "White" for a neutral, "Curve" for a point
    // on the curve, "Mixer" for a band. A press on the view reads
    // the picture there; a drag moves what the press chose.
    in-out property <string> picking: "";
    callback pick-started(string);
    callback pick-pressed(length, length);
    callback pick-dragged(length, length);
    callback pick-released();
    // The chosen adjustment's name, after the sections it colors.
    in-out property <string> target-name: "";
    callback target-changed(int);
    callback adjustment-toggled(int);
    callback add-adjustment(string);
    callback delete-adjustment();
    callback add-shape(string, string);
    callback delete-shape-at(int);
    callback shape-toggled(int);
    callback component-changed(int);
    callback renamed();
    // A press on the view while placing, and whether it was the right button.
    callback place-pressed(length, length, bool);
    callback place-dragged(length, length);
    callback place-released();
    // The chosen shape on the view: its kind, its handles (the whole
    // first), and for a radial its outline; for a linear the angle of
    // its lines.
    in-out property <string> mask-kind: "";
    in-out property <[Pt]> mask-handles: [];
    // An object's boxes and picks, the chosen one's or the one being
    // placed.
    in-out property <[MaskBox]> mask-boxes: [];
    in-out property <[MaskPick]> mask-picks: [];
    in-out property <float> mask-angle: 0;
    in-out property <float> mask-rx: 0;
    in-out property <float> mask-ry: 0;
    in-out property <float> mask-feather-scale: 0.5;
    callback mask-grabbed(int);
    callback mask-dragged(int, length, length);
    callback mask-dropped();
    in-out property <float> grain-amount: 0;
    in-out property <float> grain-size: 0.5;
    in-out property <string> grain-kind: "Cubic";
    in-out property <float> vignette-amount: 0;
    in-out property <float> vignette-midpoint: 0.5;
    in-out property <float> vignette-feather: 0.5;
    in-out property <float> vignette-roundness: 0;
    in-out property <float> geo-angle: 0;
    in-out property <float> geo-vertical: 0;
    in-out property <float> geo-horizontal: 0;
    in-out property <int> geo-turns: 0;
    in-out property <bool> geo-flip: false;
    callback geometry-turned(int);
    callback geometry-flipped(bool);
    in-out property <bool> geo-has-crop: false;
    in-out property <float> geo-crop-x: 0;
    in-out property <float> geo-crop-y: 0;
    in-out property <float> geo-crop-w: 1;
    in-out property <float> geo-crop-h: 1;
    in-out property <string> aspect-name: "Free";
    in-out property <string> aspect-custom: "65:24";
    in-out property <bool> portrait: false;
    in property <length> crop-left;
    in property <length> crop-top;
    in property <length> crop-width;
    in property <length> crop-height;
    callback crop-toggled();
    callback crop-pressed(int);
    callback crop-dragged(int, length, length);
    callback crop-released();
    callback geometry-changed();
    callback geometry-reset();
    callback level-end(length, length, length, length);
    /// A stroke of the perspective guide, its two ends. The first is
    /// kept by Rust in source pixels, not here in view pixels: the
    /// view can zoom, pan or change file between the two strokes.
    callback guide-stroke(length, length, length, length);
    /// Drop a half-finished pair: the tool put down, or pointed at the
    /// other axis, which its first stroke does not belong to.
    callback guide-dropped();
    /// The kept first stroke's two ends, where they are in the view
    /// now; empty when there is none.
    in property <[Pt]> guide-kept: [];
    // The color mixer: per-band arrays, and the chosen band's values
    // on the sliders.
    // The mixer's eight bands, in hue order: the swatches, and the
    // colors the hue slider's track is painted with.
    property <[color]> band-colors: [#e05050, #e08a40, #d8c040, #60c060, #40c0c0, #5080e0, #9060d0, #d060b0];
    // The track under the global saturation and vibrance sliders: the
    // hue circle swept along it, grey at the left and the bands' own
    // colors at the right, so the dull way and the vivid way read at
    // a glance.
    property <color> dull: #8c8c8c;
    property <brush> spectrum: @linear-gradient(90deg,
        root.dull 0%,
        root.band-colors[1].mix(root.dull, 0.125) 12.5%,
        root.band-colors[2].mix(root.dull, 0.25) 25%,
        root.band-colors[3].mix(root.dull, 0.375) 37.5%,
        root.band-colors[4].mix(root.dull, 0.5) 50%,
        root.band-colors[5].mix(root.dull, 0.625) 62.5%,
        root.band-colors[6].mix(root.dull, 0.75) 75%,
        root.band-colors[7].mix(root.dull, 0.875) 87.5%,
        root.band-colors[0] 100%);
    in-out property <bool> mixer-enabled: true;
    in-out property <int> mixer-band: 0;
    in-out property <float> mixer-hue: 0;
    in-out property <float> mixer-saturation: 0;
    in-out property <float> mixer-luminance: 0;
    in-out property <[float]> mixer-hues: [0, 0, 0, 0, 0, 0, 0, 0];
    in-out property <[float]> mixer-saturations: [0, 0, 0, 0, 0, 0, 0, 0];
    in-out property <[float]> mixer-luminances: [0, 0, 0, 0, 0, 0, 0, 0];
    callback mixer-band-changed();
    callback mixer-changed();
    callback mixer-reset();
    // Black and white: off by default, the eight bands' weights, the
    // chosen band on the slider, and which contrast filter the
    // weights are (0 None; -1 for a set of weights that is no
    // filter's).
    in-out property <bool> bw-enabled: false;
    in-out property <int> bw-band: 0;
    in-out property <float> bw-weight: 0;
    in-out property <[float]> bw-weights: [0, 0, 0, 0, 0, 0, 0, 0];
    // How much of those weights acts: one is the filters as their
    // tables are written, three is about where the real glass sits.
    in-out property <float> bw-strength: 1;
    // The strength in hundredths, so its reading can carry two
    // decimals: a multiplier that jumped between "1x" and "1.05x"
    // would move the column it sits in.
    property <float> bw-strength-cents: round(root.bw-strength * 100);
    // The stops the chosen band's weight actually applies: the
    // strength scales the whole set, so the weight alone is only
    // the reading at 1.00x (`BlackWhite::stops`).
    property <float> bw-applied: root.bw-weight * root.bw-strength;
    // The color mixer does not act under a mono conversion
    // (`Edit::acting_mixer`), so the picture's own mixer is shown
    // off and dead while this is on. A mask's mixer is its own.
    property <bool> mixer-superseded: root.bw-enabled && root.target == 0;
    property <bool> mixer-acts: root.mixer-enabled && !root.mixer-superseded;
    // Which contrast filter the weights are, "" for a set that is
    // no filter's.
    in-out property <string> bw-filter: "None";
    callback bw-band-changed();
    callback bw-changed();
    callback bw-filter-changed();
    callback bw-reset();
    // Color grading: three wheels, shadows, mid-tones and highlights,
    // their hues (degrees) and strengths, the sliders' wheel, balance.
    in-out property <bool> grading-enabled: true;
    in-out property <int> grade-range: 0;
    in-out property <float> grade-hue: 0;
    in-out property <float> grade-saturation: 0;
    in-out property <float> grade-balance: 0;
    in-out property <[float]> grade-hues: [0, 0, 0];
    in-out property <[float]> grade-saturations: [0, 0, 0];
    // The wheels' pictures, shadows, mid-tones, highlights; and which
    // one is enlarged, none at -1.
    in property <[image]> grade-images: [];
    in-out property <int> grade-big: -1;
    callback grade-press(int, float, float);
    callback grade-move(int, float, float);
    callback grade-release();
    callback grade-double(int);
    callback grade-resized();
    callback grade-changed();
    callback grade-reset();
    // A tint toward one hue: the hue in Oklab degrees, how far 0 to
    // 1, off at nothing. The track is the Oklab hue circle at the
    // grading wheels' lightness and chroma, a stop every thirty
    // degrees, so which color each way goes to reads without
    // dragging; `tint-color` is what a mid grey becomes under the
    // tint as it stands, which the window works out.
    in-out property <float> tint-hue: 0;
    in-out property <float> tint-amount: 0;
    in property <color> tint-color: #8c8c8c;
    // The ring: the same picture as a grading wheel, the hue round
    // and the amount outward, with a marker where the tint is. The
    // window draws it and reads a press back. `tint-hue-text` is the
    // hue to a tenth of a degree, which the window formats because
    // Slint cannot hold a trailing zero.
    in property <image> tint-image;
    in property <string> tint-hue-text: "0.0\u{00b0}";
    callback tint-press(float, float);
    callback tint-move(float, float);
    callback tint-release();
    property <brush> hue-circle: @linear-gradient(90deg,
        #e680a1 0%, #eb8373 8.33%, #df8f48 16.67%, #c4a032 25%,
        #9ab04b 33.33%, #62bb78 41.67%, #06bfa8 50%, #00bad1 58.33%,
        #4baeed 66.67%, #859ff6 75%, #b191ea 83.33%, #d285cb 91.67%,
        #e680a1 100%);
    callback tint-changed();
    callback tint-reset();
    callback curve-press(float, float);
    callback curve-move(float, float);
    callback curve-release();
    callback curve-double(float, float);
    callback curve-reset();
    callback curve-channel-changed();
    callback curve-mode-changed();
    callback parametric-changed();
    in-out property <float> temperature: 5500;
    in-out property <float> tint: 0;
    in-out property <bool> denoise: false;
    in-out property <float> denoise-strength: 1.5;
    // The learned denoiser's tier by name, "off" for the engine's own.
    in-out property <string> denoise-learned: "off";
    in property <[string]> denoise-tiers;
    in-out property <float> denoise-learned-strength: 1.0;
    // Local contrast: the section's switch and its two sliders, -1 to
    // 1, shown as ±100.
    in-out property <bool> detail-enabled: true;
    in-out property <float> detail-texture: 0;
    in-out property <float> detail-clarity: 0;
    in-out property <float> detail-dehaze: 0;
    in-out property <bool> sharpen: true;
    // The lens: what the database found for the file, whether it
    // found anything, whether there is a database at all, and the
    // edit's choices.
    in property <string> lens-profile: "";
    // Whether the open file is a raw: the sections before the lens
    // have nothing to act on in a picture that is not.
    in property <bool> raw-input: true;
    // What a picture that is not a raw was taken to be.
    in property <string> source-note;
    in property <bool> lens-available: false;
    in property <bool> lens-database: false;
    in-out property <bool> lens-profile-on: true;
    in-out property <bool> lens-distortion: true;
    in-out property <bool> lens-ca: true;
    in-out property <bool> lens-vignetting: true;
    in-out property <float> lens-manual: 0;
    in-out property <float> lens-ca-red: 0;
    in-out property <float> lens-ca-blue: 0;
    in-out property <bool> lens-auto-scale: true;
    in-out property <float> lens-scale: 1;
    in-out property <bool> lens-defringe: false;
    in-out property <float> lens-defringe-radius: 2;
    in-out property <float> lens-defringe-threshold: 13;
    // The two hue windows the pass is gated on: a center on the Oklab
    // hue circle, a width in degrees and how much of the pass a
    // deviation inside gets. Rust's defaults are the measured ones.
    in-out property <float> lens-defringe-purple-center: 310;
    in-out property <float> lens-defringe-purple-width: 120;
    in-out property <float> lens-defringe-purple-amount: 1;
    in-out property <float> lens-defringe-green-center: 130;
    in-out property <float> lens-defringe-green-width: 120;
    in-out property <float> lens-defringe-green-amount: 1;
    callback fetch-lenses();
    in-out property <bool> sharpen-auto-radius: true;
    in-out property <float> sharpen-radius: 0.75;
    in-out property <float> sharpen-iterations: 20;
    in-out property <bool> sharpen-auto-threshold: true;
    in-out property <float> sharpen-threshold: 0.1;
    // What the last develop measured, shown while the automatics are on.
    in property <float> sharpen-measured-radius: 0;
    in property <float> sharpen-measured-threshold: 0;
    in-out property <string> demosaic: "amaze-vng4";
    in property <[string]> demosaics;
    // The camera profile: what the edit stores ("embedded" or a DCP's
    // file name), the names and the labels of what the profile
    // directory holds, a word on the directory, and a warning when the
    // chosen profile was made for another camera.
    in-out property <string> camera-profile: "embedded";
    in property <[string]> camera-profile-names;
    in property <[string]> camera-profile-labels;
    in property <string> camera-profile-note;
    in property <string> camera-profile-warning;
    callback camera-profile-picked();
    // Asked for when the section is opened, so a profile dropped into
    // the directory while the editor is running is listed without
    // reopening the file.
    callback camera-profiles-wanted();
    changed collapsed-camera => {
        if (!root.collapsed-camera) { root.camera-profiles-wanted(); }
    }
    // The look: what the edit stores ("none" or a table's file name),
    // the names and the labels of what the look directory holds, how
