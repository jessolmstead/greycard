    in-out property <[Pt]> mask-handles: [];
    // An object's boxes and picks, the chosen one's or the one being
    // placed.
    in-out property <[MaskBox]> mask-boxes: [];
    in-out property <[MaskPick]> mask-picks: [];
    // The people a part may be of, while one is to be picked.
    in-out property <[PersonBox]> person-boxes: [];
    in-out property <float> mask-angle: 0;
    in-out property <float> mask-rx: 0;
    in-out property <float> mask-ry: 0;
    in-out property <float> mask-feather-scale: 0.5;
    callback mask-grabbed(int);
    // `alt`: Alt as the handle's own pointer event reported it on this
    // move (`CropHandle`'s `alt`), not a window-wide latch — a mask
    // handle's own drag reads it to choose pivot (plain) or free-end
    // (Alt) rotation.
    callback mask-dragged(int, length, length, bool);
    callback mask-dropped();
    /// Whether a point of the view (logical pixels) lies on the chosen
    /// shape's body, where a drag moves the whole shape.
    pure callback mask-body-at(length, length, float) -> bool;
    // Whether a drag on the chosen shape's body is moving it.
    out property <bool> mask-body-moving: view.mask-body-moving;
    in-out property <float> grain-amount: 0;
    in-out property <float> grain-size: 0.5;
    in-out property <string> grain-kind: "Cubic";
    in-out property <float> vignette-amount: 0;
    in-out property <float> vignette-midpoint: 0.5;
    in-out property <float> vignette-feather: 0.5;
    in-out property <float> vignette-roundness: 0;
    in-out property <float> geo-angle: 0;
    in-out property <float> geo-vertical: 0;
    in-out property <float> geo-horizontal: 0;
    in-out property <int> geo-turns: 0;
    in-out property <bool> geo-flip: false;
    callback geometry-turned(int);
    callback geometry-flipped(bool);
    in-out property <bool> geo-has-crop: false;
    in-out property <float> geo-crop-x: 0;
    in-out property <float> geo-crop-y: 0;
    in-out property <float> geo-crop-w: 1;
    in-out property <float> geo-crop-h: 1;
    in-out property <string> aspect-name: "Free";
    in-out property <string> aspect-custom: "65:24";
    in-out property <bool> portrait: false;
    // The aspect the crop was last shown or fitted under, as
    // `panel::crop::aspect_key` writes it, so a pick from the list
    // knows what it was picked over; and the size, in plane pixels
    // squared, a change of the crop's shape was asked to keep, until
    // the crop moves (0 for none).
    in-out property <string> aspect-fitted: "Free";
    in-out property <float> crop-kept-area: 0;
    // Whether the picture the crop is measured on stands taller than
    // wide (`viewport::show_source_shape`), and so whether the plane,
    // turned by the edit's quarters, does.
    in property <bool> source-tall: false;
    out property <bool> plane-tall: root.source-tall != (root.geo-turns == 1 || root.geo-turns == 3);
    // What the Portrait switch shows: whether the crop is tall. The
    // stored flag says that for a named ratio; under "Original" it
    // says "the other way from the frame", so on a tall plane the
    // two read opposite. Under Free nothing reads the flag, so the
    // switch is off and greyed (`portrait-live`).
    out property <bool> portrait-live: root.aspect-name != "Free";
    out property <bool> portrait-shown: root.portrait-live
        && root.portrait != (root.aspect-name == "Original" && root.plane-tall);
    in property <length> crop-left;
    in property <length> crop-top;
    in property <length> crop-width;
    in property <length> crop-height;
    callback crop-toggled();
    callback crop-pressed(int);
    callback crop-dragged(int, length, length);
    callback crop-released();
    callback crop-draw-pressed(length, length);
    callback crop-draw-dragged(length, length);
    callback crop-draw-released();
    callback geometry-changed();
    callback geometry-reset();
    callback level-end(length, length, length, length);
