    callback find-landscape(string);
    callback add-landscape(string);
    in-out property <[string]> landscape-offers;
    in-out property <[string]> landscape-kinds;
    in-out property <bool> landscape-menu-shown: false;
    callback delete-shape-at(int);
    callback shape-toggled(int);
    callback invert-shape-toggled(int);
    callback component-changed(int);
    callback renamed();
