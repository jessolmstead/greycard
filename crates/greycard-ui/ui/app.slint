    callback snapshot-restored(int);
    callback snapshot-hovered(int, string);
    callback snapshot-renamed(int, string);
    callback snapshot-deleted(int);
    in-out property <[HistoryRow]> history-rows: [];
    /// The version the frame on screen is, by name, said after the
