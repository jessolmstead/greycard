    // 1, shown as ±100.
    in-out property <bool> detail-enabled: true;
    in-out property <float> detail-texture: 0;
    in-out property <float> detail-clarity: 0;
    in-out property <float> detail-dehaze: 0;
    in-out property <bool> sharpen: true;
    // The lens: what the database found for the file, whether it
    // found anything, whether there is a database at all, and the
    // edit's choices.
    in property <string> lens-profile: "";
    // Whether the open file is a raw: the sections before the lens
    // have nothing to act on in a picture that is not.
    in property <bool> raw-input: true;
    // What a picture that is not a raw was taken to be.
    in property <string> source-note;
    in property <bool> lens-available: false;
    in property <bool> lens-database: false;
    in-out property <bool> lens-profile-on: true;
    in-out property <bool> lens-distortion: true;
    in-out property <bool> lens-ca: true;
    in-out property <bool> lens-vignetting: true;
    in-out property <float> lens-manual: 0;
    in-out property <float> lens-ca-red: 0;
    in-out property <float> lens-ca-blue: 0;
    in-out property <bool> lens-auto-scale: true;
    in-out property <float> lens-scale: 1;
    in-out property <bool> lens-defringe: false;
    in-out property <float> lens-defringe-radius: 2;
    in-out property <float> lens-defringe-threshold: 13;
    // The two hue windows the pass is gated on: a center on the Oklab
    // hue circle, a width in degrees and how much of the pass a
    // deviation inside gets. Rust's defaults are the measured ones.
    in-out property <float> lens-defringe-purple-center: 310;
    in-out property <float> lens-defringe-purple-width: 120;
    in-out property <float> lens-defringe-purple-amount: 1;
    in-out property <float> lens-defringe-green-center: 130;
    in-out property <float> lens-defringe-green-width: 120;
    in-out property <float> lens-defringe-green-amount: 1;
    callback fetch-lenses();
    in-out property <bool> sharpen-auto-radius: true;
    in-out property <float> sharpen-radius: 0.75;
    in-out property <float> sharpen-iterations: 20;
    in-out property <bool> sharpen-auto-threshold: true;
    in-out property <float> sharpen-threshold: 0.1;
    // What the last develop measured, shown while the automatics are on.
    in property <float> sharpen-measured-radius: 0;
    in property <float> sharpen-measured-threshold: 0;
    in-out property <string> demosaic: "amaze-vng4";
    in property <[string]> demosaics;
    // The camera profile: what the edit stores ("embedded" or a DCP's
    // file name), the names and the labels of what the profile
    // directory holds, a word on the directory, and a warning when the
    // chosen profile was made for another camera.
    in-out property <string> camera-profile: "embedded";
    in property <[string]> camera-profile-names;
    in property <[string]> camera-profile-labels;
    in property <string> camera-profile-note;
    in property <string> camera-profile-warning;
    callback camera-profile-picked();
    // Asked for when the section is opened, so a profile dropped into
    // the directory while the editor is running is listed without
    // reopening the file.
    callback camera-profiles-wanted();
    changed collapsed-camera => {
        if (!root.collapsed-camera) { root.camera-profiles-wanted(); }
    }
    // The look: what the edit stores ("none" or a table's file name),
    // the names and the labels of what the look directory holds, how
    // much of the table to lay on, a word on the directory, and a
    // warning when the chosen table is not there or will not read.
    in-out property <string> look-name: "none";
    in-out property <float> look-strength: 1.0;
    in property <[string]> look-names;
    in property <[string]> look-labels;
    in property <string> look-note;
    in property <string> look-warning;
    callback look-picked();
    // As the profile directory's: asked for when the section is
    // opened, so a table dropped in while the editor is running is
    // listed without reopening the file.
    callback looks-wanted();
    changed collapsed-look => {
        if (!root.collapsed-look) { root.looks-wanted(); }
    }
    callback view-changed();
    callback develop-changed();

    in property <string> status;
    /// What the camera's picture standing in for a develop is, in its
    /// own words. It takes the status line's place for as long as
    /// `placeholder` is set, so that the word over the picture and
    /// the line under it cannot say different things: everything that
    /// asks for a develop writes "developing..." into `status`, and
    /// the picture on screen is not that develop yet.
    in property <string> placeholder-status;
    in property <string> file-name;
    // What the file says the frame was shot at, under its name: the
    // body and its lens, then the exposure triangle. Either is empty
    // when the file said nothing.
    in property <string> shot-camera;
    in property <string> shot-exposure;
    // "6000 \u{d7} 4000 \u{b7} 24 MP": the developed picture's size,
    // from the develop rather than the file, so a picture that is
    // not a raw reads the same way.
    in property <string> shot-size;
    // The scope over the panel: its picture, which one is shown and
    // the ones on offer.
    // The navigator: the whole frame as shown, and the part of it the
    // view has, as fractions, when that is less than all.
    in property <image> navigator;
    in property <bool> nav-partial;
    in property <float> nav-left;
    in property <float> nav-top;
    in property <float> nav-width;
    in property <float> nav-height;
    callback navigate(float, float);
    in property <image> scope-picture;
    in property <[string]> scopes;
    in-out property <string> scope: "RGB";
    callback scope-changed(string);
    // The clipping marks at the histogram's corners: lit in the
    // color of the channels that clip, and whether each end's
    // warning is painted over the picture. J toggles both.
    in property <bool> clip-shadows-lit;
    in property <color> clip-shadows-mark;
    in property <bool> clip-highlights-lit;
    in property <color> clip-highlights-mark;
    in-out property <bool> warn-shadows;
    in-out property <bool> warn-highlights;
    callback warn-changed();
    // The soft proof: on or off (S), its profile (a space's name, or
    // "File" with the path), the intent, and the gamut warning.
    in-out property <bool> proofing;
    in-out property <string> proof-profile: "sRGB";
    in-out property <string> proof-file;
    in-out property <string> proof-intent: "Perceptual";
    in-out property <bool> gamut-warning: true;
    callback proof-changed();
    callback choose-proof-file();
    // The monitor's profile: "System" for colord's, of the monitor
    // named (the models colord knows are listed), a standard's name,
    // or "File" with the path; and a line on what the table does.
    in-out property <string> display-profile: "System";
    in-out property <string> display-monitor;
    in-out property <string> display-file;
    in property <[string]> monitors;
    in property <string> display-note;
    callback display-changed();
    callback choose-display-file();
    // The viewport's surround: black, or one of three greys, painted
    // by the Rectangle behind the picture and by the shader outside
    // the frame alike (`canvas-colors`); the index into both.
    in-out property <int> canvas-choice: 0;
    property <[color]> canvas-colors: [#0f0f0f, #262626, #2e2e2e, #444444];
    callback canvas-changed();
    /// A develop is on its way.
    in property <bool> busy;
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();
    callback export();
    /// A set is being exported, a frame at a time; Stop (or Escape)
    /// finishes the frame in hand and stops.
    in property <bool> export-running: false;
    /// The set was told to stop and is finishing the frame in hand.
    in property <bool> export-stopping: false;
    callback export-stop();
    // Retouching: the tool in hand ("", "Heal" or "Clone"), the next
    // or chosen patch's size (of the picture's width), feather and
    // opacity, the patches by name, the chosen one, and its pins on the
    // view: its center, then its source.
    in-out property <string> retouch-mode: "";
    in-out property <float> patch-size: 0.02;
    in-out property <float> patch-feather: 0.3;
    in-out property <float> patch-opacity: 1.0;
    in-out property <[string]> patch-names: [];
    in-out property <int> patch: -1;
    in-out property <[Pt]> patch-handles: [];
    // The chosen patch's edge on the view, and where its feather
    // begins, as a Path's commands; empty when there is none to show.
    in property <string> patch-outline: "";
    in property <string> patch-feather-outline: "";
    callback retouch-toggled(string);
    callback patch-changed(int);
    callback delete-patch();
    callback patch-edited();
    callback patch-grabbed(int);
    callback patch-dragged(int, length, length);
    callback patch-dropped();
    // The model sheet: a model to fetch, offered with its license.
    in-out property <bool> fetch-open: false;
    in-out property <string> fetch-title: "";
    in-out property <string> fetch-text: "";
    in-out property <string> fetch-note: "";
    callback fetch-answered(bool);
    // The export sheet.
    in-out property <bool> export-open: false;
    in-out property <string> export-format: "JPEG";
    in-out property <float> export-quality: 92;
    in-out property <string> export-size: "Full";
    /// The long edge typed for the Custom size, as typed.
    in-out property <string> export-custom: "1600";
    /// The picture's size as an export writes it at Full: the frame
    /// after the crop, in pixels.
    in-out property <int> frame-width: 0;
    in-out property <int> frame-height: 0;
    /// The typed text as a long edge, or 0 when it is not a size.
    pure callback custom-edge(string) -> int;
    in-out property <string> export-space: "sRGB";
    in-out property <bool> export-embed: true;
    in-out property <string> export-sharpen: "Standard";
    /// What an export does when a file of that name is already there.
    in-out property <string> export-on-exists: "Increment";
    /// What the file says of where it came from: All, No edit, None.
    in-out property <string> export-metadata: "All";
    /// The watermark: Off, Text or Image, and its settings; the size
    /// and the margin are percent of the export's long edge.
    in-out property <string> export-mark: "Off";
    in-out property <string> export-mark-text: "";
    in-out property <string> export-mark-image: "";
    /// The image's file name, for the sheet to show.
    in-out property <string> export-mark-image-name: "";
    in-out property <string> export-mark-color: "White";
    in-out property <string> export-mark-position: "Bottom right";
    in-out property <float> export-mark-size: 15;
    in-out property <float> export-mark-margin: 2;
    in-out property <float> export-mark-opacity: 60;
    /// Ask the desktop for the watermark's PNG.
    callback export-mark-choose();
    /// The export presets by name, the one chosen (empty for none)
    /// and whether the sheet has moved from it since.
    in-out property <[string]> export-presets: [];
    in-out property <string> export-preset: "";
    in-out property <bool> export-preset-edited: false;
    callback export-preset-chosen(string);
    callback export-preset-saved(string);
    callback export-preset-deleted();
    pure callback export-preset-exists(string) -> bool;
    /// Any of the sheet's choices moved.
    callback export-sheet-changed();
    changed export-format => { root.export-sheet-changed(); }
    changed export-quality => { root.export-sheet-changed(); }
    changed export-size => { root.export-sheet-changed(); }
    changed export-custom => { root.export-sheet-changed(); }
    changed export-space => { root.export-sheet-changed(); }
    changed export-embed => { root.export-sheet-changed(); }
    changed export-sharpen => { root.export-sheet-changed(); }
    changed export-on-exists => { root.export-sheet-changed(); }
    changed export-metadata => { root.export-sheet-changed(); }
    changed export-mark => { root.export-sheet-changed(); }
    changed export-mark-text => { root.export-sheet-changed(); }
    changed export-mark-image => { root.export-sheet-changed(); }
    changed export-mark-color => { root.export-sheet-changed(); }
    changed export-mark-position => { root.export-sheet-changed(); }
    changed export-mark-size => { root.export-sheet-changed(); }
    changed export-mark-margin => { root.export-sheet-changed(); }
    changed export-mark-opacity => { root.export-sheet-changed(); }
    // The settings sheet: what is the installation's and not a
    // picture's. Where a sidecar is written, "Beside the raw" or
    // "Hidden folder"; whether an XMP is written beside it; how many
    // of the open folder's sidecars are in the other place, and what
    // the last move of them did. Ctrl+, or the gear opens it, through
    // Rust, which counts first.
    in-out property <bool> settings-open: false;
    // However the sheet is closed — Done, Escape, a click outside — a
    // cap typed and not yet entered is taken; Rust ignores one that
    // did not change.
    changed settings-open => {
        if (!root.settings-open) { root.thumb-cache-cap-changed(); }
    }
    in-out property <string> sidecar-placement: "Beside the raw";
    in-out property <bool> xmp-sidecars: false;
    in property <int> sidecars-elsewhere: 0;
    /// How many frames are open, which the count and the move run
    /// over; and whether this run writes sidecars at all.
    in property <int> open-frames: 0;
    in property <bool> sidecars-written: true;
    in property <string> settings-note: "";
    callback settings-asked();
    callback placement-changed();
    callback xmp-changed();
    callback sidecars-move();
    /// The thumbnail cache: whether there is one this run, how many
    /// entries it holds and what that is in words, the cap in
    /// megabytes as the field has it, and the Clear and the cap's
    /// change.
    in property <bool> thumb-cache-on: false;
    in property <int> thumb-cache-entries: 0;
    in property <string> thumb-cache-words: "";
    in-out property <string> thumb-cache-cap: "";
    callback thumb-cache-clear();
    callback thumb-cache-cap-changed();
    /// Move to the file `by` places along the strip; with Shift held,
    /// the set keeps what it had and takes that file as well.
    callback step(int, bool);
    /// Ask the desktop for a folder, and open it in place of the
    /// current file list.
    callback open-folder();
    /// Open the bug report form in the browser, filled in, and the
    /// log's folder beside it.
    callback report-asked();
    /// Whether a viewport tool is in hand: a shape being placed, a
    /// dropper, a perspective guide, the level. Escape puts each down.
    pure function tool-in-hand() -> bool {
        return root.placing != "" || root.picking != "" || root.guide-mode != "" || root.level-mode;
    }
    /// Whether a sheet is over everything. The sheets are declared
    /// after the grid and draw over it, so the keys belong to them.
    /// Tab: everything but the picture put away, the left pane, the
    /// panel, the strip and the status plate, and the viewport over
    /// the whole window; Tab again brings them back. Not remembered:
    /// the next run opens with them.
    in-out property <bool> panels-hidden: false;
    /// Public so the Rust side asks the same question before it puts
    /// a sheet up of its own accord.
    public pure function sheet-open() -> bool {
        return root.export-open || root.fetch-open || root.preset-open || root.rejects-open
            || root.settings-open || root.sync-open;
    }

    // Keys that are nobody's: arrows step files, ctrl+z undoes.
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            // The settings sheet is declared last and so drawn over the
            // rest: Escape closes it first.
            if (e.text == Key.Escape && root.settings-open) { root.settings-open = false; return accept; }
            if (e.text == Key.Escape && root.export-open) { root.export-open = false; return accept; }
            if (e.text == Key.Escape && root.fetch-open) { root.fetch-answered(false); return accept; }
            if (e.text == Key.Escape && root.preset-open) { root.preset-open = false; return accept; }
            if (e.text == Key.Escape && root.rejects-open) { root.rejects-answered(false); return accept; }
            if (e.text == Key.Escape && root.sync-open) { root.sync-open = false; return accept; }
            if (e.text == Key.Escape && (root.placing != "" || root.picking != "")) { root.stop-placing(); return accept; }
            // A repair chosen for editing, not one just drawn: Esc
            // lets go of it, so the sliders go back to the brush.
            if (e.text == Key.Escape && root.patch != -1) { root.patch-changed(-1); return accept; }
            if (e.text == Key.Escape && root.guide-mode != "") { root.guide-mode = ""; root.guide-dropped(); return accept; }
            if (e.text == Key.Escape && root.level-mode) { root.level-mode = false; return accept; }
            // A set being exported stops before Escape means anything
            // else: the sheet is gone by then, and this is its cancel.
            // Once stopping, Escape is the window's again.
            if (e.text == Key.Escape && root.export-running && !root.export-stopping && !root.sheet-open()) {
                root.export-stop();
                return accept;
            }
            // A set of frames goes back to the one on screen before
            // Escape means anything else: leaving the grid or the
            // culling mode with the set still held would leave it
            // chosen where it cannot be seen.
            if (e.text == Key.Escape && root.set-count > 1 && !root.sheet-open()) {
                root.set-collapsed();
                return accept;
            }
            // The grid takes the window: its own arrows, its own
            // zoom, and three ways back to the loupe.
            if (root.grid-open && !root.sheet-open()) {
                if (e.text == Key.Escape || e.text == Key.Return) { root.grid-open = false; return accept; }
                if (e.text == Key.LeftArrow) { root.grid-step(-1, 0, root.grid-cols, e.modifiers.shift); return accept; }
                if (e.text == Key.RightArrow) { root.grid-step(1, 0, root.grid-cols, e.modifiers.shift); return accept; }
                if (e.text == Key.UpArrow) { root.grid-step(0, -1, root.grid-cols, e.modifiers.shift); return accept; }
                if (e.text == Key.DownArrow) { root.grid-step(0, 1, root.grid-cols, e.modifiers.shift); return accept; }
                if (e.text == "+" || e.text == "=") { root.grid-zoom(1); return accept; }
                if (e.text == "-" || e.text == "_") { root.grid-zoom(-1); return accept; }
            }
            // Tab as Lightroom has it. Nothing else here binds it, and
            // a LineEdit with the focus has it first, so typing in the
            // filter or a name never reaches this. Not over the grid,
            // which has the window already.
            if (e.text == Key.Tab && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
                && !e.modifiers.shift && !root.sheet-open() && !root.grid-open) {
                root.panels-hidden = !root.panels-hidden;
                return accept;
            }
            if ((e.text == "g" || e.text == "G") && !e.modifiers.control && !root.sheet-open()) {
                root.grid-open = !root.grid-open;
                return accept;
            }
            // Culling: Return or Escape leaves it on the frame the
            // selection is on and develops that; V cycles the compare
            // view; C is the way in and out.
            if (root.culling && !root.sheet-open() && (e.text == Key.Return || e.text == Key.Escape)) {
                root.cull-leave();
                return accept;
            }
            if (root.culling && !root.sheet-open() && !e.modifiers.control && (e.text == "v" || e.text == "V")) {
                root.compare-changed(root.compare == 1 ? 2 : root.compare == 2 ? 4 : 1);
                return accept;
            }
            if ((e.text == "c" || e.text == "C") && !e.modifiers.control && !root.sheet-open()) {
                root.cull-toggled();
                return accept;
            }
            // Undo and redo move the frame under the sheet, and a sheet
            // reads that frame: a sync would carry the undone state.
            // Under a sheet they are nobody's.
            if (e.modifiers.control && (e.text == "z" || e.text == "Z")) {
                if (!root.sheet-open()) {
                    if (e.modifiers.shift) { root.redo(); } else { root.undo(); }
                }
                return accept;
            }
            if (e.modifiers.control && (e.text == "y" || e.text == "Y")) {
                if (!root.sheet-open()) { root.redo(); }
                return accept;
            }
            if (e.modifiers.control && e.modifiers.shift && (e.text == "e" || e.text == "E")) {
                if (!root.export-open && !root.busy && !root.export-running && root.selected >= 0 && !root.culling) { root.export-open = true; }
                return accept;
            }
            // Ctrl+, is where a desktop application keeps its
            // settings; nothing else here binds a comma.
            if (e.modifiers.control && e.text == "," && !root.sheet-open()) {
                root.settings-asked();
                return accept;
            }
            if (e.modifiers.control && (e.text == "o" || e.text == "O")) {
                root.open-folder();
                return accept;
            }
            // Sync settings: Lightroom's Ctrl+Shift+S. The bare S is
            // the proof, and Ctrl+S nothing yet, so this one reads
            // the same to a hand from there.
            if (e.modifiers.control && e.modifiers.shift && (e.text == "s" || e.text == "S")) {
                // Not over a tool in hand either: the sheet would hide
                // the drag or the pick half done.
                if (root.set-count > 1 && !root.sheet-open() && !root.tool-in-hand()) { root.sync-open-asked(); }
                return accept;
            }
            // The filter's text field, two ways in. Ctrl+F is what
            // every application means by find and nothing here bound
            // it; / is the one-key reach for a hand already on the
            // arrows and the rating keys, and is what less, vim and
            // a browser's quick find mean by search. Neither is
            // typed into anything, since the field itself has the
            // keys once it has the focus, and Esc there clears it
            // and gives them back.
            if (e.modifiers.control && (e.text == "f" || e.text == "F") && !root.sheet-open()) {
                root.filter-asked();
                return accept;
            }
            if (e.text == "/" && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
                && !root.sheet-open()) {
                root.filter-asked();
                return accept;
            }
            // The culling keys: stars, the flag, the color label. They
            // belong to the browser, and the strip is the browser in
            // the loupe, so they work in both views. Nothing here is
            // modified, so a Ctrl or an Alt shortcut is not eaten.
            if (!e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
                && !root.sheet-open() && root.meta-key(e.text)) {
                return accept;
            }
            // The frame's own turn, a quarter left and a quarter
            // right. Unmodified, as the culling keys are: nothing
            // else in the window binds a bracket, so Lightroom's
            // Ctrl+[ and Ctrl+] are not needed to keep out of the
            // way, and a hand on the arrows reaches these.
            if (!e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
                && !root.sheet-open() && (e.text == "[" || e.text == "]")) {
                root.frame-turned(e.text == "[" ? -1 : 1);
                return accept;
            }
            // Everything below acts on the frame behind a sheet, and a
            // sheet reads that frame: the sync sheet's words and its
            // source would go stale under an arrow. Under a sheet they
            // do nothing.
            if (root.sheet-open()) { return reject; }
            if (e.text == Key.LeftArrow) { root.step(-1, e.modifiers.shift); return accept; }
            if (e.text == Key.RightArrow) { root.step(1, e.modifiers.shift); return accept; }
            if (e.text == " " && !e.modifiers.control && !root.grid-open) { root.zoom-key(1); return accept; }
            if ((e.text == "z" || e.text == "Z") && !e.modifiers.control && !root.grid-open) { root.zoom-key(3); return accept; }
            if ((e.text == "s" || e.text == "S") && !e.modifiers.control && !root.grid-open) {
                root.proofing = !root.proofing;
                root.proof-changed();
                return accept;
            }
            if ((e.text == "j" || e.text == "J") && !e.modifiers.control && !root.grid-open) {
                // Both on, unless either is: then both off.
                let on = !(root.warn-shadows || root.warn-highlights);
                root.warn-shadows = on;
                root.warn-highlights = on;
                root.warn-changed();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        HorizontalLayout {
            // The left panel: the navigator, the presets, the
            // snapshots and the history, as an editor keeps them on
            // its left; at its foot, the way to report a problem,
            // found where it is looked for and nowhere near the work.
            // Put away by Tab: out of the layout altogether. At zero
            // width its wrapping texts would grow tall and raise the
            // window's minimum height past the screen's.
            if !root.panels-hidden: Rectangle {
                width: 240px;
                background: Theme.surface;
                Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.border; }
                VerticalLayout {
                VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    padding: Theme.space-4;
                    padding-top: Theme.space-2;
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Open folder...";
                        icon: @image-url("icons/folder-open.svg");
                        clicked => { root.open-folder(); }
                    }
                    NavigatorSection {
                        zoom-text: root.zoom-text;
                        collapsed-navigator <=> root.collapsed-navigator;
                        navigator: root.navigator;
                        nav-partial: root.nav-partial;
                        nav-left: root.nav-left;
                        nav-top: root.nav-top;
                        nav-width: root.nav-width;
                        nav-height: root.nav-height;
                        navigate(a, b) => { root.navigate(a, b); }
                        focus-keys => { keys.focus(); }
                    }
                    // The presets: a click lays one over the edit, the
                    // bin removes it, and the edit is saved or a
                    // Lightroom preset brought in below the list. Not
                    // in culling, as the snapshots and the history.
                    if !root.culling: PresetsSection {
                        selected <=> root.selected;
                        collapsed-presets <=> root.collapsed-presets;
                        preset-names <=> root.preset-names;
                        preset-applied(a) => { root.preset-applied(a); }
                        preset-deleted(a) => { root.preset-deleted(a); }
                        preset-import => { root.preset-import(); }
                        preset-save-open => { root.preset-save-open(); }
                        set-count: root.set-count;
                        sync-open-asked => { root.sync-open-asked(); }
                    }
                    // The snapshots: whole states kept by name. A
                    // click restores one as a step; a double-click
                    // renames it; the bin removes it.
                    // Not in culling, where the panel is not the
                    // frame's and a step is the way out of the mode.
                    if !root.culling: SnapshotsSection {
                        selected <=> root.selected;
                        snapshot-names <=> root.snapshot-names;
                        snapshot-editing <=> root.snapshot-editing;
                        snapshot-taken => { root.snapshot-taken(); }
                        snapshot-restored(a) => { root.snapshot-restored(a); }
                        snapshot-hovered(a) => { root.snapshot-hovered(a); }
                        snapshot-renamed(a, b) => { root.snapshot-renamed(a, b); }
                        snapshot-deleted(a) => { root.snapshot-deleted(a); }
                        collapsed-snapshots <=> root.collapsed-snapshots;
                    }
                    // The history: every step, newest first, the
                    // current one lit and the undone ones muted. A
                    // click makes a step current; what lies past it
                    // stays until the next change.
                    if !root.culling: HistorySection {
                        history-names <=> root.history-names;
                        history-current <=> root.history-current;
                        history-clicked(a) => { root.history-clicked(a); }
                        history-hovered(a) => { root.history-hovered(a); }
                        collapsed-history <=> root.collapsed-history;
                    }
                }
                VerticalLayout {
                    padding: Theme.space-4;
                    padding-top: Theme.space-2;
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Settings...";
                        icon: @image-url("icons/settings.svg");
                        clicked => { root.settings-asked(); }
                    }
                    PanelButton {
                        text: "Report a problem...";
                        icon: @image-url("icons/bug.svg");
                        clicked => { root.report-asked(); }
                    }
                }
                }
            }
            // Viewport. Everything drawn over the picture — a mask's
            // outline and handles, the brush under the pointer, the
            // crop's shade — is placed in view pixels off a geometry
            // that is free to run past the edge: a gradient's line is
            // deliberately longer than any window, and a handle sits
            // wherever the shape does, zoomed and panned. So the
            // viewport clips, or that work is drawn over the left bar
            // and the filmstrip and takes their clicks besides.
            view := Viewport {
                zoom(a, b, c) => { root.zoom(a, b, c); }
                pan(a, b) => { root.pan(a, b); }
                toggle-zoom(a, b) => { root.toggle-zoom(a, b); }
                placeholder: root.placeholder;
                compare-tiles: root.compare-tiles;
                crop-mode <=> root.crop-mode;
                level-mode <=> root.level-mode;
                guide-mode <=> root.guide-mode;
                panel-tab <=> root.panel-tab;
                placing <=> root.placing;
                brush-size <=> root.brush-size;
                brush-feather <=> root.brush-feather;
                brush-op <=> root.brush-op;
                brush-scale <=> root.brush-scale;
                picking <=> root.picking;
                pick-pressed(a, b) => { root.pick-pressed(a, b); }
                pick-dragged(a, b) => { root.pick-dragged(a, b); }
                pick-released => { root.pick-released(); }
                place-pressed(a, b, c) => { root.place-pressed(a, b, c); }
                place-dragged(a, b) => { root.place-dragged(a, b); }
                place-released => { root.place-released(); }
                mask-kind <=> root.mask-kind;
                mask-handles <=> root.mask-handles;
                mask-boxes <=> root.mask-boxes;
                mask-picks <=> root.mask-picks;
                mask-angle <=> root.mask-angle;
                mask-rx <=> root.mask-rx;
                mask-ry <=> root.mask-ry;
                mask-feather-scale <=> root.mask-feather-scale;
                mask-grabbed(a) => { root.mask-grabbed(a); }
                mask-dragged(a, b, c) => { root.mask-dragged(a, b, c); }
                mask-dropped => { root.mask-dropped(); }
                crop-left: root.crop-left;
                crop-top: root.crop-top;
                crop-width: root.crop-width;
                crop-height: root.crop-height;
                crop-pressed(a) => { root.crop-pressed(a); }
                crop-dragged(a, b, c) => { root.crop-dragged(a, b, c); }
                crop-released => { root.crop-released(); }
                level-end(a, b, c, d) => { root.level-end(a, b, c, d); }
                guide-stroke(a, b, c, d) => { root.guide-stroke(a, b, c, d); }
                guide-kept: root.guide-kept;
                status: root.status;
                placeholder-status: root.placeholder-status;
                canvas-choice <=> root.canvas-choice;
                canvas-colors: root.canvas-colors;
                busy: root.busy || root.export-running;
                retouch-mode <=> root.retouch-mode;
                patch-size <=> root.patch-size;
                patch-feather <=> root.patch-feather;
                patch <=> root.patch;
                patch-handles <=> root.patch-handles;
                patch-outline: root.patch-outline;
                patch-feather-outline: root.patch-feather-outline;
                patch-changed(a) => { root.patch-changed(a); }
                patch-edited => { root.patch-edited(); }
                patch-grabbed(a) => { root.patch-grabbed(a); }
                patch-dragged(a, b, c) => { root.patch-dragged(a, b, c); }
                patch-dropped => { root.patch-dropped(); }
                focus-keys => { keys.focus(); }
                plate-hidden: root.panels-hidden;
            }

            // Panel.
            // Put away by Tab, as the left pane is.
            if !root.panels-hidden: Rectangle {
                width: 320px;
                background: Theme.surface;
                Rectangle { x: 0; width: 1px; height: 100%; background: Theme.border; }
                // The sections scroll; the view and export buttons stay
                // put under them, so a long tab never hides them.
                VerticalLayout {
                // The file, what it was shot at and the scopes stay
                // at the top while the sections scroll under them, so
                // the histogram is in sight of whatever slider moves it.
                PanelHead {
                    culling <=> root.culling;
                    file-name: root.file-name;
                    shot-camera: root.shot-camera;
                    shot-exposure: root.shot-exposure;
                    shot-size: root.shot-size;
                    scope-picture: root.scope-picture;
                    scopes: root.scopes;
                    scope <=> root.scope;
                    scope-changed(a) => { root.scope-changed(a); }
                    clip-shadows-lit: root.clip-shadows-lit;
                    clip-shadows-mark: root.clip-shadows-mark;
                    clip-highlights-lit: root.clip-highlights-lit;
                    clip-highlights-mark: root.clip-highlights-mark;
                    warn-shadows <=> root.warn-shadows;
                    warn-highlights <=> root.warn-highlights;
                    warn-changed => { root.warn-changed(); }
                    can-undo: root.can-undo;
                    can-redo: root.can-redo;
                    undo => { root.undo(); }
                    redo => { root.redo(); }
                }
                ScrollView {
                    content-y <=> root.panel-scroll;
                    VerticalLayout {
                        alignment: start;
                        padding: Theme.space-4;
                        padding-top: Theme.space-2;
                        spacing: Theme.space-2;
                        // The panel in the order a photo is developed;
                        // the masks and the retouch on tabs of their own.
                        Segmented {
                            options: ["Develop", "Crop", "Masks", "Retouch"];
                            current <=> root.panel-tab;
                            selected(t) => {
                                // Away from Crop the frame is shown whole again.
                                if (t != "Crop" && root.crop-mode) {
                                    root.crop-mode = false;
                                    root.level-mode = false;
                                    root.guide-mode = "";
                                    root.guide-dropped();
                                    root.crop-toggled();
                                }
                                root.tab-changed(t);
                            }
                        }
                        // Culling: what the mode is, the browser's
                        // filter, the compare view, and the two ways
                        // out of it, one of them for the rejects.
                        if root.panel-tab == "Cull": CullSection {
                            frame-turned(a) => { root.frame-turned(a); }
                            grid-open <=> root.grid-open;
                            cull-leave => { root.cull-leave(); }
                            compare-text <=> root.compare-text;
                            compare-changed(a) => { root.compare-changed(a); }
                            filter-stars <=> root.filter-stars;
                            filter-flags <=> root.filter-flags;
                            filter-labels <=> root.filter-labels;
                            filter-exact <=> root.filter-exact;
                            filter-text <=> root.filter-text;
                            filter-shown <=> root.filter-shown;
                            filter-total <=> root.filter-total;
                            filter-on <=> root.filter-on;
                            filter-focus <=> root.filter-focus;
                            filter-facets: root.filter-facets;
                            filter-facet-note: root.filter-facet-note;
                            filter-facet-toggled(a, b) => { root.filter-facet-toggled(a, b); }
                            collapsed-culling <=> root.collapsed-culling;
                            filter-star-picked(a) => { root.filter-star-picked(a); }
                            filter-flag-toggled(a) => { root.filter-flag-toggled(a); }
                            filter-label-toggled(a) => { root.filter-label-toggled(a); }
                            filter-exact-toggled => { root.filter-exact-toggled(); }
                            filter-text-edited(a) => { root.filter-text-edited(a); }
                            filter-cleared => { root.filter-cleared(); }
                            reject-count: root.reject-count;
                            rejects-asked => { root.rejects-asked(); }
                            focus-keys => { keys.focus(); }
                        }
                        if root.panel-tab == "Masks": AdjustmentsSection {
                            adjustment-names <=> root.adjustment-names;
                            target <=> root.target;
                            mask-invert <=> root.mask-invert;
                            has-feather <=> root.has-feather;
                            mask-feather <=> root.mask-feather;
                            lum-low <=> root.lum-low;
                            lum-high <=> root.lum-high;
                            lum-low-feather <=> root.lum-low-feather;
                            lum-high-feather <=> root.lum-high-feather;
                            range-hue <=> root.range-hue;
                            range-width <=> root.range-width;
                            range-hue-feather <=> root.range-hue-feather;
                            range-chroma <=> root.range-chroma;
                            range-chroma-feather <=> root.range-chroma-feather;
                            hue-circle: root.hue-circle;
                            picking <=> root.picking;
                            pick-started(a) => { root.pick-started(a); }
                            show-mask <=> root.show-mask;
                            show-mask-toggled => { root.show-mask-toggled(); }
                            collapsed-adjustments <=> root.collapsed-adjustments;
                            placing <=> root.placing;
                            adjustment-name <=> root.adjustment-name;
                            component-names <=> root.component-names;
                            component-on <=> root.component-on;
                            component <=> root.component;
                            component-invert <=> root.component-invert;
                            shape-mode <=> root.shape-mode;
                            adjustment-on <=> root.adjustment-on;
                            shapes-open <=> root.shapes-open;
                            placing-into <=> root.placing-into;
                            component-kind <=> root.component-kind;
                            brush-size <=> root.brush-size;
                            brush-feather <=> root.brush-feather;
                            brush-flow <=> root.brush-flow;
                            brush-op <=> root.brush-op;
                            target-changed(a) => { root.target-changed(a); }
                            adjustment-toggled(a) => { root.adjustment-toggled(a); }
                            add-adjustment(a) => { root.add-adjustment(a); }
                            delete-adjustment => { root.delete-adjustment(); }
                            add-shape(a, b) => { root.add-shape(a, b); }
                            delete-shape-at(a) => { root.delete-shape-at(a); }
                            shape-toggled(a) => { root.shape-toggled(a); }
                            component-changed(a) => { root.component-changed(a); }
                            renamed => { root.renamed(); }
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": WhiteBalanceSection {
                            as-shot <=> root.as-shot;
                            collapsed-wb <=> root.collapsed-wb;
                            picking <=> root.picking;
                            pick-started(a) => { root.pick-started(a); }
                            temperature <=> root.temperature;
                            tint <=> root.tint;
                            raw-input: root.raw-input;
                            develop-changed => { root.develop-changed(); }
                        }
                        if root.panel-tab == "Develop": CameraSection {
                            collapsed-camera <=> root.collapsed-camera;
                            raw-input: root.raw-input;
                            source-note: root.source-note;
                            camera-profile <=> root.camera-profile;
                            camera-profile-names: root.camera-profile-names;
                            camera-profile-labels: root.camera-profile-labels;
                            camera-profile-note: root.camera-profile-note;
                            camera-profile-warning: root.camera-profile-warning;
                            camera-profile-picked => { root.camera-profile-picked(); }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): LightSection {
                            exposure <=> root.exposure;
                            tone-curve <=> root.tone-curve;
                            contrast <=> root.contrast;
                            highlights <=> root.highlights;
                            shadows <=> root.shadows;
                            whites <=> root.whites;
                            blacks <=> root.blacks;
                            light-enabled <=> root.light-enabled;
                            collapsed-light <=> root.collapsed-light;
                            target-name <=> root.target-name;
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): ColorSection {
                            color-enabled <=> root.color-enabled;
                            saturation <=> root.saturation;
                            vibrance <=> root.vibrance;
                            collapsed-color <=> root.collapsed-color;
                            target-name <=> root.target-name;
                            band-colors: root.band-colors;
                            dull: root.dull;
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): CurvesSection {
                            curves-enabled <=> root.curves-enabled;
                            curve-mode <=> root.curve-mode;
                            para-highlights <=> root.para-highlights;
                            para-lights <=> root.para-lights;
                            para-darks <=> root.para-darks;
                            para-shadows <=> root.para-shadows;
                            curve-channel <=> root.curve-channel;
                            curve-image: root.curve-image;
                            collapsed-curves <=> root.collapsed-curves;
                            picking <=> root.picking;
                            pick-started(a) => { root.pick-started(a); }
                            target-name <=> root.target-name;
                            curve-press(a, b) => { root.curve-press(a, b); }
                            curve-move(a, b) => { root.curve-move(a, b); }
                            curve-release => { root.curve-release(); }
                            curve-double(a, b) => { root.curve-double(a, b); }
                            curve-reset => { root.curve-reset(); }
                            curve-channel-changed => { root.curve-channel-changed(); }
                            curve-mode-changed => { root.curve-mode-changed(); }
                            parametric-changed => { root.parametric-changed(); }
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): MixerSection {
                            collapsed-mixer <=> root.collapsed-mixer;
                            picking <=> root.picking;
                            pick-started(a) => { root.pick-started(a); }
                            target-name <=> root.target-name;
                            band-colors: root.band-colors;
                            mixer-enabled <=> root.mixer-enabled;
                            mixer-band <=> root.mixer-band;
                            mixer-hue <=> root.mixer-hue;
                            mixer-saturation <=> root.mixer-saturation;
                            mixer-luminance <=> root.mixer-luminance;
                            mixer-band-changed => { root.mixer-band-changed(); }
                            mixer-changed => { root.mixer-changed(); }
                            mixer-reset => { root.mixer-reset(); }
                            bw-enabled <=> root.bw-enabled;
                            target <=> root.target;
                            view-changed => { root.view-changed(); }
                        }
                        // Global only: a mask carries a look, and a
                        // picture is mono or it is not, so this one
                        // is not offered on the Masks tab.
                        if root.panel-tab == "Develop": BlackWhiteSection {
                            collapsed-bw <=> root.collapsed-bw;
                            band-colors: root.band-colors;
                            dull: root.dull;
                            bw-enabled <=> root.bw-enabled;
                            bw-band <=> root.bw-band;
                            bw-weight <=> root.bw-weight;
                            bw-strength <=> root.bw-strength;
                            bw-filter <=> root.bw-filter;
                            bw-band-changed => { root.bw-band-changed(); }
                            bw-changed => { root.bw-changed(); }
                            bw-filter-changed => { root.bw-filter-changed(); }
                            bw-reset => { root.bw-reset(); }
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): GradingSection {
                            collapsed-grading <=> root.collapsed-grading;
                            target-name <=> root.target-name;
                            grading-enabled <=> root.grading-enabled;
                            grade-range <=> root.grade-range;
                            grade-hue <=> root.grade-hue;
                            grade-saturation <=> root.grade-saturation;
                            grade-balance <=> root.grade-balance;
                            grade-images: root.grade-images;
                            grade-big <=> root.grade-big;
                            grade-press(a, b, c) => { root.grade-press(a, b, c); }
                            grade-move(a, b, c) => { root.grade-move(a, b, c); }
                            grade-release => { root.grade-release(); }
                            grade-double(a) => { root.grade-double(a); }
                            grade-resized => { root.grade-resized(); }
                            grade-changed => { root.grade-changed(); }
                            grade-reset => { root.grade-reset(); }
                            view-changed => { root.view-changed(); }
                        }
                        // A tint toward one hue, the last thing the
                        // Oklab pass does: Lightroom's local Color,
                        // and a look's, so the global picture and
                        // every mask can carry one. No switch: the
                        // amount at nothing is off.
                        if root.panel-tab == "Develop" || (root.panel-tab == "Masks" && root.target > 0): TintSection {
                            collapsed-tint <=> root.collapsed-tint;
                            target-name <=> root.target-name;
                            tint-hue <=> root.tint-hue;
                            tint-amount <=> root.tint-amount;
                            tint-color: root.tint-color;
                            tint-image: root.tint-image;
                            tint-hue-text: root.tint-hue-text;
                            tint-press(a, b) => { root.tint-press(a, b); }
                            tint-move(a, b) => { root.tint-move(a, b); }
                            tint-release => { root.tint-release(); }
                            hue-circle: root.hue-circle;
                            tint-changed => { root.tint-changed(); }
                            tint-reset => { root.tint-reset(); }
                        }
                        if root.panel-tab == "Develop": LookSection {
                            collapsed-look <=> root.collapsed-look;
                            look-name <=> root.look-name;
                            look-strength <=> root.look-strength;
                            look-names: root.look-names;
                            look-labels: root.look-labels;
                            look-note: root.look-note;
                            look-warning: root.look-warning;
                            look-picked => { root.look-picked(); }
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": NoiseSection {
                            noise-enabled <=> root.noise-enabled;
                            collapsed-noise <=> root.collapsed-noise;
                            denoise <=> root.denoise;
                            denoise-strength <=> root.denoise-strength;
                            denoise-learned <=> root.denoise-learned;
                            denoise-tiers: root.denoise-tiers;
                            denoise-learned-strength <=> root.denoise-learned-strength;
                            raw-input: root.raw-input;
                            develop-changed => { root.develop-changed(); }
                        }
                        if root.panel-tab == "Develop": LensSection {
                            lens-enabled <=> root.lens-enabled;
                            collapsed-lens <=> root.collapsed-lens;
                            picking <=> root.picking;
                            pick-started(a) => { root.pick-started(a); }
                            hue-circle: root.hue-circle;
                            lens-profile: root.lens-profile;
                            lens-available: root.lens-available;
                            lens-database: root.lens-database;
                            lens-profile-on <=> root.lens-profile-on;
                            lens-distortion <=> root.lens-distortion;
                            lens-ca <=> root.lens-ca;
                            lens-vignetting <=> root.lens-vignetting;
                            lens-manual <=> root.lens-manual;
                            lens-ca-red <=> root.lens-ca-red;
                            lens-ca-blue <=> root.lens-ca-blue;
                            lens-auto-scale <=> root.lens-auto-scale;
                            lens-scale <=> root.lens-scale;
                            lens-defringe <=> root.lens-defringe;
                            lens-defringe-radius <=> root.lens-defringe-radius;
                            lens-defringe-threshold <=> root.lens-defringe-threshold;
                            lens-defringe-purple-center <=> root.lens-defringe-purple-center;
                            lens-defringe-purple-width <=> root.lens-defringe-purple-width;
                            lens-defringe-purple-amount <=> root.lens-defringe-purple-amount;
                            lens-defringe-green-center <=> root.lens-defringe-green-center;
                            lens-defringe-green-width <=> root.lens-defringe-green-width;
                            lens-defringe-green-amount <=> root.lens-defringe-green-amount;
                            fetch-lenses => { root.fetch-lenses(); }
                            develop-changed => { root.develop-changed(); }
                        }
                        // Local contrast, the Texture and Clarity of the
                        // engine's guided filter: a develop op, so the
                        // worker runs it, after the retouch and before
                        // the sharpen.
                        if root.panel-tab == "Develop": DetailSection {
                            collapsed-detail <=> root.collapsed-detail;
                            detail-enabled <=> root.detail-enabled;
                            detail-texture <=> root.detail-texture;
                            detail-clarity <=> root.detail-clarity;
                            detail-dehaze <=> root.detail-dehaze;
                            develop-changed => { root.develop-changed(); }
                        }
                        if root.panel-tab == "Develop": SharpenSection {
                            collapsed-sharpen <=> root.collapsed-sharpen;
                            show-sharpen-mask <=> root.show-sharpen-mask;
                            sharpen <=> root.sharpen;
                            sharpen-auto-radius <=> root.sharpen-auto-radius;
                            sharpen-radius <=> root.sharpen-radius;
                            sharpen-iterations <=> root.sharpen-iterations;
                            sharpen-auto-threshold <=> root.sharpen-auto-threshold;
                            sharpen-threshold <=> root.sharpen-threshold;
                            sharpen-measured-radius: root.sharpen-measured-radius;
                            sharpen-measured-threshold: root.sharpen-measured-threshold;
                            view-changed => { root.view-changed(); }
                            develop-changed => { root.develop-changed(); }
                        }
                        if root.panel-tab == "Develop": VignetteSection {
                            vignette-enabled <=> root.vignette-enabled;
                            collapsed-vignette <=> root.collapsed-vignette;
                            vignette-amount <=> root.vignette-amount;
                            vignette-midpoint <=> root.vignette-midpoint;
                            vignette-feather <=> root.vignette-feather;
                            vignette-roundness <=> root.vignette-roundness;
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": GrainSection {
                            grain-enabled <=> root.grain-enabled;
                            collapsed-grain <=> root.collapsed-grain;
                            grain-amount <=> root.grain-amount;
                            grain-size <=> root.grain-size;
                            grain-kind <=> root.grain-kind;
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": ProofSection {
                            collapsed-proof <=> root.collapsed-proof;
                            proofing <=> root.proofing;
                            proof-profile <=> root.proof-profile;
                            proof-file <=> root.proof-file;
                            proof-intent <=> root.proof-intent;
                            gamut-warning <=> root.gamut-warning;
                            proof-changed => { root.proof-changed(); }
                            choose-proof-file => { root.choose-proof-file(); }
                        }
                        if root.panel-tab == "Develop": MonitorSection {
                            collapsed-monitor <=> root.collapsed-monitor;
                            display-profile <=> root.display-profile;
                            display-monitor <=> root.display-monitor;
                            display-file <=> root.display-file;
                            monitors: root.monitors;
                            display-note: root.display-note;
                            display-changed => { root.display-changed(); }
                            choose-display-file => { root.choose-display-file(); }
                            canvas-choice <=> root.canvas-choice;
                            canvas-colors: root.canvas-colors;
                            canvas-changed => { root.canvas-changed(); }
                        }
                        // The Crop tab in three: what is kept, which way
                        // up it is, and the keystone. One section held
                        // them all until the guide's buttons arrived and
                        // the perspective's own heading began to read as
                        // a second section inside the first.
                        if root.panel-tab == "Crop": CropSection {
                            crop-mode <=> root.crop-mode;
                            level-mode <=> root.level-mode;
                            guide-mode <=> root.guide-mode;
                            collapsed-crop <=> root.collapsed-crop;
                            aspect-name <=> root.aspect-name;
                            aspect-custom <=> root.aspect-custom;
                            portrait <=> root.portrait;
                            crop-toggled => { root.crop-toggled(); }
                            geometry-changed => { root.geometry-changed(); }
                            guide-dropped => { root.guide-dropped(); }
                        }
                        if root.panel-tab == "Crop": RotateSection {
                            frame-turned(a) => { root.frame-turned(a); }
                            crop-mode <=> root.crop-mode;
                            level-mode <=> root.level-mode;
                            guide-mode <=> root.guide-mode;
                            collapsed-rotate <=> root.collapsed-rotate;
                            geo-angle <=> root.geo-angle;
                            geometry-turned(a) => { root.geometry-turned(a); }
                            geometry-flipped(a) => { root.geometry-flipped(a); }
                            crop-toggled => { root.crop-toggled(); }
                            geometry-changed => { root.geometry-changed(); }
                            guide-dropped => { root.guide-dropped(); }
                        }
                        // The keystone: the camera's tilt, up or to the
                        // right positive, for a lens whose focal length
                        // is the frame's half side.
                        if root.panel-tab == "Crop": PerspectiveSection {
                            crop-mode <=> root.crop-mode;
                            level-mode <=> root.level-mode;
                            guide-mode <=> root.guide-mode;
                            collapsed-perspective <=> root.collapsed-perspective;
                            geo-vertical <=> root.geo-vertical;
                            geo-horizontal <=> root.geo-horizontal;
                            crop-toggled => { root.crop-toggled(); }
                            geometry-changed => { root.geometry-changed(); }
                            geometry-reset => { root.geometry-reset(); }
                            guide-dropped => { root.guide-dropped(); }
                        }
                        if root.panel-tab == "Develop": DemosaicSection {
                            collapsed-demosaic <=> root.collapsed-demosaic;
                            raw-input: root.raw-input;
                            source-note: root.source-note;
                            demosaic <=> root.demosaic;
                            demosaics: root.demosaics;
                            develop-changed => { root.develop-changed(); }
                        }
                        if root.panel-tab == "Retouch": RetouchSection {
                            retouch-enabled <=> root.retouch-enabled;
                            collapsed-retouch <=> root.collapsed-retouch;
                            develop-changed => { root.develop-changed(); }
                            retouch-mode <=> root.retouch-mode;
                            patch-size <=> root.patch-size;
                            patch-feather <=> root.patch-feather;
                            patch-opacity <=> root.patch-opacity;
                            patch-names <=> root.patch-names;
                            patch <=> root.patch;
                            retouch-toggled(a) => { root.retouch-toggled(a); }
                            patch-changed(a) => { root.patch-changed(a); }
                            delete-patch => { root.delete-patch(); }
                            patch-edited => { root.patch-edited(); }
                        }
                    }
                }
                Rectangle {
                    height: Theme.control-height + 2 * Theme.space-3 + 1px;
                    background: Theme.surface;
                    Rectangle { y: 0; height: 1px; width: 100%; background: Theme.border; }
                    HorizontalLayout {
                        padding: Theme.space-3;
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-4;
                        spacing: Theme.space-2;
                        PanelButton {
                            text: "Fit";
                            icon: @image-url("icons/maximize.svg");
                            clicked => { root.reset-view(); }
                        }
                        PanelButton {
                            text: root.export-running ? "Stop export" : "Export...";
                            icon: @image-url("icons/image-down.svg");
                            primary: !root.export-running;
                            enabled: root.export-running || (!root.busy && root.selected >= 0 && !root.culling);
                            clicked => {
                                if (root.export-running) { root.export-stop(); } else { root.export-open = true; }
                            }
                        }
                    }
                }
                }
            }
        }

        // Filmstrip.
        strip := Filmstrip {
            height: root.panels-hidden ? 0px : 148px;
            visible: !root.panels-hidden;
            thumbs: root.thumbs;
            selected <=> root.selected;
            frame-clicked(a, b, c) => { root.frame-clicked(a, b, c); }
            meta-stars: root.meta-stars;
            strip-item: root.strip-item;
            strip-pitch: root.strip-pitch;
            strip-pad: root.strip-pad;
            strip-relay => { root.strip-relay(); }
            strip-report => { root.strip-report(); }
            focus-keys => { keys.focus(); }
        }
    }

    // The grid, over the window: the folder as a contact sheet, in
    // place of the viewport, the strip and both panels. It is drawn
    // over them rather than swapped in for them so the viewport's
    // texture, and everything named inside it, stays where the rest
    // of the window can reach it.
    if root.grid-open: GridSheet {
        thumbs: root.thumbs;
        selected <=> root.selected;
        frame-clicked(a, b, c) => { root.frame-clicked(a, b, c); }
        set-count: root.set-count;
        meta-stars: root.meta-stars;
        grid-open <=> root.grid-open;
        grid-cell <=> root.grid-cell;
        grid-pad: root.grid-pad;
        grid-label: root.grid-label;
        grid-w <=> root.grid-w;
        grid-h <=> root.grid-h;
        grid-scroll: root.grid-scroll;
        grid-gap: root.grid-gap;
        grid-row: root.grid-row;
        grid-slack(a, b, c) => { return root.grid-slack(a, b, c); }
        grid-cols: root.grid-cols;
        grid-max: root.grid-max;
        grid-wheel(a, b) => { root.grid-wheel(a, b); }
        grid-relay => { root.grid-relay(); }
        culling <=> root.culling;
        cull-toggled => { root.cull-toggled(); }
        filter-stars <=> root.filter-stars;
        filter-flags <=> root.filter-flags;
        filter-labels <=> root.filter-labels;
        filter-exact <=> root.filter-exact;
        filter-text <=> root.filter-text;
        filter-shown <=> root.filter-shown;
        filter-total <=> root.filter-total;
        filter-on <=> root.filter-on;
        filter-focus <=> root.filter-focus;
        filter-facets: root.filter-facets;
        filter-facet-note: root.filter-facet-note;
        filter-facet-toggled(a, b) => { root.filter-facet-toggled(a, b); }
        filter-star-picked(a) => { root.filter-star-picked(a); }
        filter-flag-toggled(a) => { root.filter-flag-toggled(a); }
        filter-label-toggled(a) => { root.filter-label-toggled(a); }
        filter-exact-toggled => { root.filter-exact-toggled(); }
        filter-text-edited(a) => { root.filter-text-edited(a); }
        filter-cleared => { root.filter-cleared(); }
        open-folder => { root.open-folder(); }
        focus-keys => { keys.focus(); }
    }

    // The model sheet: a download offered, with its license, until
    // answered.
    if root.fetch-open: ModelSheet {
        fetch-title <=> root.fetch-title;
        fetch-text <=> root.fetch-text;
        fetch-note <=> root.fetch-note;
        fetch-answered(a) => { root.fetch-answered(a); }
    }

    // The move-rejects sheet: how many and where, until answered.
    // Never a delete, and no undo but a move back by hand, which it
    // says.
    if root.rejects-open: RejectsSheet {
        rejects-text: root.rejects-text;
        rejects-answered(a) => { root.rejects-answered(a); }
    }

    // The preset sheet: a name and what the preset carries, until
    // saved or left.
    if root.preset-open: PresetSheet {
        preset-open <=> root.preset-open;
        preset-name <=> root.preset-name;
        preset-section-names <=> root.preset-section-names;
        preset-section-on <=> root.preset-section-on;
        preset-section-toggled(a, b) => { root.preset-section-toggled(a, b); }
        preset-saved => { root.preset-saved(); }
    }

    // The sync sheet: the preset sheet's twin, over everything, until
    // applied or left.
    if root.sync-open: SyncSheet {
        sync-open <=> root.sync-open;
        sync-text: root.sync-text;
        sync-section-names <=> root.sync-section-names;
        sync-section-on <=> root.sync-section-on;
        sync-section-toggled(a, b) => { root.sync-section-toggled(a, b); }
        sync-applied => { root.sync-applied(); }
    }

    // The export sheet, over everything, until a choice is made.
    if root.export-open: ExportSheet {
        file-name: root.file-name;
        set-count: root.set-count;
        export => { root.export(); }
        export-open <=> root.export-open;
        export-format <=> root.export-format;
        export-quality <=> root.export-quality;
        export-size <=> root.export-size;
        export-custom <=> root.export-custom;
        frame-width <=> root.frame-width;
        frame-height <=> root.frame-height;
        custom-edge(a) => { return root.custom-edge(a); }
        export-space <=> root.export-space;
        export-embed <=> root.export-embed;
        export-sharpen <=> root.export-sharpen;
        export-on-exists <=> root.export-on-exists;
        export-metadata <=> root.export-metadata;
        export-mark <=> root.export-mark;
        export-mark-text <=> root.export-mark-text;
        export-mark-image-name <=> root.export-mark-image-name;
        export-mark-color <=> root.export-mark-color;
        export-mark-position <=> root.export-mark-position;
        export-mark-size <=> root.export-mark-size;
        export-mark-margin <=> root.export-mark-margin;
        export-mark-opacity <=> root.export-mark-opacity;
        export-mark-choose => { root.export-mark-choose(); }
        export-presets <=> root.export-presets;
        export-preset <=> root.export-preset;
        export-preset-edited <=> root.export-preset-edited;
        export-preset-chosen(n) => { root.export-preset-chosen(n); }
        export-preset-saved(n) => { root.export-preset-saved(n); }
        export-preset-deleted => { root.export-preset-deleted(); }
        export-preset-exists(n) => { return root.export-preset-exists(n); }
    }

    // The settings sheet, over everything, until closed.
    if root.settings-open: SettingsSheet {
        settings-open <=> root.settings-open;
        sidecar-placement <=> root.sidecar-placement;
        xmp-sidecars <=> root.xmp-sidecars;
        open-frames: root.open-frames;
        sidecars-written: root.sidecars-written;
        sidecars-elsewhere: root.sidecars-elsewhere;
        settings-note: root.settings-note;
        placement-changed => { root.placement-changed(); }
        xmp-changed => { root.xmp-changed(); }
        sidecars-move => { root.sidecars-move(); }
        thumb-cache-on: root.thumb-cache-on;
        thumb-cache-entries: root.thumb-cache-entries;
        thumb-cache-words: root.thumb-cache-words;
        thumb-cache-cap <=> root.thumb-cache-cap;
        thumb-cache-clear => { root.thumb-cache-clear(); }
        thumb-cache-cap-changed => { root.thumb-cache-cap-changed(); }
    }

}
