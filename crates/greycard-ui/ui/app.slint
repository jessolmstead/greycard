    in-out property <bool> noise-enabled: true;
    in-out property <bool> lens-enabled: true;
    in-out property <bool> vignette-enabled: true;
    in-out property <bool> grain-enabled: true;
    in-out property <bool> retouch-enabled: true;
    // Which sections are folded away; kept between runs.
    in-out property <bool> collapsed-navigator: false;
    in-out property <bool> collapsed-adjustments: false;
    in-out property <bool> collapsed-mask: false;
    in-out property <bool> collapsed-wb: false;
    in-out property <bool> collapsed-light: false;
    in-out property <bool> collapsed-curves: false;
    in-out property <bool> collapsed-mixer: false;
    in-out property <bool> collapsed-color: false;
    in-out property <bool> collapsed-bw: false;
    in-out property <bool> collapsed-grading: false;
    in-out property <bool> collapsed-tint: false;
    in-out property <bool> collapsed-noise: false;
    in-out property <bool> collapsed-lens: false;
    in-out property <bool> collapsed-detail: false;
    in-out property <bool> collapsed-sharpen: false;
    in-out property <bool> collapsed-vignette: false;
    in-out property <bool> collapsed-grain: false;
    in-out property <bool> collapsed-proof: false;
    in-out property <bool> collapsed-monitor: false;
    in-out property <bool> collapsed-crop: false;
    in-out property <bool> collapsed-rotate: false;
    in-out property <bool> collapsed-perspective: false;
    in-out property <bool> collapsed-demosaic: false;
    in-out property <bool> collapsed-camera: false;
    in-out property <bool> collapsed-look: false;
    in-out property <bool> collapsed-retouch: false;
    in-out property <bool> collapsed-presets: false;
