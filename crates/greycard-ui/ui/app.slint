    // warning when the chosen table is not there or will not read.
    in-out property <string> look-name: "none";
    in-out property <float> look-strength: 1.0;
    in property <[string]> look-names;
    in property <[string]> look-labels;
    in property <string> look-note;
    in property <string> look-warning;
    callback look-picked();
    // As the profile directory's: asked for when the section is
    // opened, so a table dropped in while the editor is running is
    // listed without reopening the file.
    callback looks-wanted();
    changed collapsed-look => {
        if (!root.collapsed-look) { root.looks-wanted(); }
    }
    callback view-changed();
    callback develop-changed();

    in property <string> status;
    /// What the camera's picture standing in for a develop is, in its
    /// own words. It takes the status line's place for as long as
    /// `placeholder` is set, so that the word over the picture and
