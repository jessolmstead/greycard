    /// kept by Rust in source pixels, not here in view pixels: the
    /// view can zoom, pan or change file between the two strokes.
    callback guide-stroke(length, length, length, length);
    /// Drop a half-finished pair: the tool put down, or pointed at the
    /// other axis, which its first stroke does not belong to.
    callback guide-dropped();
    /// The kept first stroke's two ends, where they are in the view
    /// now; empty when there is none.
    in property <[Pt]> guide-kept: [];
    // The color mixer: per-band arrays, and the chosen band's values
    // on the sliders.
    // The mixer's eight bands, in hue order: the swatches, and the
    // colors the hue slider's track is painted with.
    property <[color]> band-colors: [#e05050, #e08a40, #d8c040, #60c060, #40c0c0, #5080e0, #9060d0, #d060b0];
    property <color> dull: #8c8c8c;
    in-out property <bool> mixer-enabled: true;
    in-out property <int> mixer-band: 0;
    in-out property <float> mixer-hue: 0;
    in-out property <float> mixer-saturation: 0;
    in-out property <float> mixer-luminance: 0;
    in-out property <[float]> mixer-hues: [0, 0, 0, 0, 0, 0, 0, 0];
    in-out property <[float]> mixer-saturations: [0, 0, 0, 0, 0, 0, 0, 0];
    in-out property <[float]> mixer-luminances: [0, 0, 0, 0, 0, 0, 0, 0];
    callback mixer-band-changed();
    callback mixer-changed();
    callback mixer-reset();
    // Black and white: off by default, the eight bands' weights, the
    // chosen band on the slider, and which contrast filter the
    // weights are (0 None; -1 for a set of weights that is no
    // filter's).
    in-out property <bool> bw-enabled: false;
    in-out property <int> bw-band: 0;
    in-out property <float> bw-weight: 0;
    in-out property <[float]> bw-weights: [0, 0, 0, 0, 0, 0, 0, 0];
    // How much of those weights acts: one is the filters as their
    // tables are written, three is about where the real glass sits.
    in-out property <float> bw-strength: 1;
    // Which contrast filter the weights are, "" for a set that is
    // no filter's.
    in-out property <string> bw-filter: "None";
    callback bw-band-changed();
    callback bw-changed();
    callback bw-filter-changed();
    callback bw-reset();
    // Color grading: three wheels, shadows, mid-tones and highlights,
    // their hues (degrees) and strengths, the sliders' wheel, balance.
    in-out property <bool> grading-enabled: true;
    in-out property <int> grade-range: 0;
    in-out property <float> grade-hue: 0;
    in-out property <float> grade-saturation: 0;
    in-out property <float> grade-balance: 0;
    in-out property <[float]> grade-hues: [0, 0, 0];
    in-out property <[float]> grade-saturations: [0, 0, 0];
    // The wheels' pictures, shadows, mid-tones, highlights; and which
    // one is enlarged, none at -1.
    in property <[image]> grade-images: [];
    in-out property <int> grade-big: -1;
    callback grade-press(int, float, float);
    callback grade-move(int, float, float);
    callback grade-release();
    callback grade-double(int);
    callback grade-chose(int);
    callback grade-changed();
    callback grade-reset();
    // A tint toward one hue: the section's switch, the hue in Oklab
    // degrees, how far 0 to 1, nothing at 0. The track is the Oklab
    // hue circle at the grading wheels' lightness and chroma, a stop
    // every thirty degrees, so which color each way goes to reads
    // without dragging; `tint-color` is what a mid grey becomes under
    // the tint as it is set, which the window works out.
    in-out property <bool> tint-enabled: true;
    in-out property <float> tint-hue: 0;
    in-out property <float> tint-amount: 0;
    in property <color> tint-color: #8c8c8c;
    // The ring: the same picture as a grading wheel, the hue round
    // and the amount outward, with a marker where the tint is. The
    // window draws it and reads a press back. `tint-hue-text` is the
    // hue to a tenth of a degree, which the window formats because
    // Slint cannot hold a trailing zero.
    in property <image> tint-image;
    in property <string> tint-hue-text: "0.0\u{00b0}";
    callback tint-press(float, float);
    callback tint-move(float, float);
    callback tint-release();
    property <brush> hue-circle: @linear-gradient(90deg,
        #e680a1 0%, #eb8373 8.33%, #df8f48 16.67%, #c4a032 25%,
        #9ab04b 33.33%, #62bb78 41.67%, #06bfa8 50%, #00bad1 58.33%,
        #4baeed 66.67%, #859ff6 75%, #b191ea 83.33%, #d285cb 91.67%,
        #e680a1 100%);
    callback tint-changed();
    callback tint-reset();
    callback curve-press(float, float);
    callback curve-move(float, float);
    callback curve-release();
    callback curve-double(float, float);
    // The point curve's selected point, its index in the channel's
    // points or -1, and its In and Out as the fields show them.
    in-out property <int> curve-selected: -1;
    in-out property <string> curve-point-in;
    in-out property <string> curve-point-out;
    callback curve-typed(string, string);
    callback curve-reset();
    callback curve-channel-changed();
    callback curve-mode-changed();
    callback parametric-changed();
    in-out property <float> temperature: 5500;
    in-out property <float> tint: 0;
    // The chosen mask's own white balance: whether it has one, and
    // the light it says is there.
    in-out property <bool> local-wb-on: false;
    in-out property <float> local-temperature: 5500;
    in-out property <float> local-tint: 0;
    // Whether the sliders hold a light of the mask's own, on or
    // switched off; false, the mask follows the global.
    in-out property <bool> local-wb-kept: false;
    // Its switch: turned on, it brings back the light it kept, or
    // starts at the global's white when there is none.
    callback local-wb-toggled();
    // A double-click on its Temperature or Tint: the light forgotten,
    // the switch off, the mask following the global.
    callback local-wb-reset();
    in-out property <bool> denoise: false;
    in-out property <float> denoise-strength: 1.5;
    // The learned denoiser's tier by name, "off" for the engine's own.
    in-out property <string> denoise-learned: "off";
    in property <[string]> denoise-tiers;
    in-out property <float> denoise-learned-strength: 1.0;
    // Local contrast: the section's switch and its two sliders, -1 to
    // 1, shown as ±100.
    in-out property <bool> detail-enabled: true;
    in-out property <float> detail-texture: 0;
    in-out property <float> detail-clarity: 0;
    in-out property <float> detail-dehaze: 0;
    // The chosen mask's own Detail: its switch and its three sliders,
    // put on at the finish by the mask's weight.
    in-out property <bool> local-detail-enabled: true;
    in-out property <float> local-texture: 0;
    in-out property <float> local-clarity: 0;
    in-out property <float> local-dehaze: 0;
    in-out property <bool> sharpen: true;
    // The lens: what the database found for the file, whether it
    // found anything, whether there is a database at all, and the
    // edit's choices.
    in property <string> lens-profile: "";
    // Whether the open file is a raw: the sections before the lens
    // have nothing to act on in a picture that is not.
    in property <bool> raw-input: true;
    // Why the noise section rests, or "" when it does not: a picture
    // that is not a raw.
    in property <string> noise-unavailable: "";
    // Why the learned denoiser's tiers rest while the profiled
    // denoise works, or "" when they do not: an X-Trans raw.
    in property <string> learned-unavailable: "";
    // What a picture that is not a raw was taken to be.
    in property <string> source-note;
    in property <bool> lens-available: false;
    in property <bool> lens-database: false;
    in-out property <bool> lens-profile-on: true;
    in-out property <bool> lens-distortion: true;
    in-out property <bool> lens-ca: true;
    in-out property <bool> lens-vignetting: true;
    in-out property <float> lens-manual: 0;
    in-out property <float> lens-ca-red: 0;
    in-out property <float> lens-ca-blue: 0;
    in-out property <bool> lens-auto-scale: true;
    in-out property <float> lens-scale: 1;
    in-out property <bool> lens-defringe: false;
    in-out property <float> lens-defringe-radius: 2;
    in-out property <float> lens-defringe-threshold: 13;
    // The two hue windows the pass is gated on: a center on the Oklab
    // hue circle, a width in degrees and how much of the pass a
    // deviation inside gets. Rust's defaults are the measured ones.
    in-out property <float> lens-defringe-purple-center: 310;
    in-out property <float> lens-defringe-purple-width: 120;
    in-out property <float> lens-defringe-purple-amount: 1;
    in-out property <float> lens-defringe-green-center: 130;
    in-out property <float> lens-defringe-green-width: 120;
    in-out property <float> lens-defringe-green-amount: 1;
    callback fetch-lenses();
    in-out property <bool> sharpen-auto-radius: true;
    in-out property <float> sharpen-radius: 0.75;
    in-out property <float> sharpen-iterations: 20;
    in-out property <bool> sharpen-auto-threshold: true;
    in-out property <float> sharpen-threshold: 0.1;
    // What the last develop measured, shown while the automatics are on.
    in property <float> sharpen-measured-radius: 0;
    in property <float> sharpen-measured-threshold: 0;
    in-out property <string> demosaic: "amaze-vng4";
    // The open raw's mosaic's choices, its default first.
    in property <[string]> demosaics;
    // What the edit stores. The menu shows the choice resolved for the
    // open raw's mosaic; only a pick changes what is stored.
    in-out property <string> demosaic-stored: "amaze-vng4";
    // Why the menu rests while the open raw's mosaic is not known, or "".
    in property <string> demosaic-hint: "";
    callback demosaic-picked(string);
    demosaic-picked(v) => {
        root.demosaic-stored = v;
        root.develop-changed();
    }
    // The camera profile: what the edit stores ("embedded" or a DCP's
    // file name), the names and the labels of what the profile
