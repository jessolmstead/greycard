    in property <bool> export-queue-running: false;
    callback export-queue-add();
    callback export-queue-run();
    callback export-queue-clear();
    // Retouching: the tool in hand ("", "Heal" or "Clone"), the next
    // or chosen patch's size (of the picture's width), feather and
    // opacity, the patches by name, the chosen one, and its pins on the
    // view: its center, then its source.
    in-out property <string> retouch-mode: "";
    in-out property <float> patch-size: 0.02;
    in-out property <float> patch-feather: 0.3;
    in-out property <float> patch-opacity: 1.0;
    in-out property <[string]> patch-names: [];
    in-out property <int> patch: -1;
    in-out property <[Pt]> patch-handles: [];
    // The chosen patch's edge on the view, and where its feather
    // begins, as a Path's commands; empty when there is none to show.
    in property <string> patch-outline: "";
    in property <string> patch-feather-outline: "";
    callback retouch-toggled(string);
    callback patch-changed(int);
    callback delete-patch();
    callback patch-edited();
    callback patch-grabbed(int);
    callback patch-dragged(int, length, length);
    callback patch-dropped();
    // The model sheet: a model to fetch, offered with its license.
    in-out property <bool> fetch-open: false;
    in-out property <string> fetch-title: "";
    in-out property <string> fetch-text: "";
    in-out property <string> fetch-note: "";
    callback fetch-answered(bool);
    // The export sheet.
    in-out property <bool> export-open: false;
    in-out property <string> export-format: "JPEG";
    in-out property <float> export-quality: 92;
    in-out property <string> export-size: "Full";
    /// The long edge typed for the Custom size, as typed.
    in-out property <string> export-custom: "1600";
    /// The picture's size as an export writes it at Full: the frame
    /// after the crop, in pixels.
    in-out property <int> frame-width: 0;
    in-out property <int> frame-height: 0;
    /// The typed text as a long edge, or 0 when it is not a size.
    pure callback custom-edge(string) -> int;
    /// The typed Subfolder as the export reads it: its name, and why
    /// it is refused (each empty when there is nothing to say).
    pure callback export-subfolder-name(string) -> string;
    pure callback export-subfolder-problem(string) -> string;
    /// The export sheet's Folder row for a typed subfolder, the frame
    /// (its name and its row), the turn below and room for so many
    /// characters.
    pure callback export-folder-line(string, string, int, int, int) -> string;
    /// Counts the folders chosen, so the row reads the new one.
    in property <int> export-folder-turn;
    /// The row's Choose button.
    callback export-folder-choose();
    in-out property <string> export-space: "sRGB";
    in-out property <bool> export-embed: true;
    in-out property <string> export-sharpen: "Standard";
    /// What an export does when a file of that name is already there.
    in-out property <string> export-on-exists: "Increment";
    /// A folder under each frame's own to export into; empty for the
    /// folder the sheet's Folder row shows.
    in-out property <string> export-subfolder: "";
    /// What the file says of where it came from: All, No edit, None.
    in-out property <string> export-metadata: "All";
    /// The watermark: Off, Text or Image, and its settings; the size
    /// and the margin are percent of the export's long edge.
    in-out property <string> export-mark: "Off";
    in-out property <string> export-mark-text: "";
    in-out property <string> export-mark-image: "";
    /// The image's file name, for the sheet to show.
    in-out property <string> export-mark-image-name: "";
    in-out property <string> export-mark-color: "White";
    in-out property <string> export-mark-position: "Bottom right";
    in-out property <float> export-mark-size: 15;
    in-out property <float> export-mark-margin: 2;
    in-out property <float> export-mark-opacity: 60;
    /// A border round the picture, added outside it: on or off, its
    /// width in percent of the picture's long edge, and its color.
    in-out property <bool> export-border: false;
    in-out property <float> export-border-width: 5;
    in-out property <string> export-border-color: "White";
    /// Ask the desktop for the watermark's PNG.
    callback export-mark-choose();
    /// The export presets by name, the one chosen (empty for none)
    /// and whether the sheet has moved from it since.
    in-out property <[string]> export-presets: [];
    in-out property <string> export-preset: "";
    in-out property <bool> export-preset-edited: false;
    callback export-preset-chosen(string);
    callback export-preset-saved(string);
    callback export-preset-deleted();
    pure callback export-preset-exists(string) -> bool;
    /// Any of the sheet's choices moved.
    callback export-sheet-changed();
    changed export-format => { root.export-sheet-changed(); }
    changed export-quality => { root.export-sheet-changed(); }
    changed export-size => { root.export-sheet-changed(); }
    changed export-custom => { root.export-sheet-changed(); }
    changed export-space => { root.export-sheet-changed(); }
    changed export-embed => { root.export-sheet-changed(); }
    changed export-sharpen => { root.export-sheet-changed(); }
    changed export-on-exists => { root.export-sheet-changed(); }
    changed export-subfolder => { root.export-sheet-changed(); }
    changed export-metadata => { root.export-sheet-changed(); }
    changed export-mark => { root.export-sheet-changed(); }
    changed export-mark-text => { root.export-sheet-changed(); }
    changed export-mark-image => { root.export-sheet-changed(); }
    changed export-mark-color => { root.export-sheet-changed(); }
    changed export-mark-position => { root.export-sheet-changed(); }
    changed export-mark-size => { root.export-sheet-changed(); }
    changed export-mark-margin => { root.export-sheet-changed(); }
    changed export-mark-opacity => { root.export-sheet-changed(); }
    changed export-border => { root.export-sheet-changed(); }
    changed export-border-width => { root.export-sheet-changed(); }
    changed export-border-color => { root.export-sheet-changed(); }
    // The import sheet: frames from a card into a folder, renamed,
    // verified, backed up and given a preset. Ctrl+Shift+I or the
    // grid's Import button opens it, through Rust, which looks for a
    // card and reads the source on threads of their own.
    in-out property <bool> import-open: false;
    in property <string> import-source: "";
    in property <string> import-destination: "";
    in property <string> import-backup: "";
    in-out property <string> import-subfolder: "{date}";
    in-out property <string> import-name: "{name}";
    in property <[string]> import-presets: [];
    in-out property <string> import-preset: "None";
    in property <string> import-note: "";
    in property <string> import-preview: "";
    /// A word on the folders: the backup on the destination's drive.
    in property <string> import-folders-note: "";
    in property <int> import-count: 0;
    in property <bool> import-ready: false;
    /// Compare a frame already there with the card byte for byte.
    in-out property <bool> import-verify: false;
    /// An import is copying, a frame at a time; Stop (or Escape)
    /// finishes the frame in hand and stops.
    in property <bool> import-running: false;
    in property <bool> import-stopping: false;
    /// The import's progress, then its end, for the left pane under
    /// Import with the grid up (or the grid's header with the pane put
    /// away), since the grid covers the status plate; empty when there
    /// is nothing to say.
    in property <string> import-status: "";
    callback import-asked();
    callback import-choose(string);
    callback import-backup-cleared();
    callback import-started();
    callback import-stop();
    callback import-pattern-changed();
    changed import-subfolder => { root.import-pattern-changed(); }
    changed import-name => { root.import-pattern-changed(); }
    // The Lightroom catalog import: a catalog chosen, its roots and
    // its set asked, the dry run's report shown, then written on a
    // thread of its own, its progress under the button and on the
    // status line, and the report again. Through Rust throughout.
    in-out property <bool> lr-open: false;
    in property <int> lr-step: 0;
    in property <string> lr-title: "";
    in property <string> lr-subtitle: "";
    in property <string> lr-note: "";
    in property <[LightroomRoot]> lr-roots: [];
    in-out property <string> lr-set: "";
    in property <bool> lr-has-creations: false;
    in-out property <bool> lr-creations: true;
    in property <int> lr-already: 0;
    in-out property <bool> lr-force: false;
    in property <[ReportLine]> lr-lines: [];
    in property <[ReportLine]> lr-done: [];
    in property <bool> lr-busy: false;
    in property <string> lr-busy-text: "";
    in property <bool> lr-ready: false;
    /// A write running, and what it has done, for the left pane.
    in property <bool> lr-running: false;
    in property <string> lr-status: "";
    callback lr-asked();
    callback lr-choose-root(int);
    callback lr-check();
    callback lr-back();
    callback lr-write();
    // RawTherapee's profiles beside a folder's frames: offered once
    // under the folder's name, then the import's sheet, its dry run as
    // the command prints it and the write on a thread. Through Rust
    // throughout.
    /// The offer's words, empty for none.
    in property <string> rt-offer: "";
    callback rt-offer-import();
    callback rt-offer-dismissed();
    in-out property <bool> rt-open: false;
    in property <int> rt-step: 0;
    in property <string> rt-title: "";
    in property <string> rt-subtitle: "";
    in property <string> rt-note: "";
    in property <[ReportLine]> rt-totals: [];
    in property <[ReportLine]> rt-lines: [];
    in property <int> rt-held: 0;
    in-out property <bool> rt-force: false;
    in property <bool> rt-busy: false;
    in property <bool> rt-writing: false;
    in property <string> rt-busy-text: "";
    in property <bool> rt-ready: false;
    callback rt-force-toggled();
    callback rt-write();
    // The settings sheet: what is the installation's and not a
    // picture's. Where a sidecar is written, "Beside the raw" or
    // "Hidden folder"; whether an XMP is written beside it; how many
    // of the open folder's sidecars are in the other place, and what
    // the last move of them did. Ctrl+, or the gear opens it, through
    // Rust, which counts first.
    in-out property <bool> settings-open: false;
    // However the sheet is closed — Done, Escape, a click outside — a
    // cap typed and not yet entered is taken; Rust ignores one that
    // did not change.
    changed settings-open => {
        if (!root.settings-open) {
            root.thumb-cache-cap-changed();
            root.preview-cache-cap-changed();
            root.network-poll-changed();
        }
    }
    in-out property <string> sidecar-placement: "Beside the raw";
    in-out property <bool> xmp-sidecars: false;
    in-out property <bool> jpegs-apart: false;
    callback jpegs-apart-changed();
    in property <int> sidecars-elsewhere: 0;
    /// How many frames are open, which the count and the move run
    /// over; and whether this run writes sidecars at all.
    in property <int> open-frames: 0;
    in property <bool> sidecars-written: true;
    in property <string> settings-note: "";
    callback settings-asked();
    callback placement-changed();
    callback xmp-changed();
    callback sidecars-move();
    /// The thumbnail cache: whether there is one this run, how many
    /// entries it holds and what that is in words, the cap in
    /// megabytes as the field has it, and the Clear and the cap's
    /// change.
    in property <bool> thumb-cache-on: false;
    in property <int> thumb-cache-entries: 0;
    in property <string> thumb-cache-words: "";
    in-out property <string> thumb-cache-cap: "";
    callback thumb-cache-clear();
    callback thumb-cache-cap-changed();
    /// The local previews' own cap, in megabytes as the field has it,
    /// and its change.
    in-out property <string> preview-cache-cap: "";
    callback preview-cache-cap-changed();
    /// How often a root on a network mount is passed over, in minutes
    /// as the field has it, and its change.
    in-out property <string> network-poll-minutes: "";
    callback network-poll-changed();
    /// The shipped presets the store is without, as a count and in
    /// words, and the settings' Restore that puts them back.
    in property <int> presets-missing: 0;
    in property <string> presets-missing-words: "";
    callback presets-restore();
    /// Move to the file `by` places along the strip; with Shift held,
    /// the set keeps what it had and takes that file as well.
    callback step(int, bool);
    /// Home (false) or End (true): to the first file of the strip or
    /// the grid, or the last, as an arrow lands; with Shift held the
    /// set takes the whole run from the current frame to there.
    callback step-end(bool, bool);
    /// Ask the desktop for a folder, and open it in place of the
    /// current file list.
    callback open-folder();
    /// Open the bug report form in the browser, filled in, and the
    /// log's folder beside it.
    callback report-asked();
    /// The keys sheet: ? or Help > Keys. Its rows are the key table's
    /// (`keys.rs`), narrowed by its field as it is typed into.
    in-out property <bool> keys-open: false;
    in property <[KeyRow]> keys-rows: [];
    callback keys-searched(string);
    /// The name the key table gives a press, empty when it binds
    /// none: the one way the window's key handler reads a key.
    callback key-chord(string, bool, bool, bool, bool) -> string;
    /// Help > User guide: the guide in the browser.
    callback guide-asked();
    /// Set to open the Help menu, for a capture of it.
    in-out property <bool> help-menu-shown: false;
    /// The update check: the Settings sheet's switch, its Check now
    /// and the line that answers it; and a newer release found, by
    /// its version as shown ("0.1.4", empty for none) and its page,
    /// which the left pane's entry opens or is told not to offer.
    in-out property <bool> update-check: true;
    callback update-check-changed();
    callback update-check-now();
    in property <string> update-note: "";
    in property <bool> update-checking: false;
    in property <string> update-version: "";
    in property <string> update-url: "";
    callback update-open();
    callback update-dismissed();
    /// Whether a viewport tool is in hand: a shape being placed, a
    /// dropper, a perspective guide, the level, the crop's Draw. Escape
    /// puts each down.
    pure function tool-in-hand() -> bool {
        return root.placing != "" || root.picking != "" || root.guide-mode != "" || root.level-mode
            || root.crop-draw-armed;
    }
    /// Whether the export sheet can open now: a frame open, nothing
    /// developing or exporting, not culling.
    pure function can-export() -> bool {
        return !root.export-open && !root.busy && !root.export-running && root.selected >= 0 && !root.culling;
    }
    /// Ctrl+Shift+E, and the frame menu's Export...
    public function export-asked() {
        if (root.can-export()) { root.export-open = true; }
    }
    /// A right-click over row `row` (-1: the viewport's frame), at
    /// (x, y) in the window: the target settled, then the menu. Not
    /// under a sheet, which a sheet's own frames would move under.
    /// The menu's Export...: the sheet now, or once the develop in
    /// progress lands (a right-click on a frame outside the selection
    /// starts one).
    public function menu-export() {
        if (root.busy) { root.export-waiting = true; } else { root.export-asked(); }
    }
    changed busy => {
        if (!self.busy && self.export-waiting) {
            self.export-waiting = false;
            self.export-asked();
        }
    }
    // A paste's sheet closed, however: the next opening is a sync's
    // unless a paste asks again.
    changed sync-open => {
        if (!self.sync-open) { self.sync-paste = false; }
    }
    /// Whether the frame menu is up, for the surfaces: a press outside
    /// it closes it and is still delivered to what is under the
    /// pointer, which lets that one go by. Slint 1.18 does not say
    /// whether a ContextMenuArea's menu is open, so it is read off the
    /// keys: Slint's own menu takes the focus from them while it is up
    /// and gives it back when it closes, however it closes. A native
    /// menu (macOS, Windows) takes neither the focus nor the click.
    out property <bool> menu-up: false;
    pure function menu-shown() -> bool {
        return root.menu-up;
    }
    /// After a menu item is picked: the focus back on the keys. Slint
    /// gives it back itself when a menu closes, but not when the pick
    /// was made with the pointer from a sub-menu, where two popups
    /// close at once; `menu-up` then stayed true, every surface let
    /// every press go by as the closing click, and the keys had no
    /// focus to take, so the window looked frozen until Escape.
    function menu-done() {
        menu-refocus.running = true;
    }
    // After the pick's own turn: the activation runs before the
    // popups close, and their closing moves the focus once more, so
    // a focus given back in the handler itself is taken again.
    menu-refocus := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.menu-up || !keys.has-focus) { keys.focus(); }
        }
    }
    function frame-menu-at(row: int, x: length, y: length) {
        if (root.sheet-open()) { return; }
        root.frame-menu-asked(row);
        frame-menu.open(x, y);
    }
    /// Whether a sheet is over everything. The sheets are declared
    /// after the grid and draw over it, so the keys belong to them.
    /// The left pane, the develop panel and the strip, each put away
    /// on its own: F7, F8 and F6, or the arrow on its edge. Tab puts
    /// all three away and, with all three away, brings all three
    /// back. With all three away the status plate goes too, and the
    /// viewport has the whole window. Kept in the settings.
    in-out property <bool> left-hidden: false;
    in-out property <bool> right-hidden: false;
    in-out property <bool> strip-hidden: false;
    // The three widths, read by the layout and by the arrows on the
    // viewport's edges.
    property <length> left-w: root.left-hidden ? 0px : 240px;
    property <length> right-w: root.right-hidden ? 0px : 320px;
    property <length> strip-h: root.strip-hidden ? 0px : 148px;
    pure function all-hidden() -> bool {
        return root.left-hidden && root.right-hidden && root.strip-hidden;
    }
    /// Public so the Rust side asks the same question before it puts
    /// a sheet up of its own accord.
    public pure function sheet-open() -> bool {
        return root.export-open || root.fetch-open || root.preset-open || root.rejects-open
            || root.delete-open || root.look-remove-open || root.look-rename-open || root.overwrite-open || root.archive-open || root.archive-rejects-open
            || root.settings-open || root.sync-open || root.import-open || root.match-open
            || root.root-sheet-open || root.collection-sheet-open || root.preset-report-open
            || root.lr-open || root.rt-open || root.keys-open;
    }

    // A value typed into a field, set or let go: the keys are the
    // window's again, as when a sheet closes.
    property <int> entries-done: Typing.done;
    changed entries-done => { keys.focus(); }

    // A sheet closed from the Rust side (an answer invoked, not
    // clicked) takes its focus with it: the keys are the window's
    // again whoever closed it, unless another sheet is up by then.
    // A changed handler runs after the turn, so a sheet that closed
    // as the next one opened would otherwise take the keys from it.
    changed rejects-open => { if (!root.rejects-open && !root.sheet-open()) { keys.focus(); } }
    changed delete-open => { if (!root.delete-open && !root.sheet-open()) { keys.focus(); } }
    changed look-remove-open => { if (!root.look-remove-open && !root.sheet-open()) { keys.focus(); } }
    changed look-rename-open => { if (!root.look-rename-open && !root.sheet-open()) { keys.focus(); } }
    changed overwrite-open => { if (!root.overwrite-open && !root.sheet-open()) { keys.focus(); } }
    changed archive-open => { if (!root.archive-open && !root.sheet-open()) { keys.focus(); } }
    changed archive-rejects-open => {
        if (!root.archive-rejects-open && !root.sheet-open()) { keys.focus(); }
    }
    changed collection-sheet-open => {
        if (!root.collection-sheet-open && !root.sheet-open()) { keys.focus(); }
    }
    changed preset-report-open => {
        if (!root.preset-report-open && !root.sheet-open()) { keys.focus(); }
    }
    changed lr-open => {
        if (!root.lr-open && !root.sheet-open()) { keys.focus(); }
    }
    changed rt-open => {
        if (!root.rt-open && !root.sheet-open()) { keys.focus(); }
    }
    // Opened, the whole table, whatever the last search left; closed,
    // the keys back.
    changed keys-open => {
        if (root.keys-open) { root.keys-searched(""); }
        if (!root.keys-open && !root.sheet-open()) { keys.focus(); }
    }

    // Keys that are nobody's: arrows step files, ctrl+z undoes.
    forward-focus: keys;
    keys := FocusScope {
        focus-lost(reason) => {
            if (reason == FocusReason.popup-activation) { root.menu-up = true; }
        }
        focus-gained(reason) => { root.menu-up = false; }
        key-pressed(e) => {
            // A key takes the hover text down, as it does a tooltip: a
            // row or a panel the key removes never hears the pointer go.
            root.tip-text = "";
            // The press by the name the key table gives it
            // (`keys.rs`), empty for a key the table does not bind.
            // Nothing below compares the event's text, so the keys sheet,
            // made from the same table, is every key there is.
            let chord = root.key-chord(e.text, e.modifiers.control, e.modifiers.shift,
                e.modifiers.alt, e.modifiers.meta);
            if (chord == "") { return reject; }
            if (chord == "Esc" && root.keys-open) { root.keys-open = false; return accept; }
            // The settings sheet is declared last and so drawn over the
            // rest: Escape closes it first.
            if (chord == "Esc" && root.settings-open) { root.settings-open = false; return accept; }
            if (chord == "Esc" && root.export-open) { root.export-open = false; return accept; }
            if (chord == "Esc" && root.import-open) { root.import-open = false; return accept; }
            if (chord == "Esc" && root.fetch-open) { root.fetch-answered(false); return accept; }
            if (chord == "Esc" && root.preset-open) { root.preset-open = false; return accept; }
            if (chord == "Esc" && root.preset-report-open) { root.preset-report-open = false; return accept; }
            if (chord == "Esc" && root.lr-open) {
                if (!root.lr-busy) { root.lr-open = false; }
                return accept;
            }
            if (chord == "Esc" && root.rt-open) {
                if (!root.rt-writing) { root.rt-open = false; }
                return accept;
            }
            if (chord == "Esc" && root.root-sheet-open) { root.root-sheet-open = false; return accept; }
            if (chord == "Esc" && root.collection-sheet-open) { root.collection-sheet-open = false; return accept; }
            if (chord == "Esc" && root.rejects-open) { root.rejects-answered(false); return accept; }
            if (chord == "Esc" && root.delete-open) { root.delete-answered(0); return accept; }
            if (chord == "Esc" && root.look-remove-open) { root.look-remove-answered(0); return accept; }
            if (chord == "Esc" && root.look-rename-open) {
                if (!root.look-rename-working) { root.look-rename-answered(false); }
                return accept;
            }
            if (chord == "Esc" && root.overwrite-open) { root.overwrite-answered(0); return accept; }
            if (chord == "Esc" && root.archive-open) { root.archive-answered(false); return accept; }
            if (chord == "Esc" && root.archive-rejects-open) { root.archive-rejects-answered(0); return accept; }
            if (chord == "Esc" && root.match-open && !root.match-running) { root.match-close(); return accept; }
            if (chord == "Esc" && root.sync-open) { root.sync-open = false; return accept; }
            if (chord == "Esc" && (root.placing != "" || root.picking != "")) { root.stop-placing(); return accept; }
            // A preset's removal asked and not answered: Esc is its
            // Cancel.
            if (chord == "Esc" && root.preset-confirm-remove >= 0) { root.preset-confirm-remove = -1; return accept; }
            // A repair chosen for editing, not one just drawn: Esc
            // lets go of it, so the sliders go back to the brush.
            if (chord == "Esc" && root.patch != -1) { root.patch-changed(-1); return accept; }
            if (chord == "Esc" && root.guide-mode != "") { root.guide-mode = ""; root.guide-dropped(); return accept; }
            if (chord == "Esc" && root.level-mode) { root.level-mode = false; return accept; }
            if (chord == "Esc" && root.crop-draw-armed) { root.crop-draw-armed = false; return accept; }
            // A set being exported stops before Escape means anything
            // else: the sheet is gone by then, and this is its cancel.
            // Once stopping, Escape is the window's again.
            if (chord == "Esc" && root.export-running && !root.export-stopping && !root.sheet-open()) {
                root.export-stop();
                return accept;
            }
            // A set of frames goes back to the one on screen before
            // Escape means anything else: leaving the grid or the
            // culling mode with the set still held would leave it
            // chosen where it cannot be seen.
            if (chord == "Esc" && root.set-count > 1 && !root.sheet-open()) {
                root.set-collapsed();
                return accept;
            }
            // The lightbox: L in and out, Return to the loupe on the
            // frame chosen and Return, Escape or L back from there,
            // Escape out to the grid, G to the grid, plus and minus
            // the tiles' size. The rest is the grid's, below.
            if (!root.sheet-open()) {
                let l = chord == "L";
                // A held key is one press: held, it would flip in and out
                // at the repeat's rate. Its repeats are eaten here, not
                // left to the grid's keys below, which would take the
                // next step out. Plus and minus may repeat.
                let ours = l || chord == "G" || chord == "Return"
                    || chord == "Esc";
                if (root.lightbox && e.repeat && ours) { return accept; }
                if (root.lightbox && root.lightbox-loupe) {
                    if (!e.repeat && (l || chord == "Return" || chord == "Esc")) {
                        root.lightbox-from-loupe();
                        return accept;
                    }
                    if (!e.repeat && (chord == "G")) { root.lightbox-leave(); return accept; }
                } else if (root.lightbox) {
                    if (!e.repeat && (l || chord == "Esc" || chord == "G")) {
                        root.lightbox-leave();
                        return accept;
                    }
                    if (!e.repeat && chord == "Return") { root.lightbox-to-loupe(); return accept; }
                    if (chord == "+" || chord == "=") { root.lightbox-zoom(1); return accept; }
                    if (chord == "-" || chord == "_") { root.lightbox-zoom(-1); return accept; }
                } else if (l && !e.repeat) {
                    root.lightbox-enter();
                    return accept;
                }
            }
            // The grid takes the window: its own arrows, its own
            // zoom, and three ways back to the loupe.
            if (root.grid-open && !root.sheet-open()) {
                // Held, one step out and no further.
                if (chord == "Esc" || chord == "Return") {
                    if (!e.repeat) { root.grid-open = false; }
                    return accept;
                }
                if (chord == "Left" || chord == "Shift+Left") { root.grid-step(-1, 0, root.grid-cols, e.modifiers.shift); return accept; }
                if (chord == "Right" || chord == "Shift+Right") { root.grid-step(1, 0, root.grid-cols, e.modifiers.shift); return accept; }
                if (chord == "Up" || chord == "Shift+Up") { root.grid-step(0, -1, root.grid-cols, e.modifiers.shift); return accept; }
                if (chord == "Down" || chord == "Shift+Down") { root.grid-step(0, 1, root.grid-cols, e.modifiers.shift); return accept; }
                // The sheet's top or its foot, and the frame there
                // chosen as an arrow chooses one; the scroll is set
                // as well, since the frame may be chosen already.
                if (chord == "Home" || chord == "End" || chord == "Shift+Home" || chord == "Shift+End"
                || chord == "Ctrl+Home" || chord == "Ctrl+End" || chord == "Ctrl+Shift+Home"
                || chord == "Ctrl+Shift+End") {
                    let end = chord == "End" || chord == "Shift+End" || chord == "Ctrl+End"
                    || chord == "Ctrl+Shift+End";
                    root.step-end(end, e.modifiers.shift);
                    root.grid-scroll-to(end ? root.grid-max : 0px);
                    return accept;
                }
                if (chord == "+" || chord == "=" || chord == "Ctrl++" || chord == "Ctrl+=") {
                    root.grid-zoom(1);
                    return accept;
                }
                if (chord == "-" || chord == "_" || chord == "Ctrl+-" || chord == "Ctrl+_") {
                    root.grid-zoom(-1);
                    return accept;
                }
            }
            // Delete opens the delete sheet over the selection, in the
            // grid, culling and the loupe: only the sheet, whose
            // confirmation is the delete. A text field with the focus
            // has the key first. On a Mac the key marked delete sends Backspace,
            // so Backspace there too; elsewhere the table binds no
            // Backspace and its chord is empty.
            if ((chord == "Delete" || chord == "Backspace") && !e.repeat && !root.sheet-open()) {
                root.delete-asked("selection");
                return accept;
            }
            // Over the grid, F7 and Tab put the left pane away and
            // bring it back: the pane is the one of the three the
            // grid leaves showing.
            if ((chord == "Tab" || chord == "F7") && root.grid-open && !root.sheet-open()) {
                root.left-hidden = !root.left-hidden;
                return accept;
            }
            // Tab as Lightroom has it. Nothing else here binds it, and
            // a LineEdit with the focus has it first, so typing in the
            // filter or a name never reaches this. Over the grid it is
            // the pane's alone (above).
            if (chord == "Tab" && !root.sheet-open() && !root.grid-open) {
                // Any one showing: all away. All away: all back.
                let hide = !root.all-hidden();
                root.left-hidden = hide;
                root.right-hidden = hide;
                root.strip-hidden = hide;
                return accept;
            }
            // One at a time, as Lightroom has F7 and F8 for its side
            // panels. F6 for the strip, where Lightroom has it. The
            // same guards as Tab's.
            if ((chord == "F6" || chord == "F7" || chord == "F8") && !root.sheet-open() && !root.grid-open) {
                if (chord == "F6") { root.strip-hidden = !root.strip-hidden; }
                if (chord == "F7") { root.left-hidden = !root.left-hidden; }
                if (chord == "F8") { root.right-hidden = !root.right-hidden; }
                return accept;
            }
            if (chord == "G" && !root.sheet-open()) {
                root.grid-open = !root.grid-open;
                return accept;
            }
            // Stacks, as Lightroom has them: Ctrl+G the selection into
            // a stack, Ctrl+Shift+G out of it.
            if ((chord == "Ctrl+G" || chord == "Ctrl+Shift+G") && !root.sheet-open()) {
                if (chord == "Ctrl+Shift+G") { root.stack-unmake(); } else { root.stack-make(); }
                return accept;
            }
            // S opens or closes the stack, Shift+S puts the frame on its
            // top: in the grid, as Lightroom's Library has them.
            // Elsewhere S is the proof, below; in culling a stack opens
            // and closes by its badge on the strip.
            if ((chord == "S" || chord == "Shift+S") && root.grid-open && !root.lightbox
                && !root.sheet-open()) {
                if (chord == "Shift+S") { root.stack-top(false); } else { root.stack-toggle(); }
                return accept;
            }
            // B, as Lightroom has it for its quick collection: the
            // selection into the collection open, or the last one added
            // to, or out of it when it is all in it already.
            if (chord == "B" && !root.sheet-open()) {
                root.collection-key();
                return accept;
            }
            // Culling: Return or Escape leaves it on the frame the
            // selection is on and develops that; V cycles the compare
            // view; C is the way in and out.
            if (root.culling && !root.sheet-open() && (chord == "Return" || chord == "Esc")) {
                root.cull-leave();
                return accept;
            }
            // An import stops on Escape only when nothing above took
            // it: leaving the grid, leaving culling or letting go of a
            // set is what Escape is for there, and an import is long
            // enough that stopping it by the way would cost a card's
            // worth of waiting. Its Stop button always stops it.
            if (chord == "Esc" && root.import-running && !root.import-stopping && !root.sheet-open()) {
                root.import-stop();
                return accept;
            }
            if (root.culling && !root.sheet-open() && chord == "V") {
                // Three up is Compare versions' alone; V goes on from it
                // to four, as from two.
                root.compare-changed(root.compare == 1 ? 2 : root.compare == 2 || root.compare == 3 ? 4 : 1);
                return accept;
            }
            if (chord == "C" && !root.sheet-open()) {
                root.cull-toggled();
                return accept;
            }
            // Undo and redo move the frame under the sheet, and a sheet
            // reads that frame: a sync would carry the undone state.
            // Under a sheet they are nobody's.
            if (chord == "Ctrl+Z" || chord == "Ctrl+Shift+Z") {
                if (!root.sheet-open()) {
                    if (chord == "Ctrl+Shift+Z") { root.redo(); } else { root.undo(); }
                }
                return accept;
            }
            if (chord == "Ctrl+Y") {
                if (!root.sheet-open()) { root.redo(); }
                return accept;
            }
            // Copy and paste the settings: Ctrl+C and Ctrl+V (Command
            // on a Mac, which Slint calls control). Only here, where
            // the keys are nobody's: a text field with the focus has
            // its own Ctrl+C and Ctrl+V first. Under a sheet, nothing,
            // as undo: the sync sheet reads the frame behind it.
            if (chord == "Ctrl+C") {
                if (!root.sheet-open()) { root.copy-asked(); }
                return accept;
            }
            // Ctrl+', Lightroom's key: a new version of the frame on
            // screen, its edit copied.
            if (chord == "Ctrl+'") {
                if (!root.sheet-open()) { root.version-new-asked(false, false); }
                return accept;
            }
            if (chord == "Ctrl+V") {
                if (!root.sheet-open()) { root.paste-asked(); }
                return accept;
            }
            // Import: Lightroom's Ctrl+Shift+I. Needs no frame open,
            // since an empty editor is where a first card goes.
            if (chord == "Ctrl+Shift+I") {
                if (!root.sheet-open() && !root.import-running) { root.import-asked(); }
                return accept;
            }
            if (chord == "Ctrl+Shift+E") {
                root.export-asked();
                return accept;
            }
            // Ctrl+, is where a desktop application keeps its
            // settings; nothing else here binds a comma.
            if (chord == "Ctrl+," && !root.sheet-open()) {
                root.settings-asked();
                return accept;
            }
            if (chord == "Ctrl+O") {
                root.open-folder();
                return accept;
            }
            // Sync settings: Lightroom's Ctrl+Shift+S. The bare S is
            // the proof, and Ctrl+S nothing yet, so this one reads
            // the same to a hand from there.
            if (chord == "Ctrl+Shift+S") {
                // Not over a tool in hand either: the sheet would hide
                // the drag or the pick half done.
                if (root.set-count > 1 && !root.sheet-open() && !root.tool-in-hand()) { root.sync-open-asked(); }
                return accept;
            }
            // The filter's text field, two ways in. Ctrl+F is what
            // every application means by find and nothing here bound
            // it; / is the one-key reach for a hand already on the
            // arrows and the rating keys, and is what less, vim and
            // a browser's quick find mean by search. Neither is
            // typed into anything, since the field itself has the
            // keys once it has the focus, and Esc there clears it
            // and gives them back.
            if (chord == "Ctrl+F" && !root.sheet-open()) {
                root.filter-asked();
                return accept;
            }
            if (chord == "/" && !root.sheet-open()) {
                root.filter-asked();
                return accept;
            }
            // The keys sheet, made from the table this handler reads:
            // ? where an application keeps its shortcuts, Shift and /
            // on most boards.
            if (chord == "?" && !root.sheet-open()) {
                root.keys-open = true;
                return accept;
            }
            // The culling keys: stars, the flag, the color label. They
            // belong to the browser, and the strip is the browser in
            // the loupe, so they work in both views. Nothing here is
            // modified, so a Ctrl or an Alt shortcut is not eaten.
            // A held key is one press: a repeat has nothing to add
            // to a rating, flickers a label, and with move-on would
            // rate a run of frames.
            if (!e.repeat && !root.sheet-open()
                && (chord == "0" || chord == "1" || chord == "2" || chord == "3" || chord == "4"
                    || chord == "5" || chord == "6" || chord == "7" || chord == "8" || chord == "9"
                    || chord == "P" || chord == "X" || chord == "U"
                    || chord == "Shift+P" || chord == "Shift+X" || chord == "Shift+U")
                && root.meta-key(e.text)) {
                return accept;
            }
            // The frame's own turn, a quarter left and a quarter
            // right. Unmodified, as the culling keys are: nothing
            // else in the window binds a bracket, so Lightroom's
            // Ctrl+[ and Ctrl+] are not needed to keep out of the
            // way, and a hand on the arrows reaches these.
            if (!root.sheet-open() && (chord == "[" || chord == "]")) {
                root.frame-turned(chord == "[" ? -1 : 1);
                return accept;
            }
            // Everything below acts on the frame behind a sheet, and a
            // sheet reads that frame: the sync sheet's words and its
            // source would go stale under an arrow. Under a sheet they
            // do nothing.
            if (root.sheet-open()) { return reject; }
            if (chord == "Left" || chord == "Shift+Left") { root.step(-1, e.modifiers.shift); return accept; }
            if (chord == "Right" || chord == "Shift+Right") { root.step(1, e.modifiers.shift); return accept; }
            // The strip's ends, as the grid's above.
            if (chord == "Home" || chord == "End" || chord == "Shift+Home" || chord == "Shift+End"
                || chord == "Ctrl+Home" || chord == "Ctrl+End" || chord == "Ctrl+Shift+Home"
                || chord == "Ctrl+Shift+End") {
                let end = chord == "End" || chord == "Shift+End" || chord == "Ctrl+End"
                    || chord == "Ctrl+Shift+End";
                root.step-end(end, e.modifiers.shift);
                strip.content-x = end ? min(0px, strip.width - strip.content-width) : 0px;
                return accept;
            }
            if (chord == "Space" && !root.grid-open) { root.zoom-key(1); return accept; }
            if (chord == "Z" && !root.grid-open) { root.zoom-key(3); return accept; }
            if (chord == "S" && !root.grid-open) {
                root.proofing = !root.proofing;
                root.proof-changed();
                return accept;
            }
            if (chord == "J" && !root.grid-open) {
                // Both on, unless either is: then both off.
                let on = !(root.warn-shadows || root.warn-highlights);
                root.warn-shadows = on;
                root.warn-highlights = on;
                root.warn-changed();
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        HorizontalLayout {
            // The left pane's room: the pane itself is drawn over it,
            // after the grid (below), so that the grid, which covers
            // the rest of the window, leaves it showing.
            if !root.left-hidden: Rectangle { width: root.left-w; }
            // Viewport. Everything drawn over the picture — a mask's
            // outline and handles, the brush under the pointer, the
            // crop's shade — is placed in view pixels off a geometry
            // that is free to run past the edge: a gradient's line is
            // deliberately longer than any window, and a handle sits
            // wherever the shape does, zoomed and panned. So the
            // viewport clips, or that work is drawn over the left bar
            // and the filmstrip and takes their clicks besides.
            view := Viewport {
                typing: root.snapshot-editing >= 0;
                zoom(a, b, c) => { root.zoom(a, b, c); }
                pan(a, b) => { root.pan(a, b); }
                wheel-pan(a, b) => { root.wheel-pan(a, b); }
                toggle-zoom(a, b) => { root.toggle-zoom(a, b); }
                placeholder: root.placeholder;
                compare-tiles: root.compare-tiles;
                culling: root.culling;
                frame-rating: root.frame-rating;
                frame-flag: root.frame-flag;
                frame-label: root.frame-label;
                meta-stars: root.meta-stars;
                notice: root.notice;
                notice-on: root.notice-on;
                crop-mode <=> root.crop-mode;
                level-mode <=> root.level-mode;
                guide-mode <=> root.guide-mode;
                panel-tab <=> root.panel-tab;
                placing <=> root.placing;
                brush-size <=> root.brush-size;
                brush-feather <=> root.brush-feather;
                brush-op <=> root.brush-op;
                brush-scale <=> root.brush-scale;
                picking <=> root.picking;
                pick-pressed(a, b) => { root.pick-pressed(a, b); }
                pick-dragged(a, b) => { root.pick-dragged(a, b); }
                pick-released => { root.pick-released(); }
                place-pressed(a, b, c) => { root.place-pressed(a, b, c); }
                place-dragged(a, b) => { root.place-dragged(a, b); }
                place-released => { root.place-released(); }
                mask-kind <=> root.mask-kind;
                mask-handles <=> root.mask-handles;
                mask-boxes <=> root.mask-boxes;
                mask-picks <=> root.mask-picks;
                person-boxes <=> root.person-boxes;
                all-people => { root.all-people(); }
                mask-angle <=> root.mask-angle;
                mask-rx <=> root.mask-rx;
                mask-ry <=> root.mask-ry;
                mask-feather-scale <=> root.mask-feather-scale;
                mask-grabbed(a) => { root.mask-grabbed(a); }
                mask-dragged(a, b, c, d) => { root.mask-dragged(a, b, c, d); }
                mask-dropped => { root.mask-dropped(); }
                mask-body-at(a, b, c) => { return root.mask-body-at(a, b, c); }
                crop-left: root.crop-left;
                crop-top: root.crop-top;
                crop-width: root.crop-width;
                crop-height: root.crop-height;
                crop-pressed(a) => { root.crop-pressed(a); }
                crop-dragged(a, b, c) => { root.crop-dragged(a, b, c); }
                crop-released => { root.crop-released(); }
                crop-draw-pressed(a, b) => { root.crop-draw-pressed(a, b); }
                crop-draw-dragged(a, b) => { root.crop-draw-dragged(a, b); }
                crop-draw-released => { root.crop-draw-released(); }
                crop-draw-armed <=> root.crop-draw-armed;
                level-end(a, b, c, d) => { root.level-end(a, b, c, d); }
                guide-stroke(a, b, c, d) => { root.guide-stroke(a, b, c, d); }
                guide-kept: root.guide-kept;
                status: root.status;
                sync-note: root.sync-note;
                sync-retry => { root.sync-retry(); }
                placeholder-status: root.placeholder-status;
                canvas-choice <=> root.canvas-choice;
                canvas-colors: root.canvas-colors;
                busy: root.busy || root.export-running || root.import-running;
                retouch-mode <=> root.retouch-mode;
                patch-size <=> root.patch-size;
                patch-feather <=> root.patch-feather;
                patch <=> root.patch;
                patch-handles <=> root.patch-handles;
                patch-outline: root.patch-outline;
                patch-feather-outline: root.patch-feather-outline;
                patch-changed(a) => { root.patch-changed(a); }
                patch-edited => { root.patch-edited(); }
                patch-grabbed(a) => { root.patch-grabbed(a); }
                patch-dragged(a, b, c) => { root.patch-dragged(a, b, c); }
                patch-dropped => { root.patch-dropped(); }
                // Not while the frame menu is up: the keys coming back
                // are how the window knows it closed, and a pointer
                // passing over the picture must not take them early.
                focus-keys => { if (!root.menu-shown()) { keys.focus(); } }
                plate-hidden: root.all-hidden();
                ctrl-click-menu: root.ctrl-click-menu;
                frame-menu(x, y) => { root.frame-menu-at(-1, x, y); }
                menu-shown => { return root.menu-shown(); }
            }

            // Panel.
            // Put away by F8 or Tab, as the left pane is.
            if !root.right-hidden: Rectangle {
                width: root.right-w;
                background: Theme.surface;
                Rectangle { x: 0; width: 1px; height: 100%; background: Theme.border; }
                // The sections scroll; the view and export buttons stay
                // put under them, so a long tab never hides them.
                VerticalLayout {
                // The file, what it was shot at and the scopes stay
                // at the top while the sections scroll under them, so
                // the histogram is in sight of whatever slider moves it.
                head := PanelHead {
                    culling <=> root.culling;
                    file-name: root.file-name;
                    file-companion: root.file-companion;
                    shot-camera: root.shot-camera;
                    shot-exposure: root.shot-exposure;
                    shot-size: root.shot-size;
                    scope-picture: root.scope-picture;
                    scopes: root.scopes;
                    scope <=> root.scope;
                    scope-changed(a) => { root.scope-changed(a); }
                    scope-selection <=> root.scope-selection;
                    scope-mask-active: root.scope-mask-active;
                    scope-selection-changed => { root.scope-selection-changed(); }
                    clip-shadows-lit: root.clip-shadows-lit;
                    clip-shadows-mark: root.clip-shadows-mark;
                    clip-highlights-lit: root.clip-highlights-lit;
                    clip-highlights-mark: root.clip-highlights-mark;
                    warn-shadows <=> root.warn-shadows;
                    warn-highlights <=> root.warn-highlights;
                    warn-changed => { root.warn-changed(); }
                    can-undo: root.can-undo;
                    can-redo: root.can-redo;
                    undo => { root.undo(); }
                    redo => { root.redo(); }
                    set-count: root.set-count;
                    sync-asked => { root.sync-open-asked(); }
                }
                // The panel in the order a photo is developed; the
                // masks and the retouch on tabs of their own. The bar
                // stays put above the sections, so it is always within
                // reach however far a tab has scrolled.
                tabs := VerticalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    padding-top: Theme.space-2;
                    Segmented {
                        options: ["Develop", "Crop", "Masks", "Retouch"];
                        current <=> root.panel-tab;
                        selected(t) => {
                            // Away from Crop the frame is shown whole again.
                            if (t != "Crop" && root.crop-mode) {
                                root.crop-mode = false;
                                root.level-mode = false;
                                root.guide-mode = "";
                                root.guide-dropped();
                                root.crop-toggled();
                            }
                            root.tab-changed(t);
                        }
                    }
                }
                // The Masks tab's list of what the panel edits, pinned
                // as the bar is: whatever slider is in hand, Global or
                // another mask is one click away. The sections scroll
                // under it, and the scroll counts from its foot, so
                // the list's own height never moves what they show.
                if root.panel-tab == "Masks": VerticalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    padding-top: Theme.space-2;
                    AdjustmentsList {
                        // What the panel has under its head (the
                        // scope, whose height is the scope's), the tab
                        // bar and over the footer, none of which reads
                        // the list.
                        room: root.height - root.strip-h - head.preferred-height - tabs.preferred-height - panel-foot.height;
                        adjustment-names <=> root.adjustment-names;
                        target <=> root.target;
                        adjustment-on <=> root.adjustment-on;
                        collapsed-adjustments <=> root.collapsed-adjustments;
                        target-changed(a) => { root.target-changed(a); }
                        adjustment-toggled(a) => { root.adjustment-toggled(a); }
                        // A new mask's name and shapes are in the
                        // first section, so the sections go back to
                        // their top for it.
                        new-mask => { root.panel-scroll = 0px; root.new-mask(); }
                        delete-adjustment => { root.delete-adjustment(); }
                    }
                }
                // Named so the tests find the view's own edges.
                panel-view := ScrollView {
                    content-y <=> root.panel-scroll;
                    // Under a tall scope in a short window the pinned
                    // list, down to its one row, can still want more
                    // than the panel has: there the sections' view
                    // gives up the rest of its room (std's own floor
                    // is 50 px) before the footer is pushed under the
                    // strip.
                    min-height: root.panel-tab == "Masks" ? 0px : 50px;
                    panel-sections := VerticalLayout {
                        alignment: start;
                        padding: Theme.space-4;
                        padding-top: Theme.space-2;
                        spacing: Theme.space-2;
                        // Culling: what the mode is, the browser's
                        // filter, the compare view, and the two ways
                        // out of it, one of them for the rejects.
                        if root.panel-tab == "Cull": CullSection {
                            frame-turned(a) => { root.frame-turned(a); }
                            grid-open <=> root.grid-open;
                            cull-leave => { root.cull-leave(); }
                            compare-text <=> root.compare-text;
                            compare-changed(a) => { root.compare-changed(a); }
                            move-on <=> root.cull-move-on;
                            move-on-changed => { root.cull-move-on-changed(); }
                            filter-stars <=> root.filter-stars;
                            filter-flags <=> root.filter-flags;
                            filter-labels <=> root.filter-labels;
                            filter-exact <=> root.filter-exact;
                            filter-text <=> root.filter-text;
                            filter-shown <=> root.filter-shown;
                            filter-total <=> root.filter-total;
                            filter-on <=> root.filter-on;
                            filter-focus <=> root.filter-focus;
                            filter-facets: root.filter-facets;
