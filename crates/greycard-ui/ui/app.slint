    // when the file said nothing.
    in property <string> shot-camera;
    in property <string> shot-exposure;
    // "6000 \u{d7} 4000 \u{b7} 24 MP": the developed picture's size,
    // from the develop rather than the file, so a picture that is
    // not a raw reads the same way.
    in property <string> shot-size;
    // The scope over the panel: its picture, which one is shown and
    // the ones on offer.
    // The navigator: the whole frame as shown, and the part of it the
    // view has, as fractions, when that is less than all.
    in property <image> navigator;
    in property <bool> nav-partial;
    in property <float> nav-left;
    in property <float> nav-top;
    in property <float> nav-width;
    in property <float> nav-height;
    callback navigate(float, float);
    in property <image> scope-picture;
    in property <[string]> scopes;
    in-out property <string> scope: "RGB";
    callback scope-changed(string);
    // The clipping marks at the histogram's corners: lit in the
    // color of the channels that clip, and whether each end's
    // warning is painted over the picture. J toggles both.
    in property <bool> clip-shadows-lit;
    in property <color> clip-shadows-mark;
    in property <bool> clip-highlights-lit;
    in property <color> clip-highlights-mark;
    in-out property <bool> warn-shadows;
    in-out property <bool> warn-highlights;
    callback warn-changed();
    // The soft proof: on or off (S), its profile (a space's name, or
    // "File" with the path), the intent, and the gamut warning.
    in-out property <bool> proofing;
    in-out property <string> proof-profile: "sRGB";
    in-out property <string> proof-file;
    in-out property <string> proof-intent: "Perceptual";
    in-out property <bool> gamut-warning: true;
    callback proof-changed();
    callback choose-proof-file();
    // The monitor's profile: "System" for colord's, of the monitor
    // named (the models colord knows are listed), a standard's name,
    // or "File" with the path; and a line on what the table does.
    in-out property <string> display-profile: "System";
    in-out property <string> display-monitor;
    in-out property <string> display-file;
    in property <[string]> monitors;
    in property <string> display-note;
    callback display-changed();
    callback choose-display-file();
    // The viewport's surround: black, or one of three greys, painted
    // by the Rectangle behind the picture and by the shader outside
