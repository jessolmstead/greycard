                            sharpen-measured-threshold: root.sharpen-measured-threshold;
                            view-changed => { root.view-changed(); }
                            develop-changed => { root.develop-changed(); }
                        }
                        if root.panel-tab == "Develop": VignetteSection {
                            vignette-enabled <=> root.vignette-enabled;
                            collapsed-vignette <=> root.collapsed-vignette;
                            vignette-amount <=> root.vignette-amount;
                            vignette-midpoint <=> root.vignette-midpoint;
                            vignette-feather <=> root.vignette-feather;
                            vignette-roundness <=> root.vignette-roundness;
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": GrainSection {
                            grain-enabled <=> root.grain-enabled;
                            collapsed-grain <=> root.collapsed-grain;
                            grain-amount <=> root.grain-amount;
                            grain-size <=> root.grain-size;
                            grain-kind <=> root.grain-kind;
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": ProofSection {
                            collapsed-proof <=> root.collapsed-proof;
                            proofing <=> root.proofing;
                            proof-profile <=> root.proof-profile;
                            proof-file <=> root.proof-file;
                            proof-intent <=> root.proof-intent;
                            gamut-warning <=> root.gamut-warning;
                            proof-changed => { root.proof-changed(); }
                            choose-proof-file => { root.choose-proof-file(); }
                        }
                        if root.panel-tab == "Develop": MonitorSection {
                            collapsed-monitor <=> root.collapsed-monitor;
                            display-profile <=> root.display-profile;
                            display-monitor <=> root.display-monitor;
                            display-file <=> root.display-file;
                            monitors: root.monitors;
                            display-note: root.display-note;
                            display-changed => { root.display-changed(); }
                            choose-display-file => { root.choose-display-file(); }
                            canvas-choice <=> root.canvas-choice;
                            canvas-colors: root.canvas-colors;
                            canvas-changed => { root.canvas-changed(); }
                        }
                        // The Crop tab in three: what is kept, which way
                        // up it is, and the keystone. One section held
                        // them all until the guide's buttons arrived and
                        // the perspective's own heading began to read as
                        // a second section inside the first.
                        if root.panel-tab == "Crop": CropSection {
                            crop-mode <=> root.crop-mode;
                            level-mode <=> root.level-mode;
                            guide-mode <=> root.guide-mode;
                            collapsed-crop <=> root.collapsed-crop;
                            aspect-name <=> root.aspect-name;
                            aspect-custom <=> root.aspect-custom;
                            portrait <=> root.portrait;
                            portrait-shown: root.portrait-shown;
                            portrait-live: root.portrait-live;
                            crop-draw-armed <=> root.crop-draw-armed;
                            crop-toggled => { root.crop-toggled(); }
                            geometry-changed => { root.geometry-changed(); }
                            guide-dropped => { root.guide-dropped(); }
                        }
                        if root.panel-tab == "Crop": RotateSection {
                            frame-turned(a) => { root.frame-turned(a); }
                            crop-mode <=> root.crop-mode;
                            level-mode <=> root.level-mode;
                            guide-mode <=> root.guide-mode;
                            collapsed-rotate <=> root.collapsed-rotate;
                            geo-angle <=> root.geo-angle;
                            geometry-turned(a) => { root.geometry-turned(a); }
                            geometry-flipped(a) => { root.geometry-flipped(a); }
                            crop-toggled => { root.crop-toggled(); }
                            geometry-changed => { root.geometry-changed(); }
                            guide-dropped => { root.guide-dropped(); }
                        }
                        // The keystone: the camera's tilt, up or to the
                        // right positive, for a lens whose focal length
                        // is the frame's half side.
                        if root.panel-tab == "Crop": PerspectiveSection {
                            crop-mode <=> root.crop-mode;
                            level-mode <=> root.level-mode;
                            guide-mode <=> root.guide-mode;
                            collapsed-perspective <=> root.collapsed-perspective;
                            geo-vertical <=> root.geo-vertical;
                            geo-horizontal <=> root.geo-horizontal;
                            crop-toggled => { root.crop-toggled(); }
                            geometry-changed => { root.geometry-changed(); }
                            geometry-reset => { root.geometry-reset(); }
                            guide-dropped => { root.guide-dropped(); }
                        }
                        if root.panel-tab == "Develop": DemosaicSection {
                            collapsed-demosaic <=> root.collapsed-demosaic;
                            raw-input: root.raw-input;
                            source-note: root.source-note;
                            demosaic <=> root.demosaic;
                            demosaics: root.demosaics;
                            menu-hint: root.demosaic-hint;
                            picked(v) => { root.demosaic-picked(v); }
                        }
                        if root.panel-tab == "Retouch": RetouchSection {
                            retouch-enabled <=> root.retouch-enabled;
                            collapsed-retouch <=> root.collapsed-retouch;
                            develop-changed => { root.develop-changed(); }
                            retouch-mode <=> root.retouch-mode;
                            patch-size <=> root.patch-size;
                            patch-feather <=> root.patch-feather;
                            patch-opacity <=> root.patch-opacity;
                            patch-names <=> root.patch-names;
                            patch <=> root.patch;
                            retouch-toggled(a) => { root.retouch-toggled(a); }
                            patch-changed(a) => { root.patch-changed(a); }
                            delete-patch => { root.delete-patch(); }
                            patch-edited => { root.patch-edited(); }
                        }
                    }
                }
                panel-foot := Rectangle {
                    height: Theme.control-height + 2 * Theme.space-3 + 1px;
                    background: Theme.surface;
                    Rectangle { y: 0; height: 1px; width: 100%; background: Theme.border; }
                    HorizontalLayout {
                        padding: Theme.space-3;
                        padding-left: Theme.space-4;
                        padding-right: Theme.space-4;
                        spacing: Theme.space-2;
                        PanelButton {
                            text: "Fit";
                            icon: @image-url("icons/maximize.svg");
                            clicked => { root.reset-view(); }
                        }
                        PanelButton {
                            text: root.export-running ? "Stop export" : "Export...";
                            icon: @image-url("icons/image-down.svg");
                            primary: !root.export-running;
                            enabled: root.export-running || (!root.busy && root.selected >= 0 && !root.culling);
                            clicked => {
                                if (root.export-running) { root.export-stop(); } else { root.export-open = true; }
                            }
                        }
                    }
                }
                }
            }
        }

        // Filmstrip.
        strip := Filmstrip {
            height: root.strip-h;
            visible: !root.strip-hidden;
            thumbs: root.thumbs;
            cells: root.strip-cells;
            selected <=> root.selected;
            frame-clicked(a, b, c) => { root.frame-clicked(a, b, c); }
            frame-menu(r, x, y) => { root.frame-menu-at(r, x, y); }
            stack-clicked(r) => { root.stack-badge(r); }
            menu-shown => { return root.menu-shown(); }
            ctrl-click-menu: root.ctrl-click-menu;
            menu-at: root.grid-open ? -1 : root.menu-at;
            meta-stars: root.meta-stars;
            strip-item: root.strip-item;
            strip-pitch: root.strip-pitch;
            strip-pad: root.strip-pad;
            strip-relay => { root.strip-relay(); }
            strip-report => { root.strip-report(); }
            bar-length(a, b) => { return root.bar-length(a, b); }
            bar-offset(a, b, c) => { return root.bar-offset(a, b, c); }
            bar-drag(a, b, c, d) => { return root.bar-drag(a, b, c, d); }
            bar-awake <=> root.strip-bar-awake;
            focus-keys => { keys.focus(); }
        }
    }

    // The arrows on the viewport's edges, one for each thing that
    // puts away: the left pane, the develop panel and the strip. Over
    // the viewport, not beside it, so they take no width from the
    // picture; under the grid and the sheets, which are declared
    // after. With all three away they go quiet (see EdgeArrow).
    property <length> view-mid: (root.height - root.strip-h) / 2;
    EdgeArrow {
        x: root.width - root.right-w - self.width;
        y: root.view-mid - self.height / 2;
        width: 16px;
        height: 40px;
        quiet: root.all-hidden();
        label: "Right panel";
        words: root.right-hidden ? "Show panel" : "Hide panel";
        icon: root.right-hidden ? @image-url("icons/chevron-left.svg") : @image-url("icons/chevron-right.svg");
        clicked => { root.right-hidden = !root.right-hidden; keys.focus(); }
    }
    EdgeArrow {
        x: root.left-w + (root.width - root.left-w - root.right-w - self.width) / 2;
        y: root.height - root.strip-h - self.height;
        width: 40px;
        height: 16px;
        quiet: root.all-hidden();
        label: "Strip";
        words: root.strip-hidden ? "Show strip" : "Hide strip";
        icon: root.strip-hidden ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
        clicked => { root.strip-hidden = !root.strip-hidden; keys.focus(); }
    }

    // A view's load in the loupe: over the viewport's bottom, above
    // the strip it will fill and clear of the status plate, whose own
    // bar is a develop's. Under the grid and the sheets; it takes no
    // clicks.
    if root.loading-shown && !root.grid-open: LoadingCard {
        width: 280px;
        x: root.left-w + (root.width - root.left-w - root.right-w - self.width) / 2;
        // Above the plate's row (24px on a space-3 margin), so a long
        // status line on a narrow window runs under neither. In culling
        // also above the notice (40px, 56px up; viewport.slint), which
        // says what the key just pressed did and must not be covered;
        // held there for the whole of culling so the card does not jump
        // as the notice comes and goes.
        y: root.height - root.strip-h - self.height
            - (root.culling ? 56px + 40px + Theme.space-2 : 24px + Theme.space-3 + Theme.space-4);
        fraction: root.loading-fraction;
        line: root.loading-line;
    }

    // The grid, over the window: the folder as a contact sheet, in
    // place of the viewport, the strip and both panels. It is drawn
    // over them rather than swapped in for them so the viewport's
    // texture, and everything named inside it, stays where the rest
    // of the window can reach it.
    if root.grid-open: GridSheet {
        x: root.left-w;
        y: 0;
        width: root.width - root.left-w;
        height: root.height;
        thumbs: root.thumbs;
        cells: root.grid-cells;
        selected <=> root.selected;
        frame-clicked(a, b, c) => { root.frame-clicked(a, b, c); }
        frame-menu(r, x, y) => { root.frame-menu-at(r, x, y); }
        stack-clicked(r) => { root.stack-badge(r); }
        menu-shown => { return root.menu-shown(); }
        side-step(by) => { root.grid-step(by, 0, root.grid-cols, false); }
        ctrl-click-menu: root.ctrl-click-menu;
        menu-at: root.menu-at;
        set-count: root.set-count;
        meta-stars: root.meta-stars;
        grid-open <=> root.grid-open;
        grid-cell: root.tile-cell;
        lightbox: root.lightbox;
        lightbox-asked => { root.lightbox-enter(); }
        grid-pad: root.grid-pad;
        grid-label: root.grid-label;
        grid-w <=> root.grid-w;
        grid-h <=> root.grid-h;
        grid-scroll: root.grid-scroll;
        grid-gap: root.grid-gap;
        grid-row: root.grid-row;
        grid-slack(a, b, c) => { return root.grid-slack(a, b, c); }
        grid-cols: root.grid-cols;
        grid-max: root.grid-max;
        grid-top: root.grid-top;
        // No folder tiles in the lightbox: frames alone.
        tiles: root.lightbox ? [] : root.grid-tiles;
        tile-picked(i) => { root.grid-tile-picked(i); }
        tile-reveal(i) => { root.grid-tile-reveal(i); }
        menu-done => { root.menu-done(); }
        grid-wheel(a, b) => { root.grid-wheel(a, b); }
        grid-relay => { root.grid-relay(); }
        grid-scroll-to(a) => { root.grid-scroll-to(a); }
        bar-length(a, b) => { return root.bar-length(a, b); }
        bar-offset(a, b, c) => { return root.bar-offset(a, b, c); }
        bar-drag(a, b, c, d) => { return root.bar-drag(a, b, c, d); }
        bar-awake <=> root.grid-bar-awake;
        culling <=> root.culling;
        cull-toggled => { root.cull-toggled(); }
        filter-stars <=> root.filter-stars;
        filter-flags <=> root.filter-flags;
        filter-labels <=> root.filter-labels;
        filter-exact <=> root.filter-exact;
        filter-text <=> root.filter-text;
        filter-shown <=> root.filter-shown;
        filter-total <=> root.filter-total;
        filter-on <=> root.filter-on;
        filter-focus <=> root.filter-focus;
        filter-facets-long: root.filter-facets-long;
        filter-facets-short: root.filter-facets-short;
        filter-facet-note: root.filter-facet-note;
        filter-facet-toggled(a, b) => { root.filter-facet-toggled(a, b); }
        filter-star-picked(a) => { root.filter-star-picked(a); }
        filter-flag-toggled(a) => { root.filter-flag-toggled(a); }
        filter-label-toggled(a) => { root.filter-label-toggled(a); }
        filter-exact-toggled => { root.filter-exact-toggled(); }
        filter-text-edited(a) => { root.filter-text-edited(a); }
        filter-save-smart => { root.filter-save-smart(); }
        // No Save... over a collection: its list is no place a filter
        // can be kept over.
        filter-can-save: root.collection-open == "";
        reorder: root.collection-reorder;
        frame-moved(a, b) => { root.collection-moved(a, b); }
        filter-cleared => { root.filter-cleared(); }
        sort-menu: root.sort-menu;
        sort-shown <=> root.sort-menu-shown;
        sort-picked(a) => { root.sort-picked(a); }
        sort-turned(a) => { root.sort-turned(a); }
        // Said here only with the pane, which says it under Import,
        // put away.
        import-line: root.left-hidden ? root.import-status : "";
        status-line: root.status;
        sync-note: root.sync-note;
        sync-retry => { root.sync-retry(); }
        focus-keys => { keys.focus(); }
        loading-shown: root.loading-shown;
        loading-fraction: root.loading-fraction;
        loading-line: root.loading-line;
        archive-text: root.archive-header;
        archive-choices: root.archive-header-choices;
        archive-pressed(i) => { root.archive-header-pressed(i); }
        reject-count: root.reject-count;
        rejects-asked => { root.rejects-asked(); }
        back-count: root.back-count;
        back-to: root.back-to;
        move-back => { root.move-back-asked(); }
        delete-asked(w) => { root.delete-asked(w); }
        archive-rejects-choices: root.archive-rejects-choices;
        archive-rejects-asked(i) => { root.archive-rejects-asked(i); }
    }

    // The left pane: the navigator, then the folder open and Recently
    // opened and the open root's folders, then the presets, the
    // snapshots and the history, as an editor keeps them on its left;
    // with the grid up, what is browsed
    // in its place: Import, the roots and the open root's folders. At
    // its foot, the way to report a problem, found where it is looked
    // for and nowhere near the work. Drawn over its room in the layout
    // and over the grid, which covers everything else. Put away by F7
    // or Tab: gone altogether. At zero width its wrapping texts would
    // grow tall.
    if !root.left-hidden: Rectangle {
        x: 0;
        y: 0;
        width: root.left-w;
        height: root.grid-open ? root.height : root.height - root.strip-h;
        background: Theme.surface;
        // Over the grid the pane lies over the strip's left end, which
        // the grid leaves drawn under it: a press or a wheel in the
        // pane's gaps must not reach a cell there. First, so the
        // sections after it have their events before it.
        TouchArea {
            scroll-event(e) => { return accept; }
        }
        Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.border; }
        VerticalLayout {
        // Library and Develop: the grid and the one frame, as G has
        // them, the one on screen pressed. At the pane's top in both,
        // above what scrolls, so a hand from Lightroom looking for its
        // modules finds the way to the other from either.
        HorizontalLayout {
            padding: Theme.space-4;
            padding-top: Theme.space-3;
            padding-bottom: 0;
            spacing: Theme.space-2;
            PanelButton {
                text: "Library";
                icon: @image-url("icons/library.svg");
                primary: root.grid-open;
                accessible-role: button;
                accessible-label: "Library view";
                accessible-checked: root.grid-open;
                // Out of the lightbox first, to the grid, as G and L
                // leave it.
                clicked => {
                    keys.focus();
                    root.lightbox-leave();
                    root.grid-open = true;
                }
            }
            PanelButton {
                text: "Develop";
                icon: @image-url("icons/sliders-horizontal.svg");
                primary: !root.grid-open;
                accessible-role: button;
                accessible-label: "Develop view";
                accessible-checked: !root.grid-open;
                // Out of the lightbox and its loupe both, to the frame.
                clicked => {
                    keys.focus();
                    root.lightbox-leave();
                    root.grid-open = false;
                }
            }
        }
        // The sections scroll; Settings and Report stay put
        // beneath them, as the develop panel does on the
        // right. Presets, Snapshots and History each cap
        // their own list, and the navigator is just one
        // thumbnail, held to the pane's width — nothing here
        // is unbounded on its own, but their sum, on a small
        // or high-DPI screen, still could be. A ScrollView
        // never passes its content's size up to its parent,
        // so nothing here can raise the window's minimum
        // height past the screen's (see the note above about
        // Windows leaving fullscreen).
        ScrollView {
            VerticalLayout {
                alignment: start;
                padding: Theme.space-4;
                padding-top: Theme.space-2;
                spacing: Theme.space-2;
                // The frame's, and so the loupe's alone: first, so
                // it keeps the pane's top left corner whatever the
                // folder sections below it hold.
                if !root.grid-open: NavigatorSection {
                    zoom-text: root.zoom-text;
                    collapsed-navigator <=> root.collapsed-navigator;
                    navigator: root.navigator;
                    nav-partial: root.nav-partial;
                    nav-left: root.nav-left;
                    nav-top: root.nav-top;
                    nav-width: root.nav-width;
                    nav-height: root.nav-height;
                    navigate(a, b) => { root.navigate(a, b); }
                    focus-keys => { keys.focus(); }
                }
                // The button, and under it the folder it
                // opened, which offers the ones before it.
                VerticalLayout {
                    spacing: 2px;
                    PanelButton {
                        text: "Open folder...";
                        icon: @image-url("icons/folder-open.svg");
                        clicked => { keys.focus(); root.open-folder(); }
                    }
                    if root.open-folder-name != "" || root.open-folder-note != ""
                        || root.recent-folders.length > 0: FolderName {
                        name: root.open-folder-name;
                        root-name: root.open-folder-root;
                        path: root.open-folder-path;
                        note: root.open-folder-note;
                        has-list: root.recent-folders.length > 0;
                        quiet: root.sheet-open();
                        menu(x, y) => { root.recent-menu-at(x, y); }
                        tip(t, x, y) => { root.tip-at(t, x, y); }
                        menu-shown => { return root.menu-shown(); }
                    }
                    // RawTherapee's profiles found beside the folder's
                    // frames, offered once: Import... opens the sheet,
                    // Not now asks no more for this folder.
                    if root.rt-offer != "": VerticalLayout {
                        spacing: 2px;
                        padding-top: 2px;
                        padding-bottom: Theme.space-2;
                        Text {
                            text: root.rt-offer;
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            PanelButton {
                                text: "Import...";
                                horizontal-stretch: 1;
                                clicked => { keys.focus(); root.rt-offer-import(); }
                            }
                            PanelButton {
                                text: "Not now";
                                horizontal-stretch: 1;
                                clicked => { keys.focus(); root.rt-offer-dismissed(); }
                            }
                        }
                    }
                }
                // The other way a folder fills, from a card, and while
                // it runs its progress under it: the grid covers the
                // status plate. Ctrl+Shift+I reaches the same sheet.
                if root.grid-open: VerticalLayout {
                    spacing: 2px;
                    PanelButton {
                        text: root.import-running ? (root.import-stopping ? "Stopping..." : "Stop import") : "Import...";
                        icon: @image-url("icons/camera.svg");
                        enabled: !root.import-stopping;
                        clicked => {
                            keys.focus();
                            if (root.import-running) { root.import-stop(); } else { root.import-asked(); }
                        }
                    }
                    if root.import-status != "": Text {
                        text: root.import-status;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        wrap: word-wrap;
                    }
                    // A Lightroom catalog brought across, the same way:
                    // its progress under it while it writes.
                    PanelButton {
                        text: root.lr-running ? "Importing the catalog..." : "Import a Lightroom catalog...";
                        icon: @image-url("icons/folder-open.svg");
                        enabled: !root.lr-running;
                        clicked => { keys.focus(); root.lr-asked(); }
                    }
                    if root.lr-status != "": Text {
                        text: root.lr-status;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        wrap: word-wrap;
                    }
                }
                // The library's roots, with the grid: a row a root.
                if root.grid-open: RootsSection {
                    roots: root.library-roots;
                    all-on: root.library-all-on;
                    all-count: root.library-all-count;
                    can-add-open: root.library-can-add-open;
                    empty-note: root.library-note;
                    ctrl-click-menu: root.ctrl-click-menu;
                    collapsed-roots <=> root.collapsed-roots;
                    picked(p) => { root.library-root-picked(p); }
                    removed(p) => { root.library-root-removed(p); }
                    add => { root.library-root-add(); }
                    add-open => { root.library-root-add-open(); }
                    rename(p) => { root.library-root-rename(p); }
                    archive-toggled(p) => { root.library-root-archive(p); }
                    focus-keys => { keys.focus(); }
                    menu-done => { root.menu-done(); }
                    menu-shown => { return root.menu-shown(); }
                    quiet: root.sheet-open();
                    tip(t, x, y) => { root.tip-at(t, x, y); }
                }
                // The open root's folders, from the index.
                if root.folder-tree-shown: FoldersSection {
                    rows: root.folder-tree;
                    subfolders <=> root.folder-tree-subfolders;
                    collapsed-folders <=> root.collapsed-folders;
                    picked(p) => { root.folder-tree-picked(p); }
                    folded(p) => { root.folder-tree-folded(p); }
                    subfolders-changed => { root.folder-tree-subfolders-changed(); }
                    focus-keys => { keys.focus(); }
                }
                // The collections, beside the roots and the folders.
                if root.grid-open: CollectionsSection {
                    collections: root.collections;
                    ctrl-click-menu: root.ctrl-click-menu;
                    collapsed-collections <=> root.collapsed-collections;
                    picked(id) => { root.collection-picked(id); }
                    rename(id) => { root.collection-rename(id); }
                    delete(id) => { root.collection-delete(id); }
                    capture-toggled(id) => { root.collection-capture(id); }
                    forget-missing(id) => { root.collection-forget-missing(id); }
                    forgettable(id) => { return root.collection-forgettable(id); }
                    add => { root.collection-new(); }
                    focus-keys => { keys.focus(); }
                    menu-done => { root.menu-done(); }
                    menu-shown => { return root.menu-shown(); }
                }
                // The presets: a click lays one over the edit, the
                // bin removes it, and the edit is saved or a
                // Lightroom preset brought in below the list. Not
                // in culling, as the snapshots and the history.
                if !root.culling && !root.grid-open: PresetsSection {
                    selected <=> root.selected;
                    collapsed-presets <=> root.collapsed-presets;
                    preset-names <=> root.preset-names;
                    confirm-remove <=> root.preset-confirm-remove;
                    preset-applied(a) => { root.preset-applied(a); }
                    preset-deleted(a) => { root.preset-deleted(a); }
                    preset-import => { root.preset-import(); }
                    preset-save-open => { root.preset-save-open(); }
                    set-count: root.set-count;
                    sync-open-asked => { root.sync-open-asked(); }
                }
                // The snapshots: whole states kept by name. A
                // click restores one as a step; a double-click
                // renames it; the bin removes it.
                // Not in culling, where the panel is not the
                // frame's and a step is the way out of the mode.
                if !root.culling && !root.grid-open: SnapshotsSection {
                    selected <=> root.selected;
                    snapshot-names <=> root.snapshot-names;
                    snapshot-editing <=> root.snapshot-editing;
                    snapshot-taken => { root.snapshot-taken(); }
                    snapshot-restored(a) => { root.snapshot-restored(a); }
                    snapshot-hovered(a, b) => { root.snapshot-hovered(a, b); }
                    snapshot-renamed(a, b) => { root.snapshot-renamed(a, b); }
                    snapshot-deleted(a) => { root.snapshot-deleted(a); }
                    collapsed-snapshots <=> root.collapsed-snapshots;
                }
                // The history: every step, newest first, the
                // current one lit and the undone ones muted. A
                // click makes a step current; what lies past it
                // stays until the next change.
                if !root.culling && !root.grid-open: HistorySection {
                    history-rows <=> root.history-rows;
                    hint: root.history-version;
                    history-current <=> root.history-current;
                    history-clicked(a) => { root.history-clicked(a); }
                    history-hovered(a) => { root.history-hovered(a); }
                    collapsed-history <=> root.collapsed-history;
                }
            }
        }
        VerticalLayout {
            padding: Theme.space-4;
            padding-top: Theme.space-2;
            spacing: Theme.space-2;
            // A newer release, when the check found one: the
            // page in the browser, or Not now for this one.
            if root.update-version != "": HorizontalLayout {
                spacing: Theme.space-2;
                PanelButton {
                    text: root.update-version + " is available";
                    icon: @image-url("icons/sparkles.svg");
                    horizontal-stretch: 1;
                    clicked => { root.update-open(); }
                }
                PanelButton {
                    icon: @image-url("icons/x.svg");
                    accessible-role: button;
                    accessible-label: "Not now: do not offer " + root.update-version + " again";
                    words: "Not now";
                    width: Theme.control-height;
                    horizontal-stretch: 0;
                    clicked => { root.update-dismissed(); }
                }
            }
            PanelButton {
                text: "Settings...";
                icon: @image-url("icons/settings.svg");
                clicked => { root.settings-asked(); }
            }
            // Help: the keys sheet, the guide in the browser, and the
            // report, which also has its own button below, where the
            // guide has always said it is.
            PanelButton {
                text: "Help";
                icon: @image-url("icons/circle-help.svg");
                accessible-role: button;
                accessible-label: "Help menu";
                clicked => {
                    keys.focus();
                    help-menu.show({ x: 0, y: self.height });
                }
                property <bool> asked: root.help-menu-shown;
                changed asked => {
                    if (self.asked) {
                        root.help-menu-shown = false;
                        help-menu.show({ x: 0, y: self.height });
                    }
                }
                help-menu := ContextMenuArea {
                    width: 0px;
                    height: 0px;
                    enabled: false;
                    Menu {
                        // The sheet takes the focus itself: no
                        // `menu-done`, whose timer would take it back.
                        MenuItem {
                            title: "Keys (?)";
                            activated => { root.keys-open = true; }
                        }
                        MenuItem {
                            title: "User guide";
                            activated => { root.guide-asked(); root.menu-done(); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: "Report a problem...";
                            activated => { root.report-asked(); root.menu-done(); }
                        }
                    }
                }
            }
            PanelButton {
                text: "Report a problem...";
                icon: @image-url("icons/bug.svg");
                clicked => { root.report-asked(); }
            }
        }
        }
    }

    // The left pane's arrow, over the grid too, at the grid's edge
    // and the window's middle there: the grid keeps the pane, and the
    // arrow is its way back. Quiet only in the loupe with all three
    // away, as the others.
    EdgeArrow {
        x: root.left-w;
        y: root.grid-open ? (root.height - self.height) / 2 : root.view-mid - self.height / 2;
        width: 16px;
        height: 40px;
        quiet: root.all-hidden() && !root.grid-open;
        label: "Left panel";
        words: root.left-hidden ? "Show panel" : "Hide panel";
        icon: root.left-hidden ? @image-url("icons/chevron-right.svg") : @image-url("icons/chevron-left.svg");
        clicked => { root.left-hidden = !root.left-hidden; keys.focus(); }
    }

    // Under every sheet, over everything else: a wheel or a touchpad's
    // swipe that the sheet does not take (its dimmed surround, its
    // header and buttons, a list already at its end) stops here, and
    // never zooms the picture or scrolls a pane or the grid behind it.
    // Each sheet's surround takes the presses already; a TouchArea
    // passes a scroll it has no handler for to whatever is beneath.
    if root.sheet-open(): TouchArea {
        scroll-event(e) => { return accept; }
    }

    // The model sheet: a download offered, with its license, until
    // answered.
    if root.fetch-open: ModelSheet {
        fetch-title <=> root.fetch-title;
        fetch-text <=> root.fetch-text;
        fetch-note <=> root.fetch-note;
        fetch-answered(a) => { root.fetch-answered(a); }
    }

    // The move-rejects sheet: how many and where, until answered.
    // Never a delete, and undone by Move back, which it says.
    if root.rejects-open: RejectsSheet {
        rejects-text: root.rejects-text;
        rejects-answered(a) => {
            root.rejects-answered(a);
            keys.focus();
        }
    }

    // The delete sheet: how many, from where, and to the trash or for
    // good, until answered. The keys go back to the window after.
    if root.delete-open: DeleteSheet {
        delete-title: root.delete-title;
        delete-text: root.delete-text;
        delete-note: root.delete-note;
        delete-trash: root.delete-trash;
        delete-permanent: root.delete-permanent;
        delete-archive: root.delete-archive;
        delete-confirm: root.delete-confirm;
        delete-answered(a) => {
            root.delete-answered(a);
            keys.focus();
        }
    }

    // The remove-a-look sheet: the files, the pictures that name the
    // look, and to the trash or for good. The keys go back to the
    // window after.
    if root.look-remove-open: LookRemoveSheet {
        remove-title: root.look-remove-title;
        remove-files: root.look-remove-files;
        remove-uses: root.look-remove-uses;
        remove-note: root.look-remove-note;
        remove-trash: root.look-remove-trash;
        remove-permanent: root.look-remove-permanent;
        remove-answered(a) => {
            root.look-remove-answered(a);
            keys.focus();
        }
    }

    // The rename-a-look sheet: the new name, what the files become and
    // who names the look. The keys go back to the window after.
    if root.look-rename-open: LookRenameSheet {
        rename-title: root.look-rename-title;
        rename-name <=> root.look-rename-name;
        rename-files: root.look-rename-files;
        rename-refusal: root.look-rename-refusal;
        rename-uses: root.look-rename-uses;
        rename-note: root.look-rename-note;
        rename-ready: root.look-rename-ready;
        rename-warning: root.look-rename-warning;
        rename-working: root.look-rename-working;
        rename-edited => { root.look-rename-edited(); }
        rename-answered(yes) => {
            root.look-rename-answered(yes);
            if (!root.look-rename-open) { keys.focus(); }
        }
    }

    // The overwrite sheet: the files an export would write over, and
    // keep both or overwrite. The keys go back to the window after.
    if root.overwrite-open: OverwriteSheet {
        overwrite-title: root.overwrite-title;
        overwrite-files: root.overwrite-files;
        overwrite-answered(a) => {
            root.overwrite-answered(a);
            keys.focus();
        }
    }

    if root.archive-open: ArchiveSheet {
        title: root.archive-title;
        text: root.archive-text;
        named: root.archive-named;
        dest <=> root.archive-dest;
        dest-note: root.archive-dest-note;
        rejects: root.archive-rejects;
        include-rejects <=> root.archive-include-rejects;
        confirm: root.archive-confirm;
        can-confirm: root.archive-can-confirm;
        answered(yes) => {
            root.archive-answered(yes);
            keys.focus();
        }
        look-again => { root.archive-look-again(); }
    }

    // Remove rejects from an archive: the list, the move (Enter's) and
    // the delete (a click's alone).
    if root.archive-rejects-open: ArchiveRejectsSheet {
        title: root.archive-rejects-title;
        text: root.archive-rejects-text;
        named: root.archive-rejects-named;
        note: root.archive-rejects-note;
        move-text: root.archive-rejects-move;
        trash-text: root.archive-rejects-trash;
        permanent-text: root.archive-rejects-permanent;
        answered(a) => {
            root.archive-rejects-answered(a);
            keys.focus();
        }
    }

    // A backup or a bring-back under way, over the window's foot,
    // whatever is open: its bar and its Cancel.
    if root.archive-running: ArchiveCard {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 48px;
        fraction: root.archive-fraction;
        line: root.archive-line;
        cancel => { root.archive-cancel(); }
    }

    // The camera match sheet: open until closed; while a fit runs it
    // stays, its Close a Stop.
    if root.match-open: MatchSheet {
        match-scope <=> root.match-scope;
        match-scopes: root.match-scopes;
        match-scope-note: root.match-scope-note;
        match-curve-note: root.match-curve-note;
        match-groups: root.match-groups;
        match-summary: root.match-summary;
        match-list-note: root.match-list-note;
        match-can-fit: root.match-can-fit;
        match-fit-label: root.match-fit-label;
        match-fit-note: root.match-fit-note;
        match-group-toggled(i) => { root.match-group-toggled(i); }
        match-replace <=> root.match-replace;
        match-replace-toggled => { root.match-replace-toggled(); }
        match-running: root.match-running;
        match-done: root.match-done;
        match-progress: root.match-progress;
        match-fraction: root.match-fraction;
        match-results: root.match-results;
        match-scope-picked(s) => { root.match-scope-picked(s); }
        match-fit => { root.match-fit(); }
        match-cancel => { root.match-cancel(); }
        match-close => { root.match-close(); }
    }

    // The preset sheet: a name and what the preset carries, until
    // saved or left.
    if root.preset-open: PresetSheet {
        preset-open <=> root.preset-open;
        preset-name <=> root.preset-name;
        preset-rows: root.preset-rows;
        preset-lines: root.preset-lines;
        preset-row-toggled(i) => { root.preset-row-toggled(i); }
        preset-all(on) => { root.preset-all(on); }
        preset-join-chosen(join) => { root.preset-join-chosen(join); }
        preset-saved => { root.preset-saved(); }
    }

    // The preset import's report, once: what came in and what did not.
    if root.preset-report-open: PresetReportSheet {
        report-open <=> root.preset-report-open;
        report-title: root.preset-report-title;
        report-refusals: root.preset-report-refusals;
        report-lines: root.preset-report-lines;
        report-note: root.preset-report-note;
    }

    // The Lightroom catalog import's sheet.
    if root.lr-open: LightroomSheet {
        lr-open <=> root.lr-open;
        lr-step: root.lr-step;
        lr-title: root.lr-title;
        lr-subtitle: root.lr-subtitle;
        lr-note: root.lr-note;
        lr-roots: root.lr-roots;
        lr-set <=> root.lr-set;
        lr-has-creations: root.lr-has-creations;
        lr-creations <=> root.lr-creations;
        lr-already: root.lr-already;
        lr-force <=> root.lr-force;
        lr-lines: root.lr-lines;
        lr-done: root.lr-done;
        lr-busy: root.lr-busy;
        lr-busy-text: root.lr-busy-text;
        lr-ready: root.lr-ready;
        lr-choose-root(i) => { root.lr-choose-root(i); }
        lr-check => { root.lr-check(); }
        lr-back => { root.lr-back(); }
        lr-write => { root.lr-write(); }
    }

    // The RawTherapee profiles' import over the folder open.
    if root.rt-open: RawTherapeeSheet {
        rt-open <=> root.rt-open;
        rt-step: root.rt-step;
        rt-title: root.rt-title;
        rt-subtitle: root.rt-subtitle;
        rt-note: root.rt-note;
        rt-totals: root.rt-totals;
        rt-lines: root.rt-lines;
        rt-held: root.rt-held;
        rt-force <=> root.rt-force;
        rt-busy: root.rt-busy;
        rt-writing: root.rt-writing;
        rt-busy-text: root.rt-busy-text;
        rt-ready: root.rt-ready;
        rt-force-toggled => { root.rt-force-toggled(); }
        rt-write => { root.rt-write(); }
    }

    // The collection sheet: a name for a new collection, a smart one
    // or a renamed one, or whether to delete one.
    if root.collection-sheet-open: CollectionSheet {
        open <=> root.collection-sheet-open;
        title: root.collection-sheet-title;
        note: root.collection-sheet-note;
        asks-name: root.collection-sheet-asks-name;
        verb: root.collection-sheet-verb;
        name <=> root.collection-sheet-name;
        placeholder: root.collection-sheet-placeholder;
        done => { root.collection-sheet-done(); }
    }
    // The root sheet: a root's name, from its row's menu.
    if root.root-sheet-open: RootSheet {
        open <=> root.root-sheet-open;
        path: root.root-sheet-path;
        folder: root.root-sheet-folder;
        name <=> root.root-sheet-name;
        done => { root.root-sheet-done(); }
    }

    // The sync sheet: the preset sheet's twin, over everything, until
    // applied or left.
    if root.sync-open: SyncSheet {
        sync-open <=> root.sync-open;
        sync-text: root.sync-text;
        paste: root.sync-paste;
        paste-from: root.clip-from;
        sync-rows: root.sync-rows;
        sync-lines: root.sync-lines;
        sync-row-toggled(i) => { root.sync-row-toggled(i); }
        sync-all(on) => { root.sync-all(on); }
        sync-join-chosen(join) => { root.sync-join-chosen(join); }
        sync-applied => { root.sync-applied(); }
        shift-temperature <=> root.sync-shift-temperature;
        shift-tint <=> root.sync-shift-tint;
        shift-exposure <=> root.sync-shift-exposure;
        shift-shown: root.sync-shift-shown;
        shift-white: root.sync-shift-white;
        shift-light: root.sync-shift-light;
        shift-words: root.sync-shift-words;
        shift-changed => { root.sync-shift-changed(); }
    }

    // The export sheet, over everything, until a choice is made.
    if root.export-open: ExportSheet {
        file-name: root.file-name;
        set-count: root.set-count;
        export => { root.export(); }
        exporting: root.export-running;
        queue-sets: root.export-queue-sets;
        queue-line: root.export-queue-line;
        queue-running: root.export-queue-running;
        queue-add => { root.export-queue-add(); }
        queue-run => { root.export-queue-run(); }
        queue-clear => { root.export-queue-clear(); }
        export-open <=> root.export-open;
        export-format <=> root.export-format;
        export-quality <=> root.export-quality;
        export-size <=> root.export-size;
        export-custom <=> root.export-custom;
        frame-width <=> root.frame-width;
        frame-height <=> root.frame-height;
        custom-edge(a) => { return root.custom-edge(a); }
        export-subfolder-name(a) => { return root.export-subfolder-name(a); }
        export-folder-line(a, b, c, d, e) => { return root.export-folder-line(a, b, c, d, e); }
        frame-index: root.selected;
        export-folder-turn: root.export-folder-turn;
        export-folder-choose => { root.export-folder-choose(); }
        export-subfolder-problem(a) => { return root.export-subfolder-problem(a); }
        export-space <=> root.export-space;
        export-embed <=> root.export-embed;
        export-sharpen <=> root.export-sharpen;
        export-on-exists <=> root.export-on-exists;
        export-subfolder <=> root.export-subfolder;
        export-metadata <=> root.export-metadata;
        export-mark <=> root.export-mark;
        export-mark-text <=> root.export-mark-text;
        export-mark-image-name <=> root.export-mark-image-name;
        export-mark-color <=> root.export-mark-color;
        export-mark-position <=> root.export-mark-position;
        export-mark-size <=> root.export-mark-size;
        export-mark-margin <=> root.export-mark-margin;
        export-mark-opacity <=> root.export-mark-opacity;
        export-border <=> root.export-border;
        export-border-width <=> root.export-border-width;
        export-border-color <=> root.export-border-color;
        export-mark-choose => { root.export-mark-choose(); }
        export-presets <=> root.export-presets;
        export-preset <=> root.export-preset;
        export-preset-edited <=> root.export-preset-edited;
        export-preset-chosen(n) => { root.export-preset-chosen(n); }
        export-preset-saved(n) => { root.export-preset-saved(n); }
        export-preset-deleted => { root.export-preset-deleted(); }
        export-preset-exists(n) => { return root.export-preset-exists(n); }
    }

    // The import sheet, over everything, until started or left.
    if root.import-open: ImportSheet {
        import-open <=> root.import-open;
        import-source: root.import-source;
        import-destination: root.import-destination;
        import-backup: root.import-backup;
        import-subfolder <=> root.import-subfolder;
        import-name <=> root.import-name;
        import-presets: root.import-presets;
        import-preset <=> root.import-preset;
        import-note: root.import-note;
        import-preview: root.import-preview;
        import-folders-note: root.import-folders-note;
        import-count: root.import-count;
        import-ready: root.import-ready;
        import-verify <=> root.import-verify;
        import-choose(w) => { root.import-choose(w); }
        import-backup-cleared => { root.import-backup-cleared(); }
        import-started => { root.import-started(); }
    }

    // The settings sheet, over everything, until closed.
    if root.settings-open: SettingsSheet {
        settings-open <=> root.settings-open;
        sidecar-placement <=> root.sidecar-placement;
        xmp-sidecars <=> root.xmp-sidecars;
        jpegs-apart <=> root.jpegs-apart;
        jpegs-apart-changed => { root.jpegs-apart-changed(); }
        open-frames: root.open-frames;
        sidecars-written: root.sidecars-written;
        sidecars-elsewhere: root.sidecars-elsewhere;
        settings-note: root.settings-note;
        placement-changed => { root.placement-changed(); }
        xmp-changed => { root.xmp-changed(); }
        sidecars-move => { root.sidecars-move(); }
        thumb-cache-on: root.thumb-cache-on;
        thumb-cache-entries: root.thumb-cache-entries;
        thumb-cache-words: root.thumb-cache-words;
        thumb-cache-cap <=> root.thumb-cache-cap;
        thumb-cache-clear => { root.thumb-cache-clear(); }
        thumb-cache-cap-changed => { root.thumb-cache-cap-changed(); }
        preview-cache-cap <=> root.preview-cache-cap;
        preview-cache-cap-changed => { root.preview-cache-cap-changed(); }
        network-poll-minutes <=> root.network-poll-minutes;
        network-poll-changed => { root.network-poll-changed(); }
        presets-missing: root.presets-missing;
        presets-missing-words: root.presets-missing-words;
        presets-restore => { root.presets-restore(); }
        update-check <=> root.update-check;
        update-note: root.update-note;
        update-checking: root.update-checking;
        update-check-changed => { root.update-check-changed(); }
        update-check-now => { root.update-check-now(); }
    }

    // The keys sheet, over everything, until closed.
    if root.keys-open: KeysSheet {
        open <=> root.keys-open;
        rows: root.keys-rows;
        searched(t) => { root.keys-searched(t); }
    }

    // The frame menu: one for the window, opened where the
    // right-click was. Declared last, though its menu is a popup and
    // draws over everything wherever it is declared.
    frame-menu := FrameMenu {
        x: 0;
        y: 0;
        count: root.menu-count;
        paste-from: root.clip-from;
        paste-count: root.menu-paste-count;
        rating: root.menu-rating;
        flag: root.menu-flag;
        label: root.menu-label;
        file: root.menu-file;
        can-meta: root.menu-can-meta;
        can-export: !root.export-open && !root.export-running && root.selected >= 0 && !root.culling;
        archive-verb: root.archive-verb;
        archive-choices: root.archive-choices;
        back-count: root.back-count;
        back-to: root.back-to;
        move-back => { root.move-back-asked(); root.menu-done(); }
        collections: root.collection-names;
        collection-open: root.collection-open;
        collection-add(i) => { root.collection-menu-add(i); root.menu-done(); }
        collection-remove => { root.collection-menu-remove(); root.menu-done(); }
        archive(i) => { root.archive-menu-picked(i); root.menu-done(); }
        copy => { root.menu-copy(); root.menu-done(); }
        paste => { root.paste-asked(); root.menu-done(); }
        meta(k, v) => { root.menu-meta(k, v); root.menu-done(); }
        reveal => { root.menu-reveal(); root.menu-done(); }
        export => { root.menu-export(); root.menu-done(); }
        // The sheet takes the focus itself: no `menu-done`, whose
        // timer would take it back.
        current: root.selected >= 0 && root.selected < root.thumbs.length
            ? root.thumbs[root.selected].name : "";
        sync => {
            if (root.set-count > 1 && !root.sheet-open() && !root.tool-in-hand()) {
                root.sync-open-asked();
            } else {
                root.menu-done();
            }
        }
        lightbox: root.lightbox;
        lightbox-toggled => {
            if (root.lightbox) { root.lightbox-leave(); } else { root.lightbox-enter(); }
            root.menu-done();
        }
        version: root.menu-version;
        can-version: root.selected >= 0 && !root.culling;
        // A new version's name sheet takes the focus itself: no
        // `menu-done`, whose timer would take it back.
        new-version => { root.version-new-asked(false, true); }
        new-version-from-original => { root.version-new-asked(true, true); }
        rename-version => { root.version-rename-asked(); }
        swap-version => { root.version-swap-asked(); root.menu-done(); }
        delete-version => { root.version-delete-asked(); }
        can-compare: root.menu-compare;
        compare-versions => { root.version-compare-asked(); root.menu-done(); }
        stack: root.menu-stack;
        stack-open: root.menu-stack-open;
        stack-top: root.menu-stack-top;
        can-stack: root.menu-can-stack;
        stack-holds: root.menu-stack-holds;
        stack-make => { root.stack-make(); root.menu-done(); }
        stack-unmake => { root.stack-unmake(); root.menu-done(); }
        stack-toggle => { root.stack-toggle(); root.menu-done(); }
        stack-top-asked => { root.stack-top(true); root.menu-done(); }
        stack-remove => { root.stack-remove(); root.menu-done(); }
        stack-compare => { root.stack-compare(); root.menu-done(); }
    }

    // Recently opened: one list for the window, opened below the
    // folder's name in the left pane.
    recent-menu := RecentMenu {
        x: 0;
        y: 0;
        folders: root.recent-folders;
        chosen(p) => { root.recent-chosen(p); root.menu-done(); }
    }

    // The hover text, over everything and kept inside the window; not
    // over a sheet, which a key can open while the pointer rests on a
    // name.
    if root.tip-text != "" && !root.sheet-open(): Rectangle {
        x: max(0px, min(root.tip-x, root.width - self.width - Theme.space-1));
        y: root.tip-y;
        width: min(tip-label.preferred-width + 2 * Theme.space-2, root.width);
        height: tip-label.preferred-height + 2 * Theme.space-1;
        background: Theme.raised;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: Theme.radius-sm;
        tip-label := Text {
            x: Theme.space-2;
            width: parent.width - 2 * Theme.space-2;
            text: root.tip-text;
            color: Theme.text;
            font-size: Theme.font-xs;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
