                            component-changed(a) => { root.component-changed(a); }
                            renamed => { root.renamed(); }
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": LookSection {
                            collapsed-look <=> root.collapsed-look;
                            look-name <=> root.look-name;
                            look-strength <=> root.look-strength;
                            look-rows: root.look-rows;
                            look-mismatch: root.look-mismatch;
                            look-refit: root.look-refit;
