    in property <string> look-refit;
    callback look-refit-asked();
    callback look-group-toggled(string);
    callback look-curve-changed();
    in property <string> look-note;
    in property <string> look-warning;
    in property <string> look-fitted;
    callback look-picked();
    callback look-hovered(string, bool);
    /// The look list taken off the screen with the pointer on it, which
    /// reports no leave: the panel hidden, another tab, the section
    /// folded.
    callback look-list-gone();
    /// The chosen look has files in the look folder to remove.
    in property <bool> look-removable: false;
    callback look-remove-asked();
    /// The remove-a-look sheet: what goes, who names it, and what it
    /// offers, until answered: 0 no, 1 the trash, 2 permanently.
    in-out property <bool> look-remove-open: false;
    in property <string> look-remove-title: "";
    in property <[string]> look-remove-files;
    in property <string> look-remove-uses: "";
    in property <string> look-remove-note: "";
    in property <bool> look-remove-trash: true;
    in property <bool> look-remove-permanent: false;
    callback look-remove-answered(int);
    /// The chosen look has files in the look folder and none is a link.
    in property <bool> look-renamable: false;
    callback look-rename-asked();
    /// The rename-a-look sheet: the new name, what the files become,
    /// who names the look, and whether the name can be taken, until
    /// answered.
    in-out property <bool> look-rename-open: false;
    in property <string> look-rename-title: "";
    in-out property <string> look-rename-name: "";
    in property <[string]> look-rename-files;
    in property <string> look-rename-refusal: "";
    in property <string> look-rename-uses: "";
    in property <string> look-rename-note: "";
    in property <bool> look-rename-ready: false;
    in property <string> look-rename-warning: "";
    in property <bool> look-rename-working: false;
    callback look-rename-edited();
    callback look-rename-answered(bool);
    /// An export about to write over files that are there, under the
    /// Overwrite policy: every one of them, until answered (0 no, 1
    /// keep both, 2 overwrite).
    in-out property <bool> overwrite-open: false;
    in property <string> overwrite-title: "";
    in property <[string]> overwrite-files;
    callback overwrite-answered(int);
    // The camera match's sheet, from the Look section: the scope, the
    // groups found in it, the run's progress and its results.
    in-out property <bool> match-open: false;
    in-out property <string> match-scope: "This folder";
    in property <[string]> match-scopes: ["This folder"];
    in property <string> match-scope-note;
    in property <string> match-curve-note;
    in property <[MatchGroup]> match-groups;
    in property <string> match-summary;
    in property <string> match-list-note;
    in property <bool> match-can-fit;
    /// The Fit button's words, which count the groups checked, and why
