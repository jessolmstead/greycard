    callback redo();
    callback export();
    /// A set is being exported, a frame at a time; Stop (or Escape)
    /// finishes the frame in hand and stops.
    in property <bool> export-running: false;
    /// The set was told to stop and is finishing the frame in hand.
    in property <bool> export-stopping: false;
    callback export-stop();
    /// The export queue: sets waiting to be exported later, counted at
    /// the export sheet's foot, run in order by Export the queue.
