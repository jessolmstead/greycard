// The editor's window: a filmstrip along the bottom, a viewport
// drawn by the engine into a wgpu texture, and a panel of controls bound
// to the edit state on the Rust side. Everything reads the tokens in
// theme.slint; the controls are in controls.slint, and the tree's
// sections, bars and sheets are in panel/, one file a section, each
// bound to the properties and callbacks below that it uses.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tips, EdgeArrow, PanelButton, Segmented, Typing } from "controls.slint";
// The typed numbers are read on the Rust side (`entry.rs`).
export { Typing, TypedNumber } from "controls.slint";
import { LightroomRoot, ReportLine, Pt, Thumb, ThumbCell, MaskBox, MaskPick, PersonBox, CompareTile, FilterChip, FacetRow, FacetChip, RootChip, CollectionChip, SortMenu, RecentFolder, FolderRow, FolderTile, HistoryRow, LookRow, MatchGroup, CarryRow, KeyRow } from "structs.slint";
import { CullSection } from "panel/cull.slint";
import { AdjustmentsList, AdjustmentsSection } from "panel/mask.slint";
import { CameraSection, LookSection } from "panel/assets.slint";
import { PresetsSection } from "panel/presets.slint";
import { WhiteBalanceSection, ColorSection, MixerSection, BlackWhiteSection, GradingSection, TintSection } from "panel/color.slint";
import { CurvesSection } from "panel/curve.slint";
import { LightSection, NoiseSection, DetailSection, SharpenSection, VignetteSection, GrainSection, DemosaicSection } from "panel/edit.slint";
import { LensSection } from "panel/lens.slint";
import { ProofSection, MonitorSection } from "panel/display.slint";
import { CropSection, RotateSection, PerspectiveSection } from "panel/crop.slint";
import { RetouchSection } from "panel/retouch.slint";
import { NavigatorSection } from "panel/navigator.slint";
import { SnapshotsSection, HistorySection } from "panel/history.slint";
import { PanelHead } from "panel/scopes.slint";
import { ModelSheet } from "panel/model-sheet.slint";
import { RejectsSheet } from "panel/rejects-sheet.slint";
import { DeleteSheet } from "panel/delete-sheet.slint";
import { LookRemoveSheet } from "panel/look-remove-sheet.slint";
import { LookRenameSheet } from "panel/look-rename-sheet.slint";
import { OverwriteSheet } from "panel/overwrite-sheet.slint";
import { ArchiveSheet, ArchiveCard } from "panel/archive-sheet.slint";
import { ArchiveRejectsSheet } from "panel/archive-rejects-sheet.slint";
import { MatchSheet } from "panel/match-sheet.slint";
import { PresetSheet } from "panel/preset-sheet.slint";
import { PresetReportSheet } from "panel/preset-report-sheet.slint";
import { LightroomSheet } from "panel/lightroom-sheet.slint";
import { RawTherapeeSheet } from "panel/rawtherapee-sheet.slint";
import { SyncSheet } from "panel/sync-sheet.slint";
import { ExportSheet } from "panel/deliver.slint";
import { ImportSheet } from "panel/import-sheet.slint";
import { SettingsSheet } from "panel/settings-sheet.slint";
import { GridSheet } from "panel/grid.slint";
import { LoadingCard } from "panel/loading.slint";
import { Filmstrip } from "panel/strip.slint";
import { Viewport } from "panel/viewport.slint";
import { FrameMenu } from "panel/frame-menu.slint";
import { RootSheet } from "panel/root-sheet.slint";
import { FolderName, RecentMenu } from "panel/recent.slint";
import { FoldersSection } from "panel/folders.slint";
import { RootsSection } from "panel/roots.slint";
import { CollectionsSection } from "panel/collections.slint";
import { CollectionSheet } from "panel/collection-sheet.slint";
import { KeysSheet } from "panel/keys-sheet.slint";

export component App inherits Window {
    title: "greycard";
    icon: @image-url("../../../assets/icon/greycard.svg");
    // 800 high fits under the menu bar and above the Dock of a 13 or
    // 14 inch laptop, title bar and all; a screen with less has it cut
    // to what the screen has (`window_fit`).
    preferred-width: 1500px;
    preferred-height: 800px;
    // The size asked for and the least the layout takes, for the
    // opening size's fit to the screen (`window_fit`), which runs
    // before the window exists and holds a size of its own; a window
    // clamped below the least would only be pushed back up.
    out property <length> asked-width: self.preferred-width;
    out property <length> asked-height: self.preferred-height;
    out property <length> least-width: self.min-width;
    out property <length> least-height: self.min-height;
    background: Theme.canvas;
    default-font-size: Theme.font-md;

    // The viewport: the texture the engine renders, at the size of the
    // element in physical pixels, and the interaction on it.
    in property <image> texture <=> view.source;
    out property <int> view-width: view.width / 1phx;
    out property <int> view-height: view.height / 1phx;
    callback zoom(float, length, length);
    callback pan(length, length);
    callback wheel-pan(length, length);
    callback reset-view();
    /// Zoom to a level (0 fits) with the image pixel at the point held.
    callback zoom-to(float, length, length);
    /// Fit if zoomed, else 1:1 at the point.
    callback toggle-zoom(length, length);
    /// Fit if at this level, else this level about the view's center.
    callback zoom-key(float);
    /// The effective zoom in words: "Fit", or a percentage.
    in property <string> zoom-text: "Fit";

    // The filmstrip.
    in property <[Thumb]> thumbs;
    /// The strip's cells and the grid's: windows over `thumbs` of the
    /// rows on screen and a margin, which Rust moves as each view
    /// reports what it shows (`cells.rs`).
    in property <[ThumbCell]> strip-cells;
    in property <[ThumbCell]> grid-cells;
    in-out property <int> selected: -1;
    /// Open the frame on this row and make it the whole selection.
    callback select(int);
    /// A click on a frame in the strip or the grid, with Ctrl and
    /// Shift as they were held: Rust decides what it does to the set
    /// (`selection::click`). `selected` stays the current frame, the
    /// one on screen; each row's `chosen` says it is in the set.
    callback frame-clicked(int, bool, bool);
    /// How many frames the selection holds, the current one among
    /// them: 1 with a frame open and nothing else chosen.
    in property <int> set-count: 1;
    /// Escape over a set of more than one: back to the current frame.
    callback set-collapsed();
    /// Ctrl+Shift+S, or the presets' Sync button: the sync sheet.
    callback sync-open-asked();
    // The sync sheet: the current frame's sections, parts and masks,
    // checked, to lay over the rest of the set (`carry.rs`).
    in-out property <bool> sync-open: false;
    in property <string> sync-text: "";
    in property <[CarryRow]> sync-rows: [];
    /// The sync sheet's relative choices: Temperature, Tint and
    /// Exposure each set to the source's value (false) or shifted by
    /// its own move (true). Kept in the settings. Shown on a sync's
    /// sheet, not a paste's; a field whose section does not go is
    /// greyed; the words say what a frame moves by.
    in-out property <bool> sync-shift-temperature: false;
    in-out property <bool> sync-shift-tint: false;
    in-out property <bool> sync-shift-exposure: false;
    in property <bool> sync-shift-shown: false;
    in property <bool> sync-shift-white: false;
    in property <bool> sync-shift-light: false;
    in property <string> sync-shift-words;
    callback sync-shift-changed();
    in property <int> sync-lines: 0;
    callback sync-row-toggled(int);
    callback sync-all(bool);
    callback sync-join-chosen(bool);
    callback sync-applied();
    /// The sync sheet opened by a paste: the clipboard's sections
    /// over the whole selection, the frame copied from left out.
    in-out property <bool> sync-paste: false;
    // The frame menu, on a right-click over a frame in the strip, the
    // grid or the viewport (`panel::menu`).
    /// The row right-clicked, -1 for the frame on screen: Rust makes
    /// it current first when it is not in the selection
    /// (`selection::right_click`), and fills the menu's checks.
    callback frame-menu-asked(int);
    /// How many frames the menu acts on.
    in property <int> menu-count: 1;
    /// How many of them a paste goes onto.
    in property <int> menu-paste-count: 0;
    /// What the selection shares, for the checks; -1 where it differs.
    in property <int> menu-rating: -1;
    in property <int> menu-flag: -1;
    in property <int> menu-label: -1;
    /// A rating, flag or label from the menu: through the keys' code.
    callback menu-meta(string, int);
    /// The frame right-clicked, shown in the desktop's file manager.
    callback menu-reveal();
    /// Whether a Control+click is a right-click: a Mac's.
    in property <bool> ctrl-click-menu: false;
    /// The name of the frame right-clicked, whose settings the menu's
    /// Copy takes.
    in property <string> menu-file: "";
    /// Whether the selection has a frame for a rating, a flag or a
    /// label to reach.
    in property <bool> menu-can-meta: true;
    /// The version the frame right-clicked is, by name; empty for the
    /// file's own.
    in property <string> menu-version: "";
    /// New version (Ctrl+', the menu): the frame's edit copied, or
    /// with true the default edit; then Rename, Swap with the original
    /// and Delete of the version right-clicked.
    callback version-new-asked(bool, bool);
    callback version-rename-asked();
    callback version-swap-asked();
    callback version-delete-asked();
    /// Whether the frame right-clicked has versions or is one, and
    /// the menu's Compare versions on it.
    in property <bool> menu-compare: false;
    callback version-compare-asked();
    /// Stacks: the stack the frame right-clicked is in (how many frames
    /// it shows, 0 for none; open; the frame its top) and whether the
    /// frames chosen can be stacked. Stack (Ctrl+G), Unstack
    /// (Ctrl+Shift+G), open or close (S, or a click on the badge of
    /// a row), Set as top (Shift+S; true from the menu), Remove from
    /// stack and Compare stack.
    in property <int> menu-stack: 0;
    in property <bool> menu-stack-open: false;
    in property <bool> menu-stack-top: false;
    in property <bool> menu-can-stack: false;
    /// How many frames the stack Stack would make holds.
    in property <int> menu-stack-holds: 0;
    callback stack-make();
    callback stack-unmake();
    callback stack-toggle();
    callback stack-badge(int);
    callback stack-top(bool);
    callback stack-remove();
    callback stack-compare();
    /// The menu's Copy settings: the frame right-clicked, where Ctrl+C
    /// copies the frame on screen.
    callback menu-copy();
    /// The menu's Export... asked while a develop was running: the
    /// sheet opens once it lands.
    in-out property <bool> export-waiting: false;
    /// For a snapshot (`--menu`): the row of the strip, or of the grid
    /// when it is open, to open the menu over.
    in-out property <int> menu-at: -1;
    /// The settings clipboard: the frame its edit was copied from,
    /// empty when nothing is copied.
    in property <string> clip-from: "";
    /// Ctrl+C, or the menu's Copy settings: the current frame's edit
    /// into the clipboard.
    callback copy-asked();
    /// Ctrl+V, or the menu's Paste settings: the sheet, over the
    /// selection.
    callback paste-asked();
    /// A culling key over the browser: the text of it, and true when
    /// it meant something. Rust reads the key, applies it to the
    /// whole selection and writes the sidecars; the badges follow.
    callback meta-key(string) -> bool;
    /// The frame's own quarter turns, clockwise: the camera's
    /// orientation tag put right. Not an edit, so undo, the history
    /// and a preset leave it alone; see the sidecar's `turn`.
    callback frame-turned(int);
    /// The most stars a badge draws, set from `meta::STARS` so this
    /// file and that module cannot drift apart.
    in property <int> meta-stars: 5;
    // The strip's geometry, shared by its layout and its scrolling.
    property <length> strip-item: 178px;
    property <length> strip-pitch: root.strip-item + Theme.space-2;
    property <length> strip-pad: Theme.space-3;
    /// The frames the strip shows now, first and last, so their
    /// pictures are made before the rest of the folder's.
    callback strip-range(int, int);
    changed selected => { root.strip-reveal(); root.grid-reveal(); }
    /// Scroll the strip the least that brings the selected frame into
    /// view, leaving the padding beside it. Called when the selection
    /// moves and when the strip is first laid out or refilled.
    ///
    /// The width guard is the launch case: Slint runs the changed
    /// handlers before the first layout, and with a width of zero
    /// every frame past the first reads as off the right edge and
    /// scrolls to the clamp. `strip-relay` does the real reveal
    /// once the strip has a width.
    function strip-reveal() {
        if (strip.width <= 0px) { return; }
        // With nothing chosen the strip stays where it is, and still
        // says what it shows: its cells are made from what it says.
        if (root.selected >= 0) {
            // The frame's edges in the content's coordinates, and the
            // left edge of what is on screen.
            let left = root.strip-pad + root.selected * root.strip-pitch;
            let right = left + root.strip-item;
            let x = -strip.content-x;
            let wanted = left - root.strip-pad < x
                ? left - root.strip-pad
                : (right + root.strip-pad > x + strip.width
                    ? right + root.strip-pad - strip.width
                    : x);
            strip.content-x = min(0px, max(strip.width - strip.content-width, -wanted));
        }
        root.strip-report();
    }
    /// Put the strip where the selection is visible, worked out from
    /// the start rather than from where the strip stands. For a new
    /// width or a new folder: the launch runs a layout pass at an
    /// intermediate width, and a least-scroll from that one leaves
    /// the frame at an arbitrary place in the settled strip.
    function strip-relay() {
        strip.content-x = 0px;
        root.strip-reveal();
    }
    /// Tell Rust which frames are on screen. Sent on every move; the
    /// Rust side drops a repeat of the range it last acted on.
    function strip-report() {
        if (root.thumbs.length == 0 || strip.width <= 0px || root.grid-open) { return; }
        let x = -strip.content-x - root.strip-pad;
        root.strip-range(
            max(0, floor(x / root.strip-pitch)),
            min(root.thumbs.length - 1, ceil((x + strip.width) / root.strip-pitch)));
    }

    // The grid: the whole folder at once, over the window, in place
    // of the viewport, the strip and the panels. G opens it; G,
    // Escape or Return leave it on the frame the selection landed on.
    in-out property <bool> grid-open: false;
    /// A cell's side, logical pixels. Rust owns the steps it takes.
    in-out property <length> grid-cell: 176px;
    /// The grid's geometry, set from the Rust side's own constants so
    /// the layout here and the arithmetic there cannot drift apart.
    in property <length> grid-gap: 8px;
    in property <length> grid-pad: 12px;
    in property <length> grid-label: 22px;
    /// The sheet's size, mirrored out of it so the reveal and the
    /// report read the same numbers Rust is given. Writable so a
    /// test can lay the grid out on a backend that never does.
    in-out property <length> grid-w;
    in-out property <length> grid-h;
    /// How far down the sheet is scrolled, logical pixels. Out for
    /// the tests.
    out property <length> grid-scroll: 0px;
    property <length> grid-row: root.tile-cell + root.grid-label + root.grid-gap;
    pure callback grid-columns(length, length) -> int;
    /// What is left over beside a full row, halved: the cells sit in
    /// the middle of the window rather than against its left edge.
    pure callback grid-slack(length, length, int) -> length;
    /// How far the sheet can be scrolled, and the scroll that brings
    /// the selected cell into view: asked of the same arithmetic the
    /// Rust side tests, rather than written out again here.
    pure callback grid-max-scroll(length, length, int, int, length) -> length;
    pure callback grid-reveal-to(length, length, length, int, int, int, length) -> length;
    property <int> grid-cols: root.grid-columns(root.grid-w, root.tile-cell);
    /// How far the folder tiles push the cells down: none without
    /// tiles.
    pure callback grid-tiles-top(int, length, int) -> length;
    property <length> grid-top: root.lightbox ? 0px
        : root.grid-tiles-top(root.grid-tiles.length, root.tile-cell, root.grid-cols);
    property <length> grid-max:
        root.grid-max-scroll(root.grid-h, root.tile-cell, root.grid-cols, root.thumbs.length,
            root.grid-top);
    /// The scroll bars' thumbs, the grid's and the strip's, their
    /// length and their place along the bar, and the scroll a drag of
    /// one comes to: the same arithmetic.
    pure callback bar-length(length, length) -> length;
    pure callback bar-offset(length, length, length) -> length;
    pure callback bar-drag(length, length, length, length) -> length;
    /// Whether the grid's scroll bar, and the strip's, are awake after
    /// a scroll: each fades once its view has been still a moment. Out
    /// here for the tests.
    in-out property <bool> grid-bar-awake;
    in-out property <bool> strip-bar-awake;
    /// Move the selection a column along or a row down, told how many
    /// columns there are now.
    callback grid-step(int, int, int, bool);
    /// A step up or down the cell sizes.
    callback grid-zoom(int);
    /// The frames the grid shows now, from its scroll and its height:
    /// the same queue ordering the strip's range drives.
    callback grid-range(length, length, int, length);
    changed grid-open => {
        // A name under the pointer that goes with the grid or the pane
        // hears nothing of the pointer leaving: its hover text goes
        // here instead of staying over the window for good.
        root.tip-text = "";
        if (root.grid-open) {
            // The sheet is back, by whatever way (a folder picked from
            // the pane in the lightbox's loupe, the window's own): the
            // loupe is over, and its keys are the lightbox's again.
            root.lightbox-loupe = false;
            // Nothing can be placed on a picture that is not on
            // screen: whatever was in hand is put down on the way in,
            // so Escape in the grid is never spent on a stale mode.
            if (root.placing != "" || root.picking != "") { root.stop-placing(); }
            if (root.guide-mode != "") { root.guide-mode = ""; root.guide-dropped(); }
            root.level-mode = false;
            root.crop-draw-armed = false;
            // The sheet's own `init` lays it out and reports.
        } else {
            // The lightbox's sheet closed by anything but its own keys
            // (a double-click on a tile, the menu): that is its loupe,
            // and Return or Escape comes back to it.
            if (root.lightbox && !root.lightbox-loupe) {
                root.lightbox-loupe = true;
                root.lightbox-scroll = root.grid-scroll;
            }
            root.strip-relay();
        }
    }

    // The lightbox (L): the grid with everything that gets in the way
    // of judging a set whole taken out, over the view the grid shows
    // (a collection in its own order, the filtered folder). Tiles a
    // few across to a handful, the picture an export of each will be,
    // no names, badges or marks, on the canvas's dark; the left pane,
    // the develop panel and the strip put away on the way in and put
    // back as they were on the way out. Return is the loupe on the
    // frame chosen, and Return or Escape comes back to the same scroll;
    // Escape leaves to the grid.
    in-out property <bool> lightbox: false;
    /// In the loupe from the lightbox: the grid closed under it, to
    /// come back to.
    in-out property <bool> lightbox-loupe: false;
    /// How many tiles across. Rust owns the steps.
    in-out property <int> lightbox-across: 4;
    /// The panes as they were before the lightbox put them away.
    in-out property <bool> lightbox-left-was;
    in-out property <bool> lightbox-right-was;
    in-out property <bool> lightbox-strip-was;
    /// The sheet's scroll when the loupe was taken, -1px for none.
    property <length> lightbox-scroll: -1px;
    /// A tile's side for `lightbox-across` tiles across a sheet this
    /// wide.
    pure callback lightbox-cell(length, int) -> length;
    /// A step toward fewer, larger tiles (1) or more, smaller ones.
    callback lightbox-zoom(int);
    /// The lightbox came or went.
    callback lightbox-changed();
    /// The cell the grid's sheet is laid out at: the lightbox's tiles
    /// while it is on, else the grid's own size, which the lightbox
    /// leaves alone.
    out property <length> tile-cell: root.lightbox
        ? root.lightbox-cell(root.grid-w, root.lightbox-across) : root.grid-cell;
    public function lightbox-enter() {
        if (root.lightbox) { return; }
        root.lightbox-left-was = root.left-hidden;
        root.lightbox-right-was = root.right-hidden;
        root.lightbox-strip-was = root.strip-hidden;
        root.left-hidden = true;
        root.right-hidden = true;
        root.strip-hidden = true;
        root.lightbox-scroll = -1px;
        root.lightbox-loupe = false;
        root.lightbox = true;
        root.grid-open = true;
        root.lightbox-changed();
    }
    /// Out of the lightbox to the grid, the panes as they were.
    public function lightbox-leave() {
        if (!root.lightbox) { return; }
        root.lightbox = false;
        root.lightbox-loupe = false;
        root.lightbox-scroll = -1px;
        root.left-hidden = root.lightbox-left-was;
        root.right-hidden = root.lightbox-right-was;
        root.strip-hidden = root.lightbox-strip-was;
        root.grid-open = true;
        root.lightbox-changed();
    }
    /// The loupe on the frame chosen, and back.
    function lightbox-to-loupe() {
        root.lightbox-scroll = root.grid-scroll;
        root.lightbox-loupe = true;
        root.grid-open = false;
    }
    function lightbox-from-loupe() {
        root.lightbox-loupe = false;
        root.grid-open = true;
    }
    changed tile-cell => { root.grid-relay(); }
    // Another folder's frames: the sheet re-flows and reports afresh,
    // as the strip does from its content width.
    changed thumbs => { root.grid-relay(); }
    // The tiles come or go with the view, and move the cells.
    changed grid-top => { root.grid-relay(); }
    /// Scroll the sheet, or size the cells when Ctrl is held. A
    /// notch is a third of a row, whatever the row is: 60 logical
    /// pixels against a 542 px row at the largest cell would be a
    /// crawl.
    function grid-wheel(by: length, ctrl: bool) {
        if (ctrl) {
            if (root.lightbox) {
                root.lightbox-zoom(by > 0px ? 1 : -1);
            } else {
                root.grid-zoom(by > 0px ? 1 : -1);
            }
            return;
        }
        root.lightbox-scroll = -1px;
        root.grid-scroll = clamp(
            root.grid-scroll - by * (root.grid-row / 3 / 60px), 0px, root.grid-max);
        root.grid-report();
    }
    /// Scroll the sheet to `to`, held to its range, as the scroll
    /// bar's drag and its track do: the wheel's path, so the report
    /// follows.
    function grid-scroll-to(to: length) {
        root.lightbox-scroll = -1px;
        root.grid-scroll = clamp(to, 0px, root.grid-max);
        root.grid-report();
    }
    /// Put the sheet where the selection is visible, worked out from
    /// the top rather than from where it stands: a re-flow at a new
    /// cell size or a new width makes the old offset meaningless, and
    /// §89's lesson is that a least-scroll from an intermediate
    /// layout leaves the frame at an arbitrary place.
    function grid-relay() {
        // Back from the lightbox's loupe: where the sheet was, and the
        // least move from there that shows the frame the loupe left on.
        root.grid-scroll = root.lightbox && root.lightbox-scroll >= 0px
            ? clamp(root.lightbox-scroll, 0px, root.grid-max) : 0px;
        root.grid-reveal();
    }
    /// Scroll the least that brings the selected cell into view, the
    /// padding left beside it.
    function grid-reveal() {
        if (!root.grid-open || root.grid-h <= 0px) { return; }
        // A folder with nothing chosen in it yet still has to say
        // what it shows, or its pictures wait behind the rest.
        if (root.selected >= 0) {
            root.grid-scroll = root.grid-reveal-to(
                root.grid-scroll, root.grid-h, root.tile-cell,
                root.grid-cols, root.thumbs.length, root.selected, root.grid-top);
        }
        root.grid-report();
    }
    /// Tell Rust which frames the grid shows, as the strip does.
    function grid-report() {
        if (!root.grid-open || root.thumbs.length == 0 || root.grid-h <= 0px) { return; }
        root.grid-range(root.grid-scroll, root.grid-h, root.grid-cols, root.grid-top);
    }
    /// For `--time-scroll`: move the grid, or the strip when the grid
    /// is closed, `by` further along, as a wheel does. Says whether
    /// it moved, which at an end it does not.
    public function scroll-by(by: length) -> bool {
        if (root.grid-open) {
            let was = root.grid-scroll;
            root.grid-scroll = clamp(root.grid-scroll + by, 0px, root.grid-max);
            root.grid-report();
            return root.grid-scroll != was;
        }
        let was = strip.content-x;
        strip.content-x = min(0px, max(strip.width - strip.content-width, strip.content-x - by));
        return strip.content-x != was;
    }
    /// How many cells the strip and the grid have made, for
    /// `--time-scroll`'s line.
    out property <int> cells-made: root.strip-cells.length + (root.grid-open ? root.grid-cells.length : 0);

    // Culling: the camera's own JPEG in the viewport, through the
    // monitor's profile only, and no develop until Enter or a slider.
    // C enters and leaves; V cycles the compare view through one, two
    // and four frames; the panel shows a CULLING section in place of
    // the develop tabs' while it is on.
    in-out property <bool> culling: false;
    // The camera's JPEG standing in for a develop that has not landed,
    // on the frame just selected. It is a placeholder and not a mode:
    // the develop replaces it the moment it lands. Nothing placed in
    // the developed picture's own coordinates is drawn over it — it
    // is neither that size nor that picture — and a word in the
    // corner says what it is.
    in property <bool> placeholder: false;
    callback cull-toggled();
    /// Leave the mode and develop the frame the selection is on.
    callback cull-leave();
    /// How many frames the compare view shows: 1, 2 or 4, and the
    /// same as the panel's row spells it.
    in property <int> compare: 1;
    in-out property <string> compare-text: "1";
    callback compare-changed(int);
    /// The compared frames on the view: each one's box, its name, and
    /// whether it is the selection.
    in property <[CompareTile]> compare-tiles: [];
    /// The frame on screen's stars, flag and label, as `Thumb` codes
    /// them, for the culling loupe's badge; a compare tile carries
    /// its own.
    in property <int> frame-rating: 0;
    in property <int> frame-flag: 0;
    in property <int> frame-label: 0;
    /// The word over the picture for the culling key just pressed
    /// ("3 stars", "Rejected"): the text, and whether it is up. Rust
    /// puts it up and takes it down on a timer of its own; nothing
    /// else takes it down, so an arrow pressed after the key leaves
    /// it to be read.
    in property <string> notice: "";
    in property <bool> notice-on: false;
    /// Move on to the next frame after a rating, a flag or a label,
    /// in culling: the CULLING section's switch, kept in the
    /// settings.
    in-out property <bool> cull-move-on: false;
    callback cull-move-on-changed();
    /// The browser's filter on the meta: the rating chips and the
    /// reading they are in, the flag chips, the label chips and a
    /// word looked for in the file name and the keywords. It applies
    /// to the strip, the grid and the arrows, in and out of culling.
    /// Rust owns every decision here; the chips are what it says.
    in-out property <[FilterChip]> filter-stars: [];
    in-out property <[FilterChip]> filter-flags: [];
    in-out property <[FilterChip]> filter-labels: [];
    in-out property <bool> filter-exact: false;
    in-out property <string> filter-text: "";
    /// How many frames the filter shows, and how many there are.
    in-out property <int> filter-shown: 0;
    in-out property <int> filter-total: 0;
    /// Whether the filter asks anything of a frame at all.
    in-out property <bool> filter-on: false;
    /// A key has asked for the filter's text field; the bar on
    /// screen answers it and puts it back to false.
    in-out property <bool> filter-focus: false;
    /// The facets counted for the folder, a row a facet: the EXIF's
    /// from the library index, the keyword's and the kind's from the
    /// frames in hand; and what to say while there are none.
    in property <[FacetRow]> filter-facets: [];
    /// The same rows split for the grid's header: camera and lens, then
    /// the others.
    in property <[FacetRow]> filter-facets-long: [];
    in property <[FacetRow]> filter-facets-short: [];
    in property <string> filter-facet-note: "";
    callback filter-facet-toggled(int, string);
    /// The library's roots, in the left pane with the grid: each with
    /// its file count, the all-roots view, and whether the folder open
    /// can be added with a press.
    in property <[RootChip]> library-roots: [];
    in property <bool> library-all-on: false;
    in property <int> library-all-count: 0;
    in property <bool> library-can-add-open: false;
    in property <string> library-note: "";
    /// A root chosen by its path, or every root for an empty one.
    callback library-root-picked(string);
    callback library-root-removed(string);
    callback library-root-add();
    callback library-root-add-open();
    /// A root's menu asked to rename it, by its path.
    callback library-root-rename(string);
    /// A root's menu turned its archive mark on or off, by its path.
    callback library-root-archive(string);
    /// The collections, in the left pane with the grid
    /// (`panel::collections`): a row each, a click opens one, its menu
    /// renames it, sorts it by capture time, forgets its missing frames
    /// or deletes it.
    in property <[CollectionChip]> collections: [];
    in-out property <bool> collapsed-collections: false;
    callback collection-picked(string);
    callback collection-rename(string);
    callback collection-delete(string);
    callback collection-capture(string);
    callback collection-forget-missing(string);
    pure callback collection-forgettable(string) -> int;
    callback collection-new();
    /// The frame menu's Add to collection, by its place in
    /// `collection-names` (-1 for a new one), and Remove from the one
    /// open; B adds the selection to the collection open, or the last
    /// one added to, or takes it out when it is all in it already.
    in property <[string]> collection-names: [];
    in property <string> collection-open: "";
    callback collection-menu-add(int);
    callback collection-menu-remove();
    callback collection-key();
    /// The grid shows a collection in its own order: a drag moves a
    /// frame, from its row to before another's.
    in property <bool> collection-reorder: false;
    callback collection-moved(int, int);
    /// The filter bar's Save...: the filter kept as a smart collection.
    callback filter-save-smart();
    /// The collection sheet: a name asked for, or a delete.
    in-out property <bool> collection-sheet-open: false;
    in property <string> collection-sheet-title;
    in property <string> collection-sheet-note;
    in property <bool> collection-sheet-asks-name: true;
    in property <string> collection-sheet-verb: "Save";
    in-out property <string> collection-sheet-name;
    /// The field's hint: a collection's name, or a version's.
    in property <string> collection-sheet-placeholder: "Name, or Set/Name";
    callback collection-sheet-done();
    // The archive roots (`panel::archive`, notes §197, §216).
    /// The grid header's Back up or Bring back: its words, empty for
    /// none, and its choices by name.
    in property <string> archive-header: "";
    in property <[string]> archive-choices: [];
    /// The header's menu with more than one choice: each in full
    /// ("Back up to nas (3 frames not on nas)..."), in the same order.
    in property <[string]> archive-header-choices: [];
    /// The header's button pressed, with the choice.
    callback archive-header-pressed(int);
    /// The frame menu's: "Back up", "Bring back" or nothing, and the
    /// choice picked there.
    in property <string> archive-verb: "";
    callback archive-menu-picked(int);
    /// The sheet: what a copy would do, before it does it.
    in-out property <bool> archive-open: false;
    in property <string> archive-title: "";
    in property <string> archive-text: "";
    in property <string> archive-named: "";
    in-out property <string> archive-dest: "";
    in property <string> archive-dest-note: "";
    in property <int> archive-rejects: -1;
    in-out property <bool> archive-include-rejects: false;
    in property <string> archive-confirm: "";
    in property <bool> archive-can-confirm: false;
    callback archive-answered(bool);
    callback archive-look-again();
    /// A copy under way: its bar, by bytes, and its words.
    in property <bool> archive-running: false;
    in property <float> archive-fraction: 0;
    in property <string> archive-line: "";
    callback archive-cancel();
    /// Remove rejects from an archive: the CULLING section's entries,
    /// one an archive, and the sheet, answered 0 no, 1 move, 2 delete
    /// to the trash, 3 delete permanently.
    in property <[string]> archive-rejects-choices: [];
    callback archive-rejects-asked(int);
    in-out property <bool> archive-rejects-open: false;
    in property <string> archive-rejects-title: "";
    in property <string> archive-rejects-text: "";
    in property <string> archive-rejects-named: "";
    in property <string> archive-rejects-note: "";
    in property <string> archive-rejects-move: "";
    in property <string> archive-rejects-trash: "";
    in property <string> archive-rejects-permanent: "";
    callback archive-rejects-answered(int);
    /// The folder open, as the left pane names it under its Open
    /// folder button: its own name (or the root's, or "All roots"
    /// for a view of the roots), the root it is under, and its path
    /// for the hover text; all empty with nothing open. The note is
    /// what a folder chosen from Recently opened that has gone said,
    /// shown in the name's place until the next folder opens.
    in property <string> open-folder-name: "";
    in property <string> open-folder-root: "";
    in property <string> open-folder-path: "";
    in property <string> open-folder-note: "";
    /// Recently opened, the most recent first, the one open checked.
    in property <[RecentFolder]> recent-folders: [];
    /// A folder chosen from Recently opened, by its path.
    callback recent-chosen(string);
    /// The open root's folders as a tree in the left pane, shown while
    /// a root's view is open; a folder chosen or folded there, by its
    /// row in the list shown; and the switch that takes in the
    /// folders under the one chosen.
    in property <bool> folder-tree-shown: false;
    in property <[FolderRow]> folder-tree: [];
    in-out property <bool> folder-tree-subfolders: false;
    in-out property <bool> collapsed-folders: false;
    in-out property <bool> collapsed-roots: false;
    callback folder-tree-picked(int);
    callback folder-tree-folded(int);
    callback folder-tree-subfolders-changed();
    /// The folders under the one open, as tiles at the top of the
    /// grid; empty with the switch on, or for a view with no tree. A
    /// tile clicked opens its folder as its row in the tree does, and
    /// its menu's Reveal shows it in the file manager; both by the
    /// tile's number.
    in property <[FolderTile]> grid-tiles: [];
    callback grid-tile-picked(int);
    callback grid-tile-reveal(int);
    /// The hover text over everything, and where; empty for none.
    out property <string> tip-text;
    property <length> tip-x;
    property <length> tip-y;
    changed left-hidden => { root.tip-text = ""; }
    changed right-hidden => {
        root.tip-text = "";
        root.look-list-gone();
    }
    changed strip-hidden => { root.tip-text = ""; }
    // What a TipArea has to say, from the controls' own global, and the
    // panel scrolled from under the pointer takes it down.
    property <int> tips-serial: Tips.serial;
    changed tips-serial => { root.tip-at(Tips.text, Tips.x, Tips.y); }
    changed panel-scroll => { root.tip-text = ""; }
    function recent-menu-at(x: length, y: length) {
        root.tip-text = "";
        if (root.sheet-open()) { return; }
        // As a root's menu: the keys take the focus first, so the
        // window can tell the menu is up by their losing it.
        keys.focus();
        recent-menu.open(x, y);
    }
    function tip-at(text: string, x: length, y: length) {
        root.tip-text = text;
        root.tip-x = x;
        root.tip-y = y;
    }
    /// The root sheet: a root's name, from its row's menu. The path
    /// is the root's, and the folder's own name is what an empty name
    /// falls back to.
    in-out property <bool> root-sheet-open: false;
    in-out property <string> root-sheet-path;
    in-out property <string> root-sheet-folder;
    in-out property <string> root-sheet-name;
    callback root-sheet-done();
    in-out property <bool> collapsed-culling: false;
    callback filter-star-picked(int);
    callback filter-flag-toggled(int);
    callback filter-label-toggled(int);
    callback filter-exact-toggled();
    callback filter-text-edited(string);
    callback filter-cleared();
    /// The filter bar's Sort menu: the view's order as Rust says it,
    /// an entry picked by its place, and a way up picked.
    in property <SortMenu> sort-menu;
    callback sort-picked(int);
    callback sort-turned(bool);
    /// The grid's Sort menu opened from Rust, for a snapshot of it.
    in-out property <bool> sort-menu-shown: false;
    /// Bring the frame chosen into view in the strip and the grid, from
    /// where each stands: after a sort, when the row it is on may not
    /// have moved but the rows around it have.
    public function reveal-selected() {
        root.strip-reveal();
        root.grid-reveal();
    }
    /// Ctrl+F or /: put the filter's chips where they can be reached
    /// and the cursor in its text field.
    callback filter-asked();
    /// How many frames of the folder are flagged reject.
    in property <int> reject-count: 0;
    /// The move-rejects sheet: what it will do, until answered.
    in-out property <bool> rejects-open: false;
    in property <string> rejects-text: "";
    callback rejects-asked();
    callback rejects-answered(bool);
    /// Move back, the inverse: how many of the selection are in a
    /// rejects folder (none hides it), and the folder above by name.
    in property <int> back-count: 0;
    in property <string> back-to: "";
    callback move-back-asked();
    /// The delete sheet: what it will delete, from where, and what it
    /// offers, until answered. Asked for "selection" or "rejects";
    /// answered 0 no, 1 the trash, 2 permanently.
    in-out property <bool> delete-open: false;
    in property <string> delete-title: "";
    in property <string> delete-text: "";
    in property <string> delete-note: "";
    in property <bool> delete-trash: true;
    in property <bool> delete-permanent: false;
    /// Whether the frames to delete are on an archive: a line.
    in property <string> delete-archive: "";
    /// The default button's word when the sheet asks about something
    /// other than files to the trash (a version, which is a line of a
    /// sidecar and goes with a save): empty for the trash's.
    in property <string> delete-confirm: "";
    callback delete-asked(string);
    callback delete-answered(int);

    // The edit, mirrored from Rust's state struct.
    in-out property <float> exposure: 0;
    in-out property <float> contrast: 1;
    in-out property <float> highlights: 0;
    in-out property <float> shadows: 0;
    in-out property <float> whites: 0;
    in-out property <float> blacks: 0;
    // Global vibrance and saturation, in the same pass as the mixer.
    in-out property <bool> color-enabled: true;
    in-out property <float> saturation: 0;
    in-out property <float> vibrance: 0;
    in-out property <bool> as-shot: true;
    // The curves: which of the two the section shows, "Parametric" or
    // "Point" (both apply); the parametric curve's four amounts and
    // three splits; the point curves as flat x, y pairs per channel;
    // and the picture of the one being edited.
    in-out property <bool> curves-enabled: true;
    in-out property <string> curve-mode: "Point";
    in-out property <float> para-highlights: 0;
    in-out property <float> para-lights: 0;
    in-out property <float> para-darks: 0;
    in-out property <float> para-shadows: 0;
    in-out property <[float]> para-splits: [0.25, 0.5, 0.75];
    in-out property <string> curve-channel: "RGB";
    in-out property <[float]> curve-rgb: [0, 0, 1, 1];
    in-out property <[float]> curve-red: [0, 0, 1, 1];
    in-out property <[float]> curve-green: [0, 0, 1, 1];
    in-out property <[float]> curve-blue: [0, 0, 1, 1];
    // The color curves against lightness, the neutral at y = 0.5.
    in-out property <[float]> curve-red-green: [0, 0.5, 1, 0.5];
    in-out property <[float]> curve-blue-yellow: [0, 0.5, 1, 0.5];
    in property <image> curve-image;
    // How far the panel's sections are scrolled, the ScrollView's
    // own content-y (so down is negative); set from Rust for a
    // snapshot of a section below the fold, once the sections have
    // their height, as the ScrollView puts an earlier value back to
    // the top when it first lays out.
    in-out property <length> panel-scroll: 0px;
    // Straighten and crop. The crop is fractions of the source; the
    // overlay's rectangle is in view pixels, set by Rust each frame.
    in-out property <bool> crop-mode: false;
    in-out property <bool> level-mode: false;
    // The perspective guide: "" when it is not in hand, else the way
    // the two lines being traced should run, "Vertical" or "Horizontal".
    in-out property <string> guide-mode: "";
    // The crop's Draw in hand: the next drag on the picture draws a
    // fresh crop wherever it starts. Put down on leaving crop mode,
    // and by the level or a guide taken up in its place.
    in-out property <bool> crop-draw-armed: false;
    changed crop-mode => { if (!root.crop-mode) { root.crop-draw-armed = false; } }
    changed level-mode => { if (root.level-mode) { root.crop-draw-armed = false; } }
    changed guide-mode => { if (root.guide-mode != "") { root.crop-draw-armed = false; } }
    // Local adjustments: the list (Global first), which one the panel
    // edits (0 is global), that one's own controls, and the kind of
    // shape being drawn in the viewport, if any.
    in-out property <[string]> adjustment-names: ["Global"];
    in-out property <int> target: 0;
    // Which tab the panel shows: Develop, Crop, Masks or Retouch.
    in-out property <string> panel-tab: "Develop";
    // Each tab starts at its top, however it was reached: the scroll is
    // one for all four, and Develop scrolled to its foot left a shorter
    // tab showing only the empty space below its sections.
    // A field open in a section the change takes away is closed, and
    // the keys handed back: a destroyed field says nothing itself.
    changed panel-tab => {
        root.panel-scroll = 0px;
        Typing.close-all();
        root.look-list-gone();
    }
    changed target => { Typing.close-all(); }
    changed curve-mode => { Typing.close-all(); }
    changed culling => { Typing.close-all(); }
    callback tab-changed(string);
    in-out property <bool> adjustment-enabled: true;
    in-out property <bool> mask-invert: false;
    in-out property <bool> has-feather: false;
    in-out property <float> mask-feather: 0.5;
    // The chosen shape's window when it is a luminance or a color
    // range: Oklab lightness 0 to 1; Oklch hue and widths in degrees,
    // chroma in Oklab's units (`mask::Shape`).
    in-out property <float> lum-low: 0.7;
    in-out property <float> lum-high: 1.0;
    in-out property <float> lum-low-feather: 0.1;
    in-out property <float> lum-high-feather: 0.0;
    in-out property <float> range-hue: 55;
    in-out property <float> range-width: 60;
    in-out property <float> range-hue-feather: 25;
    in-out property <float> range-chroma: 0.02;
    in-out property <float> range-chroma-feather: 0.01;
    in-out property <bool> show-mask: false;
    // Thrown by hand, as against set while a shape is placed.
    callback show-mask-toggled();
    // The sections' switches that are not a part's own.
    in-out property <bool> light-enabled: true;
    // The display curve: per channel, on a norm or AgX, by name.
