                            look-warning: root.look-warning;
                            look-fitted: root.look-fitted;
                            look-picked => { root.look-picked(); }
                            look-hovered(name, on) => { root.look-hovered(name, on); }
                            look-removable: root.look-removable;
                            look-remove-asked => { root.look-remove-asked(); }
                            look-renamable: root.look-renamable;
                            look-rename-asked => { root.look-rename-asked(); }
                            match-asked => { root.match-asked(); }
                            view-changed => { root.view-changed(); }
                        }
                        if root.panel-tab == "Develop": WhiteBalanceSection {
                            as-shot <=> root.as-shot;
                            collapsed-wb <=> root.collapsed-wb;
                            picking <=> root.picking;
                            pick-started(a) => { root.pick-started(a); }
                            wb-auto => { root.wb-auto(); }
                            temperature <=> root.temperature;
                            tint <=> root.tint;
                            raw-input: root.raw-input;
                            develop-changed => { root.develop-changed(); }
                        }
                        // The chosen mask's own white balance: the light
