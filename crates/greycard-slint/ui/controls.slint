// The panel's controls, built on the tokens: each has its four states
// (rest, hover, pressed, disabled) and a focus ring where it takes
// focus. Icons are Lucide (ISC, see icons/LICENSE), tinted here.

import { Theme, ScrollBars, LabelColumn } from "theme.slint";

// The window's one hover text, written by whatever has rested under the
// pointer (a `TipArea`) and drawn by the window over everything: it
// watches `serial`, which moves on every show and every hide, so the
// same words twice running still show.
export global Tips {
    out property <string> text;
    out property <length> x;
    out property <length> y;
    out property <int> serial;
    /// How long the pointer rests before a tip comes up.
    out property <duration> rest: 600ms;
    public function show(words: string, at-x: length, at-y: length) {
        self.text = words;
        self.x = at-x;
        self.y = at-y;
        self.serial += 1;
    }
    public function hide() {
        self.show("", 0, 0);
    }
}

// A TouchArea for something that shows a picture and no words: after
// the pointer has rested on it for a moment, `words` (one or two, the
// absolute minimum) come up at the pointer through `Tips`, and go on
// leaving, on a press, and wherever the window takes the text down.
// Empty words, no tip. The accessible label stays the control's own.
export component TipArea inherits TouchArea {
    in property <string> words;
    property <bool> tipped;
    function untip() {
        if (root.tipped) {
            root.tipped = false;
            Tips.hide();
        }
    }
    Timer {
        interval: Tips.rest;
        running: root.has-hover && !root.tipped && root.words != "";
        triggered => {
            root.tipped = true;
            Tips.show(root.words, root.absolute-position.x, root.absolute-position.y + root.height + 2px);
        }
    }
    /// A press of any button, after the tip is taken down.
    callback down(PointerEvent);
    /// A release of any button.
    callback up(PointerEvent);
    /// A press that ends with no release: the grab lost (the window
    /// left, another took the pointer).
    callback canceled();
    changed has-hover => { if (!root.has-hover) { root.untip(); } }
    // Words taken away while up (the control gone quiet): the tip too.
    changed words => { if (root.words == "") { root.untip(); } }
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            root.untip();
            root.down(e);
        } else if (e.kind == PointerEventKind.up) {
            root.up(e);
        } else if (e.kind == PointerEventKind.cancel) {
            root.canceled();
        }
    }
}

// The whole of a name its row cuts short, through `Tips` after the
// same rest a `TipArea` takes; a name that fits says nothing. It lies
// over the name's own text, and the row's TouchArea says when the
// pointer is over it, where over it, and counts its presses of any
// button, a right one too, which a TouchArea's `pressed` leaves out. A
// press keeps the name down until the pointer leaves, since a menu or
// a drag may follow it. A scroll of the view the row is in, which
// carries the row from under a still pointer that never hears it as a
// leaving, takes the name down until the pointer moves and rests
// again, and so does a re-flow of the view; a row given another name
// takes the old one down. We watch the
// view's scroll rather than the row's absolute position, since a change
// handler on the absolute position left a click in the folder tree
// unheard. A row a list reset destroys never hears the pointer leave,
// so the window takes the text down when its lists are replaced.
export component NameTip {
    in property <string> name;
    /// The row cuts the name short.
    in property <bool> cut;
    /// The pointer is over the row at all, and over the part of it
    /// that counts as the name (the row's choice; the whole row for a
    /// row that is little else). A press, a scroll or a re-flow keeps
    /// the name down until the pointer leaves the row, not the name: a
    /// held press slid from a picture onto its name is a drag.
    in property <bool> row-hover;
    in property <bool> hover;
    /// The pointer's place over the row, which moves only when the
    /// pointer does.
    in property <length> pointer-x;
    in property <length> pointer-y;
    /// The scroll of the view the row is in, whichever axis.
    in property <length> scroll;
    /// The number of the view's layout, which moves on a re-flow.
    in property <int> shape;
    /// The row's presses so far: each one takes the name down.
    in property <int> downs;
    /// A menu or a sheet is up: nothing is put up.
    in property <bool> quiet;
    property <bool> tipped;
    property <bool> spent;
    property <bool> moved;
    function untip() {
        if (root.tipped) {
            root.tipped = false;
            Tips.hide();
        }
    }
    function press() {
        root.untip();
        root.spent = true;
    }
    changed downs => { root.press(); }
    // Only under the pointer: a row moved while the pointer is
    // elsewhere is entered afresh, maybe at the very spot it was left,
    // which would not move `pointer-x` to clear the mark.
    function shift() {
        root.untip();
        if (root.row-hover) {
            root.moved = true;
        }
    }
    changed hover => { root.untip(); }
    changed row-hover => {
        if (!root.row-hover) {
            root.untip();
            root.spent = false;
            root.moved = false;
        }
    }
    changed scroll => { root.shift(); }
    changed shape => { root.shift(); }
    changed pointer-x => { root.moved = false; }
    changed pointer-y => { root.moved = false; }
    changed name => { root.untip(); }
    Timer {
        interval: Tips.rest;
        running: root.hover && root.cut && !root.quiet && !root.tipped && !root.spent && !root.moved
            && root.name != "";
        triggered => {
            root.tipped = true;
            Tips.show(root.name, root.absolute-position.x, root.absolute-position.y + root.height + 2px);
        }
    }
}

// A key a focused button or switch does not take. The window's keys
// sit beside the panel, not over it, so a key a control turned away
// would go nowhere: the control hands it on here, as a slider does,
// and the window takes it as its own. Not Tab, Slint's move to the
// next control, and not under a sheet, whose own keys sit over its
// controls and take what they turn away.
export global ButtonKeys {
    // Set by the window.
    in-out property <bool> sheet-up: false;
    // Counted up, and the key.
    in-out property <int> passed: 0;
    in-out property <KeyEvent> passed-key;
    // Whether `e` went on to the window.
    public function pass(e: KeyEvent) -> bool {
        if (ButtonKeys.sheet-up || e.text == Key.Tab || e.text == Key.Backtab) { return false; }
        ButtonKeys.passed-key = e;
        ButtonKeys.passed += 1;
        return true;
    }
}

// A switch on its own, smaller than a Toggle's, for a header.
export component Switch inherits Rectangle {
    in-out property <bool> checked: true;
    in property <bool> enabled: true;
    // Its name to a screen reader: the section's title.
    in property <string> label;
    // Shown off whatever `checked` says: for a switch another
    // section has taken over, which keeps what it was set to for
    // when it is handed back.
    in property <bool> force-off: false;
    callback toggled();
    width: 28px;
    height: 16px;
    border-radius: 8px;
    property <bool> shown: root.checked && !root.force-off;
    // To a screen reader a switch, on or off as it shows, and whether
    // it takes a hand: a dead one is heard as disabled.
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.shown;
    accessible-enabled: root.enabled;
    property <bool> active: enabled && (ta.has-hover || ta.pressed || fs.has-focus);
    background: !root.enabled ? Theme.border
        : root.shown ? (root.active ? Theme.accent-hover : Theme.accent)
        : (root.active ? Theme.hover : Theme.border-strong);
    border-width: fs.has-focus ? 2px : 0;
    border-color: Theme.focus-ring;
    animate background { duration: Theme.quick; }
    Rectangle {
        x: root.shown ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.enabled ? Theme.knob : Theme.text-muted;
        animate x { duration: 120ms; easing: ease-out; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        // Disabled while it held the focus (a FocusScope keeps it):
        // its own keys are taken and do nothing, so none acts on the
        // window or a sheet behind it either.
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                if (root.enabled) {
                    root.checked = !root.checked;
                    root.toggled();
                }
                return accept;
            }
            return ButtonKeys.pass(e) ? accept : reject;
        }
    }
    // Enabled either way: a disabled switch takes the press and does
    // nothing, so it never falls through to the header row under it,
    // which would fold the section.
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                fs.focus();
                root.checked = !root.checked;
                root.toggled();
            }
        }
    }
}

// The panel's sections, one open at a time when the Settings sheet
// asks: a section of the panel that opens, by its header or by a key,
// says so here, and every other section of the panel then folds. Only
// the tab on screen has its sections made, so the others are its own.
export global Folds {
    in-out property <bool> one-open: false;
    // The sections numbered as they first open, the last to open, and
    // a count of openings that the others watch.
    in-out property <int> count: 0;
    in-out property <int> opener: 0;
    in-out property <int> opened: 0;
    // A section opened by its header, for the panel to bring into
    // view as the others fold: counted up at each of its moves, and
    // where it is in the window.
    in-out property <int> reveal: 0;
    in-out property <length> reveal-y;
    in-out property <length> reveal-height;
    // Whether this reveal is the opening's first (the panel clears it
    // as it reads it), and a count the
    // panel puts up when the wheel moved it since the last: the
    // section is let go of rather than pulled back from the wheel.
    in-out property <bool> reveal-first;
    in-out property <int> let-go: 0;
}

// A header dragged to move its section, by whichever stack holds it.
// Esc while one is in hand puts it back: the window's keys see the Esc
// and count it here, and the stack lets the drag go with nothing moved.
export global SectionDrag {
    // A stack has a header in hand: Esc is the drag's.
    in-out property <bool> active: false;
    in-out property <int> cancels: 0;
}

// A section: a header of icon, title and chevron over a rule, and
// the body under it. The header folds the body away and back. A
// section with an effect carries a switch at the header's right: off,
// the picture is as if the section were not there, and the body's
// settings stay as they are, dimmed, for when it is on again.
export component Section inherits VerticalLayout {
    in property <string> title;
    // Whose section this is, before the title: a mask's adjustment
    // on the Masks tab. A long one is cut; the title after it stays.
    // A name, so shown as typed, where the title is in capitals.
    in property <string> owner;
    in property <image> icon;
    // A word after the title, muted: a key, say.
    in property <string> hint;
    // A reading at the header's right, muted: a zoom, say. It keeps to
    // its own end so the title does not move as it changes.
    in property <string> note;
    in property <bool> switchable: false;
    in-out property <bool> on: true;
    // A command at the header's right, in words: a click on it does
    // what it says and leaves the fold as it is, so it is there with
    // the section folded too. Empty for none.
    in property <string> action;
    callback action-clicked();
    // A reset at the header's right, left of the switch or of its
    // room: a click puts the whole section back to what a new edit
    // has, as one step, and leaves the fold and the section's place as
    // they are. Hidden, its room kept, while the section stands there
    // already (`reset-live` false) and while its switch is dead; the
    // empty room is then the header's. Not in the keys' focus walk, as
    // the header's other picture-only parts are not. Never dropped for
    // want of room: at the panel's narrowest (280 px) the header holds
    // it with a few letters of the title, which is cut instead.
    in property <bool> has-reset: false;
    in property <bool> reset-live: true;
    callback reset-clicked();
    property <length> reset-width: Theme.icon + 2 * Theme.space-1;
    property <length> switch-width: 28px;
    // Whether the focused slider is in this section, by where it last
    // said it was (it says so at each move).
    pure function holds-the-keys() -> bool {
        let x = SliderKeys.reveal-x - root.absolute-position.x;
        let y = SliderKeys.reveal-y - root.absolute-position.y;
        return x >= 0 && x <= root.width && y >= 0 && y < root.height;
    }
    // Another section has taken this one over, or the frame has
    // nothing for it to act on (a monochrome sensor's white balance),
    // and it does not act whatever its switch says: the switch shows
    // off and is dead, the body is dimmed, and `on` keeps what it was
    // for when it acts again.
    in property <bool> superseded: false;
    in-out property <bool> collapsed: false;
    // A header that moves its section by a drag, in a SectionStack: the
    // stack works out where it lands and says at the release whether
    // anything moved, so that the click the release also makes over the
    // header folds only when nothing did.
    in property <bool> reorderable: false;
    callback reorder-started();
    callback reorder-moved(length, length);
    callback reorder-ended(bool) -> bool;
    property <bool> reorder-armed: false;
    property <bool> reorder-dragging: false;
    // A drag another button put back: the left's release is no click.
    property <bool> reorder-swallow: false;
    property <length> reorder-down-y;
    // A press turns into a drag once the pointer has gone 8 px up or
    // down: past a click's wobble (GTK's own drag threshold is 8 px),
    // and along the stack only, since sideways moves nothing in it.
    // Under that the stack is never told, and a release is the click it
    // always was.
    function reorder-press(e: PointerEvent, y: length) {
        // Another button pressed or let go while the left is held puts
        // the section back: the header loses the pointer's grab at that
        // release, so the left's own may never reach it. Nothing moves,
        // and the left's release, should it land on the header, is no
        // fold.
        if ((e.kind == PointerEventKind.down || e.kind == PointerEventKind.up)
            && e.button != PointerEventButton.left) {
            if (root.reorder-armed || root.reorder-dragging) {
                root.reorder-swallow = root.reorder-dragging;
                root.reorder-finish(false);
                root.reorder-armed = false;
            }
            return;
        }
        if (e.kind == PointerEventKind.down) {
            root.reorder-swallow = false;
            root.reorder-armed = root.reorderable && e.button == PointerEventButton.left;
            root.reorder-down-y = y;
            root.reorder-dragging = false;
        } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
            // Released off the header, no click follows: the drop is here.
            // Over it, the click came first and has had it.
            root.reorder-finish(e.kind == PointerEventKind.up);
            root.reorder-armed = false;
        }
    }
    function reorder-motion(x: length, y: length) {
        if (!root.reorder-armed) { return; }
        if (!root.reorder-dragging && abs(y - root.reorder-down-y) > 8px) {
            root.reorder-dragging = true;
            root.reorder-started();
        }
        if (root.reorder-dragging) { root.reorder-moved(x, y); }
    }
    // The drag in hand let go, dropped or not: whether it moved the
    // section, after which the release's click is no fold.
    function reorder-finish(commit: bool) -> bool {
        if (!root.reorder-dragging) { return false; }
        root.reorder-dragging = false;
        return root.reorder-ended(commit);
    }
    // A cancel (Esc, or a change of what the panes show) puts the
    // section back at once, whether or not a release ever comes here:
    // the cursor is the pointer's again, and a release over the header
    // is no fold.
    property <int> drag-cancels: SectionDrag.cancels;
    changed drag-cancels => {
        if (root.reorder-dragging) {
            root.reorder-dragging = false;
            root.reorder-armed = false;
            root.reorder-swallow = true;
        }
    }
    function header-clicked() {
        if (root.reorder-swallow) {
            root.reorder-swallow = false;
            return;
        }
        if (root.reorder-finish(true)) { return; }
        root.fold-clicked();
    }
    // Whether a fold moves or lands at once: a click on the header
    // moves it, and a fold the view brings, set false around it,
    // lands as the sections around it appear.
    in-out property <bool> animated: true;
    property <duration> fold-time: root.animated ? 120ms : 0ms;
    // One of the panel's sections, which fold for each other under
    // `Folds`, while the panel is on screen; a pane's or a list's do
    // not. The grid covers the panel without unmaking it, and a pane's
    // section sharing a fold with one of the panel's (METADATA's)
    // must not fold the panel behind it.
    in property <bool> one-of-panel: false;
    property <int> fold-number: 0;
    // Opened under the rule: a section whose fold another tab shares
    // folds that tab's sections here, which are not made to fold.
    callback opened-alone();
    changed collapsed => {
        if (!root.collapsed && root.one-of-panel && Folds.one-open) {
            if (root.fold-number == 0) {
                Folds.count += 1;
                root.fold-number = Folds.count;
            }
            Folds.opener = root.fold-number;
            Folds.opened += 1;
            root.opened-alone();
        }
    }
    property <int> fold-opened: Folds.opened;
    changed fold-opened => {
        if (root.one-of-panel && Folds.one-open && !root.collapsed
            && Folds.opener != root.fold-number) {
            root.collapsed = true;
        }
    }
    // Opened by its header while the others fold: an open section
    // above it folding carries it up, out of sight at the top, and its
    // own body opens past the foot. So it is followed while both
    // animations run, and the panel scrolls it into view as it moves.
    property <bool> chased: false;
    property <length> chased-y: root.chased ? root.absolute-position.y : 0px;
    property <length> chased-height: root.chased ? root.height : 0px;
    changed chased-y => { root.show-opened(); }
    changed chased-height => { root.show-opened(); }
    property <int> let-go: Folds.let-go;
    changed let-go => { root.chased = false; }
    function show-opened() {
        if (!root.chased) { return; }
        Folds.reveal-y = root.absolute-position.y;
        Folds.reveal-height = root.height;
        Folds.reveal += 1;
    }
    // Past the folds' 120 ms, with room for a slow frame.
    Timer {
        interval: 400ms;
        running: root.chased;
        triggered => { root.chased = false; }
    }
    callback switched();
    // One of the left pane's lists, which share the pane's height
    // (app.slint): open, the body may grow past its own height, up to
    // its layout's maximum, and the room goes to the list's box, the
    // one child of the body that stretches. Its other children must
    // each have a bounded height.
    in property <bool> shares: false;
    // The gap between the body's children. The panel's sections set
    // their own gaps between groups; the left pane's lists keep 4 px
    // between a list and what is under it.
    in property <length> body-spacing: 0px;
    // Nothing in the body for now (NAVIGATOR with no frame): the
    // header over the 1 px line, as folded, with no empty box.
    in property <bool> empty: false;
    // The width the body gives its rows, inside its padding.
    out property <length> body-width: body.width - body.padding-left - body.padding-right;
    // The header under the pointer: all of it answers at once.
    property <bool> lit: row.has-hover;
    function fold-clicked() {
        // A focused slider elsewhere in the panel keeps the keys, and
        // the panel keeps it in view as this section opens or folds;
        // one in this section lets go, since the fold takes it out of
        // view, as does one anywhere in the panel when this one opens
        // under One section open at a time, which folds all others.
        let folds-the-rest = root.collapsed && root.one-of-panel && Folds.one-open;
        if (SliderKeys.holder == 0 || Typing.editing || root.holds-the-keys() || folds-the-rest) {
            Typing.close-all();
        }
        root.animated = true;
        root.collapsed = !root.collapsed;
        if (!root.collapsed && root.one-of-panel && Folds.one-open) {
            root.chased = true;
            Folds.reveal-first = true;
            root.show-opened();
        }
    }
    // The header, in one look in both panes: chevron, icon, and title
    // in `Theme.text`, and under the pointer the hover's fill, as a
    // button's, not the accent, which is what is chosen. It heads a
    // raised box round the body and stays above it as it folds away,
    // and the whole row takes the press.
    Rectangle {
        border-radius: Theme.radius-sm;
        background: root.lit ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }
        row := TouchArea {
            // To a screen reader the fold: a button named by the
            // section's title, open or folded, whose press folds it as
            // a click does.
            accessible-role: button;
            accessible-label: root.title;
            accessible-expandable: true;
            accessible-expanded: !root.collapsed;
            accessible-action-default => { root.fold-clicked(); }
            accessible-action-expand => { if (root.collapsed) { root.fold-clicked(); } }
            mouse-cursor: root.reorder-dragging ? MouseCursor.grabbing : MouseCursor.pointer;
            pointer-event(e) => { root.reorder-press(e, self.absolute-position.y + self.mouse-y); }
            moved => { root.reorder-motion(self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y); }
            clicked => { root.header-clicked(); }
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            padding-top: Theme.space-2;
            padding-bottom: Theme.space-2;
            padding-right: Theme.space-1;
            Rectangle {
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;
                    Image {
                        source: @image-url("icons/chevron-down.svg");
                        colorize: Theme.text;
                        width: Theme.icon;
                        height: Theme.icon;
                        y: (parent.height - self.height) / 2;
                        transform-rotation: root.collapsed ? -90deg : 0deg;
                        animate transform-rotation { duration: root.fold-time; easing: ease-out; }
                    }
                    if root.icon.width > 0: Image {
                        source: root.icon;
                        colorize: Theme.text;
                        width: Theme.icon;
                        height: Theme.icon;
                        y: (parent.height - self.height) / 2;
                    }
                    if root.owner != "": Text {
                        text: root.owner;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        color: Theme.text;
                        font-size: Theme.font-xs;
                        font-weight: Theme.weight-semibold;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    title-words := Text {
                        // Said by the fold, which it names.
                        accessible-role: none;
                        text: (root.owner == "" ? "" : "\u{00b7}  ") + root.title;
                        color: Theme.text;
                        font-size: Theme.font-xs;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: 0.8px;
                        vertical-alignment: center;
                        // A long title is cut, not the panel widened;
                        // after an owner, the owner is cut instead.
                        overflow: elide;
                        // Never under a few letters, so a narrow header
                        // still names its section.
                        min-width: root.owner == "" ? 0px : min(self.preferred-width, 56px);
                    }
                    // Cut first, so a long one (a version's name) never
                    // pushes the header's action off the panel.
                    if root.hint != "": Text {
                        text: root.hint;
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                    }
                }
                if root.note != "": Text {
                    x: parent.width - self.width;
                    text: root.note;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                    height: 100%;
                }
            }
            if root.action != "": Rectangle {
                width: action-text.preferred-width + 2 * Theme.space-1;
                border-radius: Theme.radius-sm;
                background: action-area.pressed ? Theme.pressed : action-area.has-hover ? Theme.hover : transparent;
                animate background { duration: Theme.quick; }
                accessible-role: button;
                accessible-label: root.action;
                accessible-action-default => { root.action-clicked(); }
                action-text := Text {
                    // Said by its button, which it names.
                    accessible-role: none;
                    text: root.action;
                    color: action-area.has-hover ? Theme.text : Theme.text-secondary;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
                action-area := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.action-clicked(); }
                }
            }
            // Its room is kept while there is nothing to reset, so
            // nothing moves as it comes and goes; a click on the empty
            // room is the header's: its touch area is switched off, so
            // the header's row under it takes the press.
            if root.has-reset: reset-slot := Rectangle {
                property <bool> live: root.reset-live && !root.superseded;
                width: root.reset-width;
                if reset-slot.live: reset-button := Rectangle {
                    border-radius: Theme.radius-sm;
                    background: reset-area.pressed ? Theme.pressed : reset-area.has-hover ? Theme.hover : transparent;
                    animate background { duration: Theme.quick; }
                    accessible-role: button;
                    accessible-label: @tr("Reset");
                    accessible-description: root.title;
                    accessible-action-default => { root.reset-clicked(); }
                    Image {
                        source: @image-url("icons/rotate-ccw.svg");
                        colorize: reset-area.has-hover ? Theme.text : Theme.text-secondary;
                        width: Theme.icon;
                        height: Theme.icon;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                // Made once and only switched off, so a tip up as the
                // section reaches its defaults (an undo by a key, say)
                // goes down with its words rather than staying up.
                reset-area := TipArea {
                    enabled: reset-slot.live;
                    words: reset-slot.live ? @tr("Reset") : "";
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { if (reset-slot.live) { root.reset-clicked(); } }
                }
            }
            if root.switchable: header-switch := Switch {
                label: root.title;
                checked <=> root.on;
                enabled: !root.superseded;
                force-off: root.superseded;
                y: (parent.height - self.height) / 2;
                toggled => { root.switched(); }
            }
            // A reset with no switch beside it keeps the switch's room,
            // so the resets stand in one column down the panel.
            if root.has-reset && !root.switchable: Rectangle {
                width: root.switch-width;
            }
        }
    }
    // The body, clipped to nothing when folded: it folds down to a
    // solid 1 px line under the header.
    fold-box := Rectangle {
        width: 100%;
        clip: true;
        property <bool> shut-or-empty: root.collapsed || root.empty;
        property <bool> line-only: self.shut-or-empty && self.height <= 1px;
        background: self.line-only ? Theme.border : Theme.raised;
        border-color: Theme.border;
        border-width: self.line-only ? 0px : 1px;
        // Never under the line it folds to.
        property <length> least: 1px;
        property <length> full: self.shut-or-empty ? 0px : body.preferred-height;
        animate full { duration: root.fold-time; easing: ease-out; }
        // For the sliders' focus walk alone: closed all the way, the
        // body is put far to the left, out of every column, so comma
        // and period pass a folded section's sliders over.
        property <float> shut: root.collapsed ? 1 : 0;
        animate shut { duration: root.fold-time; }
        // Sharing, the body's height is the layout's share, not its
        // own: open and settled, it is bounded by the body's layout
        // alone. Folding, by a fraction of the height it had when last
        // open and settled (`held`), so a fold runs from the share the
        // list had. Opening, by the same fraction of the body's own
        // bounds, so at its end they are the settled bounds and the
        // share it lands on is the one the pane has now, with no step
        // however the window changed while it was folded. A list's
        // content changing while open moves at once: no fold is under
        // way to animate it.
        property <float> open: root.collapsed ? 0 : 1;
        animate open { duration: root.fold-time; easing: ease-out; }
        property <length> held;
        property <bool> moving: self.open < 1;
        property <bool> folding: self.moving && root.collapsed;
        property <length> span: self.held > 0 ? self.held : body.preferred-height;
        preferred-height: max(self.least, !root.shares ? self.full
            : self.folding ? self.open * self.span : self.open * body.preferred-height);
        max-height: max(self.least, !root.shares ? self.full
            : self.folding ? self.open * self.span : self.open * body.max-height);
        min-height: max(self.least, !root.shares ? self.full
            : self.folding ? self.open * self.span : self.open * body.min-height);
        // Kept only for a sharing section, so no other lays itself out
        // as it is made (a change handler reads its height at once).
        if root.shares: Rectangle {
            width: 0px;
            height: 0px;
            property <length> laid: fold-box.height;
            property <bool> settled: !root.collapsed && !fold-box.moving;
            init => { if (self.settled && self.laid > 0) { fold-box.held = self.laid; } }
            changed laid => { if (self.settled && self.laid > 0) { fold-box.held = self.laid; } }
        }
        body := VerticalLayout {
            // 8 px above and below and 6 at the sides: the body as
            // wide as before the box, so a button's words keep their
            // letters.
            padding: Theme.space-2;
            padding-left: Theme.space-2 - 2px;
            padding-right: Theme.space-2 - 2px;
            x: parent.shut >= 1 ? -100000px : 0;
            y: 0;
            width: 100%;
            // Folding, at the height it had, so it slides under the clip
            // rather than squeezing its list.
            height: !root.shares ? self.preferred-height
                : max(parent.height, self.preferred-height, parent.folding ? parent.span : 0px);
            spacing: root.body-spacing;
            opacity: (root.switchable && !root.on) || root.superseded ? 0.45 : 1;
            animate opacity { duration: Theme.quick; }
            @children
        }
    }
}

// A gap that is dragged to move room from one side of it to the
// other: the gap between two of the left pane's lists, and the panes'
// edges. Nothing is drawn; the pointer over it, when `live`, turns to
// the resizing hand. `hovering` is raised at each move over it with no
// button held, and at a release, so the owner can work `live` out
// afresh for the next move; the hand shows the answer a move behind.
// `dragged` carries the pointer's travel since the press, in the
// window, along y or, with `along-y` false, along x, so the gap moving
// under the pointer as the room moves does not count. A double-click
// is `evened`, which its press and release precede.
// `live` false, nothing could move there as last asked: the pointer keeps the
// arrow; a press still raises `started`, and the owner finds nothing
// to move.
export component DragEdge inherits Rectangle {
    in property <bool> along-y: true;
    in property <bool> live: true;
    callback hovering();
    callback started();
    callback dragged(length);
    callback ended();
    callback evened();
    property <length> from;
    pure function at() -> length {
        return root.along-y ? root.absolute-position.y + area.mouse-y
            : root.absolute-position.x + area.mouse-x;
    }
    area := TouchArea {
        mouse-cursor: !root.live ? MouseCursor.default
            : root.along-y ? MouseCursor.ns-resize : MouseCursor.ew-resize;
        pointer-event(e) => {
            // The TouchArea's `moved` comes only with a button held.
            if (e.kind == PointerEventKind.move && !self.pressed) { root.hovering(); }
            if (e.button != PointerEventButton.left) { return; }
            if (e.kind == PointerEventKind.down) {
                root.from = root.at();
                root.started();
            }
            // The release asks too: the drag moved room, so where the
            // pointer now rests may have turned.
            if (e.kind == PointerEventKind.up) { root.ended(); root.hovering(); }
        }
        moved => {
            if (self.pressed) { root.dragged(root.at() - root.from); }
        }
        double-clicked => { root.evened(); }
    }
}

// What the slots of a stack need of its drag: the section in hand, the
// place it would land (before the slot of that index, or after the
// last one on show when it is past them all), the last slot on show,
// and a count of the moves, at each of which the slots say where they
// are. No section is in hand while `index` is below nought.
export struct SectionDragState {
    index: int,
    slot: int,
    last: int,
    revision: int,
}

// Sections in the order the user drags them into (`panel::order`),
// each in a SectionSlot: the drag and where it would land. The
// sections stay where they are until the release, and only a 1 px line
// in the accent shows the place, so nothing jumps as the pointer goes.
// Each move, every slot on show says where its line would be, and the
// first one below the pointer takes the drop; past them all, the drop
// is after the last. Off the pane sideways it is nowhere, and the
// release moves nothing. Near the pane's top or foot, or past them,
// the stack scrolls the pane.
export component SectionStack inherits VerticalLayout {
    // Which order this is, named to the Rust side with a move. A drag
    // under way when it changes (the left pane's stack holds Library's
    // order or the Loupe's) is let go of with nothing moved.
    in property <string> view;
    in property <int> count;
    // Whether a header here is dragged at all: not with one section.
    in property <bool> movable: root.count > 1;
    in property <length> viewport-x;
    in property <length> viewport-y;
    in property <length> viewport-width;
    in property <length> viewport-height;
    property <int> drag-index: -1;
    property <int> drop-slot: -1;
    property <int> last-shown: -1;
    // The first slot on show under the one in hand (the order's length
    // for none): a drop there is just under itself on screen, whatever
    // hidden slots lie between, and moves nothing.
    property <int> next-shown: -1;
    property <length> drag-y;
    property <int> drag-revision;
    property <string> drag-view;
    property <int> drag-cancels;
    // The drag as the slots see it: none once Esc or a change of view
    // has let it go, though the header in hand hears of that only at
    // its release.
    property <bool> live: root.drag-index >= 0 && root.drag-view == root.view
        && root.drag-cancels == SectionDrag.cancels;
    // Whether the section in hand still said where it is at the last
    // move: one the view has taken away under the drag hears no release,
    // and its line and the scrolling go with it.
    property <bool> dragged-there;
    property <bool> held: root.live && root.dragged-there;
    out property <SectionDragState> state: {
        index: root.held ? root.drag-index : -1,
        slot: root.drop-slot,
        last: root.last-shown,
        revision: root.drag-revision,
    };
    // A section moved, by its index in `view`'s order, to before the
    // one at `to` (the order's length for the end), with the first slot
    // on show under it, so the Rust side can tell a drop there is none.
    callback moved-section(string, int, int, int);
    callback scroll-by(length);
    // A drag begun: the window's keys take the focus, so that an Esc
    // reaches them.
    callback started();
    public function start(i: int) {
        root.drag-index = i;
        root.drop-slot = -1;
        root.dragged-there = true;
        root.drag-view = root.view;
        root.drag-cancels = SectionDrag.cancels;
        SectionDrag.active = true;
        root.started();
    }
    public function move(x: length, y: length) {
        if (!root.live) { return; }
        root.drag-y = y;
        if (x < root.viewport-x || x > root.viewport-x + root.viewport-width) {
            root.drop-slot = -1;
            return;
        }
        root.ask();
    }
    function ask() {
        root.dragged-there = false;
        root.drop-slot = root.count;
        root.last-shown = -1;
        root.next-shown = root.count;
        root.drag-revision += 1;
    }
    // Slot `i`, on show, has its line at `top` in the window.
    public function consider(i: int, top: length) {
        if (!root.live) { return; }
        if (i == root.drag-index) { root.dragged-there = true; }
        root.last-shown = max(root.last-shown, i);
        if (i > root.drag-index && i < root.next-shown) { root.next-shown = i; }
        if (root.drag-y < top && i < root.drop-slot) { root.drop-slot = i; }
    }
    // The release over the pane (`commit`) or elsewhere: whether the
    // drag moved a section or had been canceled, so the header's
    // click does not fold it. A drop on itself, or just under itself on
    // screen, moves nothing.
    public function end(commit: bool) -> bool {
        if (root.drag-index < 0) { return false; }
        let from = root.drag-index;
        let to = root.drop-slot;
        let next = root.next-shown;
        let live = root.held;
        root.drag-index = -1;
        root.drop-slot = -1;
        SectionDrag.active = false;
        if (!live) { return true; }
        if (commit && to >= 0 && to != from && to != next) {
            root.moved-section(root.view, from, to, next);
            return true;
        }
        return false;
    }
    // 30 px from an end, or past it, the pane scrolls 12 px every 40 ms
    // (300 px a second) toward it, and the drop is worked out afresh.
    Timer {
        interval: 40ms;
        running: root.held && root.drop-slot >= 0
            && (root.drag-y < root.viewport-y + 30px
                || root.drag-y > root.viewport-y + root.viewport-height - 30px);
        triggered => {
            root.scroll-by(root.drag-y < root.viewport-y + 30px ? 12px : -12px);
            root.ask();
        }
    }
    // A cancel (Esc, or a change of what the panes show) lets the drag
    // go here too: the header in hand may never hear a release.
    property <int> cancels: SectionDrag.cancels;
    changed cancels => {
        root.drag-index = -1;
        root.drop-slot = -1;
    }
    @children
}

// One place in a SectionStack, holding whichever section its name is.
// One the view does not show holds nothing and takes no room: a layout
// lays out every child it has, shown or not, so the stack has no
// spacing of its own. Sections abut: a box shows where one ends, and
// the next header's 8 px above its title are the gap. Draws the drop's
// line, and in the left pane carries the edge that moves room between
// its list and the one above (`DragEdge`), over the 8 px of padding at
// the foot of the box above.
export component SectionSlot inherits Rectangle {
    in property <int> index;
    in property <SectionDragState> drag: { index: -1, slot: -1, last: -1, revision: 0 };
    in property <length> spacing: 0px;
    // The left pane's slots, which share its height: each as tall as
    // its section's bounds, so the room goes where the stretches say.
    in property <bool> fills: false;
    in property <float> stretch: 0;
    // The lists either side of the gap above, by their share index; no
    // edge unless both are.
    in property <int> resize-a: -1;
    in property <int> resize-b: -1;
    in property <bool> resize-live: false;
    callback resize-hovered();
    callback resize-started();
    callback resize-dragged(length);
    callback resize-evened();
    callback consider(int, length);
    out property <bool> shown: inner.preferred-height > 0;
    min-height: content.min-height;
    preferred-height: content.preferred-height;
    max-height: content.max-height;
    vertical-stretch: root.stretch;
    property <int> revision: root.drag.revision;
    changed revision => {
        // Within the header, however tall the body under it: a tall open
        // body does not put the place past the foot of the view.
        if (root.shown) {
            root.consider(root.index, root.absolute-position.y + min(inner.height / 2, Theme.space-4));
        }
    }
    content := VerticalLayout {
        inner := VerticalLayout {
            spacing: root.spacing;
            alignment: root.fills ? LayoutAlignment.stretch : LayoutAlignment.start;
            @children
        }
    }
    // Over the 8 px of padding at the foot of the box above: the owner
    // gives `resize-a` only where the slot above ends in an open list's
    // box, so the edge never lies over a row or a header, and the
    // header below keeps the whole of its row for its fold.
    if root.drag.index < 0 && root.shown && root.resize-a >= 0 && root.resize-b >= 0: DragEdge {
        y: -Theme.space-2;
        width: 100%;
        height: Theme.space-2;
        live: root.resize-live;
        hovering => { root.resize-hovered(); }
        started => { root.resize-started(); }
        dragged(d) => { root.resize-dragged(d); }
        evened => { root.resize-evened(); }
    }
    // The drop's line: on the section's top edge, or under the last
    // one's foot.
    if root.drag.index >= 0 && root.shown && root.drag.slot == root.index: Rectangle {
        y: 0px;
        height: 1px;
        width: 100%;
        background: Theme.accent;
    }
    if root.drag.index >= 0 && root.shown && root.drag.slot > root.drag.last && root.drag.last == root.index: Rectangle {
        y: root.height - 1px;
        height: 1px;
        width: 100%;
        background: Theme.accent;
    }
}

// What a number typed into a field comes to, as the Rust side reads
// it (`entry.rs`): not `ok` when the text holds no number.
export struct TypedNumber {
    ok: bool,
    value: float,
}

// The sliders' keys, one place for all of them: which slider holds
// the keys, and the question a slider asks the others for the next or
// the previous one, with comma and period or with Tab in its field.
// The answer takes two of Slint's rounds of change handlers, both
// within the press: in the first, every slider past the asker in its
// column puts itself forward if it is nearer than the best so far; in
// the second, the one left takes the focus or opens its field.
export global SliderKeys {
    // Whether the system scrolls naturally, content following the
    // fingers, as a Mac does by default: a swipe up then comes as a
    // scroll down, and a slider turns it back so it moves the way
    // the fingers went. Set from the system's setting at the start,
    // and before each wheel event where a touchpad's way differs
    // from a wheel's.
    in-out property <bool> natural: false;
    // The slider with the keys, by its number, or 0. The picture does
    // not take the keys at the pointer's crossing while one has them.
    in-out property <int> holder: 0;
    // The numbers handed out, one a slider.
    in-out property <int> count: 0;
    // The question, counted up at each asking.
    in-out property <int> asked: 0;
    in-out property <int> asker: 0;
    in-out property <int> way: 1;
    in-out property <bool> field: false;
    in-out property <length> from-x;
    in-out property <length> from-y;
    in-out property <length> from-width;
    // The nearest so far, by its number and its top.
    in-out property <int> best: 0;
    in-out property <length> best-y;
    // Counted up once every slider has answered.
    in-out property <int> settled: 0;
    // A slider reached by a key, for the panel to scroll into view:
    // counted up, and where it is in the window. Not `by-key` when
    // the focused slider has only moved on the screen: the panel
    // keeps it in view if the layout moved it, and lets it go if the
    // wheel took it out of view.
    in-out property <int> reveal: 0;
    in-out property <bool> by-key: true;
    in-out property <length> reveal-x;
    in-out property <length> reveal-y;
    in-out property <length> reveal-height;
    // A key a focused slider does not take, for the window's own:
    // counted up, and the key.
    in-out property <int> passed: 0;
    in-out property <KeyEvent> passed-key;
}

// The reading of typed numbers, one place for every field: the Rust
// side answers both callbacks, so a slider's shown text and what is
// typed over it are read by the same code.
export global Typing {
    // The shown text as a field starts it: its number alone, the +
    // sign and the unit off ("+0.40 EV" edits as "0.40").
    pure callback editable(string) -> string;
    // What a typed text sets: its number over the scale, clamped to
    // the minimum and the maximum.
    pure callback parse(string, float, float, float) -> TypedNumber;
    // Counted up each time a field lets go of the keyboard, however
    // it closes: the window hands the keys back to its shortcuts, as
    // a sheet does when it closes.
    in-out property <int> done: 0;
    // Counted up at each field opened. A field closing hands the keys
    // back only while it is the last one opened, so a click from one
    // field into another leaves the new one its focus.
    in-out property <int> opened: 0;
    // A field is open. A field taken away while open (its section
    // gone with a tab) leaves this set with nobody to clear it:
    // `close-all` does, and hands the keys back itself.
    in-out property <bool> editing: false;
    // Counted up to close whatever field is open.
    in-out property <int> cancel: 0;
    // The panel's text boxes focused (the filter's words, a custom
    // aspect, the words that find a lens, a mask's name, and the
    // frame's title and keywords): each counts itself in as it takes
    // the focus and out as it loses it, so the order of the two
    // between boxes does not matter. While above zero, the pointer
    // crossing the picture leaves the keys with the box.
    in-out property <int> boxes: 0;
    public function box-focus(has: bool) {
        self.boxes = has ? self.boxes + 1 : max(0, self.boxes - 1);
    }
    // Close the open field, if any, typed text not counting: for a
    // click on a control that takes no focus (a tab, a swatch, the
    // curve, a section's header), and for a tab or a mask target
    // changed under the field.
    // A focused slider or text box lets go of the keys the same way.
    public function close-all() {
        if (self.editing) {
            self.editing = false;
            self.cancel += 1;
            self.done += 1;
        } else if (SliderKeys.holder != 0) {
            SliderKeys.holder = 0;
            self.done += 1;
        } else if (self.boxes > 0) {
            // A box taken away while focused says nothing itself.
            self.boxes = 0;
            self.done += 1;
        }
    }
}

// A reading that a click turns into a text field. Enter hands the
// typed text to `committed`, unless it is the reading's own number
// untouched (the reading is rounded, and reading it back would move
// the value); Escape, the focus going elsewhere or `close-all` puts
// the reading back as it was. The field starts on the reading's
// number alone, all selected.
export component ValueField inherits Rectangle {
    in property <string> shown;
    in property <bool> enabled: true;
    // Drawn as a field at rest too, not only while typed in.
    in property <bool> boxed: false;
    in property <TextHorizontalAlignment> alignment: right;
    // What the field is of, for a screen reader.
    in property <string> label;
    out property <bool> editing: false;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.shown;
    accessible-enabled: root.enabled;
    callback committed(string);
    // A slider's field: Up and Down nudge the value, with Shift by
    // the bigger step, and Tab and Shift+Tab go on to the next and the
    // previous slider's field; what was typed is set first, as Enter
    // sets it.
    in property <bool> nudges: false;
    callback nudged(int, bool);
    callback tabbed(int);
    // Which opening this is, against `Typing.opened`.
    property <int> ticket: 0;
    property <int> cancels: Typing.cancel;
    changed cancels => {
        if (root.editing) { root.close(); }
    }
    // Disabled while typed in: what was typed does not count.
    changed enabled => {
        if (!root.enabled && root.editing) { root.close(); }
    }
    public function edit() {
        if (root.enabled) {
            Typing.opened += 1;
            root.ticket = Typing.opened;
            Typing.editing = true;
            root.editing = true;
        }
    }
    function close() {
        root.editing = false;
        if (Typing.opened == root.ticket) {
            Typing.editing = false;
            Typing.done += 1;
        }
    }
    // Closed from outside: a Tab with no field past this one.
    public function finish() {
        if (root.editing) { root.close(); }
    }
    // The typed text set, unless it is the reading's own.
    function take(typed: string) {
        if (typed != Typing.editable(root.shown)) { root.committed(typed); }
    }
    border-radius: Theme.radius-sm;
    border-width: root.editing || root.boxed ? 1px : 0;
    border-color: root.editing ? Theme.focus-ring : Theme.border;
    background: root.editing || root.boxed ? Theme.base : transparent;
    TouchArea {
        enabled: root.enabled && !root.editing;
        mouse-cursor: root.enabled ? MouseCursor.text : MouseCursor.default;
        clicked => { root.edit(); }
    }
    if !root.editing: Text {
        x: root.boxed ? Theme.space-1 : 0;
        width: parent.width - 2 * self.x;
        height: 100%;
        text: root.shown;
        color: root.enabled ? Theme.text-secondary : Theme.text-muted;
        font-size: Theme.font-sm;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.editing: TextInput {
        // The field itself is the text input a screen reader meets;
        // this would say the same text again.
        accessible-role: none;
        x: Theme.space-1;
        width: parent.width - 2 * Theme.space-1;
        height: 100%;
        text: Typing.editable(root.shown);
        single-line: true;
        color: Theme.text;
        font-size: Theme.font-sm;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
        init => {
            self.focus();
            self.select-all();
        }
        accepted => {
            let typed = self.text;
            root.close();
            if (typed != Typing.editable(root.shown)) { root.committed(typed); }
        }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            if (root.nudges && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                    root.take(self.text);
                    root.nudged(e.text == Key.UpArrow ? 1 : -1, e.modifiers.shift);
                    self.text = Typing.editable(root.shown);
                    self.select-all();
                    return accept;
                }
                if (e.text == Key.Tab || e.text == Key.Backtab) {
                    root.take(self.text);
                    self.text = Typing.editable(root.shown);
                    self.select-all();
                    root.tabbed(e.text == Key.Backtab || e.modifiers.shift ? -1 : 1);
                    return accept;
                }
            }
            return reject;
        }
        // Clicked away: nothing typed counts, and the keys go back.
        changed has-focus => {
            if (!self.has-focus && root.editing) { root.close(); }
        }
    }
}

// A slider's steps for the keys, in its value (in stops on a
// logarithmic one): an arrow, plus or minus, and an arrow with Shift;
// and the fine step, of an arrow or a wheel's click with Ctrl.
export struct Nudge {
    small: float,
    big: float,
    fine: float,
}

// Every slider's steps, one table: each slider names its line. The
// steps are the ones Lightroom's hand expects, read in what the slider
// shows: a tenth and a third of a stop on exposure, 1 and 10 on a
// slider shown 0 to 100 or -100 to +100. The fine step is a tenth of
// the small one, or the least the slider's number shows where that is
// more: a line shown no finer than its small step has no finer step.
export global Steps {
    // Exposure, and the vignette's amount, in EV over ±5.
    out property <Nudge> exposure: { small: 0.1, big: 1 / 3, fine: 0.01 };
    // Highlights, shadows and whites, in EV over ±2.
    out property <Nudge> tone: { small: 0.05, big: 0.25, fine: 0.01 };
    // Blacks, ±30 % shown: 1 and 5.
    out property <Nudge> blacks: { small: 0.01, big: 0.05, fine: 0.01 };
    // Contrast's multiplier, in stops over two. Shown as the
    // multiplier, where a finer step in stops would not always show.
    out property <Nudge> contrast: { small: 0.02, big: 0.2, fine: 0.02 };
    // Shown as a percent, 0 to 100, ±100, or 0 to 200 (a 0 to 1, ±1,
    // or 0 to 2 value): 1 and 10.
    out property <Nudge> percent: { small: 0.01, big: 0.1, fine: 0.01 };
    // Shown to two places: a radius, a grain's size.
    out property <Nudge> hundredths: { small: 0.01, big: 0.1, fine: 0.01 };
    // Shown to two places over a range of a few: the black and white
    // strength, the denoise's strength.
    out property <Nudge> twentieths: { small: 0.05, big: 0.25, fine: 0.01 };
    // The black and white weight, shown as weighed by the strength,
    // where a finer step than the small one can hide.
    out property <Nudge> weight: { small: 0.05, big: 0.25, fine: 0.05 };
    // Shown to one place: an angle, a keystone, a radius in pixels, a
    // margin.
    out property <Nudge> tenths: { small: 0.1, big: 1, fine: 0.1 };
    // Shown to one place in halves: the mark's size, the border.
    out property <Nudge> halves: { small: 0.5, big: 5, fine: 0.1 };
    // A whole number to 100: a quality, an opacity, a count, a
    // threshold.
    out property <Nudge> whole: { small: 1, big: 10, fine: 1 };
    // An angle on the hue circle.
    out property <Nudge> degrees: { small: 1, big: 10, fine: 1 };
    // The tint's hue, whose wheel step is a tenth of a degree.
    out property <Nudge> tenth-degrees: { small: 0.1, big: 1, fine: 0.1 };
    // A hue's shift, ±30°.
    out property <Nudge> hue-shift: { small: 1, big: 5, fine: 1 };
    // White balance in kelvin, 2000 to 12000.
    out property <Nudge> kelvin: { small: 50, big: 500, fine: 5 };
    // A mask's white as an offset from the global's, mired.
    out property <Nudge> mired: { small: 1, big: 10, fine: 1 };
    // Shown to three places, or a tenth of a percent: the tint, a
    // chroma, a brush's or a repair's size.
    out property <Nudge> thousandths: { small: 0.001, big: 0.01, fine: 0.001 };
    // The lens's manual distortion, shown to a tenth over ±50.
    out property <Nudge> distortion: { small: 0.005, big: 0.05, fine: 0.001 };
    // The lens's red and blue scale, shown to a tenth over ±10.
    out property <Nudge> fringe: { small: 0.0001, big: 0.001, fine: 0.0001 };
}

// A slider: label, track with fill, handle, value. A click on the
// track jumps the value there; a press on the handle grabs it without
// moving it, then drags it once the pointer clears a small dead zone.
// Shift held on a drag moves it a tenth as far. Double-click
// restores the default. A click on the value types one: Enter sets it
// as a drag would, clamped to the range, and Escape leaves the value
// alone.
//
// Focused, by a click or a key, it holds the keys until a click, Tab,
// comma, period or Escape moves them on: the four arrows, and plus
// and minus (= and _ with them), nudge by its small step, an arrow
// with Shift by its big one and with Ctrl by its fine one, as a drag
// moves it; comma and period focus the previous and the next slider
// in the panel; Escape gives the keys
// back to the window. Tab is Slint's own, to the next control. Every
// other key is the window's, as if nothing had the focus: a rating, a
// flag, an undo.
export component EditSlider inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> default: 0;
    // A wheel's click, and the step a screen reader is told of.
    in property <float> step: 0.01;
    // Its line of `Steps`, for the keys.
    in property <Nudge> steps;
    in-out property <float> value: 0;
    in property <bool> enabled: true;
    // A track painted with the colors the slider moves between, as
    // the mixer's hue slider is. The fill is left off so the gradient
    // shows the whole way.
    in property <bool> tinted: false;
    in property <brush> tint;
    // A track in stops rather than in the value: the thumb sits at
    // the log of the value, so a multiplier's neutral, 1 between 0.5
    // and 2, is at the center as the signed sliders' zeros are, and
    // halving and doubling are the same distance from it. The step
    // and a wheel notch are then in stops too.
    in property <bool> logarithmic: false;
    // The shown number over the value: 100 for a value shown as a
    // percent or as -100 to +100, 1 for one shown as it is. A number
    // typed over the value is read back through it. A logarithmic
    // slider shows its multiplier, so a typed one is the multiplier.
    in property <float> scale: 1;
    callback changed(float);
    // A slider whose default is not a number of its own: the
    // double-click calls `reset` and leaves the value to the owner.
    in property <bool> owner-resets: false;
    callback reset();
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-enabled: root.enabled;

    height: Theme.control-height;
    // The develop panel's label column, or wider for a block whose
    // labels run long; the sliders of one block share it so their
    // tracks line up.
    in property <length> label-width: LabelColumn.width;
    property <length> value-width: 60px;
    property <length> track-left: label-width;
    property <length> track-right: self.width - value-width;
    property <length> track-width: track-right - track-left;
    property <float> fraction: root.logarithmic
        ? log(value / minimum, 2) / log(maximum / minimum, 2)
        : (value - minimum) / (maximum - minimum);
    property <bool> active: enabled && (ta.has-hover || ta.pressed || fs.has-focus);
    property <float> scroll-acc: 0;
    property <length> scroll-delta;
    property <float> notch: 40;
    property <length> handle-center-x: track-left + root.fraction * track-width;
    // A press within the handle does not move it: a click to focus, or
    // to then use the wheel, must not nudge the value. A drag off the
    // handle starts moving it only past this dead zone (the same 4px
    // the viewport uses to tell a click from a drag), and from the
    // zone's edge on, so the value leaves its press value smoothly
    // rather than with the zone's 4px at once.
    property <length> drag-dead-zone: 4px;
    property <bool> handle-grabbed: false;
    // A press on the track but off the handle still jumps, and drags
    // by following the pointer from there, as it always has. A press
    // on the label or the value text does neither: focus only.
    property <bool> track-armed: false;
    property <bool> dragging: false;
    // The value being set: a drag under way (`dragging` is left set
    // until the next press, so the pointer's hold is what ends it), or
    // a wheel's or a key's step within the last moment. The viewport
    // lays its grid on while the Angle slider says so.
    out property <bool> moving: (root.dragging && ta.pressed) || root.stepped;
    property <bool> stepped: false;
    // Steps counted, and the count the timer last saw: it lets go only
    // after a whole interval with no step, so a slow turn of the wheel
    // does not blink the grid between notches.
    property <int> step-count: 0;
    property <int> step-seen: 0;
    Timer {
        interval: 1s;
        running: root.stepped;
        triggered => {
            if (root.step-count == root.step-seen) {
                root.stepped = false;
            } else {
                root.step-seen = root.step-count;
            }
        }
    }
    property <length> press-x;
    // A drag moves the track's fraction by the pointer's travel from
    // an anchor: a point and the fraction there, unclamped so that a
    // drag past an end and back comes back where it left. Shift held
    // moves it a tenth as far; pressed or let go mid-drag, the anchor
    // moves to the last point at the value shown there, so the value
    // carries on from where it is.
    property <length> anchor-x;
    property <float> anchor-fraction;
    property <length> last-x;
    property <bool> fine-drag: false;
    property <bool> fine-held: false;

    function set-fraction(f: float) {
        value = root.logarithmic
            ? clamp(minimum * pow(maximum / minimum, clamp(f, 0, 1)), minimum, maximum)
            : clamp(minimum + clamp(f, 0, 1) * (maximum - minimum), minimum, maximum);
        changed(value);
    }
    function set-from(x: length) {
        root.set-fraction((x - track-left) / track-width);
    }
    function drag-gain(fine: bool) -> float {
        return fine ? 0.1 : 1;
    }
    function drag-fraction(x: length) -> float {
        return root.anchor-fraction + (x - root.anchor-x) / track-width * root.drag-gain(root.fine-drag);
    }
    function begin-drag(x: length, fraction: float) {
        root.dragging = true;
        root.anchor-x = x;
        root.anchor-fraction = fraction;
        root.last-x = x;
        root.fine-drag = root.fine-held;
    }
    function drag-to(x: length) {
        if (root.fine-held != root.fine-drag) {
            // Clamped here alone: fine-tuning back from past an end
            // starts at the end, not ten times the overshoot away.
            root.anchor-fraction = clamp(root.drag-fraction(root.last-x), 0, 1);
            root.anchor-x = root.last-x;
            root.fine-drag = root.fine-held;
        }
        root.last-x = x;
        root.set-fraction(root.drag-fraction(x));
    }
    // Disabled while it held the focus (a FocusScope keeps it), its
    // step keys are still its own, taken and doing nothing.
    function nudge(by: float) {
        if (!root.enabled) { return; }
        value = root.logarithmic
            ? clamp(value * pow(2, by), minimum, maximum)
            : clamp(value + by, minimum, maximum);
        root.step-count += 1;
        root.stepped = true;
        changed(value);
    }
    function bump(way: int, big: bool) {
        root.nudge(way * (big ? root.steps.big : root.steps.small));
    }
    // A wheel's click with Ctrl: the fine step, or the slider's own
    // wheel step where that is finer still.
    function wheel-step(fine: bool) -> float {
        return fine ? min(root.step, root.steps.fine) : root.step;
    }

    // Its number among the sliders, for `SliderKeys`: handed out when
    // first wanted, not at its making, so that building the panel
    // writes nothing.
    property <int> number: 0;
    function me() -> int {
        if (root.number == 0) {
            SliderKeys.count += 1;
            root.number = SliderKeys.count;
        }
        return root.number;
    }
    // Ask for the next slider down (1) or up (-1), to focus it or to
    // open its field.
    function ask(way: int, field: bool) {
        SliderKeys.asker = root.me();
        SliderKeys.way = way;
        SliderKeys.field = field;
        SliderKeys.from-x = root.absolute-position.x;
        SliderKeys.from-y = root.absolute-position.y;
        SliderKeys.from-width = root.width;
        SliderKeys.best = 0;
        SliderKeys.asked += 1;
    }
    function reveal() {
        SliderKeys.by-key = true;
        root.show();
    }
    function show() {
        SliderKeys.reveal-x = root.absolute-position.x + root.width / 2;
        SliderKeys.reveal-y = root.absolute-position.y;
        SliderKeys.reveal-height = root.height;
        SliderKeys.reveal += 1;
    }
    // Where it is while it has the keys, followed so that the panel
    // keeps it in view.
    property <length> held-y: fs.has-focus ? root.absolute-position.y : 0px;
    changed held-y => {
        if (fs.has-focus) {
            SliderKeys.by-key = false;
            root.show();
        }
    }
    // The first round: put itself forward if it is past the asker in
    // its column and nearer than the best so far. Not a disabled
    // slider; one in a folded section is out of every column.
    property <int> asked: SliderKeys.asked;
    changed asked => {
        if (SliderKeys.asker == root.number) {
            SliderKeys.settled += 1;
            return;
        }
        if (!root.enabled) { return; }
        let mid = root.absolute-position.x + root.width / 2;
        if (abs(mid - (SliderKeys.from-x + SliderKeys.from-width / 2)) > SliderKeys.from-width / 2) { return; }
        let y = root.absolute-position.y;
        if (SliderKeys.way > 0 && y > SliderKeys.from-y + 1px
            && (SliderKeys.best == 0 || y < SliderKeys.best-y)) {
            SliderKeys.best = root.me();
            SliderKeys.best-y = y;
        }
        if (SliderKeys.way < 0 && y < SliderKeys.from-y - 1px
            && (SliderKeys.best == 0 || y > SliderKeys.best-y)) {
            SliderKeys.best = root.me();
            SliderKeys.best-y = y;
        }
    }
    // The second: the nearest takes the focus or opens its field. A
    // field with none past it closes, as Enter would close it.
    property <int> settled: SliderKeys.settled;
    changed settled => {
        if (SliderKeys.best != 0 && SliderKeys.best == root.number) {
            if (SliderKeys.field) { field.edit(); } else { fs.focus(); }
            root.reveal();
        } else if (SliderKeys.best == 0 && SliderKeys.asker == root.number && SliderKeys.field) {
            field.finish();
        }
    }

    label-words := Text {
        // Said by the slider, which it names.
        accessible-role: none;
        x: 0;
        width: label-width - Theme.space-2;
        text: root.label;
        color: root.enabled ? Theme.text : Theme.text-muted;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        overflow: elide;
        height: 100%;
    }
    track := Rectangle {
        x: track-left;
        width: track-width;
        y: (root.height - self.height) / 2;
        height: root.active ? 5px : 4px;
        border-radius: self.height / 2;
        background: root.tinted && root.enabled ? root.tint
            : root.enabled ? Theme.border-strong
            : Theme.border;
        animate height { duration: Theme.quick; }
        Rectangle {
            visible: !root.tinted;
            x: 0;
            width: root.fraction * track.width;
            height: 100%;
            border-radius: parent.border-radius;
            background: !root.enabled ? Theme.text-muted
                : ta.pressed ? Theme.accent-pressed
                : root.active ? Theme.accent-hover
                : Theme.accent;
        }
    }
    handle := Rectangle {
        property <length> size: root.active ? 16px : 14px;
        x: root.handle-center-x - self.width / 2;
        y: (root.height - self.height) / 2;
        width: size;
        height: size;
        border-radius: self.width / 2;
        background: !root.enabled ? Theme.text-muted : ta.pressed ? Theme.text-strong : Theme.text;
        border-width: fs.has-focus ? 2px : 0;
        border-color: Theme.focus-ring;
        animate width, height { duration: Theme.quick; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                // The window takes the keys back, as from a field.
                Typing.done += 1;
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt && !e.modifiers.meta) {
                if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                    root.nudge(root.steps.fine);
                    return accept;
                }
                if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                    root.nudge(-root.steps.fine);
                    return accept;
                }
            }
            if (!e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                // Shift is the big step on an arrow only: on some
                // boards Shift with plus or minus is another key.
                if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                    root.bump(1, e.modifiers.shift);
                    return accept;
                }
                if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                    root.bump(-1, e.modifiers.shift);
                    return accept;
                }
                if (e.text == "+" || e.text == "=") { root.bump(1, false); return accept; }
                if (e.text == "-" || e.text == "_") { root.bump(-1, false); return accept; }
                if (e.text == ",") { root.ask(-1, false); return accept; }
                if (e.text == ".") { root.ask(1, false); return accept; }
            }
            // Slint's own move to the next control.
            if (e.text == Key.Tab || e.text == Key.Backtab) { return reject; }
            SliderKeys.passed-key = e;
            SliderKeys.passed += 1;
            return accept;
        }
        changed has-focus => {
            if (self.has-focus) {
                SliderKeys.holder = root.me();
            } else if (SliderKeys.holder == root.number) {
                SliderKeys.holder = 0;
            }
        }
        // Reached by Tab from above or below the panel's view.
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) { root.reveal(); }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(e) => {
            // Shift as of this event, read by `moved` straight after a
            // move's.
            root.fine-held = e.modifiers.shift;
            if (e.button != PointerEventButton.left) { return; }
            if (e.kind == PointerEventKind.down) {
                fs.focus();
                root.press-x = self.mouse-x;
                root.dragging = false;
                root.handle-grabbed = abs(self.mouse-x - root.handle-center-x) <= handle.size / 2;
                root.track-armed = !root.handle-grabbed
                    && self.mouse-x >= track-left && self.mouse-x <= track-right;
                if (root.track-armed) {
                    // Away from the handle, the track still jumps the
                    // value straight to where the pointer went down,
                    // and a drag goes on from there. The drag first, so
                    // the jump's change already says the value is moving.
                    root.begin-drag(self.mouse-x, (self.mouse-x - track-left) / track-width);
                    root.set-from(self.mouse-x);
                }
                // A press on the label or the value text just focuses:
                // no jump, no drag latch.
            }
        }
        moved => {
            if (!self.pressed) { return; }
            if (root.handle-grabbed && !root.dragging) {
                if (abs(self.mouse-x - root.press-x) <= root.drag-dead-zone) { return; }
                // From the zone's edge on the pointer's side, at the
                // value it was pressed at.
                root.begin-drag(
                    root.press-x + (self.mouse-x > root.press-x ? root.drag-dead-zone : -root.drag-dead-zone),
                    root.fraction);
            }
            if (root.dragging) {
                root.drag-to(self.mouse-x);
            }
        }
        double-clicked => {
            if (root.owner-resets) {
                root.reset();
            } else {
                root.value = root.default;
                root.changed(root.value);
            }
        }
        // The wheel moves a focused slider, or any slider with Shift
        // held; otherwise it passes through. Ctrl with it is the fine
        // step, notches counted the same. A mouse wheel's click is
        // one step: one event of a notch or more, whatever the
        // platform makes a click in pixels (60 on one, 15 on another),
        // so clicks never add up to two steps and never to none. A
        // touchpad's small deltas add up to steps. A positive delta
        // moves content right or down. A Mac turns a wheel's
        // vertical scroll with Shift held into a horizontal one of
        // the same sign, so a sideways delta under Shift is read as
        // the vertical it was; a negative sideways delta without
        // Shift, content moving left, is a move right, read as up. Under
        // natural scrolling the delta is the content's way, against
        // the fingers, so it is turned back: a slider follows the
        // swipe, not the content.
        scroll-event(e) => {
            if (!root.enabled || !(e.modifiers.shift || fs.has-focus)) { return reject; }
            let d = e.delta-y != 0 ? e.delta-y : (e.modifiers.shift ? e.delta-x : -e.delta-x);
            root.scroll-delta = SliderKeys.natural ? -d : d;
            if (abs(root.scroll-delta) >= root.notch * 1px) {
                root.scroll-acc = 0;
                root.nudge((root.scroll-delta > 0 ? 1 : -1) * root.wheel-step(e.modifiers.control));
                return accept;
            }
            root.scroll-acc += root.scroll-delta / 1px;
            if (abs(root.scroll-acc) >= root.notch) {
                root.nudge((root.scroll-acc > 0 ? 1 : -1) * root.wheel-step(e.modifiers.control));
                root.scroll-acc = 0;
            }
            return accept;
        }
    }
    // Over the track's touch area, so a click on the value types
    // one instead of focusing the slider.
    field := ValueField {
        x: track-right + Theme.space-2;
        width: value-width - Theme.space-2;
        y: (root.height - self.height) / 2;
        height: Theme.control-height - 4px;
        shown: root.text;
        // Spoken by a screen reader: the typed value of the slider named {}
        label: @tr("{} value", root.label);
        enabled: root.enabled;
        nudges: true;
        nudged(way, big) => { root.bump(way, big); }
        tabbed(way) => { root.ask(way, true); }
        committed(typed) => {
            let entered = Typing.parse(typed, root.scale, root.minimum, root.maximum);
            if (entered.ok) {
                root.value = entered.value;
                root.changed(root.value);
            }
        }
    }
}

// One of a `RangeSlider`'s two handles: `EditSlider`'s, which takes
// the keys by Tab, an arrow a stop each way (`step`), the arrow let go
// or the keys gone elsewhere `done`. (The panel's view scrolls a handle
// Tab reaches into view of itself.) Escape hands the keys back; any
// other key is the window's, as a slider's is. A screen reader is told
// its stop as the value, among the stops it can reach (`first` to
// `last`), and the folder's value there as the description; its
// increment and decrement are a step and done at once.
component RangeHandle inherits Rectangle {
    in property <bool> active;
    in property <bool> pressed;
    in property <string> label;
    in property <string> shown;
    in property <int> stop;
    in property <int> first;
    in property <int> last;
    callback step(int);
    callback done();
    out property <bool> focused: fs.has-focus;
    property <length> size: root.active || fs.has-focus ? 16px : 14px;
    width: self.size;
    height: self.size;
    border-radius: self.size / 2;
    background: root.pressed ? Theme.text-strong : Theme.text;
    border-width: fs.has-focus ? 2px : 0;
    border-color: Theme.focus-ring;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.stop;
    accessible-description: root.shown;
    accessible-value-minimum: root.first;
    accessible-value-maximum: root.last;
    accessible-value-step: 1;
    accessible-action-increment => { root.step(1); root.done(); }
    accessible-action-decrement => { root.step(-1); root.done(); }
    animate width, height { duration: Theme.quick; }
    property <int> number: 0;
    function arrow(e: KeyEvent) -> bool {
        return !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta
            && (e.text == Key.UpArrow || e.text == Key.RightArrow
                || e.text == Key.DownArrow || e.text == Key.LeftArrow);
    }
    function me() -> int {
        if (root.number == 0) {
            SliderKeys.count += 1;
            root.number = SliderKeys.count;
        }
        return root.number;
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                Typing.done += 1;
                return accept;
            }
            if (root.arrow(e)) {
                root.step(e.text == Key.UpArrow || e.text == Key.RightArrow ? 1 : -1);
                return accept;
            }
            if (e.text == Key.Tab || e.text == Key.Backtab) { return reject; }
            SliderKeys.passed-key = e;
            SliderKeys.passed += 1;
            return accept;
        }
        // The arrow let go: a held arrow's repeats were one move.
        key-released(e) => {
            if (root.arrow(e)) {
                root.done();
                return accept;
            }
            return reject;
        }
        changed has-focus => {
            if (self.has-focus) {
                SliderKeys.holder = root.me();
            } else {
                root.done();
                if (SliderKeys.holder == root.number) {
                    SliderKeys.holder = 0;
                }
            }
        }
    }
}

// A range over a row of values: a track and two handles, each on one
// of the stops of `values`, spaced evenly whatever the values are, so
// ISO's 100 to 102400 is as easy to set as a zoom's 24 to 70. The ends
// are the owner's (`low`, `high`), and the slider only holds one
// (`holding`), shown where it is held, until it asks to move it
// through `asked` and the owner moves it. A handle only drags: a press
// on one holds it and its release asks; a press off the handles moves
// nothing. Of two within a press of each other, the drag's way picks
// one. An arrow holds a focused end a stop at a time and asks when it
// is let go, so a held arrow is one move, as a drag is. A double-click
// asks for the whole range (`reset`), unless either press moved an
// end. New `values` under a hold let it go, asking nothing: its stop
// is the old values'. The look is `EditSlider`'s, its fill drawn
// between the handles and only while `on`. A press takes no focus, as
// the filter's chips take none: in culling the arrows are the frames'.
export component RangeSlider inherits Rectangle {
    in property <[string]> values;
    in property <int> low: 0;
    in property <int> high: 1;
    in property <bool> on: false;
    in property <string> label;
    /// An end asked to move, 0 the low and 1 the high, to a stop.
    callback asked(int, int);
    callback reset();
    /// The end a press holds (-1 none) and the stop it is shown on.
    callback holding(int, int);
    property <int> last: max(1, root.values.length - 1);
    // Half a handle each side, so a handle at an end stays inside.
    property <length> inset: 8px;
    property <length> track-width: root.width - 2 * root.inset;
    // The end a press or an arrow holds (-1 none), its stop, and the
    // value there when it was held; a press on two handles waits for
    // the drag's way to pick one.
    property <int> held: -1;
    property <int> held-at: 0;
    property <string> held-value;
    property <bool> keyed: false;
    property <bool> undecided: false;
    // Whether this press moved an end, and whether the one before did:
    // Slint takes a click soon after a drag, near its press, for a
    // double-click's second.
    property <bool> dragged: false;
    property <bool> dragged-before: false;
    property <length> press-x;
    property <int> shown-low: root.held == 0 ? root.held-at : root.low;
    property <int> shown-high: root.held == 1 ? root.held-at : root.high;
    property <bool> active: ta.has-hover || ta.pressed || lo.focused || hi.focused;
    function x-of(i: int) -> length {
        return root.inset + root.track-width * i / root.last;
    }
    function stop-at(x: length) -> int {
        return clamp(round((x - root.inset) / root.track-width * root.last), 0, root.last);
    }
    // An end held on a stop, kept on its side of the other; -1 none.
    function hold(end: int, at: int) {
        let to = clamp(end == 0 ? min(at, root.high) : max(at, root.low), 0, root.last);
        if (end >= 0 && end == root.held && to != root.held-at) {
            root.dragged = true;
        }
        root.held-at = to;
        root.held = end;
        root.held-value = end >= 0 ? root.values[to] : "";
        root.holding(end, to);
    }
    // Let go of the hold, asking nothing.
    function drop() {
        root.undecided = false;
        root.keyed = false;
        root.hold(-1, 0);
    }
    // The held end let go, and asked to its stop if it moved there.
    function let-go() {
        let end = root.held;
        let to = min(root.held-at, root.last);
        root.drop();
        if (end >= 0 && to != (end == 0 ? root.low : root.high)) {
            root.asked(end, to);
        }
    }
    // An arrow: the end held a stop on, asked when the arrow is let go.
    function step(end: int, way: int) {
        if (root.held != end) {
            root.let-go();
            root.keyed = true;
            root.hold(end, (end == 0 ? root.low : root.high) + way);
        } else {
            root.hold(end, root.held-at + way);
        }
    }
    // The arrow let go, or the keys gone: a key's hold asked for.
    function stepped() {
        if (root.keyed) { root.let-go(); }
    }
    // The stops read again under a hold: if its stop is no longer the
    // value it was held on, the hold is the old values' and goes.
    changed values => {
        if (root.held >= 0 && (root.held-at > root.last || root.values[root.held-at] != root.held-value)) {
            root.drop();
        }
    }
    track := Rectangle {
        x: root.inset;
        width: root.track-width;
        y: (root.height - self.height) / 2;
        height: root.active ? 5px : 4px;
        border-radius: self.height / 2;
        background: Theme.border-strong;
        animate height { duration: Theme.quick; }
        Rectangle {
            visible: root.on;
            x: root.x-of(root.shown-low) - root.inset;
            width: root.x-of(root.shown-high) - root.x-of(root.shown-low);
            height: 100%;
            background: ta.pressed ? Theme.accent-pressed : root.active ? Theme.accent-hover : Theme.accent;
        }
    }
    // Under the touch area, so a press on a handle is the drag's and
    // does not focus it.
    lo := RangeHandle {
        x: root.x-of(root.shown-low) - self.width / 2;
        y: (root.height - self.height) / 2;
        active: root.active;
        pressed: ta.pressed && root.held == 0;
        label: root.label;
        shown: root.values[root.shown-low];
        stop: root.shown-low;
        first: 0;
        last: root.shown-high;
        step(way) => { root.step(0, way); }
        done => { root.stepped(); }
    }
    hi := RangeHandle {
        x: root.x-of(root.shown-high) - self.width / 2;
        y: (root.height - self.height) / 2;
        active: root.active;
        pressed: ta.pressed && root.held == 1;
        label: root.label;
        shown: root.values[root.shown-high];
        stop: root.shown-high;
        first: root.shown-low;
        last: root.last;
        step(way) => { root.step(1, way); }
        done => { root.stepped(); }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.cancel) {
                root.drop();
                return;
            }
            if (e.button != PointerEventButton.left) {
                // Another button pressed mid-drag ends the drag, asking
                // nothing: its release lets go of the pointer, and the
                // left's release may come where no `up` reaches us.
                if (e.kind == PointerEventKind.down && !root.keyed) { root.drop(); }
                return;
            }
            if (e.kind == PointerEventKind.down) {
                // An arrow's hold is asked for; anything else held is a
                // drag whose release never came, and goes.
                if (root.keyed) { root.let-go(); } else { root.drop(); }
                root.press-x = self.mouse-x;
                root.dragged-before = root.dragged;
                root.dragged = false;
                let dl = abs(self.mouse-x - root.x-of(root.low));
                let dh = abs(self.mouse-x - root.x-of(root.high));
                // On a handle (half a handle each side of its middle),
                // the nearer; on both, the drag's way picks one.
                if (dl <= root.inset && dh <= root.inset) {
                    root.undecided = true;
                } else if (min(dl, dh) <= root.inset) {
                    root.hold(dl <= dh ? 0 : 1, dl <= dh ? root.low : root.high);
                }
            }
            if (e.kind == PointerEventKind.up && !root.keyed) {
                root.undecided = false;
                root.let-go();
            }
        }
        moved => {
            if (!self.pressed || root.keyed) { return; }
            if (abs(self.mouse-x - root.press-x) >= 4px) { root.dragged = true; }
            if (root.undecided) {
                if (!root.dragged) { return; }
                root.undecided = false;
                // The end the way picks, and never moved against the way
                // by this first move: a press left of both, moved right,
                // can land on a stop left of the high end it picked.
                let end = self.mouse-x < root.press-x ? 0 : 1;
                let at = root.stop-at(self.mouse-x);
                root.hold(end, end == 0 ? min(at, root.low) : max(at, root.high));
                return;
            }
            if (root.held >= 0) {
                root.hold(root.held, root.stop-at(self.mouse-x));
            }
        }
        // Before the second release's `up`, which then holds nothing.
        // Either press having moved an end, it is no double-click.
        double-clicked => {
            if (root.dragged || root.dragged-before) { return; }
            root.drop();
            root.reset();
        }
    }
}

// A switch with a label. With `follows`, `checked` is the owner's
// binding to keep: a click or a key only asks, through `toggled`, and
// the switch shows whatever the owner's state comes to.
export component Toggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> follows: false;
    callback toggled();
    // To a screen reader a switch named by its label, on or off, and
    // whether it takes a hand; the label's Text says nothing itself,
    // so the name is heard once.
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    /// Why the switch stands down, when that wants saying: at the
    /// pointer after a rest, greyed or not, and to a screen reader.
    in property <string> tip;
    accessible-description: root.tip;
    height: Theme.control-height;
    property <bool> active: enabled && (ta.has-hover || ta.pressed || fs.has-focus);
    /// The switch at the row's right edge, the label up against it on
    /// its left, rather than the switch beside the label at the left.
    /// With no label the switch keeps the right edge either way.
    in property <bool> switch-at-end: false;
    // Where the parts landed, for the tests to read.
    out property <length> label-x: lbl.x;
    out property <length> label-width: lbl.width;
    out property <length> switch-x: knob-track.x;
    out property <length> target-x: ta.x;
    out property <length> target-width: ta.width;
    property <length> gap: root.label == "" ? 0 : Theme.space-2;
    // The room the label has: the row less the switch and the gap, so
    // a label too long for it is cut and the switch never leaves it.
    property <length> room: max(0, root.width - knob-track.width - root.gap);

    lbl := Text {
        accessible-role: none;
        x: root.switch-at-end || root.label == "" ? max(0, knob-track.x - root.gap - self.width) : 0;
        width: root.label == "" ? 0 : min(self.preferred-width, root.room);
        visible: self.width > 0;
        text: root.label;
        color: root.enabled ? Theme.text : Theme.text-muted;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        overflow: elide;
        height: 100%;
    }
    knob-track := Rectangle {
        x: root.switch-at-end || root.label == "" ? max(0, root.width - self.width)
            : min(lbl.width + root.gap, max(0, root.width - self.width));
        y: (root.height - self.height) / 2;
        width: 34px;
        height: 18px;
        border-radius: 9px;
        background: !root.enabled ? Theme.border
            : root.checked ? (root.active ? Theme.accent-hover : Theme.accent)
            : (root.active ? Theme.hover : Theme.border-strong);
        border-width: fs.has-focus ? 2px : 0;
        border-color: Theme.focus-ring;
        animate background { duration: Theme.quick; }
        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.enabled ? Theme.knob : Theme.text-muted;
            animate x { duration: 120ms; easing: ease-out; }
        }
    }
    // Over the click's target alone, as the TouchArea is: a click on
    // the row's empty run falls through to what is behind, focus and
    // all, rather than taking the keys for a switch it did not flip.
    fs := FocusScope {
        x: ta.x;
        width: ta.width;
        enabled: root.enabled;
        // Disabled while it held the focus: its own keys taken and
        // nothing done, as a Switch's.
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                if (root.enabled) {
                    if (!root.follows) {
                        root.checked = !root.checked;
                    }
                    root.toggled();
                }
                return accept;
            }
            return ButtonKeys.pass(e) ? accept : reject;
        }
    }
    // The click's target, and the pointer's: the label, the gap, and
    // the switch, never the empty run of the row past them. A greyed
    // switch with a tip still hears the pointer, for the tip alone.
    ta := TipArea {
        x: min(lbl.x, knob-track.x);
        width: knob-track.x + knob-track.width - self.x;
        words: root.tip;
        enabled: root.enabled || root.tip != "";
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (!root.enabled) { return; }
            fs.focus();
            if (!root.follows) {
                root.checked = !root.checked;
            }
            root.toggled();
        }
    }
}

// A button: text, an optional icon, secondary by default.
export component PanelButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    /// For a button with a picture and no text: its name, a word or
    /// two, at the pointer after a rest.
    in property <string> words;
    // To a screen reader a button, and whether it takes a hand. A
    // worded one is named by its text, which says it; one with a
    // picture alone by its words.
    accessible-role: button;
    accessible-label: root.text != "" ? "" : root.words;
    accessible-enabled: root.enabled;
    // A screen reader's press is a click.
    accessible-action-default => {
        if (root.enabled) { root.clicked(); }
    }
    /// A menu of its own: a chevron at the right edge, which a click
    /// opens it from, as a right-click anywhere on the button does.
    in property <bool> has-menu: false;
    callback clicked();
    /// A click of the middle button: for a button with a second way to
    /// do what it does, nothing otherwise.
    callback middle-clicked();
    property <bool> middle-in;
    /// The menu asked for, at a point of the button.
    callback menu(length, length);
    /// Whether the keys are the button's: a sheet that keeps Tab
    /// within itself asks.
    out property <bool> focused: fs.has-focus;
    forward-focus: fs;
    // The focus came by a click, not the keys: no ring for it.
    property <bool> clicked-in: false;
    height: Theme.control-height;
    border-radius: Theme.radius-md;
    border-width: root.primary && root.enabled ? 0 : 1px;
    border-color: fs.has-focus ? Theme.focus-ring : Theme.border-strong;
    background: !root.enabled ? Theme.base
        : root.primary ? (ta.pressed ? Theme.accent-pressed : ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : Theme.raised);
    animate background { duration: Theme.quick; }
    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-2;
        padding-left: root.text == "" ? 0 : Theme.space-3;
        padding-right: root.text == "" ? 0 : root.has-menu ? root.chevron-w : Theme.space-3;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: !root.enabled ? Theme.text-muted : root.primary ? Theme.on-accent : Theme.text;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: !root.enabled ? Theme.text-muted : root.primary ? Theme.on-accent : Theme.text;
            font-size: Theme.font-sm;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // The chevron's strip at the right edge, which a click there
    // opens the menu from rather than clicking the button.
    out property <length> chevron-w: Theme.icon + 2 * Theme.space-2;
    if root.has-menu: Image {
        x: root.width - root.chevron-w + Theme.space-2;
        source: @image-url("icons/chevron-down.svg");
        colorize: !root.enabled ? Theme.text-muted : root.primary ? #101010 : Theme.text-secondary;
        width: Theme.icon;
        height: Theme.icon;
    }
    // A primary button's border is its fill, so its focus ring goes
    // around it instead: for the keys' focus alone, as a click's
    // would leave a ring on every button pressed.
    if root.primary && fs.has-focus && !root.clicked-in: ring := Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: Theme.radius-md + 3px;
        border-width: 2px;
        border-color: Theme.focus-ring;
    }
    fs := FocusScope {
        enabled: root.enabled;
        // The window or a popup taking the keys a moment is no new
        // focus: the button keeps how it had them.
        focus-lost(reason) => {
            if (reason != FocusReason.window-activation && reason != FocusReason.popup-activation) {
                root.clicked-in = false;
            }
        }
        key-pressed(e) => {
            // Disabled while it held the focus: its own keys taken and
            // nothing done, as a Switch's.
            if (e.text == " " || e.text == Key.Return) {
                if (root.enabled) { root.clicked(); }
                return accept;
            }
            return ButtonKeys.pass(e) ? accept : reject;
        }
    }
    ta := TipArea {
        words: root.words;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        up(e) => {
            if (e.button == PointerEventButton.middle && root.middle-in) {
                root.middle-in = false;
                if (self.mouse-x >= 0 && self.mouse-x < self.width
                        && self.mouse-y >= 0 && self.mouse-y < self.height) {
                    root.middle-clicked();
                }
            }
        }
        down(e) => {
            root.middle-in = e.button == PointerEventButton.middle;
            if (root.has-menu && e.button == PointerEventButton.right) {
                root.clicked-in = true;
                fs.focus();
                root.menu(self.mouse-x, self.mouse-y);
            }
        }
        clicked => {
            root.clicked-in = true;
            fs.focus();
            if (root.has-menu && self.mouse-x >= root.width - root.chevron-w) {
                root.menu(root.width - root.chevron-w, root.height);
            } else {
                root.clicked();
            }
        }
    }
}

// A row of choices, one selected: for a short list of named options.
// `options` are the values, which `current` and `selected` compare and
// the host keeps; `labels`, when given, are the words shown for them
// by index, so a value can stay the same in every language.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <[string]> labels;
    in-out property <string> current;
    in property <bool> enabled: true;
    /// Whether a click makes its option current itself; false for a
    /// row whose current the host sets once it has acted on the click.
    in property <bool> picks: true;
    /// Each option's words at the pointer after a rest, by index; none
    /// for an option past the list's end.
    in property <[string]> tips;
    /// Why each option cannot be chosen, by index: one with words is
    /// greyed, takes no click, and says them in place of its tip.
    in property <[string]> why-not;
    // Whether the options are all the same width, or each just wide
    // enough for its label.
    in property <bool> equal-width: false;
    // The least room each side of an option's words, when each is as
    // wide as its words: a gap between them however tight the row.
    in property <length> label-margin: 0px;
    in property <bool> rounded: true;
    in property <bool> bordered: true;
    in property <bool> padded: true;
    /// Whether Tab stops on it: one stop for the row, as a radio
    /// group's, where Left and Right move the choice at once. A click
    /// never gives it the keys, so the window's arrows stay the
    /// window's after one.
    in property <bool> tab-stop: true;
    /// The row's name to a screen reader: the words beside it, bound
    /// to that `Text`'s own, or a word of its own for a row with none.
    /// Every row has one: a screen reader would say its options with
    /// nothing to tell what they choose, and the window's walk of its
    /// controls fails on a row without (`spoken_names`).
    in property <string> name;
    callback selected(string);
    /// Whether it has the keys.
    out property <bool> focused: root.keys-here;
    height: Theme.control-height;
    border-radius: root.rounded ? Theme.radius-md : 0px;
    background: Theme.base;
    // With the keys and no option of its own to ring (`at` below), the
    // ring goes round the row.
    border-width: root.keys-here && root.at < 0 ? 2px : root.bordered ? 1px : 0px;
    border-color: root.keys-here && root.at < 0 ? Theme.focus-ring : Theme.border;
    opacity: root.enabled ? 1 : 0.45;
    // The current option's place among the first eight, -1 for none:
    // Slint has no loop to look with, and no row has more than five.
    // An option not found (none current, or one past the eighth)
    // leaves the arrows nothing to do and rings no option.
    pure function is-at(k: int) -> bool {
        return k < root.options.length && root.options[k] == root.current;
    }
    property <int> at: root.current == "" ? -1
        : root.is-at(0) ? 0
        : root.is-at(1) ? 1
        : root.is-at(2) ? 2
        : root.is-at(3) ? 3
        : root.is-at(4) ? 4
        : root.is-at(5) ? 5
        : root.is-at(6) ? 6
        : root.is-at(7) ? 7 : -1;
    // What a screen reader says the row is at: the current option's
    // words.
    property <string> spoken: root.at < 0 ? ""
        : root.at < root.labels.length ? root.labels[root.at] : root.current;
    pure function usable(i: int) -> bool {
        return i >= 0 && i < root.options.length && root.why-not[i] == "";
    }
    // The next option that can be chosen from `from` by `by`, or
    // `from` at the row's end.
    pure function next(from: int, by: int) -> int {
        if (root.usable(from + by)) { return from + by; }
        if (root.usable(from + 2 * by)) { return from + 2 * by; }
        if (root.usable(from + 3 * by)) { return from + 3 * by; }
        if (root.usable(from + 4 * by)) { return from + 4 * by; }
        if (root.usable(from + 5 * by)) { return from + 5 * by; }
        if (root.usable(from + 6 * by)) { return from + 6 * by; }
        if (root.usable(from + 7 * by)) { return from + 7 * by; }
        return from;
    }
    function pick(i: int) {
        let option = root.options[i];
        Typing.close-all();
        if (root.picks) { root.current = option; }
        root.selected(option);
    }
    // Whether its scope has the keys.
    property <bool> keys-here: false;
    // Under the options, whose clicks are their own: an option's
    // TipArea takes the press, so a click never reaches this scope
    // and never gives it the keys (`focus-on-click` aside). Only a
    // stop of the walk has one: the panel's rows take no keys at all.
    if root.tab-stop: fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        changed has-focus => { root.keys-here = self.has-focus; }
        // To a screen reader, a radio group named by its row, at its
        // current option.
        accessible-role: radio-group;
        accessible-label: root.name;
        accessible-value: root.spoken;
        key-pressed(e) => {
            let plain = !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && !e.modifiers.shift;
            if (plain && (e.text == Key.LeftArrow || e.text == Key.RightArrow)) {
                // Turned off with the keys still here (a run started),
                // or no option known to move from: taken, and nothing
                // moved.
                if (root.enabled && root.at >= 0) {
                    let to = root.next(root.at, e.text == Key.RightArrow ? 1 : -1);
                    if (to != root.at) { root.pick(to); }
                }
                return accept;
            }
            return ButtonKeys.pass(e) ? accept : reject;
        }
    }
    // A row off the walk is a radio group to a screen reader all the
    // same, named once, here, as the scope names a stop's. The Cull
    // button, one option with no name, is a button and no group; a row
    // down to one option (the denoise tiers' off alone) is its group.
    if !root.tab-stop && (root.options.length > 1 || root.name != ""): Rectangle {
        accessible-role: radio-group;
        accessible-label: root.name;
        accessible-value: root.spoken;
    }
    HorizontalLayout {
        padding: root.padded ? 3px : 0px;
        spacing: 2px;
        for option[i] in root.options: seg := Rectangle {
            property <bool> on: option == root.current;
            property <bool> usable: root.why-not[i] == "";
            border-radius: root.rounded ? Theme.radius-sm : 0px;
            background: on ? Theme.raised : (t.has-hover && root.enabled && usable ? Theme.hover : transparent);
            animate background { duration: Theme.quick; }
            // The keys' ring, on the option they move from.
            border-width: root.keys-here && i == root.at ? 2px : 0;
            border-color: Theme.focus-ring;
            // Each option a radio button, named by its words.
            accessible-role: radio-button;
            accessible-label: label.text;
            accessible-checkable: true;
            accessible-checked: on;
            accessible-action-default => {
                if (root.enabled && usable) { root.pick(i); }
            }
            min-width: root.equal-width ? 0px : label.preferred-width + 2 * root.label-margin;
            preferred-width: root.equal-width ? 0px : label.preferred-width + 2 * root.label-margin;
            label := Text {
                // Said once, by its radio button.
                accessible-role: none;
                text: i < root.labels.length ? root.labels[i] : option;
                color: !usable ? Theme.text-muted : on ? Theme.text : Theme.text-secondary;
                font-size: Theme.font-xs;
                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            t := TipArea {
                enabled: root.enabled;
                words: usable ? root.tips[i] : root.why-not[i];
                mouse-cursor: usable ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    if (!usable) { return; }
                    Typing.close-all();
                    if (root.picks) { root.current = option; }
                    root.selected(option);
                }
            }
        }
    }
}

// The keys as the window's own last saw them, counted up at each that
// goes down or up: for a held press (`CurveEditor`) that follows them,
// which the window's keys cannot reach otherwise.
export global HeldKeys {
    in-out property <int> count: 0;
    in-out property <KeyboardModifiers> modifiers;
}

// A point curve over a picture of it. The host draws the picture
// (grid, histogram, curve, points) and owns the points; this maps the
// pointer to curve coordinates, x and y in 0 to 1, y up.
export component CurveEditor inherits Rectangle {
    in property <image> picture;
    in property <bool> enabled: true;
    callback pressed(float, float);
    callback moved(float, float);
    callback released();
    callback double-clicked(float, float);
    // Its width in physical pixels as laid out, at its first layout
    // and at every change, the window's scale's among them: the
    // picture is drawn at that size.
    callback resized(float);
    property <float> physical-width: self.width / 1phx;
    // The keys as the window reported them on the last pointer event,
    // the press's and each move's: Slint calls `pointer-event` with
    // them just ahead of `moved`, so a caller reads them fresh in its
    // `pressed` and its `moved` alike.
    out property <KeyboardModifiers> modifiers;
    // Whether a press of its own is held: false again at the release,
    // and gone with the editor if a view change takes it away mid-drag,
    // which no release then reaches.
    out property <bool> held: ta.held;
    // A key gone down or up while a press of its own is held, the
    // pointer still or not: `modifiers` are the window's then. Only a
    // live, held editor hears it, so a drag its editor did not outlive
    // hears nothing.
    callback keys-changed();
    property <int> keys-seen: HeldKeys.count;
    changed keys-seen => {
        if (ta.held) {
            root.modifiers = HeldKeys.modifiers;
            root.keys-changed();
        }
    }
    height: self.width;
    init => { root.resized(self.physical-width); }
    changed physical-width => { root.resized(self.physical-width); }
    border-radius: Theme.radius-sm;
    clip: true;
    background: Theme.base;
    Image {
        width: 100%;
        height: 100%;
        source: root.picture;
        image-fit: fill;
        image-rendering: smooth;
        opacity: root.enabled ? 1 : 0.4;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.crosshair;
        // Whether the press was this area's: the release of a press
        // that closed a menu comes here without one.
        property <bool> held;
        pointer-event(e) => {
            root.modifiers = e.modifiers;
            // Cancel carries button `other`: read ahead of the filter,
            // it ends a drag the window took back.
            if (e.kind == PointerEventKind.cancel) {
                if (self.held) { root.released(); }
                self.held = false;
            } else if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    self.held = true;
                    Typing.close-all();
                    root.pressed(self.mouse-x / root.width, 1 - self.mouse-y / root.height);
                } else if (e.kind == PointerEventKind.up && self.held) {
                    self.held = false;
                    root.released();
                }
            }
        }
        moved => {
            if (self.pressed) { root.moved(self.mouse-x / root.width, 1 - self.mouse-y / root.height); }
        }
        double-clicked => {
            root.double-clicked(self.mouse-x / root.width, 1 - self.mouse-y / root.height);
        }
    }
}

// A row of color swatches, one chosen: the mixer's bands.
export component Swatches inherits Rectangle {
    in property <[color]> colors;
    in-out property <int> current: 0;
    in property <bool> enabled: true;
    // A hairline round each swatch, for shades one of which may be the
    // ground's own (a canvas grey on a section's box).
    in property <bool> ringed: false;
    /// The row's name to a screen reader, as `Segmented`'s, and each
    /// swatch's words by index: a color is nothing it can say.
    in property <string> name;
    in property <[string]> names;
    callback selected(int);
    height: Theme.control-height;
    accessible-role: radio-group;
    accessible-label: root.name;
    accessible-value: root.current < root.names.length ? root.names[root.current] : "";
    HorizontalLayout {
        spacing: Theme.space-1;
        for color[i] in root.colors: Rectangle {
            accessible-role: radio-button;
            accessible-label: i < root.names.length ? root.names[i] : "";
            accessible-checkable: true;
            accessible-checked: on;
            accessible-enabled: root.enabled;
            accessible-action-default => {
                if (root.enabled) { Typing.close-all(); root.current = i; root.selected(i); }
            }
            property <bool> on: i == root.current;
            // A pale swatch (the white canvas) under a ring of the
            // text's color would show none on a dark theme.
            property <bool> pale: color.to-hsv().value > 0.5 && color.to-hsv().saturation < 0.2;
            border-radius: self.height / 2;
            background: color;
            border-width: on ? 2px : root.ringed ? 1px : 0;
            border-color: !on ? Theme.border-strong : self.pale ? Theme.over-plate-dense : Theme.text;
            opacity: !root.enabled ? 0.3 : (on || t.has-hover) ? 1 : 0.55;
            animate opacity { duration: Theme.quick; }
            t := TouchArea {
                enabled: root.enabled;
                mouse-cursor: MouseCursor.pointer;
                clicked => { Typing.close-all(); root.current = i; root.selected(i); }
            }
        }
    }
}

// A handle of the crop: reports the pointer's travel since the press
// in window coordinates, so the handle may move under the pointer
// without the travel counting twice.
export component CropHandle inherits TouchArea {
    in property <int> id;
    in property <MouseCursor> cursor: MouseCursor.move;
    callback grabbed(int);
    callback dragged(int, length, length);
    callback dropped();
    // Alt as the window reports it on this pointer event: a move
    // carries button `other`, not `left`, so this is set before the
    // left-button check below rather than inside it — a caller that
    // cares (a linear gradient's end) reads it fresh on every move; a
    // crop handle just leaves it alone.
    out property <bool> alt: false;
    // Shift likewise, fresh on every move, for a caller whose hold
    // follows Shift through the drag.
    out property <bool> shift: false;
    // The keys held at the press, for a caller that reads them in its
    // `grabbed`.
    out property <KeyboardModifiers> press-modifiers;
    property <length> press-x;
    property <length> press-y;
    /// The middle button's press, its moves, and its release, at the
    /// point in the window: the view's, which pans or zooms by them
    /// under a handle as anywhere else on the picture.
    callback middle(PointerEvent, length, length);
    // A middle press not in a drag of the handle, whose moves and
    // release are the view's; and a left press while it is held,
    // which is neither a grab nor a drop.
    property <bool> middle-held;
    property <bool> left-ignored;
    mouse-cursor: self.middle-held ? MouseCursor.grabbing : root.cursor;
    pointer-event(e) => {
        self.alt = e.modifiers.alt;
        self.shift = e.modifiers.shift;
        if (e.button == PointerEventButton.middle) {
            if (e.kind == PointerEventKind.down && !self.pressed) {
                self.middle-held = true;
                root.middle(e, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else if (e.kind == PointerEventKind.up && self.middle-held) {
                self.middle-held = false;
                root.middle(e, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else if (e.kind == PointerEventKind.up && self.pressed && !self.left-ignored) {
                // In a drag of the handle, its release takes the
                // window's hold on the drag with it: the drag ends
                // here, and the left release, if it comes, is none.
                self.left-ignored = true;
                root.dropped();
            }
            return;
        }
        if (self.middle-held && e.kind == PointerEventKind.move) {
            root.middle(e, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            return;
        }
        if (self.middle-held && e.kind == PointerEventKind.cancel) {
            self.middle-held = false;
            root.middle(e, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
            if (self.middle-held) {
                self.left-ignored = true;
                return;
            }
            // Whatever an earlier ignored press left behind.
            self.left-ignored = false;
        }
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && self.left-ignored) {
            self.left-ignored = false;
            // Its release takes the window's hold on the pan too.
            if (self.middle-held) {
                self.middle-held = false;
                root.middle(e, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            return;
        }
        // Cancel carries button `other`, always, so it is read ahead
        // of the left-button filter below or a grab the window took
        // back mid-drag would never call `dropped`.
        if (e.kind == PointerEventKind.cancel) {
            self.left-ignored = false;
            root.dropped();
            return;
        }
        if (e.button != PointerEventButton.left) { return; }
        if (e.kind == PointerEventKind.down) {
            self.press-x = self.absolute-position.x + self.mouse-x;
            self.press-y = self.absolute-position.y + self.mouse-y;
            root.press-modifiers = e.modifiers;
            root.grabbed(root.id);
        } else if (e.kind == PointerEventKind.up) {
            root.dropped();
        }
    }
    moved => {
        if (self.pressed && !self.left-ignored) {
            root.dragged(root.id, self.absolute-position.x + self.mouse-x - self.press-x, self.absolute-position.y + self.mouse-y - self.press-y);
        }
    }
}

// A clipping mark at a corner of the histogram: a small square, lit
// in the color of the channels that clip. While its warning is
// painted over the picture the control is filled in the accent, as
// an on switch is, with the square inside it outlined dark so a lit
// square reads on the fill. Click toggles the warning.
export component ClipMark inherits Rectangle {
    in property <bool> lit;
    in property <color> mark;
    in property <bool> on;
    /// Its name to a screen reader: which end's warning it turns.
    in property <string> label;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    width: 16px;
    height: 16px;
    border-radius: Theme.radius-sm;
    background: root.on
        ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.quick; }
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: root.lit ? root.mark : transparent;
        border-width: 1px;
        border-color: root.on ? Theme.scope-ink : (root.lit ? root.mark : Theme.dark-muted);
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// What a frame carries, on its thumbnail: the flag, the stars and
// the color label, in one small pill at the corner of the picture.
// The rating is as many stars as it is rather than five with some
// filled, so a two-star frame is a quieter mark than a four-star
// one, and a frame nobody has said anything about shows nothing at
// all.
//
// The numbers are the codes `flag_code` and `label_code` make on the
// Rust side, not the meta's own spelling: a flag of 1 is a pick and
// 2 a reject, a label of 1 to 5 is red, yellow, green, blue, purple.
// `stars` is `meta::STARS`, handed down from Rust so the cap here
// and the cap there cannot drift apart; `glyph` sizes everything, so
// a badge on a large cell is not the same speck as on a small one.
export component ThumbBadges inherits Rectangle {
    in property <int> rating;
    in property <int> flag;
    in property <int> label;
    in property <int> stars: 5;
    in property <length> glyph: 9px;
    /// Over a light surround rather than a picture: a denser scrim.
    in property <bool> light-ground: false;
    property <bool> said: root.rating > 0 || root.flag > 0 || root.label > 0;
    visible: root.said;
    // What it shows, in words: "3 stars, pick, red".
    accessible-role: image;
    accessible-label: (root.rating > 0
            // Spoken by a screen reader for a thumbnail: its stars
            ? @tr("{n} star" | "{n} stars" % min(root.rating, root.stars)) : "")
        // Spoken by a screen reader for a thumbnail: its flag
        + (root.flag > 0 ? (root.rating > 0 ? ", " : "") + (root.flag == 2 ? @tr("reject") : @tr("pick")) : "")
        + (root.label > 0
            ? (root.rating > 0 || root.flag > 0 ? ", " : "")
                // Spoken by a screen reader for a thumbnail: its label
                + (root.label == 1 ? @tr("red") : root.label == 2 ? @tr("yellow") : root.label == 3 ? @tr("green")
                    // Spoken by a screen reader for a thumbnail: its label
                    : root.label == 4 ? @tr("blue") : @tr("purple"))
            : "");
    width: badges.preferred-width;
    height: root.glyph + 6px;
    border-radius: Theme.radius-sm;
    // Its own scrim: a badge must read over a white sky and a black
    // shadow alike, and what is behind it is the picture, or the
    // canvas, denser where that is white.
    background: root.light-ground ? Theme.over-plate-dense : #00000099;
    badges := HorizontalLayout {
        padding-left: root.glyph / 3;
        padding-right: root.glyph / 3;
        spacing: root.glyph / 4.5;
        alignment: center;
        if root.flag > 0: Rectangle {
            width: root.glyph;
            height: root.height;
            Image {
                source: root.flag == 2 ? @image-url("icons/x.svg") : @image-url("icons/flag.svg");
                colorize: root.flag == 2 ? Theme.label-red : Theme.over-text;
                width: root.glyph;
                height: root.glyph;
                y: (parent.height - self.height) / 2;
            }
        }
        for s in min(root.rating, root.stars): Rectangle {
            width: root.glyph;
            height: root.height;
            Image {
                source: @image-url("icons/star.svg");
                colorize: Theme.over-text;
                width: root.glyph;
                height: root.glyph;
                y: (parent.height - self.height) / 2;
            }
        }
        if root.label > 0: Rectangle {
            width: root.glyph - 2px;
            height: root.height;
            Rectangle {
                width: root.glyph - 2px;
                height: root.glyph - 2px;
                y: (parent.height - self.height) / 2;
                border-radius: (root.glyph - 2px) / 3.5;
                background: root.label == 1 ? Theme.label-red
                    : root.label == 2 ? Theme.label-yellow
                    : root.label == 3 ? Theme.label-green
                    : root.label == 4 ? Theme.label-blue
                    : Theme.label-purple;
            }
        }
    }
}

// What a frame has been through, in the corner of its picture opposite
// the badges' (rating, flag, color): a pencil for a frame whose edit
// is not the default, a picture going down for a frame exported. Both
// when both are so, nothing when neither. Quieter than the badges, in
// the secondary text color on a lighter scrim. A raw with the camera's
// JPEG beside it says so in a word, "+JPEG", after them.
export component ThumbMarks inherits Rectangle {
    in property <bool> edited;
    in property <bool> exported;
    in property <bool> collected;
    in property <bool> paired;
    in property <length> glyph: 9px;
    visible: root.edited || root.exported || root.collected || root.paired;
    width: marks.preferred-width;
    height: root.glyph + 6px;
    border-radius: Theme.radius-sm;
    background: #00000080;
    marks := HorizontalLayout {
        padding-left: root.glyph / 3;
        padding-right: root.glyph / 3;
        spacing: max(Theme.space-1, root.glyph / 4.5);
        alignment: center;
        if root.edited: Rectangle {
            width: root.glyph;
            height: root.height;
            Image {
                source: @image-url("icons/pencil.svg");
                colorize: Theme.over-text-secondary;
                width: root.glyph;
                height: root.glyph;
                y: (parent.height - self.height) / 2;
                accessible-role: image;
                // Spoken by a screen reader: a thumbnail's badge
                accessible-label: @tr("Edited");
            }
        }
        if root.exported: Rectangle {
            width: root.glyph;
            height: root.height;
            Image {
                source: @image-url("icons/image-down.svg");
                colorize: Theme.over-text-secondary;
                width: root.glyph;
                height: root.glyph;
                y: (parent.height - self.height) / 2;
                accessible-role: image;
                // Spoken by a screen reader: a thumbnail's badge
                accessible-label: @tr("Exported");
            }
        }
        if root.collected: Rectangle {
            width: root.glyph;
            height: root.height;
            Image {
                source: @image-url("icons/bookmark.svg");
                colorize: Theme.over-text-secondary;
                width: root.glyph;
                height: root.glyph;
                y: (parent.height - self.height) / 2;
                accessible-role: image;
                // Spoken by a screen reader: a thumbnail's badge
                accessible-label: @tr("In a collection");
            }
        }
        if root.paired: Text {
            text: "+JPEG";
            color: Theme.over-text-secondary;
            font-size: root.glyph;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            accessible-role: text;
            // Spoken by a screen reader: a thumbnail's badge
            accessible-label: @tr("With the camera's JPEG");
        }
    }
}

// A stack on its picture's bottom right, the corner the badges, the
// marks and a version's name leave free: the layers glyph and how many
// frames it shows on a closed stack's top, "2/5" on an open one's
// members. A click opens or closes the stack, as S does; it is drawn
// over the cell's own press so the cell does not take it. In the
// marks' quiet colors, lit while the pointer is on it.
export component ThumbStack inherits Rectangle {
    in property <int> count;
    in property <int> place;
    in property <bool> open;
    in property <length> glyph: 9px;
    /// Over a light surround rather than a picture: the denser scrim
    /// at rest too.
    in property <bool> light-ground: false;
    callback clicked();
    visible: root.count > 1;
    width: row.preferred-width;
    height: root.glyph + 6px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover || root.light-ground ? Theme.over-plate-dense : #00000080;
    accessible-role: button;
    accessible-label: root.open
        // Spoken by a screen reader: a thumbnail's stack badge
        ? @tr("Frame {} of a stack of {}, open", root.place, root.count)
        // Spoken by a screen reader: a thumbnail's stack badge
        : @tr("Stack of {}", root.count);
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: root.glyph / 3;
        padding-right: root.glyph / 3;
        spacing: root.glyph / 4.5;
        alignment: center;
        Rectangle {
            width: root.glyph;
            height: root.height;
            Image {
                source: @image-url("icons/layers.svg");
                colorize: touch.has-hover ? Theme.over-text : Theme.over-text-secondary;
                width: root.glyph;
                height: root.glyph;
                y: (parent.height - self.height) / 2;
            }
        }
        Text {
            text: root.open ? root.place + "/" + root.count : root.count;
            color: touch.has-hover ? Theme.over-text : Theme.over-text-secondary;
            font-size: root.glyph;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A version's name on the top left of its picture ("Warm"), so two
// cells of one file can be told apart; the file's own wears none. In
// the marks' quiet colors, on their scrim.
export component ThumbTag inherits Rectangle {
    in property <string> name;
    in property <length> glyph: 9px;
    /// The most it takes of the picture's width, the name elided past it.
    in property <length> most: 100px;
    visible: root.name != "";
    width: min(root.most, words.preferred-width + root.glyph * 2 / 3);
    height: root.glyph + 6px;
    border-radius: Theme.radius-sm;
    background: #00000080;
    accessible-role: text;
    // Spoken by a screen reader: a thumbnail's version badge
    accessible-label: @tr("Version {}", root.name);
    words := Text {
        x: root.glyph / 3;
        width: parent.width - root.glyph * 2 / 3;
        text: root.name;
        color: Theme.over-text-secondary;
        font-size: root.glyph + 1px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The tiles' size, the grid's and the lightbox's: a short track and a
// knob, no words (the grid's header says the size beside it, the
// lightbox shows it). `value` is where the knob sits, 0 to 1, which
// the host works out; a press on the track jumps there and a drag
// follows, each place handed back through `moved`, snapped to `steps`
// intervals when there are any (the lightbox's tiles across). With
// the keys, the arrows take a step each way through `stepped`, the
// host's own plus and minus, and Home and End the ends; every other
// key goes on to the window. `over` paints it for a dark plate over
// the pictures rather than the header's surface. A screen reader
// hears the size in logical pixels between `least` and `most`.
export component SizeSlider inherits Rectangle {
    in property <float> value;
    in property <int> steps: 0;
    in property <bool> over: false;
    in property <string> label;
    in property <string> words;
    in property <float> shown;
    in property <float> least;
    in property <float> most;
    callback moved(float);
    callback stepped(int);
    /// The press let go: the host hands the keys back.
    callback released();
    /// A drag under way, the keys held, the pointer over it.
    out property <bool> held: ta.pressed;
    out property <bool> focused: fs.has-focus;
    out property <bool> hovered: ta.has-hover;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: round(root.shown);
    accessible-value-minimum: root.least;
    accessible-value-maximum: root.most;
    // A screen reader's step: a snapping slider's interval, on average,
    // or a whole pixel.
    accessible-value-step: root.steps > 0 ? (root.most - root.least) / root.steps : 1;
    accessible-action-increment => { root.stepped(1); }
    accessible-action-decrement => { root.stepped(-1); }
    height: Theme.control-height;
    property <length> knob: 12px;
    property <length> track-x: root.knob / 2;
    property <length> track-w: max(1px, root.width - root.knob);
    property <float> at: clamp(root.value, 0, 1);
    property <bool> active: ta.has-hover || ta.pressed || fs.has-focus;
    function to(x: length) {
        let f = clamp((x - root.track-x) / root.track-w, 0, 1);
        root.moved(root.steps > 0 ? round(f * root.steps) / root.steps : f);
    }
    // The steps' marks, under the track, for a slider that snaps.
    for s in root.steps > 0 ? root.steps + 1 : 0: Rectangle {
        x: root.track-x + s / root.steps * root.track-w - 1px;
        y: (root.height - self.height) / 2;
        width: 2px;
        height: 8px;
        border-radius: 1px;
        background: root.over ? Theme.over-track : Theme.border-strong;
    }
    Rectangle {
        x: root.track-x;
        width: root.track-w;
        y: (root.height - self.height) / 2;
        height: root.active ? 5px : 4px;
        border-radius: self.height / 2;
        background: root.over ? Theme.over-track : Theme.border-strong;
        animate height { duration: Theme.quick; }
        Rectangle {
            x: 0;
            width: root.at * parent.width;
            height: 100%;
            border-radius: parent.border-radius;
            background: ta.pressed ? Theme.accent-pressed : root.active ? Theme.accent-hover : Theme.accent;
        }
    }
    Rectangle {
        x: root.track-x + root.at * root.track-w - self.width / 2;
        y: (root.height - self.height) / 2;
        width: root.active ? root.knob + 2px : root.knob;
        height: self.width;
        border-radius: self.width / 2;
        background: root.over ? Theme.over-text : ta.pressed ? Theme.text-strong : Theme.text;
        border-width: fs.has-focus ? 2px : 0;
        border-color: root.over ? Theme.accent : Theme.focus-ring;
        animate width { duration: Theme.quick; }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) { root.stepped(1); return accept; }
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) { root.stepped(-1); return accept; }
            if (e.text == Key.Home) { root.moved(0); return accept; }
            if (e.text == Key.End) { root.moved(1); return accept; }
            return ButtonKeys.pass(e) ? accept : reject;
        }
    }
    ta := TipArea {
        words: root.words;
        mouse-cursor: MouseCursor.pointer;
        down(e) => {
            if (e.button == PointerEventButton.left) {
                fs.focus();
                root.to(self.mouse-x);
            }
        }
        moved => { if (self.pressed) { root.to(self.mouse-x); } }
        up(e) => { if (e.button == PointerEventButton.left) { root.released(); } }
        // A press that never comes up hands the keys back all the same.
        canceled => { root.released(); }
    }
}

// The arrow on a panel's edge that puts the panel away and brings it
// back: a small plate over the viewport's edge, its chevron pointing
// the way the edge will move. Quiet, it shows only under the pointer,
// so a picture with everything put away is the picture alone and the
// arrows are still there to be found.
export component EdgeArrow inherits Rectangle {
    in property <image> icon;
    in property <bool> quiet: false;
    in property <string> words;
    in property <string> label;
    /// Over a light surround: a denser plate, the same at rest and
    /// under the pointer, where the chevron's brightening says it.
    in property <bool> light-ground: false;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    touch := TipArea {
        words: root.words;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        opacity: root.quiet && !touch.has-hover ? 0 : 1;
        border-radius: Theme.radius-sm;
        background: root.light-ground ? Theme.over-plate-dense : touch.has-hover ? #000000c0 : #00000080;
        Image {
            width: 14px;
            height: 14px;
            source: root.icon;
            colorize: touch.has-hover ? Theme.over-text : Theme.over-text-secondary;
        }
    }
}

// A scroll bar over the edge of something scrolled: the grid's sheet
// down its right edge, the strip along its foot, and a `ScrollPane`'s
// lists and panels. A thin thumb that widens on a track under the
// pointer, as thick as `ScrollBars` says. Not the widget: the offset
// stays the owner's, and every move the bar makes goes through
// `scroll-to`. There whenever anything scrolls, faded at rest where
// it `fades`, so a hover over the band finds it, and drawn with its
// track at rest when the bars are set to stay; a press in the band is
// the bar's and never what is under it.
export component ScrollBand inherits TouchArea {
    /// Along the foot rather than down the right edge.
    in property <bool> horizontal;
    /// How far the owner is scrolled, and how far it can be.
    in property <length> scroll;
    in property <length> max;
    /// What a screen reader calls the bar.
    in property <string> label;
    /// Whether the thumb fades away at rest; false keeps it drawn,
    /// as a list's bar is. A bar set to stay never fades.
    in property <bool> fades: true;
    /// From the band's outer edge to its track and to its thumb, and
    /// the most either may be across: a band laid over another's margin
    /// (the left pane's) keeps them to a strip of it.
    in property <length> track-inset: 2px;
    in property <length> thumb-inset: 4px;
    in property <length> most: 1000px;
    /// A drag of the thumb or a press in the track: the offset wanted,
    /// which the owner holds to its range as it holds the wheel's.
    callback scroll-to(length);
    /// The wheel over the band: its two deltas, and whether Ctrl is
    /// held.
    callback wheel(length, length, bool);
    /// The thumb's length and place, and where a drag lands, asked of
    /// the grid's arithmetic, the band's length standing for the
    /// sheet's height.
    pure callback bar-length(length, length) -> length;
    pure callback bar-offset(length, length, length) -> length;
    pure callback bar-drag(length, length, length, length) -> length;
    /// Whether the frame menu is up: a press that closes it is nothing
    /// more.
    pure callback menu-shown() -> bool;
    /// A press of a mouse's back or forward button, which the owner may
    /// take: true when it did, and the press is then nothing else.
    callback side-press(PointerEvent) -> bool;
    callback focus-keys();
    /// Shown at full strength while the owner scrolls and a moment
    /// after, then faded: every change of the scroll stamps it, and the
    /// timer below lets it sleep once a tick has passed with no new
    /// stamp. The timer runs only while it is awake, so a sheet at rest
    /// asks for no frame.
    in-out property <bool> awake;
    property <int> stamp;
    property <int> seen;
    function wake() {
        root.stamp += 1;
        root.awake = true;
    }
    changed scroll => { root.wake(); }
    Timer {
        interval: 600ms;
        running: root.awake;
        triggered => {
            if (root.seen == root.stamp && !root.pressed) {
                root.awake = false;
            }
            root.seen = root.stamp;
        }
    }
    /// The band's length, and the pointer along it.
    property <length> span: root.horizontal ? root.width : root.height;
    property <length> along: root.horizontal ? root.mouse-x : root.mouse-y;
    // While the thumb is held it follows the pointer at once, ahead of
    // the owner, which catches up at the next step below.
    property <length> thumb-at: root.bar-offset(root.span, root.max,
        root.dragging ? root.want : root.scroll);
    property <length> thumb-len: root.bar-length(root.span, root.max);
    property <bool> lit: root.has-hover || root.pressed;
    property <bool> dragging;
    property <length> from;
    property <length> press-at;
    property <bool> took;
    /// Where the held thumb puts the owner, and whether it has yet to
    /// be moved there. A fast mouse sends several moves a frame, and
    /// each move that lands the grid more than a screen away re-makes
    /// every cell and puts their pictures on again, 6 to 7 ms on a
    /// 2,000-frame folder: the moves only note the scroll, and the
    /// timer below applies the last of them, so the owner moves and
    /// reports at most once a frame.
    property <length> want;
    property <bool> pending;
    function apply() {
        root.pending = false;
        root.scroll-to(root.want);
    }
    visible: root.max > 0;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.max / 1px;
    accessible-value: round(root.scroll / 1px);
    // Lingers a moment after the pointer leaves, as after a scroll.
    changed has-hover => {
        if (!self.has-hover) { root.wake(); }
    }
    // A screen reader's step is a page, as a press in the track is.
    accessible-action-increment => { root.scroll-to(root.scroll + root.span); }
    accessible-action-decrement => { root.scroll-to(root.scroll - root.span); }
    pointer-event(e) => {
        if (root.side-press(e)) { return; }
        // A press that closes a menu is nothing more, and leaves the
        // focus to the menu's closing; any other press in the band
        // gives the keys theirs back, as the pane's controls do.
        if (e.kind == PointerEventKind.down) {
            root.took = !root.menu-shown();
            if (root.took) { root.focus-keys(); }
        }
        if (e.button != PointerEventButton.left) { return; }
        if (e.kind == PointerEventKind.up) {
            if (root.pending) { root.apply(); }
            root.dragging = false;
            // Again at the release, after a drag: only a release whose
            // press was the bar's, so a press that closed a menu is
            // still nothing.
            if (root.took) { root.focus-keys(); }
            return;
        }
        if (e.kind != PointerEventKind.down) { return; }
        root.dragging = false;
        if (!root.took) { return; }
        // Before the thumb or past it, a page that way; on it, the
        // thumb taken.
        if (root.along < root.thumb-at) {
            root.scroll-to(root.scroll - root.span);
        } else if (root.along >= root.thumb-at + root.thumb-len) {
            root.scroll-to(root.scroll + root.span);
        } else {
            root.dragging = true;
            root.from = root.scroll;
            root.want = root.scroll;
            root.press-at = root.along;
        }
    }
    moved => {
        if (root.dragging && root.pressed) {
            root.want = root.bar-drag(root.span, root.max, root.from, root.along - root.press-at);
            root.pending = true;
        }
    }
    // Runs only while a step waits, so a held thumb at rest asks for
    // nothing.
    Timer {
        interval: 16ms;
        running: root.pending;
        triggered => { root.apply(); }
    }
    // The wheel over the bar scrolls as anywhere.
    scroll-event(e) => {
        if (e.delta-x != 0px || e.delta-y != 0px) {
            root.wheel(e.delta-x, e.delta-y, e.modifiers.control);
        }
        return accept;
    }
    Rectangle {
        opacity: ScrollBars.stay || !root.fades || root.awake || root.lit ? 1 : 0;
        animate opacity { duration: 200ms; }
        // The track, round ended, as wide as the widened thumb and 2 px
        // more each side, so it keeps to the outer edge of the band and
        // a list's padding clears it.
        Rectangle {
            property <length> across: min(ScrollBars.lit + 4px, root.most);
            property <length> edge: (root.horizontal ? parent.height : parent.width) - root.track-inset;
            x: root.horizontal ? 0 : self.edge - self.across;
            y: root.horizontal ? self.edge - self.across : 0;
            width: root.horizontal ? parent.width : self.across;
            height: root.horizontal ? self.across : parent.height;
            border-radius: self.across / 2;
            background: root.lit ? Theme.scrollbar-track
                : ScrollBars.stay ? Theme.scrollbar-track-rest : transparent;
        }
        thumb := Rectangle {
            // On whole device pixels, so a 2 px thumb is crisp at a
            // fractional scale: its thickness across the band, 4 px in
            // from the outer edge, and its place and length along it.
            property <length> thick: round(min(root.lit ? ScrollBars.lit : ScrollBars.rest, root.most) / 1phx) * 1phx;
            property <length> at: round(root.thumb-at / 1phx) * 1phx;
            property <length> long: round(root.thumb-len / 1phx) * 1phx;
            property <length> edge: round(((root.horizontal ? parent.height : parent.width) - root.thumb-inset) / 1phx) * 1phx;
            animate thick { duration: 150ms; easing: ease-out; }
            x: root.horizontal ? self.at : self.edge - self.thick;
            y: root.horizontal ? self.edge - self.thick : self.at;
            width: root.horizontal ? self.long : self.thick;
            height: root.horizontal ? self.thick : self.long;
            border-radius: self.thick / 2;
            background: root.lit ? Theme.scrollbar-thumb-hover : Theme.scrollbar-thumb;
        }
    }
}

// A view that scrolls what it holds, with `ScrollBand`s down its right
// edge and along its foot in place of the std widgets' bars, so a
// list's and a panel's bar look, stay, and size as the grid's does.
// The thumb stays drawn at rest here: a view whose bar faded would
// hide that it holds more below. The thumb's arithmetic is the
// grid's: 4 px from the ends, no shorter than 24 px.
export component ScrollPane {
    out property <length> visible-width <=> flick.width;
    out property <length> visible-height <=> flick.height;
    in-out property <length> content-width <=> flick.content-width;
    in-out property <length> content-height <=> flick.content-height;
    in-out property <length> content-x <=> flick.content-x;
    in-out property <length> content-y <=> flick.content-y;
    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;
    property <length> max-x: max(0px, flick.content-width - flick.width);
    property <length> max-y: max(0px, flick.content-height - flick.height);
    // Content that gets shorter under a scroll near its foot (a section
    // folded, a mask's body changed) or a view that gets taller leaves
    // the scroll past the content's reach: room empty below it and its
    // top out of reach above. Slint's Flickable puts itself back only
    // while its content-y has no binding. The alias above is merged
    // away, but an owner's two-way binding from outside the component
    // (the right pane's `panel-scroll`, from inside an `if`) is one, so
    // we put it back here, once a change has taken it out. Where no
    // owner binds it, Slint does the same, and whichever runs first
    // leaves the other nothing to do.
    // An owner's pane on its way out (hidden, squeezed to its least
    // width until its `if` is torn down) is not kept: its content,
    // rewrapped, is shorter for a frame, and a pull then would move the
    // owner's scroll the next pane is built with.
    in property <bool> keep-in-reach: true;
    // The width of the band down the right edge that takes the bar's
    // presses. The content pads clear of it, unless it lays the band
    // over a margin of its own (the left pane's, §669).
    in property <length> band-width: ScrollBars.band;
    // Where the bar down the right edge draws in its band, as
    // `ScrollBand` takes them.
    in property <length> bar-track-inset: 2px;
    in property <length> bar-thumb-inset: 4px;
    in property <length> bar-most: 1000px;
    // Counted up at each scroll the user makes: the wheel or a flick
    // on the view, a press or a drag on a bar. A move of the view with
    // no such input (Slint revealing an item that took the focus, an
    // owner's own scroll, the content changing height) leaves it.
    out property <int> user-scrolls: 0;
    property <bool> past-y: flick.content-y < -root.max-y || flick.content-y > 0px;
    property <bool> past-x: flick.content-x < -root.max-x || flick.content-x > 0px;
    changed past-y => {
        if (self.past-y && root.keep-in-reach) { flick.content-y = clamp(flick.content-y, -root.max-y, 0px); }
    }
    changed past-x => {
        if (self.past-x && root.keep-in-reach) { flick.content-x = clamp(flick.content-x, -root.max-x, 0px); }
    }
    // Built anew (a pane hidden and shown) with an owner's scroll that
    // its content no longer reaches: a first value is no change, so we
    // look once, after the first layout has given the content its
    // height. At build its height is not laid out yet, and a look then
    // would take a good scroll back to the top.
    property <bool> looked;
    Timer {
        interval: 1ms;
        running: !root.looked && root.keep-in-reach;
        triggered => {
            root.looked = true;
            if (root.past-y) { flick.content-y = clamp(flick.content-y, -root.max-y, 0px); }
            if (root.past-x) { flick.content-x = clamp(flick.content-x, -root.max-x, 0px); }
        }
    }
    pure function track(span: length) -> length {
        return max(0px, span - 8px);
    }
    pure function thumb-length(span: length, far: length) -> length {
        if (far <= 0px || span <= 0px) { return 0px; }
        return max(root.track(span) * span / (span + far), min(24px, root.track(span)));
    }
    pure function room(span: length, far: length) -> length {
        return root.track(span) - root.thumb-length(span, far);
    }
    flick := Flickable {
        mouse-drag-pan-enabled: false;
        width: parent.width;
        height: parent.height;
        // At the input event itself, before an animated wheel moves it.
        flicked => { root.user-scrolls += 1; }
        @children
    }
    ScrollBand {
        x: parent.width - self.width;
        width: root.band-width;
        track-inset: root.bar-track-inset;
        thumb-inset: root.bar-thumb-inset;
        most: root.bar-most;
        height: root.max-x > 0 ? parent.height - ScrollBars.band : parent.height;
        fades: false;
        // Spoken by a screen reader: a scroll bar
        label: @tr("Scroll");
        scroll: -flick.content-y;
        max: root.max-y;
        scroll-to(to) => {
            root.user-scrolls += 1;
            flick.content-y = -clamp(to, 0px, root.max-y);
        }
        wheel(dx, dy, ctrl) => {
            if (dy != 0px) {
                root.user-scrolls += 1;
                flick.content-y = clamp(flick.content-y + dy, -root.max-y, 0px);
            }
        }
        bar-length(span, far) => { return root.thumb-length(span, far); }
        bar-offset(span, far, at) => {
            if (far <= 0px) { return 4px; }
            return 4px + max(0px, root.room(span, far)) * clamp(at / far, 0, 1);
        }
        bar-drag(span, far, from, by) => {
            if (far <= 0px) { return 0px; }
            if (root.room(span, far) <= 0px) { return clamp(from, 0px, far); }
            return clamp(from + by * far / root.room(span, far), 0px, far);
        }
    }
    ScrollBand {
        horizontal: true;
        x: 0px;
        y: parent.height - self.height;
        height: ScrollBars.band;
        width: root.max-y > 0 ? parent.width - ScrollBars.band : parent.width;
        fades: false;
        label: @tr("Scroll");
        scroll: -flick.content-x;
        max: root.max-x;
        scroll-to(to) => {
            root.user-scrolls += 1;
            flick.content-x = -clamp(to, 0px, root.max-x);
        }
        wheel(dx, dy, ctrl) => {
            let by = dx != 0px ? dx : dy;
            if (by != 0px) {
                root.user-scrolls += 1;
                flick.content-x = clamp(flick.content-x + by, -root.max-x, 0px);
            }
        }
        bar-length(span, far) => { return root.thumb-length(span, far); }
        bar-offset(span, far, at) => {
            if (far <= 0px) { return 4px; }
            return 4px + max(0px, root.room(span, far)) * clamp(at / far, 0, 1);
        }
        bar-drag(span, far, from, by) => {
            if (far <= 0px) { return 0px; }
            if (root.room(span, far) <= 0px) { return clamp(from, 0px, far); }
            return clamp(from + by * far / root.room(span, far), 0px, far);
        }
    }
}
