// The panel's controls, built on the tokens: each has its four states
// (rest, hover, pressed, disabled) and a focus ring where it takes
// focus. Icons are Lucide (ISC, see icons/LICENSE), tinted here.

import { Theme } from "theme.slint";

// The window's one hover text, written by whatever has rested under the
// pointer (a `TipArea`) and drawn by the window over everything: it
// watches `serial`, which moves on every show and every hide, so the
// same words twice running still show.
export global Tips {
    out property <string> text;
    out property <length> x;
    out property <length> y;
    out property <int> serial;
    public function show(words: string, at-x: length, at-y: length) {
        self.text = words;
        self.x = at-x;
        self.y = at-y;
        self.serial += 1;
    }
}

// A TouchArea for something that shows a picture and no words: after
// the pointer has rested on it for a moment, `words` (one or two, the
// absolute minimum) come up at the pointer through `Tips`, and go on
// leaving, on a press, and wherever the window takes the text down.
// Empty words, no tip. The accessible label stays the control's own.
export component TipArea inherits TouchArea {
    in property <string> words;
    property <bool> tipped;
    function untip() {
        if (root.tipped) {
            root.tipped = false;
            Tips.show("", 0, 0);
        }
    }
    Timer {
        interval: 600ms;
        running: root.has-hover && !root.tipped && root.words != "";
        triggered => {
            root.tipped = true;
            Tips.show(root.words, root.absolute-position.x, root.absolute-position.y + root.height + 2px);
        }
    }
    /// A press of any button, after the tip is taken down.
    callback down(PointerEvent);
    changed has-hover => { if (!root.has-hover) { root.untip(); } }
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            root.untip();
            root.down(e);
        }
    }
}

// A switch on its own, smaller than a Toggle's, for a header.
export component Switch inherits Rectangle {
    in-out property <bool> checked: true;
    in property <bool> enabled: true;
    // Shown off whatever `checked` says: for a switch another
    // section has taken over, which keeps what it was set to for
    // when it is handed back.
    in property <bool> force-off: false;
    callback toggled();
    width: 28px;
    height: 16px;
    border-radius: 8px;
    property <bool> shown: root.checked && !root.force-off;
    property <bool> active: enabled && (ta.has-hover || ta.pressed || fs.has-focus);
    background: !root.enabled ? Theme.border
        : root.shown ? (root.active ? Theme.accent-hover : Theme.accent)
        : (root.active ? Theme.hover : Theme.border-strong);
    border-width: fs.has-focus ? 2px : 0;
    border-color: Theme.focus-ring;
    animate background { duration: Theme.quick; }
    Rectangle {
        x: root.shown ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.enabled ? Theme.knob : Theme.text-muted;
        animate x { duration: 120ms; easing: ease-out; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            fs.focus();
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// The panel's sections, one open at a time when the Settings sheet
// asks: a section of the panel that opens, by its header or by a key,
// says so here, and every other section of the panel then folds. Only
// the tab on screen has its sections made, so the others are its own.
export global Folds {
    in-out property <bool> one-open: false;
    // The sections numbered as they first open, the last to open, and
    // a count of openings that the others watch.
    in-out property <int> count: 0;
    in-out property <int> opener: 0;
    in-out property <int> opened: 0;
}

// A section: a header of icon, title and chevron over a rule, and
// the body under it. The header folds the body away and back. A
// section with an effect carries a switch at the header's right: off,
// the picture is as if the section were not there, and the body's
// settings stay as they are, dimmed, for when it is on again.
export component Section inherits VerticalLayout {
    in property <string> title;
    // Whose section this is, before the title: a mask's adjustment
    // on the Masks tab. A long one is cut; the title after it stays.
    in property <string> owner;
    in property <image> icon;
    // A word after the title, muted: a key, say.
    in property <string> hint;
    // A reading at the header's right, muted: a zoom, say. It keeps to
    // its own end so the title does not move as it changes.
    in property <string> note;
    in property <bool> switchable: false;
    in-out property <bool> on: true;
    // Whether the focused slider is in this section, by where it last
    // said it was (it says so at each move).
    pure function holds-the-keys() -> bool {
        let x = SliderKeys.reveal-x - root.absolute-position.x;
        let y = SliderKeys.reveal-y - root.absolute-position.y;
        return x >= 0 && x <= root.width && y >= 0 && y < root.height;
    }
    // Another section has taken this one over and it does not act
    // whatever its switch says: the switch shows off and is dead,
    // the body is dimmed, and `on` keeps what it was for when the
    // other section lets go.
    in property <bool> superseded: false;
    in-out property <bool> collapsed: false;
    // One of the panel's sections, which fold for each other under
    // `Folds`, while the panel is on screen; a pane's or a list's do
    // not. The grid covers the panel without unmaking it, and a pane's
    // section sharing a fold with one of the panel's (METADATA's)
    // must not fold the panel behind it.
    in property <bool> one-of-panel: false;
    property <int> fold-number: 0;
    changed collapsed => {
        if (!root.collapsed && root.one-of-panel && Folds.one-open) {
            if (root.fold-number == 0) {
                Folds.count += 1;
                root.fold-number = Folds.count;
            }
            Folds.opener = root.fold-number;
            Folds.opened += 1;
        }
    }
    property <int> fold-opened: Folds.opened;
    changed fold-opened => {
        if (root.one-of-panel && Folds.one-open && !root.collapsed
            && Folds.opener != root.fold-number) {
            root.collapsed = true;
        }
    }
    callback switched();
    spacing: 6px;
    padding-top: Theme.space-1;
    HorizontalLayout {
        spacing: Theme.space-2;
        Rectangle {
            horizontal-stretch: 1;
            height: Theme.icon + Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                Image {
                    source: @image-url("icons/chevron-down.svg");
                    colorize: head.has-hover ? Theme.text : Theme.text-muted;
                    width: Theme.icon;
                    height: Theme.icon;
                    y: (parent.height - self.height) / 2;
                    transform-rotation: root.collapsed ? -90deg : 0deg;
                    animate transform-rotation { duration: 120ms; easing: ease-out; }
                }
                if root.icon.width > 0: Image {
                    source: root.icon;
                    colorize: Theme.text-secondary;
                    width: Theme.icon;
                    height: Theme.icon;
                    y: (parent.height - self.height) / 2;
                }
                if root.owner != "": Text {
                    text: root.owner.to-uppercase();
                    color: head.has-hover ? Theme.text : Theme.text-secondary;
                    font-size: Theme.font-xs;
                    font-weight: Theme.weight-semibold;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: (root.owner == "" ? "" : "\u{00b7}  ") + root.title;
                    color: head.has-hover ? Theme.text : Theme.text-secondary;
                    font-size: Theme.font-xs;
                    font-weight: Theme.weight-semibold;
                    letter-spacing: 0.8px;
                    vertical-alignment: center;
                    // A long title is cut, not the panel widened;
                    // after an owner, the owner is cut instead.
                    overflow: elide;
                    min-width: root.owner == "" ? 0px : self.preferred-width;
                }
                if root.hint != "": Text {
                    text: root.hint;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
            }
            if root.note != "": Text {
                x: parent.width - self.width;
                text: root.note;
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
                height: 100%;
            }
            head := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                // A focused slider elsewhere in the panel keeps the
                // keys, and the panel keeps it in view as this
                // section opens or folds; one in this section lets
                // go, since the fold takes it out of view.
                clicked => {
                    if (SliderKeys.holder == 0 || Typing.editing || root.holds-the-keys()) {
                        Typing.close-all();
                    }
                    root.collapsed = !root.collapsed;
                }
            }
        }
        if root.switchable: Switch {
            checked <=> root.on;
            enabled: !root.superseded;
            force-off: root.superseded;
            y: (parent.height - self.height) / 2;
            toggled => { root.switched(); }
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    // The body, clipped to nothing when folded.
    Rectangle {
        clip: true;
        property <length> full: root.collapsed ? 0px : body.preferred-height;
        animate full { duration: 120ms; easing: ease-out; }
        // For the sliders' focus walk alone: closed all the way, the
        // body is put far to the left, out of every column, so comma
        // and period pass a folded section's sliders over.
        property <float> shut: root.collapsed ? 1 : 0;
        animate shut { duration: 120ms; }
        preferred-height: self.full;
        max-height: self.full;
        min-height: self.full;
        body := VerticalLayout {
            x: parent.shut >= 1 ? -100000px : 0;
            y: 0;
            width: 100%;
            height: self.preferred-height;
            spacing: Theme.space-1;
            opacity: root.switchable && (!root.on || root.superseded) ? 0.45 : 1;
            animate opacity { duration: Theme.quick; }
            @children
        }
    }
}

// What a number typed into a field comes to, as the Rust side reads
// it (`entry.rs`): not `ok` when the text holds no number.
export struct TypedNumber {
    ok: bool,
    value: float,
}

// The sliders' keys, one place for all of them: which slider holds
// the keys, and the question a slider asks the others for the next or
// the previous one, with comma and period or with Tab in its field.
// The answer takes two of Slint's rounds of change handlers, both
// within the press: in the first, every slider past the asker in its
// column puts itself forward if it is nearer than the best so far; in
// the second, the one left takes the focus or opens its field.
export global SliderKeys {
    // The slider with the keys, by its number, or 0. The picture does
    // not take the keys at the pointer's crossing while one has them.
    in-out property <int> holder: 0;
    // The numbers handed out, one a slider.
    in-out property <int> count: 0;
    // The question, counted up at each asking.
    in-out property <int> asked: 0;
    in-out property <int> asker: 0;
    in-out property <int> way: 1;
    in-out property <bool> field: false;
    in-out property <length> from-x;
    in-out property <length> from-y;
    in-out property <length> from-width;
    // The nearest so far, by its number and its top.
    in-out property <int> best: 0;
    in-out property <length> best-y;
    // Counted up once every slider has answered.
    in-out property <int> settled: 0;
    // A slider reached by a key, for the panel to scroll into view:
    // counted up, and where it is in the window. Not `by-key` when
    // the focused slider has only moved on the screen: the panel
    // keeps it in view if the layout moved it, and lets it go if the
    // wheel took it out of view.
    in-out property <int> reveal: 0;
    in-out property <bool> by-key: true;
    in-out property <length> reveal-x;
    in-out property <length> reveal-y;
    in-out property <length> reveal-height;
    // A key a focused slider does not take, for the window's own:
    // counted up, and the key.
    in-out property <int> passed: 0;
    in-out property <KeyEvent> passed-key;
}

// The reading of typed numbers, one place for every field: the Rust
// side answers both callbacks, so a slider's shown text and what is
// typed over it are read by the same code.
export global Typing {
    // The shown text as a field starts it: its number alone, the +
    // sign and the unit off ("+0.40 EV" edits as "0.40").
    pure callback editable(string) -> string;
    // What a typed text sets: its number over the scale, clamped to
    // the minimum and the maximum.
    pure callback parse(string, float, float, float) -> TypedNumber;
    // Counted up each time a field lets go of the keyboard, however
    // it closes: the window hands the keys back to its shortcuts, as
    // a sheet does when it closes.
    in-out property <int> done: 0;
    // Counted up at each field opened. A field closing hands the keys
    // back only while it is the last one opened, so a click from one
    // field into another leaves the new one its focus.
    in-out property <int> opened: 0;
    // A field is open. A field taken away while open (its section
    // gone with a tab) leaves this set with nobody to clear it:
    // `close-all` does, and hands the keys back itself.
    in-out property <bool> editing: false;
    // Counted up to close whatever field is open.
    in-out property <int> cancel: 0;
    // The panel's text boxes focused (the filter's words, a custom
    // aspect, a mask's name, and the frame's title and keywords): each counts itself in as it takes the focus
    // and out as it loses it, so the order of the two between boxes
    // does not matter. While above zero, the pointer crossing the
    // picture leaves the keys with the box.
    in-out property <int> boxes: 0;
    public function box-focus(has: bool) {
        self.boxes = has ? self.boxes + 1 : max(0, self.boxes - 1);
    }
    // Close the open field, if any, typed text not counting: for a
    // click on a control that takes no focus (a tab, a swatch, the
    // curve, a section's header), and for a tab or a mask target
    // changed under the field.
    // A focused slider or text box lets go of the keys the same way.
    public function close-all() {
        if (self.editing) {
            self.editing = false;
            self.cancel += 1;
            self.done += 1;
        } else if (SliderKeys.holder != 0) {
            SliderKeys.holder = 0;
            self.done += 1;
        } else if (self.boxes > 0) {
            // A box taken away while focused says nothing itself.
            self.boxes = 0;
            self.done += 1;
        }
    }
}

// A reading that a click turns into a text field. Enter hands the
// typed text to `committed`, unless it is the reading's own number
// untouched (the reading is rounded, and reading it back would move
// the value); Escape, the focus going elsewhere or `close-all` puts
// the reading back as it was. The field starts on the reading's
// number alone, all selected.
export component ValueField inherits Rectangle {
    in property <string> shown;
    in property <bool> enabled: true;
    // Drawn as a field at rest too, not only while typed in.
    in property <bool> boxed: false;
    in property <TextHorizontalAlignment> alignment: right;
    // What the field is of, for a screen reader.
    in property <string> label;
    out property <bool> editing: false;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.shown;
    accessible-enabled: root.enabled;
    callback committed(string);
    // A slider's field: Up and Down nudge the value, with Shift by
    // the bigger step, and Tab and Shift+Tab go on to the next and the
    // previous slider's field; what was typed is set first, as Enter
    // sets it.
    in property <bool> nudges: false;
    callback nudged(int, bool);
    callback tabbed(int);
    // Which opening this is, against `Typing.opened`.
    property <int> ticket: 0;
    property <int> cancels: Typing.cancel;
    changed cancels => {
        if (root.editing) { root.close(); }
    }
    public function edit() {
        if (root.enabled) {
            Typing.opened += 1;
            root.ticket = Typing.opened;
            Typing.editing = true;
            root.editing = true;
        }
    }
    function close() {
        root.editing = false;
        if (Typing.opened == root.ticket) {
            Typing.editing = false;
            Typing.done += 1;
        }
    }
    // Closed from outside: a Tab with no field past this one.
    public function finish() {
        if (root.editing) { root.close(); }
    }
    // The typed text set, unless it is the reading's own.
    function take(typed: string) {
        if (typed != Typing.editable(root.shown)) { root.committed(typed); }
    }
    border-radius: Theme.radius-sm;
    border-width: root.editing || root.boxed ? 1px : 0;
    border-color: root.editing ? Theme.focus-ring : Theme.border;
    background: root.editing || root.boxed ? Theme.base : transparent;
    TouchArea {
        enabled: root.enabled && !root.editing;
        mouse-cursor: root.enabled ? MouseCursor.text : MouseCursor.default;
        clicked => { root.edit(); }
    }
    if !root.editing: Text {
        x: root.boxed ? Theme.space-1 : 0;
        width: parent.width - 2 * self.x;
        height: 100%;
        text: root.shown;
        color: root.enabled ? Theme.text-secondary : Theme.text-muted;
        font-size: Theme.font-sm;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.editing: TextInput {
        x: Theme.space-1;
        width: parent.width - 2 * Theme.space-1;
        height: 100%;
        text: Typing.editable(root.shown);
        single-line: true;
        color: Theme.text;
        font-size: Theme.font-sm;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
        init => {
            self.focus();
            self.select-all();
        }
        accepted => {
            let typed = self.text;
            root.close();
            if (typed != Typing.editable(root.shown)) { root.committed(typed); }
        }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            if (root.nudges && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                    root.take(self.text);
                    root.nudged(e.text == Key.UpArrow ? 1 : -1, e.modifiers.shift);
                    self.text = Typing.editable(root.shown);
                    self.select-all();
                    return accept;
                }
                if (e.text == Key.Tab || e.text == Key.Backtab) {
                    root.take(self.text);
                    self.text = Typing.editable(root.shown);
                    self.select-all();
                    root.tabbed(e.text == Key.Backtab || e.modifiers.shift ? -1 : 1);
                    return accept;
                }
            }
            return reject;
        }
        // Clicked away: nothing typed counts, and the keys go back.
        changed has-focus => {
            if (!self.has-focus && root.editing) { root.close(); }
        }
    }
}

// A slider's steps for the keys, in its value (in stops on a
// logarithmic one): an arrow, plus or minus, and an arrow with Shift;
// and the fine step, of an arrow or a wheel's click with Ctrl.
export struct Nudge {
    small: float,
    big: float,
    fine: float,
}

// Every slider's steps, one table: each slider names its line. The
// steps are the ones Lightroom's hand expects, read in what the slider
// shows: a tenth and a third of a stop on exposure, 1 and 10 on a
// slider shown 0 to 100 or -100 to +100. The fine step is a tenth of
// the small one, or the least the slider's number shows where that is
// more: a line shown no finer than its small step has no finer step.
export global Steps {
    // Exposure, and the vignette's amount, in EV over ±5.
    out property <Nudge> exposure: { small: 0.1, big: 1 / 3, fine: 0.01 };
    // Highlights, shadows and whites, in EV over ±2.
    out property <Nudge> tone: { small: 0.05, big: 0.25, fine: 0.01 };
    // Blacks, ±30 % shown: 1 and 5.
    out property <Nudge> blacks: { small: 0.01, big: 0.05, fine: 0.01 };
    // Contrast's multiplier, in stops over two. Shown as the
    // multiplier, where a finer step in stops would not always show.
    out property <Nudge> contrast: { small: 0.02, big: 0.2, fine: 0.02 };
    // Shown as a percent, 0 to 100 or ±100 (a 0 to 1 or ±1 value):
    // 1 and 10.
    out property <Nudge> percent: { small: 0.01, big: 0.1, fine: 0.01 };
    // Shown to two places: a radius, a grain's size.
    out property <Nudge> hundredths: { small: 0.01, big: 0.1, fine: 0.01 };
    // Shown to two places over a range of a few: the black and white
    // strength, the denoise's strength.
    out property <Nudge> twentieths: { small: 0.05, big: 0.25, fine: 0.01 };
    // The black and white weight, shown as weighed by the strength,
    // where a finer step than the small one can hide.
    out property <Nudge> weight: { small: 0.05, big: 0.25, fine: 0.05 };
    // Shown to one place: an angle, a keystone, a radius in pixels, a
    // margin.
    out property <Nudge> tenths: { small: 0.1, big: 1, fine: 0.1 };
    // Shown to one place in halves: the mark's size, the border.
    out property <Nudge> halves: { small: 0.5, big: 5, fine: 0.1 };
    // A whole number to 100: a quality, an opacity, a count, a
    // threshold.
    out property <Nudge> whole: { small: 1, big: 10, fine: 1 };
    // An angle on the hue circle.
    out property <Nudge> degrees: { small: 1, big: 10, fine: 1 };
    // The tint's hue, whose wheel step is a tenth of a degree.
    out property <Nudge> tenth-degrees: { small: 0.1, big: 1, fine: 0.1 };
    // A hue's shift, ±30°.
    out property <Nudge> hue-shift: { small: 1, big: 5, fine: 1 };
    // White balance in kelvin, 2000 to 12000.
    out property <Nudge> kelvin: { small: 50, big: 500, fine: 5 };
    // A mask's white as an offset from the global's, mired.
    out property <Nudge> mired: { small: 1, big: 10, fine: 1 };
    // Shown to three places, or a tenth of a percent: the tint, a
    // chroma, a brush's or a repair's size.
    out property <Nudge> thousandths: { small: 0.001, big: 0.01, fine: 0.001 };
    // The lens's manual distortion, shown to a tenth over ±50.
    out property <Nudge> distortion: { small: 0.005, big: 0.05, fine: 0.001 };
    // The lens's red and blue scale, shown to a tenth over ±10.
    out property <Nudge> fringe: { small: 0.0001, big: 0.001, fine: 0.0001 };
}

// A slider: label, track with fill, handle, value. A click on the
// track jumps the value there; a press on the handle grabs it without
// moving it, then drags it once the pointer clears a small dead zone.
// Double-click restores the default. A click on the value types one:
// Enter sets it as a drag would, clamped to the range, and Escape
// leaves the value alone.
//
// Focused, by a click or a key, it holds the keys until a click, Tab,
// comma, period or Escape moves them on: the four arrows, and plus
// and minus (= and _ with them), nudge by its small step, an arrow
// with Shift by its big one and with Ctrl by its fine one, as a drag
// moves it; comma and period focus the previous and the next slider
// in the panel; Escape gives the keys
// back to the window. Tab is Slint's own, to the next control. Every
// other key is the window's, as if nothing had the focus: a rating, a
// flag, an undo.
export component EditSlider inherits Rectangle {
    in property <string> label;
    in property <string> text;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> default: 0;
    // A wheel's click, and the step a screen reader is told of.
    in property <float> step: 0.01;
    // Its line of `Steps`, for the keys.
    in property <Nudge> steps;
    in-out property <float> value: 0;
    in property <bool> enabled: true;
    // A track painted with the colors the slider moves between, as
    // the mixer's hue slider is. The fill is left off so the gradient
    // shows the whole way.
    in property <bool> tinted: false;
    in property <brush> tint;
    // A track in stops rather than in the value: the thumb sits at
    // the log of the value, so a multiplier's neutral, 1 between 0.5
    // and 2, is at the center as the signed sliders' zeros are, and
    // halving and doubling are the same distance from it. The step
    // and a wheel notch are then in stops too.
    in property <bool> logarithmic: false;
    // The shown number over the value: 100 for a value shown as a
    // percent or as -100 to +100, 1 for one shown as it is. A number
    // typed over the value is read back through it. A logarithmic
    // slider shows its multiplier, so a typed one is the multiplier.
    in property <float> scale: 1;
    callback changed(float);
    // A slider whose default is not a number of its own: the
    // double-click calls `reset` and leaves the value to the owner.
    in property <bool> owner-resets: false;
    callback reset();
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-enabled: root.enabled;

    height: Theme.control-height;
    // Wider for a section whose labels run long; the sliders of one
    // block share it so their tracks line up.
    in property <length> label-width: 68px;
    property <length> value-width: 60px;
    property <length> track-left: label-width;
    property <length> track-right: self.width - value-width;
    property <length> track-width: track-right - track-left;
    property <float> fraction: root.logarithmic
        ? log(value / minimum, 2) / log(maximum / minimum, 2)
        : (value - minimum) / (maximum - minimum);
    property <bool> active: enabled && (ta.has-hover || ta.pressed || fs.has-focus);
    property <float> scroll-acc: 0;
    property <float> notch: 40;
    property <length> handle-center-x: track-left + root.fraction * track-width;
    // A press within the handle does not move it: a click to focus, or
    // to then use the wheel, must not nudge the value. A drag off the
    // handle starts moving it only past this dead zone (the same 4px
    // the viewport uses to tell a click from a drag), and from there
    // tracks the pointer with the offset it was grabbed at, so the
    // handle does not jump under the finger.
    property <length> drag-dead-zone: 4px;
    property <bool> handle-grabbed: false;
    // A press on the track but off the handle still jumps, and drags
    // by jumping to wherever the pointer goes next, as it always has.
    // A press on the label or the value text does neither: focus only.
    property <bool> track-armed: false;
    property <bool> dragging: false;
    property <length> press-x;
    property <length> grab-offset;

    function set-from(x: length) {
        value = root.logarithmic
            ? clamp(minimum * pow(maximum / minimum, clamp((x - track-left) / track-width, 0, 1)), minimum, maximum)
            : clamp(minimum + (x - track-left) / track-width * (maximum - minimum), minimum, maximum);
        changed(value);
    }
    function nudge(by: float) {
        value = root.logarithmic
            ? clamp(value * pow(2, by), minimum, maximum)
            : clamp(value + by, minimum, maximum);
        changed(value);
    }
    function bump(way: int, big: bool) {
        root.nudge(way * (big ? root.steps.big : root.steps.small));
    }
    // A wheel's click with Ctrl: the fine step, or the slider's own
    // wheel step where that is finer still.
    function wheel-step(fine: bool) -> float {
        return fine ? min(root.step, root.steps.fine) : root.step;
    }

    // Its number among the sliders, for `SliderKeys`: handed out when
    // first wanted, not at its making, so that building the panel
    // writes nothing.
    property <int> number: 0;
    function me() -> int {
        if (root.number == 0) {
            SliderKeys.count += 1;
            root.number = SliderKeys.count;
        }
        return root.number;
    }
    // Ask for the next slider down (1) or up (-1), to focus it or to
    // open its field.
    function ask(way: int, field: bool) {
        SliderKeys.asker = root.me();
        SliderKeys.way = way;
        SliderKeys.field = field;
        SliderKeys.from-x = root.absolute-position.x;
        SliderKeys.from-y = root.absolute-position.y;
        SliderKeys.from-width = root.width;
        SliderKeys.best = 0;
        SliderKeys.asked += 1;
    }
    function reveal() {
        SliderKeys.by-key = true;
        root.show();
    }
    function show() {
        SliderKeys.reveal-x = root.absolute-position.x + root.width / 2;
        SliderKeys.reveal-y = root.absolute-position.y;
        SliderKeys.reveal-height = root.height;
        SliderKeys.reveal += 1;
    }
    // Where it is while it has the keys, followed so that the panel
    // keeps it in view.
    property <length> held-y: fs.has-focus ? root.absolute-position.y : 0px;
    changed held-y => {
        if (fs.has-focus) {
            SliderKeys.by-key = false;
            root.show();
        }
    }
    // The first round: put itself forward if it is past the asker in
    // its column and nearer than the best so far. Not a disabled
    // slider; one in a folded section is out of every column.
    property <int> asked: SliderKeys.asked;
    changed asked => {
        if (SliderKeys.asker == root.number) {
            SliderKeys.settled += 1;
            return;
        }
        if (!root.enabled) { return; }
        let mid = root.absolute-position.x + root.width / 2;
        if (abs(mid - (SliderKeys.from-x + SliderKeys.from-width / 2)) > SliderKeys.from-width / 2) { return; }
        let y = root.absolute-position.y;
        if (SliderKeys.way > 0 && y > SliderKeys.from-y + 1px
            && (SliderKeys.best == 0 || y < SliderKeys.best-y)) {
            SliderKeys.best = root.me();
            SliderKeys.best-y = y;
        }
        if (SliderKeys.way < 0 && y < SliderKeys.from-y - 1px
            && (SliderKeys.best == 0 || y > SliderKeys.best-y)) {
            SliderKeys.best = root.me();
            SliderKeys.best-y = y;
        }
    }
    // The second: the nearest takes the focus or opens its field. A
    // field with none past it closes, as Enter would close it.
    property <int> settled: SliderKeys.settled;
    changed settled => {
        if (SliderKeys.best != 0 && SliderKeys.best == root.number) {
            if (SliderKeys.field) { field.edit(); } else { fs.focus(); }
            root.reveal();
        } else if (SliderKeys.best == 0 && SliderKeys.asker == root.number && SliderKeys.field) {
            field.finish();
        }
    }

    Text {
        x: 0;
        width: label-width - Theme.space-2;
        text: root.label;
        color: root.enabled ? Theme.text : Theme.text-muted;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        overflow: elide;
        height: 100%;
    }
    track := Rectangle {
        x: track-left;
        width: track-width;
        y: (root.height - self.height) / 2;
        height: root.active ? 5px : 4px;
        border-radius: self.height / 2;
        background: root.tinted && root.enabled ? root.tint
            : root.enabled ? Theme.border-strong
            : Theme.border;
        animate height { duration: Theme.quick; }
        Rectangle {
            visible: !root.tinted;
            x: 0;
            width: root.fraction * track.width;
            height: 100%;
            border-radius: parent.border-radius;
            background: !root.enabled ? Theme.text-muted
                : ta.pressed ? Theme.accent-pressed
                : root.active ? Theme.accent-hover
                : Theme.accent;
        }
    }
    handle := Rectangle {
        property <length> size: root.active ? 16px : 14px;
        x: root.handle-center-x - self.width / 2;
        y: (root.height - self.height) / 2;
        width: size;
        height: size;
        border-radius: self.width / 2;
        background: !root.enabled ? Theme.text-muted : ta.pressed ? Theme.text-strong : Theme.text;
        border-width: fs.has-focus ? 2px : 0;
        border-color: Theme.focus-ring;
        animate width, height { duration: Theme.quick; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                // The window takes the keys back, as from a field.
                Typing.done += 1;
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt && !e.modifiers.meta) {
                if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                    root.nudge(root.steps.fine);
                    return accept;
                }
                if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                    root.nudge(-root.steps.fine);
                    return accept;
                }
            }
            if (!e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta) {
                // Shift is the big step on an arrow only: on some
                // boards Shift with plus or minus is another key.
                if (e.text == Key.UpArrow || e.text == Key.RightArrow) {
                    root.bump(1, e.modifiers.shift);
                    return accept;
                }
                if (e.text == Key.DownArrow || e.text == Key.LeftArrow) {
                    root.bump(-1, e.modifiers.shift);
                    return accept;
                }
                if (e.text == "+" || e.text == "=") { root.bump(1, false); return accept; }
                if (e.text == "-" || e.text == "_") { root.bump(-1, false); return accept; }
                if (e.text == ",") { root.ask(-1, false); return accept; }
                if (e.text == ".") { root.ask(1, false); return accept; }
            }
            // Slint's own move to the next control.
            if (e.text == Key.Tab || e.text == Key.Backtab) { return reject; }
            SliderKeys.passed-key = e;
            SliderKeys.passed += 1;
            return accept;
        }
        changed has-focus => {
            if (self.has-focus) {
                SliderKeys.holder = root.me();
            } else if (SliderKeys.holder == root.number) {
                SliderKeys.holder = 0;
            }
        }
        // Reached by Tab from above or below the panel's view.
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) { root.reveal(); }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(e) => {
            if (e.button != PointerEventButton.left) { return; }
            if (e.kind == PointerEventKind.down) {
                fs.focus();
                root.press-x = self.mouse-x;
                root.dragging = false;
                root.handle-grabbed = abs(self.mouse-x - root.handle-center-x) <= handle.size / 2;
                root.track-armed = !root.handle-grabbed
                    && self.mouse-x >= track-left && self.mouse-x <= track-right;
                if (root.handle-grabbed) {
                    root.grab-offset = self.mouse-x - root.handle-center-x;
                } else if (root.track-armed) {
                    // Away from the handle, the track still jumps the
                    // value straight to where the pointer went down.
                    root.set-from(self.mouse-x);
                }
                // A press on the label or the value text just focuses:
                // no jump, no drag latch.
            }
        }
        moved => {
            if (!self.pressed) { return; }
            if (root.handle-grabbed) {
                if (!root.dragging) {
                    if (abs(self.mouse-x - root.press-x) > root.drag-dead-zone) {
                        root.dragging = true;
                    } else {
                        return;
                    }
                }
                root.set-from(self.mouse-x - root.grab-offset);
            } else if (root.track-armed) {
                root.set-from(self.mouse-x);
            }
        }
        double-clicked => {
            if (root.owner-resets) {
                root.reset();
            } else {
                root.value = root.default;
                root.changed(root.value);
            }
        }
        // The wheel moves a focused slider, or any slider with Shift
        // held; otherwise it passes through. Ctrl with it is the fine
        // step, notches counted the same. A mouse wheel's click is
        // one step: one event of a notch or more, whatever the
        // platform makes a click in pixels (60 on one, 15 on another),
        // so clicks never add up to two steps and never to none. A
        // touchpad's small deltas add up to steps.
        scroll-event(e) => {
            if (!root.enabled || !(e.modifiers.shift || fs.has-focus)) { return reject; }
            if (abs(e.delta-y != 0 ? e.delta-y : e.delta-x) >= root.notch * 1px) {
                root.scroll-acc = 0;
                root.nudge(((e.delta-y != 0 ? e.delta-y : e.delta-x) > 0 ? 1 : -1) * root.wheel-step(e.modifiers.control));
                return accept;
            }
            root.scroll-acc += (e.delta-y != 0 ? e.delta-y : e.delta-x) / 1px;
            if (abs(root.scroll-acc) >= root.notch) {
                root.nudge((root.scroll-acc > 0 ? 1 : -1) * root.wheel-step(e.modifiers.control));
                root.scroll-acc = 0;
            }
            return accept;
        }
    }
    // Over the track's touch area, so a click on the value types
    // one instead of focusing the slider.
    field := ValueField {
        x: track-right + Theme.space-2;
        width: value-width - Theme.space-2;
        y: (root.height - self.height) / 2;
        height: Theme.control-height - 4px;
        shown: root.text;
        label: root.label + " value";
        enabled: root.enabled;
        nudges: true;
        nudged(way, big) => { root.bump(way, big); }
        tabbed(way) => { root.ask(way, true); }
        committed(typed) => {
            let entered = Typing.parse(typed, root.scale, root.minimum, root.maximum);
            if (entered.ok) {
                root.value = entered.value;
                root.changed(root.value);
            }
        }
    }
}

// A switch with a label. With `follows`, `checked` is the owner's
// binding to keep: a click or a key only asks, through `toggled`, and
// the switch shows whatever the owner's state comes to.
export component Toggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> follows: false;
    callback toggled();
    height: Theme.control-height;
    property <bool> active: enabled && (ta.has-hover || ta.pressed || fs.has-focus);

    Text {
        x: 0;
        text: root.label;
        color: root.enabled ? Theme.text : Theme.text-muted;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        height: 100%;
    }
    knob-track := Rectangle {
        x: root.width - self.width;
        y: (root.height - self.height) / 2;
        width: 34px;
        height: 18px;
        border-radius: 9px;
        background: !root.enabled ? Theme.border
            : root.checked ? (root.active ? Theme.accent-hover : Theme.accent)
            : (root.active ? Theme.hover : Theme.border-strong);
        border-width: fs.has-focus ? 2px : 0;
        border-color: Theme.focus-ring;
        animate background { duration: Theme.quick; }
        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            y: 2px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: root.enabled ? Theme.knob : Theme.text-muted;
            animate x { duration: 120ms; easing: ease-out; }
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                if (!root.follows) {
                    root.checked = !root.checked;
                }
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            fs.focus();
            if (!root.follows) {
                root.checked = !root.checked;
            }
            root.toggled();
        }
    }
}

// A button: text, an optional icon, secondary by default.
export component PanelButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    /// For a button with a picture and no text: its name, a word or
    /// two, at the pointer after a rest.
    in property <string> words;
    /// A menu of its own: a chevron at the right edge, which a click
    /// opens it from, as a right-click anywhere on the button does.
    in property <bool> has-menu: false;
    callback clicked();
    /// The menu asked for, at a point of the button.
    callback menu(length, length);
    height: Theme.control-height;
    border-radius: Theme.radius-md;
    border-width: root.primary && root.enabled ? 0 : 1px;
    border-color: fs.has-focus ? Theme.focus-ring : Theme.border-strong;
    background: !root.enabled ? Theme.base
        : root.primary ? (ta.pressed ? Theme.accent-pressed : ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : Theme.raised);
    animate background { duration: Theme.quick; }
    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-2;
        padding-left: root.text == "" ? 0 : Theme.space-3;
        padding-right: root.text == "" ? 0 : root.has-menu ? root.chevron-w : Theme.space-3;
        if root.icon.width > 0: Image {
            source: root.icon;
            colorize: !root.enabled ? Theme.text-muted : root.primary ? Theme.on-accent : Theme.text;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: !root.enabled ? Theme.text-muted : root.primary ? Theme.on-accent : Theme.text;
            font-size: Theme.font-sm;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // The chevron's strip at the right edge, which a click there
    // opens the menu from rather than clicking the button.
    out property <length> chevron-w: Theme.icon + 2 * Theme.space-2;
    if root.has-menu: Image {
        x: root.width - root.chevron-w + Theme.space-2;
        source: @image-url("icons/chevron-down.svg");
        colorize: !root.enabled ? Theme.text-muted : root.primary ? #101010 : Theme.text-secondary;
        width: Theme.icon;
        height: Theme.icon;
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    ta := TipArea {
        words: root.words;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        down(e) => {
            if (root.has-menu && e.button == PointerEventButton.right) {
                fs.focus();
                root.menu(self.mouse-x, self.mouse-y);
            }
        }
        clicked => {
            fs.focus();
            if (root.has-menu && self.mouse-x >= root.width - root.chevron-w) {
                root.menu(root.width - root.chevron-w, root.height);
            } else {
                root.clicked();
            }
        }
    }
}

// A row of choices, one selected: for a short list of named options.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <string> current;
    in property <bool> enabled: true;
    /// Whether a click makes its option current itself; false for a
    /// row whose current the host sets once it has acted on the click.
    in property <bool> picks: true;
    callback selected(string);
    height: Theme.control-height;
    border-radius: Theme.radius-md;
    background: Theme.base;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option in root.options: Rectangle {
            property <bool> on: option == root.current;
            border-radius: Theme.radius-sm;
            background: on ? Theme.raised : (t.has-hover && root.enabled ? Theme.hover : transparent);
            animate background { duration: Theme.quick; }
            Text {
                text: option;
                color: on ? Theme.text : Theme.text-secondary;
                font-size: Theme.font-xs;
                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            t := TouchArea {
                enabled: root.enabled;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    Typing.close-all();
                    if (root.picks) { root.current = option; }
                    root.selected(option);
                }
            }
        }
    }
}

// A point curve over a picture of it. The host draws the picture
// (grid, histogram, curve, points) and owns the points; this maps the
// pointer to curve coordinates, x and y in 0 to 1, y up.
export component CurveEditor inherits Rectangle {
    in property <image> picture;
    in property <bool> enabled: true;
    callback pressed(float, float);
    callback moved(float, float);
    callback released();
    callback double-clicked(float, float);
    height: self.width;
    border-radius: Theme.radius-sm;
    clip: true;
    background: Theme.base;
    Image {
        width: 100%;
        height: 100%;
        source: root.picture;
        image-fit: fill;
        image-rendering: smooth;
        opacity: root.enabled ? 1 : 0.4;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.crosshair;
        // Whether the press was this area's: the release of a press
        // that closed a menu comes here without one.
        property <bool> held;
        pointer-event(e) => {
            // Cancel carries button `other`: read ahead of the filter,
            // it ends a drag the window took back.
            if (e.kind == PointerEventKind.cancel) {
                if (self.held) { root.released(); }
                self.held = false;
            } else if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    self.held = true;
                    Typing.close-all();
                    root.pressed(self.mouse-x / root.width, 1 - self.mouse-y / root.height);
                } else if (e.kind == PointerEventKind.up && self.held) {
                    self.held = false;
                    root.released();
                }
            }
        }
        moved => {
            if (self.pressed) { root.moved(self.mouse-x / root.width, 1 - self.mouse-y / root.height); }
        }
        double-clicked => {
            root.double-clicked(self.mouse-x / root.width, 1 - self.mouse-y / root.height);
        }
    }
}

// A row of color swatches, one chosen: the mixer's bands.
export component Swatches inherits Rectangle {
    in property <[color]> colors;
    in-out property <int> current: 0;
    in property <bool> enabled: true;
    callback selected(int);
    height: Theme.control-height;
    HorizontalLayout {
        spacing: Theme.space-1;
        for color[i] in root.colors: Rectangle {
            property <bool> on: i == root.current;
            border-radius: self.height / 2;
            background: color;
            border-width: on ? 2px : 0;
            border-color: Theme.text;
            opacity: !root.enabled ? 0.3 : (on || t.has-hover) ? 1 : 0.55;
            animate opacity { duration: Theme.quick; }
            t := TouchArea {
                enabled: root.enabled;
                mouse-cursor: MouseCursor.pointer;
                clicked => { Typing.close-all(); root.current = i; root.selected(i); }
            }
        }
    }
}

// A handle of the crop: reports the pointer's travel since the press
// in window coordinates, so the handle may move under the pointer
// without the travel counting twice.
export component CropHandle inherits TouchArea {
    in property <int> id;
    in property <MouseCursor> cursor: MouseCursor.move;
    callback grabbed(int);
    callback dragged(int, length, length);
    callback dropped();
    // Alt as the window reports it on this pointer event: a move
    // carries button `other`, not `left`, so this is set before the
    // left-button check below rather than inside it — a caller that
    // cares (a linear gradient's end) reads it fresh on every move; a
    // crop handle just leaves it alone.
    out property <bool> alt: false;
    property <length> press-x;
    property <length> press-y;
    mouse-cursor: root.cursor;
    pointer-event(e) => {
        self.alt = e.modifiers.alt;
        // Cancel carries button `other`, always, so it is read ahead
        // of the left-button filter below or a grab the window took
        // back mid-drag would never call `dropped`.
        if (e.kind == PointerEventKind.cancel) {
            root.dropped();
            return;
        }
        if (e.button != PointerEventButton.left) { return; }
        if (e.kind == PointerEventKind.down) {
            self.press-x = self.absolute-position.x + self.mouse-x;
            self.press-y = self.absolute-position.y + self.mouse-y;
            root.grabbed(root.id);
        } else if (e.kind == PointerEventKind.up) {
            root.dropped();
        }
    }
    moved => {
        if (self.pressed) {
            root.dragged(root.id, self.absolute-position.x + self.mouse-x - self.press-x, self.absolute-position.y + self.mouse-y - self.press-y);
        }
    }
}

// A clipping mark at a corner of the histogram: a small square, lit
// in the color of the channels that clip. While its warning is
// painted over the picture the control is filled in the accent, as
// an on switch is, with the square inside it outlined dark so a lit
// square reads on the fill. Click toggles the warning.
export component ClipMark inherits Rectangle {
    in property <bool> lit;
    in property <color> mark;
    in property <bool> on;
    callback clicked();
    width: 16px;
    height: 16px;
    border-radius: Theme.radius-sm;
    background: root.on
        ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.quick; }
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: root.lit ? root.mark : transparent;
        border-width: 1px;
        border-color: root.on ? Theme.scope-ink : (root.lit ? root.mark : Theme.dark-muted);
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// What a frame carries, on its thumbnail: the flag, the stars and
// the color label, in one small pill at the corner of the picture.
// The rating is as many stars as it is rather than five with some
// filled, so a two-star frame is a quieter mark than a four-star
// one, and a frame nobody has said anything about shows nothing at
// all.
//
// The numbers are the codes `flag_code` and `label_code` make on the
// Rust side, not the meta's own spelling: a flag of 1 is a pick and
// 2 a reject, a label of 1 to 5 is red, yellow, green, blue, purple.
// `stars` is `meta::STARS`, handed down from Rust so the cap here
// and the cap there cannot drift apart; `glyph` sizes everything, so
// a badge on a large cell is not the same speck as on a small one.
export component ThumbBadges inherits Rectangle {
    in property <int> rating;
    in property <int> flag;
    in property <int> label;
    in property <int> stars: 5;
    in property <length> glyph: 9px;
    property <bool> said: root.rating > 0 || root.flag > 0 || root.label > 0;
    visible: root.said;
    // What it shows, in words: "3 stars, pick, red".
    accessible-role: image;
    accessible-label: (root.rating > 0
            ? min(root.rating, root.stars) + (root.rating == 1 ? " star" : " stars") : "")
        + (root.flag > 0 ? (root.rating > 0 ? ", " : "") + (root.flag == 2 ? "reject" : "pick") : "")
        + (root.label > 0
            ? (root.rating > 0 || root.flag > 0 ? ", " : "")
                + (root.label == 1 ? "red" : root.label == 2 ? "yellow" : root.label == 3 ? "green"
                    : root.label == 4 ? "blue" : "purple")
            : "");
    width: badges.preferred-width;
    height: root.glyph + 6px;
    border-radius: Theme.radius-sm;
    // Its own scrim: a badge must read over a white sky and a black
    // shadow alike, and what is behind it is the picture.
    background: #00000099;
    badges := HorizontalLayout {
        padding-left: root.glyph / 3;
        padding-right: root.glyph / 3;
        spacing: root.glyph / 4.5;
        alignment: center;
        if root.flag > 0: Image {
            source: root.flag == 2 ? @image-url("icons/x.svg") : @image-url("icons/flag.svg");
            colorize: root.flag == 2 ? Theme.label-red : Theme.over-text;
            width: root.glyph;
            height: root.glyph;
        }
        for s in min(root.rating, root.stars): Image {
            source: @image-url("icons/star.svg");
            colorize: Theme.over-text;
            width: root.glyph;
            height: root.glyph;
        }
        if root.label > 0: Rectangle {
            width: root.glyph - 2px;
            height: root.glyph - 2px;
            border-radius: (root.glyph - 2px) / 3.5;
            background: root.label == 1 ? Theme.label-red
                : root.label == 2 ? Theme.label-yellow
                : root.label == 3 ? Theme.label-green
                : root.label == 4 ? Theme.label-blue
                : Theme.label-purple;
        }
    }
}

// What a frame has been through, in the corner of its picture opposite
// the badges' (rating, flag, color): a pencil for a frame whose edit
// is not the default, a picture going down for a frame exported. Both
// when both are so, nothing when neither. Quieter than the badges, in
// the secondary text color on a lighter scrim. A raw with the camera's
// JPEG beside it says so in a word, "+JPEG", after them.
export component ThumbMarks inherits Rectangle {
    in property <bool> edited;
    in property <bool> exported;
    in property <bool> collected;
    in property <bool> paired;
    in property <length> glyph: 9px;
    visible: root.edited || root.exported || root.collected || root.paired;
    width: marks.preferred-width;
    height: root.glyph + 6px;
    border-radius: Theme.radius-sm;
    background: #00000080;
    marks := HorizontalLayout {
        padding-left: root.glyph / 3;
        padding-right: root.glyph / 3;
        spacing: root.glyph / 4.5;
        alignment: center;
        if root.edited: Image {
            source: @image-url("icons/pencil.svg");
            colorize: Theme.over-text-secondary;
            width: root.glyph;
            height: root.glyph;
            accessible-role: image;
            accessible-label: "Edited";
        }
        if root.exported: Image {
            source: @image-url("icons/image-down.svg");
            colorize: Theme.over-text-secondary;
            width: root.glyph;
            height: root.glyph;
            accessible-role: image;
            accessible-label: "Exported";
        }
        if root.collected: Image {
            source: @image-url("icons/bookmark.svg");
            colorize: Theme.over-text-secondary;
            width: root.glyph;
            height: root.glyph;
            accessible-role: image;
            accessible-label: "In a collection";
        }
        if root.paired: Text {
            text: "+JPEG";
            color: Theme.over-text-secondary;
            font-size: root.glyph;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            accessible-role: text;
            accessible-label: "With the camera's JPEG";
        }
    }
}

// A stack on its picture's bottom right, the corner the badges, the
// marks and a version's name leave free: the layers glyph and how many
// frames it shows on a closed stack's top, "2/5" on an open one's
// members. A click opens or closes the stack, as S does; it is drawn
// over the cell's own press so the cell does not take it. In the
// marks' quiet colors, lit while the pointer is on it.
export component ThumbStack inherits Rectangle {
    in property <int> count;
    in property <int> place;
    in property <bool> open;
    in property <length> glyph: 9px;
    callback clicked();
    visible: root.count > 1;
    width: row.preferred-width;
    height: root.glyph + 6px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? #000000cc : #00000080;
    accessible-role: button;
    accessible-label: root.open
        ? "Frame " + root.place + " of a stack of " + root.count + ", open"
        : "Stack of " + root.count;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: root.glyph / 3;
        padding-right: root.glyph / 3;
        spacing: root.glyph / 4.5;
        alignment: center;
        Image {
            source: @image-url("icons/layers.svg");
            colorize: touch.has-hover ? Theme.over-text : Theme.over-text-secondary;
            width: root.glyph;
            height: root.glyph;
        }
        Text {
            text: root.open ? root.place + "/" + root.count : root.count;
            color: touch.has-hover ? Theme.over-text : Theme.over-text-secondary;
            font-size: root.glyph;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A version's name on the top left of its picture ("Warm"), so two
// cells of one file can be told apart; the file's own wears none. In
// the marks' quiet colors, on their scrim.
export component ThumbTag inherits Rectangle {
    in property <string> name;
    in property <length> glyph: 9px;
    /// The most it takes of the picture's width, the name elided past it.
    in property <length> most: 100px;
    visible: root.name != "";
    width: min(root.most, words.preferred-width + root.glyph * 2 / 3);
    height: root.glyph + 6px;
    border-radius: Theme.radius-sm;
    background: #00000080;
    accessible-role: text;
    accessible-label: "Version " + root.name;
    words := Text {
        x: root.glyph / 3;
        width: parent.width - root.glyph * 2 / 3;
        text: root.name;
        color: Theme.over-text-secondary;
        font-size: root.glyph + 1px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// The arrow on a panel's edge that puts the panel away and brings it
// back: a small plate over the viewport's edge, its chevron pointing
// the way the edge will move. Quiet, it shows only under the pointer,
// so a picture with everything put away is the picture alone and the
// arrows are still there to be found.
export component EdgeArrow inherits Rectangle {
    in property <image> icon;
    in property <bool> quiet: false;
    in property <string> words;
    in property <string> label;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    touch := TipArea {
        words: root.words;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        opacity: root.quiet && !touch.has-hover ? 0 : 1;
        border-radius: Theme.radius-sm;
        background: touch.has-hover ? #000000c0 : #00000080;
        Image {
            width: 14px;
            height: 14px;
            source: root.icon;
            colorize: touch.has-hover ? Theme.over-text : Theme.over-text-secondary;
        }
    }
}

// A scroll bar over the edge of something the window scrolls by an
// offset of its own, the grid's sheet down its right edge and the
// strip along its foot, in the band and the colors the pane's lists
// have from the fluent style: a thin thumb that widens on a track
// under the pointer. Not the widget: the offset stays the owner's, and
// every move the bar makes goes through `scroll-to`. There whenever
// anything scrolls, faded at rest, so a hover over the band finds it;
// a press in the band is the bar's and never what is under it.
export component ScrollBand inherits TouchArea {
    /// Along the foot rather than down the right edge.
    in property <bool> horizontal;
    /// How far the owner is scrolled, and how far it can be.
    in property <length> scroll;
    in property <length> max;
    /// What a screen reader calls the bar.
    in property <string> label;
    /// A drag of the thumb or a press in the track: the offset wanted,
    /// which the owner holds to its range as it holds the wheel's.
    callback scroll-to(length);
    /// The wheel over the band: its two deltas, and whether Ctrl is
    /// held.
    callback wheel(length, length, bool);
    /// The thumb's length and place, and where a drag lands, asked of
    /// the grid's arithmetic, the band's length standing for the
    /// sheet's height.
    pure callback bar-length(length, length) -> length;
    pure callback bar-offset(length, length, length) -> length;
    pure callback bar-drag(length, length, length, length) -> length;
    /// Whether the frame menu is up: a press that closes it is nothing
    /// more.
    pure callback menu-shown() -> bool;
    /// A press of a mouse's back or forward button, which the owner may
    /// take: true when it did, and the press is then nothing else.
    callback side-press(PointerEvent) -> bool;
    callback focus-keys();
    /// Shown at full strength while the owner scrolls and a moment
    /// after, then faded: every change of the scroll stamps it, and the
    /// timer below lets it sleep once a tick has passed with no new
    /// stamp. The timer runs only while it is awake, so a sheet at rest
    /// asks for no frame.
    in-out property <bool> awake;
    property <int> stamp;
    property <int> seen;
    function wake() {
        root.stamp += 1;
        root.awake = true;
    }
    changed scroll => { root.wake(); }
    Timer {
        interval: 600ms;
        running: root.awake;
        triggered => {
            if (root.seen == root.stamp && !root.pressed) {
                root.awake = false;
            }
            root.seen = root.stamp;
        }
    }
    /// The band's length, and the pointer along it.
    property <length> span: root.horizontal ? root.width : root.height;
    property <length> along: root.horizontal ? root.mouse-x : root.mouse-y;
    // While the thumb is held it follows the pointer at once, ahead of
    // the owner, which catches up at the next step below.
    property <length> thumb-at: root.bar-offset(root.span, root.max,
        root.dragging ? root.want : root.scroll);
    property <length> thumb-len: root.bar-length(root.span, root.max);
    property <bool> lit: root.has-hover || root.pressed;
    property <bool> dragging;
    property <length> from;
    property <length> press-at;
    property <bool> took;
    /// Where the held thumb puts the owner, and whether it has yet to
    /// be moved there. A fast mouse sends several moves a frame, and
    /// each move that lands the grid more than a screen away re-makes
    /// every cell and puts their pictures on again, 6 to 7 ms on a
    /// 2,000-frame folder: the moves only note the scroll, and the
    /// timer below applies the last of them, so the owner moves and
    /// reports at most once a frame.
    property <length> want;
    property <bool> pending;
    function apply() {
        root.pending = false;
        root.scroll-to(root.want);
    }
    visible: root.max > 0;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.max / 1px;
    accessible-value: round(root.scroll / 1px);
    // Lingers a moment after the pointer leaves, as after a scroll.
    changed has-hover => {
        if (!self.has-hover) { root.wake(); }
    }
    // A screen reader's step is a page, as a press in the track is.
    accessible-action-increment => { root.scroll-to(root.scroll + root.span); }
    accessible-action-decrement => { root.scroll-to(root.scroll - root.span); }
    pointer-event(e) => {
        if (root.side-press(e)) { return; }
        // A press that closes a menu is nothing more, and leaves the
        // focus to the menu's closing; any other press in the band
        // gives the keys theirs back, as the pane's controls do.
        if (e.kind == PointerEventKind.down) {
            root.took = !root.menu-shown();
            if (root.took) { root.focus-keys(); }
        }
        if (e.button != PointerEventButton.left) { return; }
        if (e.kind == PointerEventKind.up) {
            if (root.pending) { root.apply(); }
            root.dragging = false;
            // Again at the release, after a drag: only a release whose
            // press was the bar's, so a press that closed a menu is
            // still nothing.
            if (root.took) { root.focus-keys(); }
            return;
        }
        if (e.kind != PointerEventKind.down) { return; }
        root.dragging = false;
        if (!root.took) { return; }
        // Before the thumb or past it, a page that way; on it, the
        // thumb taken.
        if (root.along < root.thumb-at) {
            root.scroll-to(root.scroll - root.span);
        } else if (root.along >= root.thumb-at + root.thumb-len) {
            root.scroll-to(root.scroll + root.span);
        } else {
            root.dragging = true;
            root.from = root.scroll;
            root.want = root.scroll;
            root.press-at = root.along;
        }
    }
    moved => {
        if (root.dragging && root.pressed) {
            root.want = root.bar-drag(root.span, root.max, root.from, root.along - root.press-at);
            root.pending = true;
        }
    }
    // Runs only while a step waits, so a held thumb at rest asks for
    // nothing.
    Timer {
        interval: 16ms;
        running: root.pending;
        triggered => { root.apply(); }
    }
    // The wheel over the bar scrolls as anywhere.
    scroll-event(e) => {
        if (e.delta-x != 0px || e.delta-y != 0px) {
            root.wheel(e.delta-x, e.delta-y, e.modifiers.control);
        }
        return accept;
    }
    Rectangle {
        opacity: root.awake || root.lit ? 1 : 0;
        animate opacity { duration: 200ms; }
        // Round ends, in a band narrower than the grid's too.
        border-radius: min(7px, (root.horizontal ? root.height : root.width) / 2);
        background: root.lit ? Theme.scrollbar-track : transparent;
        Rectangle {
            // On whole device pixels, so a 2 px thumb is crisp at a
            // fractional scale: its thickness across the band, 4 px in
            // from the outer edge, and its place and length along it.
            property <length> thick: round((root.lit ? 6px : 2px) / 1phx) * 1phx;
            property <length> at: round(root.thumb-at / 1phx) * 1phx;
            property <length> long: round(root.thumb-len / 1phx) * 1phx;
            property <length> edge: round(((root.horizontal ? parent.height : parent.width) - 4px) / 1phx) * 1phx;
            animate thick { duration: 150ms; easing: ease-out; }
            x: root.horizontal ? self.at : self.edge - self.thick;
            y: root.horizontal ? self.edge - self.thick : self.at;
            width: root.horizontal ? self.long : self.thick;
            height: root.horizontal ? self.thick : self.long;
            border-radius: self.thick / 2;
            background: root.lit ? Theme.scrollbar-thumb-hover : Theme.scrollbar-thumb;
        }
    }
}
