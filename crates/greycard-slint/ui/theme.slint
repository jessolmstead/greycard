// Design tokens: the palette, the type and spacing scales, the radii.
// Everything in the panels reads from here and nowhere else.
//
// The surfaces and the text come in three palettes, one family each,
// stepped the same way: Charcoal (the default), Grey, and Light, by
// `name`. Contrast on Charcoal's panel surface (#1e1e1e): text 12:1,
// text-secondary 6.8:1, text-muted 3.6:1 (labels of disabled controls
// only), accent 7:1. Grey keeps text-muted at 3.5:1 on its surface;
// Light, whose hover and pressed step darker rather than lighter as
// a light window's do, keeps it at 3.9:1, and darkens red, yellow,
// green, and the accent where they are words, and the selection's
// fill and the focus ring, which would not show there. The
// accent's fills are the one blue in all three, and the picture's
// surround is the viewport's own setting, not the theme's.

struct Tones {
    canvas: color,
    base: color,
    surface: color,
    raised: color,
    hover: color,
    hover-veil: color,
    pressed: color,
    border: color,
    border-strong: color,
    sheet: color,
    text: color,
    text-secondary: color,
    text-muted: color,
    text-strong: color,
    accent-text: color,
    selection: color,
    focus-ring: color,
    warn-red: color,
    warn-yellow: color,
    ok-green: color,
    scrollbar-thumb: color,
    scrollbar-thumb-hover: color,
    scrollbar-track: color,
}

export global Theme {
    /// The palette by name: "Charcoal", "Grey", or "Light"; any other
    /// reads as Charcoal. Set from the Settings sheet's Theme row.
    in-out property <string> name: "Charcoal";
    out property <bool> light: name == "Light";

    property <Tones> charcoal: {
        canvas: #0f0f0f, base: #171717, surface: #1e1e1e, raised: #262626,
        hover: #2e2e2e, hover-veil: #ffffff0d, pressed: #353535,
        border: #303030, border-strong: #3d3d3d, sheet: #232323,
        text: #ececec, text-secondary: #a9a9a9, text-muted: #737373,
        text-strong: #ffffff, accent-text: #6ea8ff,
        selection: #6ea8ff26, focus-ring: #6ea8ff99,
        warn-red: #e0645c, warn-yellow: #dcb63c, ok-green: #55b46e,
        scrollbar-thumb: #8a8a8a, scrollbar-thumb-hover: #b4b4b4, scrollbar-track: #2c2c2c,
    };
    property <Tones> grey: {
        canvas: #2a2a2a, base: #333333, surface: #3b3b3b, raised: #444444,
        hover: #4c4c4c, hover-veil: #ffffff10, pressed: #555555,
        border: #4e4e4e, border-strong: #5c5c5c, sheet: #404040,
        text: #f2f2f2, text-secondary: #c2c2c2, text-muted: #909090,
        text-strong: #ffffff, accent-text: #6ea8ff,
        selection: #6ea8ff26, focus-ring: #6ea8ff99,
        warn-red: #e0645c, warn-yellow: #dcb63c, ok-green: #55b46e,
        scrollbar-thumb: #9a9a9a, scrollbar-thumb-hover: #c4c4c4, scrollbar-track: #474747,
    };
    property <Tones> light-palette: {
        canvas: #b0b0b0, base: #c4c4c4, surface: #d4d4d4, raised: #e2e2e2,
        hover: #c8c8c8, hover-veil: #00000010, pressed: #bcbcbc,
        border: #bababa, border-strong: #a4a4a4, sheet: #cbcbcb,
        text: #161616, text-secondary: #444444, text-muted: #666666,
        text-strong: #000000, accent-text: #174a96,
        selection: #1f5fbf38, focus-ring: #174a96,
        warn-red: #a12a22, warn-yellow: #6e5600, ok-green: #1f6531,
        scrollbar-thumb: #7a7a7a, scrollbar-thumb-hover: #5a5a5a, scrollbar-track: #bdbdbd,
    };
    property <Tones> now: name == "Light" ? light-palette
        : name == "Grey" ? grey
        : charcoal;

    // Surfaces, back to front.
    out property <color> canvas: now.canvas;
    out property <color> base: now.base;
    out property <color> surface: now.surface;
    out property <color> raised: now.raised;
    out property <color> hover: now.hover;
    // `hover`, as a veil rather than a flat fill: over the plain
    // plate it composites to about the `hover` grey, but over a
    // labeled cell's tinted plate it lets the tint show through,
    // where `hover` itself (opaque) would hide it. Grid cells only.
    out property <color> hover-veil: now.hover-veil;
    out property <color> pressed: now.pressed;
    out property <color> border: now.border;
    out property <color> border-strong: now.border-strong;
    // The grid's sheet, behind the thumbnails: a grey between the
    // panels and a control, so the contact sheet reads as part of the
    // window rather than a hole in it, and still quiet enough that a
    // frame is judged against a neutral. A cell's hover and its
    // selection still step from it.
    out property <color> sheet: now.sheet;
    // The lightbox's surround: pictures alone, so the same near black
    // whatever the theme.
    out property <color> lightbox: #0f0f0f;

    // Text.
    out property <color> text: now.text;
    out property <color> text-secondary: now.text-secondary;
    out property <color> text-muted: now.text-muted;
    // A step past `text`: a slider's handle held down.
    out property <color> text-strong: now.text-strong;
    // Words, and a bar's track, on a dark plate over the picture (the
    // status, a thumbnail's badges, and the viewport's edge arrows):
    // the plate is the same in every theme, so they are too.
    out property <color> over-text: #ececec;
    out property <color> over-text-secondary: #a9a9a9;
    out property <color> over-track: #3d3d3d;
    // Charcoal's muted words and marks, on grounds dark in every theme
    // (the histogram's, the lightbox's), and the clipping marks' ink.
    out property <color> dark-muted: #737373;
    out property <color> scope-ink: #0f0f0f;

    // Accent.
    out property <color> accent: #6ea8ff;
    out property <color> accent-hover: #8dbbff;
    out property <color> accent-pressed: #5b95ec;
    out property <color> accent-muted: #6ea8ff40;
    // A chosen row's fill and the keyboard's focus: the blue on the
    // dark themes, darker on Light, where it would not show.
    out property <color> selection: now.selection;
    out property <color> focus-ring: now.focus-ring;
    // The accent as words, darker on Light where the blue itself
    // would not read.
    out property <color> accent-text: now.accent-text;
    // Ink over an accent fill (a primary button's words, a tick),
    // and a switch's knob: the same in every theme, as the accent is.
    out property <color> on-accent: #101010;
    out property <color> knob: #ffffff;

    // The color labels a frame can carry, in the browser's badges.
    // Lightroom's five names, at this panel's lightness: saturated
    // enough to tell apart over a thumbnail, dim enough that a shelf
    // of them is not a fairground. Red is also the reject flag's. The
    // same in every theme: they are swatches, on thumbnails and on the
    // dark plates over them.
    out property <color> label-red: #e0645c;
    out property <color> label-yellow: #dcb63c;
    out property <color> label-green: #55b46e;
    // Red, yellow, and green as words (a warning, a missing file, a
    // match): the labels' colors on the dark themes, darker on Light
    // to read on its surfaces.
    out property <color> warn-red: now.warn-red;
    out property <color> warn-yellow: now.warn-yellow;
    out property <color> ok-green: now.ok-green;
    out property <color> label-blue: #5b9ce6;
    out property <color> label-purple: #a179dd;

    // How far a labeled grid cell's plate tints toward its color
    // label: a quarter of the way, so five labels are tellable apart
    // without the grid becoming a quilt. The selection's and the
    // hover's ground go over the tint, not through a stronger mix of
    // it, so a chosen or hovered labeled tile still carries the same
    // cue an unlabeled one does.
    out property <float> plate-tint-mix: 0.25;

    /// The color label's color (1 to 5), or transparent for none.
    public pure function label-color(label: int) -> color {
        return label == 1 ? self.label-red
            : label == 2 ? self.label-yellow
            : label == 3 ? self.label-green
            : label == 4 ? self.label-blue
            : label == 5 ? self.label-purple
            : transparent;
    }

    /// A cell's plate, its `base` color tinted toward a color label
    /// (0 leaves `base` as it was).
    public pure function plate-tint(base: color, label: int) -> color {
        // `Color.mix`'s factor is its first color's own weight, so
        // the label's share (`plate-tint-mix`) is one minus it: `base`
        // keeps the rest.
        return label == 0 ? base : base.mix(self.label-color(label), 1.0 - self.plate-tint-mix);
    }

    // Type scale.
    out property <length> font-xs: 11px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 13px;
    out property <length> font-lg: 15px;
    out property <length> font-xl: 18px;
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;

    // Spacing scale.
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;
    out property <length> space-6: 32px;

    // Radii and control sizes.
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 10px;
    out property <length> control-height: 28px;
    out property <length> icon: 16px;
    out property <duration> quick: 80ms;
    // The fluent style's ScrollView draws its bar's touch band this
    // wide over a list's right edge, whether or not the thumb itself
    // is showing. A list row with a trailing control (a bin, say)
    // gives it this much clearance so the band never sits over that
    // control's hit area.
    out property <length> scrollbar-band: 14px;
    // A bar drawn in that band for a scroll of our own (the grid's and
    // the strip's), over pictures and without the fluent bar's arrows
    // or border: its thumb, solid and grey enough to read on the sheet
    // and on a bright picture (about 5.6:1 on #1f1f1f, 3.5:1 on white), lighter
    // when it widens under the pointer, and the track shown then, the
    // fluent-dark alternate background.
    // (Light's darker, to read on its sheet.)
    out property <color> scrollbar-thumb: now.scrollbar-thumb;
    out property <color> scrollbar-thumb-hover: now.scrollbar-thumb-hover;
    out property <color> scrollbar-track: now.scrollbar-track;
}
