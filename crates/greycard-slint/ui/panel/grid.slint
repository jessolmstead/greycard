// The grid: the folder as a contact sheet over the window, its header
// with the filter, and the cells riding on one scrolled offset, under
// a row of tiles for the folders in the folder open.

import { Theme, MenuFit } from "../theme.slint";
import { Thumb, ThumbCell, FilterChip, FacetRow, FacetRange, FolderTile, SortMenu, GridHead, GridPlace } from "../structs.slint";
import { ButtonKeys, NameTip, PanelButton, ScrollBand, SizeSlider, ThumbBadges, ThumbMarks, ThumbStack, ThumbTag, TipArea } from "../controls.slint";
import { FilterBar, HeaderRanges, SortButton } from "filter.slint";
import { LoadingCard } from "loading.slint";

// A button on the lightbox's bar: an icon alone on the bar's dark
// plate, in the plate's own colors in every theme, its words at the
// pointer after a rest.
component BarButton inherits Rectangle {
    in property <image> icon;
    in property <string> words;
    in property <string> label;
    callback clicked();
    out property <bool> hovered: ta.has-hover;
    out property <bool> focused: fs.has-focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-md;
    background: ta.pressed ? #ffffff33 : ta.has-hover ? #ffffff1f : transparent;
    border-width: fs.has-focus ? 2px : 0;
    border-color: Theme.accent;
    animate background { duration: Theme.quick; }
    Image {
        source: root.icon;
        colorize: Theme.over-text;
        width: Theme.icon;
        height: Theme.icon;
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.clicked(); return accept; }
            return ButtonKeys.pass(e) ? accept : reject;
        }
    }
    ta := TipArea {
        words: root.words;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component GridSheet inherits Rectangle {
    /// Every row, for the header; the cells are drawn from `cells`,
    /// the rows on screen and a margin, each placed by its row.
    in property <[Thumb]> thumbs;
    in property <[ThumbCell]> cells;
    in-out property <int> selected;
    /// A click on a frame, with Ctrl and Shift as they were held
    /// when it was pressed.
    callback frame-clicked(int, bool, bool);
    /// A middle click on a frame, as the strip has it.
    callback frame-middle-clicked(int);
    /// A right-click on a frame (or, on a Mac, a Control+click), as
    /// the strip has it: the row and where, in the window's pixels.
    callback frame-menu(int, length, length);
    /// A click on a stack's badge: the stack of that row opened or
    /// closed.
    callback stack-clicked(int);
    /// Whether the frame menu is up: a press that closes it reaches
    /// the cell under it too, and is not a click there.
    pure callback menu-shown() -> bool;
    /// A mouse's back or forward button (true for back): the folder
    /// visited before, or the one gone back from, as a browser has
    /// them. The arrows step the frames.
    callback side-visit(bool);
    /// Whether `e` is a press of a mouse's back or forward button,
    /// going back or forward if no menu is up. Every press is the
    /// topmost TouchArea's, so a cell, a tile, the bar and the sheet
    /// between them each ask this first, and the button works wherever
    /// the pointer is over the frames.
    function side-press(e: PointerEvent) -> bool {
        if (e.kind != PointerEventKind.down
            || (e.button != PointerEventButton.back && e.button != PointerEventButton.forward)) {
            return false;
        }
        if (!root.menu-shown()) { root.side-visit(e.button == PointerEventButton.back); }
        return true;
    }
    in property <bool> ctrl-click-menu;
    /// For a snapshot (`--menu`): the row to open the menu over, as
    /// if right-clicked in its cell's middle; -1 for none.
    in property <int> menu-at: -1;
    changed menu-at => {
        if (self.menu-at >= 0 && self.menu-at < self.thumbs.length) {
            let p = self.place(self.menu-at);
            self.frame-menu(self.menu-at,
                grid-sheet.absolute-position.x + self.grid-left
                    + p.col * self.grid-pitch + self.grid-cell / 2,
                grid-sheet.absolute-position.y - self.grid-scroll + self.grid-pad + self.grid-top
                    + p.y + p.pic / 2);
        }
    }
    /// The lightbox: the sheet alone on the canvas's dark, no header,
    /// no folder tiles, and each frame its picture and nothing else,
    /// drawn from the row's `big` (the picture an export of it will
    /// be) over the whole cell, the name's room included. The current
    /// frame and the set keep their ring, which is how the arrows are
    /// followed.
    in property <bool> lightbox;
    /// The badges (rating, flag, label) on the lightbox's tiles too,
    /// asked for by a key.
    in property <bool> lightbox-badges;
    /// The header's Lightbox button.
    callback lightbox-asked();
    /// The bar's close: out of the lightbox to the grid, as L.
    callback lightbox-close();
    /// The lightbox's surround: MONITOR's canvas shade, the viewport's
    /// own. What is drawn on it straight (the rings, a tile's word, the
    /// badges' plates, the bar's scrim) reads its lightness.
    in property <color> lightbox-ground: #0f0f0f;
    /// The sheet's ground as the window works it out: the grid's grey,
    /// or the lightbox's surround. Drawn as it is, with no choice here.
    in property <color> ground;
    property <float> ground-value: root.lightbox-ground.to-hsv().value;
    /// White: the rings in the dark blue, the plates denser.
    property <bool> ground-light: root.ground-value > 0.5;
    /// The greys between black and white, where the quiet word takes
    /// a lighter grey to stay read.
    property <bool> ground-mid: root.ground-value > 0.12 && !root.ground-light;
    /// The tiles' size: where the slider's knob sits (0 to 1), the
    /// intervals it snaps to (none for a slider that does not), the
    /// size in logical pixels and its range, for a screen reader. The
    /// window works each out for the grid or the lightbox.
    in property <float> size-at;
    in property <int> size-steps;
    in property <length> size-least;
    in property <length> size-most;
    /// The slider moved to a place, or a step asked by its keys.
    callback size-moved(float);
    callback size-stepped(int);
    /// The lightbox's bar: close, the count, and the tiles' size, over
    /// the top of the sheet on a scrim. Up when the pointer moves over
    /// the sheet (or a finger or a pen touches it, having no hover),
    /// and as the lightbox opens, so it is seen once; down after
    /// `bar-rest` with the pointer still, unless the pointer is on it
    /// or one of its controls is held or has the keys.
    in-out property <bool> bar-up;
    in property <duration> bar-rest: 2s;
    property <length> bar-h: Theme.control-height + 2 * Theme.space-2;
    /// The pointer still over the bar's strip of the sheet: the move
    /// that woke the bar landed there, and the bar, come up under it,
    /// has heard nothing of the pointer since.
    property <bool> bar-under: sheet-ta.has-hover && root.seen-y >= 0 && root.seen-y < root.bar-h;
    /// Where the pointer was over the sheet, down from its top, at the
    /// last event seen: kept rather than worked out from the scroll, so
    /// a scroll by the keys under a still pointer does not move it.
    property <length> seen-y: -1px;
    property <bool> bar-held: bar-ta.has-hover || root.bar-under || bar-close.hovered
        || bar-close.focused || bar-size.held || bar-size.focused || bar-size.hovered;
    function bar-wake() {
        if (!root.lightbox) { return; }
        root.bar-up = true;
        bar-timer.running = true;
        bar-timer.restart();
    }
    bar-timer := Timer {
        interval: root.bar-rest;
        running: false;
        triggered => {
            self.running = false;
            if (!root.bar-held) { root.bar-up = false; }
        }
    }
    // Let go of (the pointer off it, the drag over, the keys gone): the
    // rest starts again from here.
    changed bar-held => { if (!root.bar-held && root.bar-up) { root.bar-wake(); } }
    changed lightbox => {
        if (root.lightbox) { root.bar-wake(); } else { root.bar-up = false; }
    }
    init => {
        if (root.lightbox) { root.bar-wake(); } else { root.bar-up = false; }
    }
    /// A pointer's event over the sheet: a move, or a press, wakes the
    /// lightbox's bar.
    function pointer-seen(e: PointerEvent) {
        root.seen-y = sheet-ta.mouse-y - root.grid-scroll;
        if (e.kind == PointerEventKind.move || e.kind == PointerEventKind.down) { root.bar-wake(); }
    }
    /// The rows are a collection's own order, which a drag changes.
    in property <bool> reorder;
    /// A frame dragged from its row to before the row of the slot, or
    /// to the end for a slot past the last.
    callback frame-moved(int, int);
    /// The slot a drag is over, -1 for none.
    property <int> drop-slot: -1;
    /// The slot under a point of the sheet: the gap nearest the point
    /// in its row, held to the list.
    function slot-at(x: length, y: length) -> int {
        let col = clamp(round((x - root.grid-left) / root.grid-pitch), 0, root.grid-cols);
        let start = root.grid-row-at(y - root.grid-pad - root.grid-top, root.grid-cell,
            root.grid-cols, root.thumbs.length, root.grid-head-rows, root.grid-shape);
        return min(max(0, start) + col, root.thumbs.length);
    }
    /// How many frames the selection holds, for the header.
    in property <int> set-count;
    in property <int> meta-stars;
    in-out property <bool> grid-open;
    in-out property <length> grid-cell;
    in property <length> grid-pad;
    in property <length> grid-label;
    in-out property <length> grid-w;
    in-out property <length> grid-h;
    in property <length> grid-scroll;
    in property <length> grid-gap;
    property <length> grid-pitch: root.grid-cell + root.grid-gap;
    pure callback grid-slack(length, length, int) -> length;
    property <length> grid-left:
        root.grid-pad + root.grid-slack(root.grid-w, root.grid-cell, root.grid-cols);
    in property <int> grid-cols;
    in property <length> grid-max;
    /// The folders in the folder open, as tiles above the cells, which
    /// they push down by `grid-top`: a row of them for each row of the
    /// grid's columns, half a cell tall. Not frames: no selection, no
    /// rating, no frame menu. A click opens the folder as its row in
    /// the tree does; a right-click offers Reveal while the root is
    /// online.
    in property <[FolderTile]> tiles;
    in property <length> grid-top;
    /// The headings: each a row of its own above the frames it heads,
    /// which start a new row under it. `grid-head-rows` is where each
    /// stands, by the list's number, for the arithmetic; empty for a
    /// grid with none (every view but the export queue's, and the
    /// lightbox, which ignores them).
    in property <[GridHead]> grid-heads;
    in property <[int]> grid-head-rows;
    in property <length> grid-head-h;
    /// A tile's export is being written: the running bar's one phase,
    /// as the status plate runs its own.
    in property <bool> queue-busy;
    property <float> busy-phase: 0;
    Timer {
        interval: 16ms;
        running: root.queue-busy;
        triggered => { root.busy-phase = mod(root.busy-phase + 0.015, 1); }
    }
    /// The export queue's view: no rejects folder to delete.
    in property <bool> queue-view;
    /// The queue's view runs the queue from its own header, as the
    /// export sheet's foot does: the count line, and the button, off
    /// while any export or the queue itself is running.
    in property <string> queue-line;
    in property <bool> queue-running;
    in property <bool> queue-can-run;
    callback queue-run();
    /// Where a frame sits under the headings, and the first frame of
    /// the row at a height, asked of the arithmetic the Rust side
    /// tests: the rows are as tall as the tallest picture in them, so
    /// a row's top is the layout's, under its number `grid-shape`.
    in property <int> grid-shape;
    pure callback grid-place(int, length, int, [int], int) -> GridPlace;
    pure callback grid-row-at(length, length, int, int, [int], int) -> int;
    function place(i: int) -> GridPlace {
        return root.grid-place(i, root.grid-cell, root.grid-cols, root.grid-head-rows, root.grid-shape);
    }
    callback tile-picked(int);
    callback tile-reveal(int);
    /// After a pick from the tiles' menu: the keys take the focus back.
    callback menu-done();
    /// The tile the menu is about.
    property <int> menu-tile: -1;
    function open-tile-menu(i: int, x: length, y: length) {
        root.focus-keys();
        root.menu-tile = i;
        tile-menu.show({ x: x - tile-menu.absolute-position.x, y: y - tile-menu.absolute-position.y });
    }
    callback grid-wheel(length, bool);
    callback grid-relay();
    /// The scroll bar: a drag of its thumb or a press in its track
    /// scrolls to an offset, held to the range by the window as the
    /// wheel's scroll is. The thumb's length and top, and where a drag
    /// lands, are asked of the grid's arithmetic.
    callback grid-scroll-to(length);
    pure callback bar-length(length, length) -> length;
    pure callback bar-offset(length, length, length) -> length;
    pure callback bar-drag(length, length, length, length) -> length;
    /// Whether the scroll bar is awake after a scroll: it fades once
    /// the sheet has been still a moment.
    in-out property <bool> bar-awake;
    /// The Loupe asked for, by the header's button or a double-click on
    /// a cell: the window's one way back to it.
    callback loupe-asked();
    in-out property <[FilterChip]> filter-stars;
    in-out property <[FilterChip]> filter-flags;
    in-out property <[FilterChip]> filter-labels;
    in-out property <bool> filter-exact;
    in-out property <string> filter-text;
    in-out property <int> filter-shown;
    in-out property <int> filter-total;
    in-out property <bool> filter-on;
    /// Whether the filter bar is shown under the header's top row;
    /// off, the header is that row alone and the filter still applies.
    in property <bool> filter-bar: true;
    in-out property <bool> filter-focus;
    in property <[FacetRow]> filter-facets-long;
    in property <[FacetRow]> filter-facets-short;
    in property <string> filter-facet-note;
    callback filter-facet-toggled(int, string, bool);
    /// ISO and the focal length, a range each over the folder's values.
    in property <FacetRange> filter-iso-range;
    in property <FacetRange> filter-focal-range;
    callback filter-range-moved(int, int, string, string);
    callback filter-range-reset(int);
    /// The filter kept as a smart collection: its name asked for.
    callback filter-save-smart();
    /// Whether the bar offers Save...: not over a collection.
    in property <bool> filter-can-save: true;
    /// The bar's Sort menu, and its two picks.
    in property <SortMenu> sort-menu;
    callback sort-picked(int);
    callback sort-turned(bool);
    in-out property <bool> sort-shown;
    callback filter-star-picked(int);
    callback filter-flag-toggled(int, bool);
    callback filter-label-toggled(int, bool);
    callback filter-exact-toggled();
    callback filter-text-edited(string);
    callback filter-cleared();
    /// An import's progress and then its end, said in place of the
    /// selection while the left pane, which says it under Import, is
    /// put away: the grid covers the status plate. Empty for none.
    in property <string> import-line;
    /// The window's status line, which the viewport's plate shows and
    /// the grid covers: said after the selection's name, so what the
    /// header's actions answer ("there is no rejects folder", a move's
    /// clash) is seen from here as it is from the loupe.
    in property <string> status-line;
    /// What waits to go to an archive, beside the status; a click on
    /// it tries now.
    in property <string> sync-note;
    callback sync-retry();
    callback focus-keys();
    /// The header's Back up or Bring back (§216): its words ("3 frames
    /// not on Archive", "Back up...", "Bring back..."), empty for none;
    /// the choices it offers, in full ("Back up to Archive..."), a menu
    /// when more than one.
    in property <string> archive-text;
    in property <[string]> archive-choices;
    callback archive-pressed(int);
    /// The header's Rejects menu: CULLING's ways out for the rejects,
    /// here because the grid covers the panel. The same counts and
    /// the same callbacks as the section's, which the window forwards
    /// to the one handler each: Move rejects (none to move grays it),
    /// Move back over the selection (none in a rejects folder leaves
    /// it out), Delete rejects folder, and Remove rejects from each
    /// archive (no archive, no item).
    in property <int> reject-count;
    callback rejects-asked();
    in property <int> back-count;
    in property <string> back-to;
    callback move-back();
    callback delete-asked(string);
    in property <[string]> archive-rejects-choices;
    callback archive-rejects-asked(int);
    /// A view's sidecars being read, past the moment a fast one takes:
    /// its bar over the sheet, which holds the list before it until
    /// the new one lands.
    in property <bool> loading-shown;
    in property <float> loading-fraction;
    in property <string> loading-line;

    background: root.ground;
    // Nothing may fall through to the viewport behind, the wheel
    // over the header least of all: it would zoom a picture that
    // is not on screen, or size the brush in hand.
    TouchArea {
        pointer-event(e) => { root.side-press(e); }
        scroll-event(e) => { return accept; }
    }
    VerticalLayout {
        // The header: what is selected and how large the cells
        // are, then the filter. Where the frames are (the folder, the
        // roots, the tree) is the left pane's; what is looked for
        // among them is here, over the sheet it narrows.
        // Always there and of no height in the lightbox, rather than
        // made and unmade by an `if`: an element brought in by one is
        // built a frame late, and the sheet would be born at the
        // window's height and re-flow once the header came in.
        Rectangle {
            visible: !root.lightbox;
            // Two rows of controls and two of chips: the selection's
            // line, the filter's meta chips with its words, and its
            // facets on two rows, camera and lens first, the rest under
            // them. Spelled out rather than asked of the layout: a
            // header whose height settles a frame late re-flows the
            // sheet twice on the way in, and the second re-flow is a
            // folder's worth of thumbnails asked for again. The
            // facets' rows are there before the index has anything to
            // put in them for the same reason, and a row the folder
            // has no facet for leaves its room empty. The ranges' row,
            // between them, is there only while a range has values,
            // and the header grows by it: room left for it always would
            // be a gap over most folders.
            height: root.lightbox ? 0px
                : root.filter-bar ? 2 * Theme.control-height + 2 * (Theme.control-height - 4px)
                    + 5 * Theme.space-2 + 1px
                    + HeaderRanges.room(root.filter-iso-range.values.length > 1,
                        root.filter-focal-range.values.length > 1, self.width - 2 * Theme.space-4)
                : Theme.control-height + 2 * Theme.space-2 + 1px;
            clip: true;
            background: Theme.surface;
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }
            header := VerticalLayout {
                padding: Theme.space-2;
                padding-left: Theme.space-4;
                padding-right: Theme.space-4;
                spacing: Theme.space-2;
                HorizontalLayout {
                    spacing: Theme.space-3;
                    height: Theme.control-height;
                    if root.import-line != "": import-line-text := Text {
                        text: root.import-line;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if root.import-line == "": chosen-name := Text {
                        text: root.selected >= 0 && root.selected < root.thumbs.length
                            ? (root.set-count > 1
                                ? @tr("{} and {n} other" | "{} and {n} others" % (root.set-count - 1), root.thumbs[root.selected].name)
                                : root.thumbs[root.selected].name)
                            : "";
                        color: Theme.text;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                        // Cut short, the whole line at the pointer.
                        chosen-ta := TouchArea {
                            property <int> downs;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) { self.downs += 1; }
                            }
                        }
                        NameTip {
                            width: 100%;
                            height: 100%;
                            name: chosen-name.text;
                            cut: chosen-name.preferred-width > chosen-name.width;
                            row-hover: chosen-ta.has-hover;
                            hover: chosen-ta.has-hover;
                            pointer-x: chosen-ta.mouse-x;
                            pointer-y: chosen-ta.mouse-y;
                            downs: chosen-ta.downs;
                            quiet: root.menu-shown();
                        }
                    }
                    if root.import-line == "" && root.status-line != "": Text {
                        text: root.status-line;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        horizontal-stretch: 2;
                        overflow: elide;
                    }
                    if root.import-line == "" && root.sync-note != "": Text {
                        // A click tries the sync again: a button to a
                        // screen reader, named by its words.
                        accessible-role: button;
                        accessible-action-default => { root.sync-retry(); }
                        text: root.sync-note;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        overflow: elide;
                        TouchArea {
                            clicked => { root.sync-retry(); }
                        }
                    }
                    if root.queue-view && root.queue-line != "": Text {
                        text: root.queue-running ? @tr("{}, running", root.queue-line) : root.queue-line;
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.queue-view: queue-run-button := PanelButton {
                        text: @tr("Export the queue");
                        icon: @image-url("../icons/image-down.svg");
                        words: @tr("Export every queued set, in order");
                        enabled: root.queue-can-run;
                        clicked => { root.focus-keys(); root.queue-run(); }
                    }
                    // The order in words rides here, on the header's top
                    // row, which has room to spare: beside the filter's
                    // count it took the last label chips off the row
                    // below at the editor's default width.
                    count-line := Text {
                        text: @tr("{n} frame" | "{n} frames" % root.thumbs.length) + " · "
                            // Grid header: 'by capture time', after the frame count
                            + (root.sort-menu.label == "" ? "" : @tr("by {}", root.sort-menu.label) + " · ")
                            + round(root.grid-cell / 1px) + " px";
                        color: Theme.text-muted;
                        font-size: Theme.font-xs;
                        vertical-alignment: center;
                    }
                    // The cells' size, beside the size in words: the
                    // lightbox's bar has the same slider for its tiles.
                    SizeSlider {
                        width: 96px;
                        label: @tr("Tile size");
                        words: @tr("Tile size");
                        value: root.size-at;
                        steps: root.size-steps;
                        shown: root.grid-cell / 1px;
                        least: root.size-least / 1px;
                        most: root.size-most / 1px;
                        moved(at) => { root.size-moved(at); }
                        stepped(by) => { root.size-stepped(by); }
                        released => { root.focus-keys(); }
                    }
                    if root.archive-text != "": archive-button := PanelButton {
                        text: root.archive-text;
                        icon: @image-url("../icons/cloud.svg");
                        clicked => {
                            root.focus-keys();
                            if (root.archive-choices.length > 1) {
                                archive-menu.show({ x: 0, y: self.height });
                            } else {
                                root.archive-pressed(0);
                            }
                        }
                        archive-menu := ContextMenuArea {
                            width: 0px;
                            height: 0px;
                            enabled: false;
                            Menu {
                                // Past what the window holds, as the
                                // frame menu's archives are: not offered.
                                for i in min(root.archive-choices.length, MenuFit.rows(0)): MenuItem {
                                    title: root.archive-choices[i];
                                    activated => { root.archive-pressed(i); }
                                }
                            }
                        }
                    }
                    // What CULLING offers for the folder's rejects, which
                    // the grid would otherwise hide: folder-level, so it
                    // sits here beside the archive's button rather than
                    // on the frame menu, which is the selection's. Move
                    // back is in both, as it is in CULLING beside Move
                    // rejects. One menu, so the header keeps its width.
                    rejects-button := PanelButton {
                        text: root.reject-count == 0 ? @tr("Rejects")
                            : @tr("{n} reject" | "{n} rejects" % root.reject-count);
                        icon: @image-url("../icons/folder-open.svg");
                        clicked => {
                            root.focus-keys();
                            rejects-menu.show({ x: 0, y: self.height });
                        }
                        rejects-menu := ContextMenuArea {
                            width: 0px;
                            height: 0px;
                            enabled: false;
                            Menu {
                                MenuItem {
                                    title: root.reject-count == 0 ? @tr("No rejects to move")
                                        : @tr("Move {n} reject..." | "Move {n} rejects..." % root.reject-count);
                                    enabled: root.reject-count > 0;
                                    activated => { root.rejects-asked(); }
                                }
                                if root.back-count > 0: MenuItem {
                                    title: root.back-count > 1
                                        ? @tr("Move {n} frame back to {}" | "Move {n} frames back to {}" % root.back-count, root.back-to)
                                        : @tr("Move back to {}", root.back-to);
                                    activated => { root.move-back(); root.menu-done(); }
                                }
                                MenuSeparator { }
                                // These two, and Move rejects above,
                                // open a sheet that takes the
                                // focus itself, so no `menu-done`: its
                                // timer would take the focus back to the
                                // window's keys after the sheet had it,
                                // and Return on the sheet would answer
                                // nothing. The timer is for a pick from
                                // a sub-menu, and this menu has none.
                                MenuItem {
                                    title: @tr("Delete rejects folder...");
                                    enabled: !root.queue-view;
                                    activated => { root.delete-asked("rejects"); }
                                }
                                if root.archive-rejects-choices.length > 0: MenuSeparator { }
                                // Beside the menu's five rows above; past
                                // them, as the archive button's are.
                                for i in min(root.archive-rejects-choices.length, MenuFit.rows(5)): MenuItem {
                                    title: root.archive-rejects-choices[i];
                                    activated => { root.archive-rejects-asked(i); }
                                }
                            }
                        }
                    }
                    lightbox-button := PanelButton {
                        text: @tr("Lightbox");
                        icon: @image-url("../icons/grid-2x2.svg");
                        clicked => { root.focus-keys(); root.lightbox-asked(); }
                    }
                    // The bar put away: its Sort button here instead,
                    // the one way to change the order.
                    if !root.filter-bar: SortButton {
                        sort: root.sort-menu;
                        sort-shown <=> root.sort-shown;
                        picked(i) => { root.sort-picked(i); }
                        turned(d) => { root.sort-turned(d); }
                        released => { root.focus-keys(); }
                    }
                }
                // Made and unmade by an `if`, unlike the header: the
                // bar comes and goes only from the Settings sheet, and
                // the one re-flow then is the change asked for.
                if root.filter-bar: FilterBar {
                    takes-focus: true;
                    wanted <=> root.filter-focus;
                    stars: root.filter-stars;
                    flags: root.filter-flags;
                    labels: root.filter-labels;
                    facets-long: root.filter-facets-long;
                    facets-short: root.filter-facets-short;
                    facet-note: root.filter-facet-note;
                    facet-toggled(c, k, x) => { root.filter-facet-toggled(c, k, x); }
                    iso-range: root.filter-iso-range;
                    focal-range: root.filter-focal-range;
                    range-moved(c, e, l, h) => { root.filter-range-moved(c, e, l, h); }
                    range-reset(c) => { root.filter-range-reset(c); }
                    exact: root.filter-exact;
                    shown: root.filter-shown;
                    total: root.filter-total;
                    on: root.filter-on;
                    text <=> root.filter-text;
                    star-picked(i) => { root.filter-star-picked(i); }
                    flag-toggled(i, x) => { root.filter-flag-toggled(i, x); }
                    label-toggled(i, x) => { root.filter-label-toggled(i, x); }
                    exact-toggled => { root.filter-exact-toggled(); }
                    text-edited(t) => { root.filter-text-edited(t); }
                    cleared => { root.filter-cleared(); }
                    can-save: root.filter-can-save;
                    save-smart => { root.filter-save-smart(); }
                    sort: root.sort-menu;
                    sort-shown <=> root.sort-shown;
                    sort-picked(i) => { root.sort-picked(i); }
                    sort-turned(d) => { root.sort-turned(d); }
                    released => { root.focus-keys(); }
                }
            }
        }
        grid-sheet := Rectangle {
            clip: true;
            // The first layout, a re-flow, a new folder: put the
            // selection back on screen from the top. Opened by G
            // the sheet is born at its full size, and `changed`
            // says nothing about a first value, so `init` reads
            // it; `changed` is for the window resizing under it.
            init => { root.grid-w = self.width; root.grid-h = self.height; root.grid-relay(); }
            changed width => { root.grid-w = self.width; root.grid-relay(); }
            changed height => { root.grid-h = self.height; root.grid-relay(); }
            // The cells ride on this one, which is also what sees
            // the wheel: a cell's own TouchArea rejects a scroll
            // and it rises to this, its parent, wherever the
            // pointer is. One offset moves the sheet, rather than
            // a binding on every cell.
            sheet-ta := TouchArea {
                y: -root.grid-scroll;
                width: parent.width;
                // The sheet, or the window's worth of it when
                // the folder is short: what can be scrolled past
                // is exactly how far it scrolls.
                height: parent.height + root.grid-max;
                pointer-event(e) => { root.pointer-seen(e); root.side-press(e); }
                scroll-event(e) => {
                    // A sideways wheel is nobody's here, and with
                    // Ctrl it would zoom out on a delta of zero.
                    if (e.delta-y == 0px) { return reject; }
                    root.grid-wheel(e.delta-y, e.modifiers.control);
                    return accept;
                }
                for t[k] in root.tiles: folder-tile := Rectangle {
                    // Its key, for automation: the folder's name.
                    accessible-id: t.name;
                    x: root.grid-left + mod(k, root.grid-cols) * root.grid-pitch;
                    y: root.grid-pad + floor(k / root.grid-cols) * (root.grid-cell / 2 + root.grid-gap);
                    width: root.grid-cell;
                    height: root.grid-cell / 2;
                    border-radius: Theme.radius-md;
                    background: tile-ta.has-hover ? Theme.hover : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    accessible-role: button;
                    // Spoken by a screen reader: a folder tile
                    accessible-label: @tr("Folder {}", t.name);
                    accessible-value: t.count;
                    accessible-action-default => { root.tile-picked(k); }
                    animate background { duration: Theme.quick; }
                    // As a cell's: a left press that closes a menu is
                    // nothing more, and a right-click (a Mac's
                    // Control+click) asks for the tile's menu, which
                    // has an item only while the root is online.
                    tile-ta := TouchArea {
                        property <bool> skip;
                        /// Presses of any button, for the name's tip.
                        property <int> downs;
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { self.downs += 1; }
                            if (e.kind != PointerEventKind.down || root.side-press(e)) { return; }
                            let closing = root.menu-shown();
                            let ctrl-menu = root.ctrl-click-menu && e.button == PointerEventButton.left
                                && e.modifiers.meta;
                            let asks = e.button == PointerEventButton.right || ctrl-menu;
                            self.skip = closing || asks || e.button != PointerEventButton.left;
                            if (asks && !t.offline) {
                                root.open-tile-menu(k, self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        clicked => {
                            if (self.skip) { return; }
                            root.focus-keys();
                            root.tile-picked(k);
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        spacing: Theme.space-2;
                        opacity: t.offline ? 0.55 : 1;
                        Image {
                            source: @image-url("../icons/folder-open.svg");
                            colorize: Theme.text-secondary;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                        }
                        tile-words := VerticalLayout {
                            alignment: center;
                            tile-name := Text {
                                text: t.name;
                                color: tile-ta.has-hover ? Theme.text : Theme.text-secondary;
                                font-size: Theme.font-xs;
                                overflow: elide;
                                // Cut short, the whole name at the pointer.
                                NameTip {
                                    width: 100%;
                                    height: 100%;
                                    name: t.name;
                                    cut: tile-name.preferred-width > tile-name.width;
                                    row-hover: tile-ta.has-hover;
                                    shape: root.grid-shape;
                                    // Over the name, not the icon or the count.
                                    hover: tile-ta.has-hover
                                        && tile-ta.mouse-x >= tile-words.x + tile-name.x
                                        && tile-ta.mouse-x < tile-words.x + tile-name.x + tile-name.width
                                        && tile-ta.mouse-y >= tile-words.y + tile-name.y
                                        && tile-ta.mouse-y < tile-words.y + tile-name.y + tile-name.height;
                                    pointer-x: tile-ta.mouse-x;
                                    pointer-y: tile-ta.mouse-y;
                                    downs: tile-ta.downs;
                                    scroll: root.grid-scroll;
                                    quiet: root.menu-shown();
                                }
                            }
                            Text {
                                text: t.count;
                                color: Theme.text-muted;
                                font-size: Theme.font-xs;
                                overflow: elide;
                            }
                        }
                    }
                }
                // The headings, full width over the rows they head: the
                // words at the left, the count at the right, muted, as
                // a root's row says its count.
                for h in root.grid-heads: Rectangle {
                    property <GridPlace> p: root.place(h.row);
                    x: root.grid-left;
                    y: root.grid-pad + root.grid-top + self.p.y - root.grid-head-h;
                    width: root.grid-cols * root.grid-pitch - root.grid-gap;
                    height: root.grid-head-h;
                    accessible-role: text;
                    accessible-label: h.text;
                    accessible-value: h.count;
                    Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.border; }
                    HorizontalLayout {
                        padding-left: Theme.space-1;
                        padding-right: Theme.space-1;
                        spacing: Theme.space-2;
                        Text {
                            text: h.text;
                            color: Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-weight: Theme.weight-medium;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: h.count;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                    }
                }
                // An open stack's band, as Lightroom draws one: a ground
                // under each member's cell, reaching half the gap to its
                // neighbors so the run reads as one, its ends rounded.
                // Under the cells, so a cell's own ground goes over it:
                // a second walk of the cells rather than a child of each,
                // which would be drawn over its cell's ground.
                for c in root.cells: Rectangle {
                    property <GridPlace> p: root.place(c.row);
                    property <bool> first: c.thumb.stack-place == 1;
                    property <bool> last: c.thumb.stack-place == c.thumb.stack;
                    property <length> reach: root.grid-gap / 2;
                    visible: !root.lightbox && c.thumb.stack > 0 && c.thumb.stack-open;
                    x: root.grid-left + self.p.col * root.grid-pitch - self.reach;
                    y: root.grid-pad + root.grid-top + self.p.y - self.reach;
                    width: root.grid-cell + 2 * self.reach;
                    height: self.p.pic + root.grid-label + 2 * self.reach;
                    // The border's tone: about 1.2:1 on the sheet in each
                    // of the three themes, where the base is lost in Light.
                    background: Theme.border;
                    border-top-left-radius: self.first ? Theme.radius-md : 0;
                    border-bottom-left-radius: self.first ? Theme.radius-md : 0;
                    border-top-right-radius: self.last ? Theme.radius-md : 0;
                    border-bottom-right-radius: self.last ? Theme.radius-md : 0;
                }
                for c in root.cells: cell := Rectangle {
                    property <int> i: c.row;
                    property <Thumb> t: c.thumb;
                    // At the top of its row, its height its own picture's:
                    // a row is as tall as its tallest picture, and a
                    // landscape beside a portrait keeps the row's top.
                    property <GridPlace> p: root.place(i);
                    // As the strip has it: the set on the
                    // selection's ground, the current frame ringed.
                    property <bool> on: i == root.selected;
                    property <bool> in-set: on || t.chosen;
                    // To a screen reader an item of the sheet named as
                    // its tile is, chosen or not, whose press picks it
                    // as a click does.
                    accessible-role: list-item;
                    accessible-label: t.version != "" ? t.version : t.name;
                    // Its key, for automation: its row in the frames.
                    accessible-id: i;
                    accessible-item-selectable: true;
                    accessible-item-selected: in-set;
                    accessible-action-default => {
                        root.focus-keys();
                        root.frame-clicked(i, false, false);
                    }
                    x: root.grid-left + self.p.col * root.grid-pitch;
                    y: root.grid-pad + root.grid-top + self.p.y;
                    width: root.grid-cell;
                    height: self.p.pic + root.grid-label;
                    border-radius: Theme.radius-md;
                    // The plate: the sheet tinted a quarter of the
                    // way toward a color label, or the sheet as it
                    // was (through `transparent`) with none. The
                    // selection's and the hover's ground go over it,
                    // in the sibling below, exactly as they go over
                    // the plain plate: a chosen or hovered labeled
                    // tile keeps the same cue an unlabeled one does,
                    // the tint showing through both, `hover-veil`
                    // (unlike `hover` itself) being translucent too.
                    background: t.label == 0 || root.lightbox ? transparent : Theme.plate-tint(Theme.sheet, t.label);
                    border-width: on ? 2px : (in-set ? 1px : 0);
                    // On a white surround the blue is lost: the dark one.
                    // The current frame on the sheet as the strip has it,
                    // in `accent-text`: the accent on the dark themes,
                    // Light's darker blue on Light's sheet. The lightbox's
                    // other grounds are the viewport's, not the theme's,
                    // and keep the accent.
                    border-color: root.lightbox && root.ground-light
                        ? (on ? Theme.accent-dark : Theme.accent-dark-muted)
                        : (on ? (root.lightbox ? Theme.accent : Theme.accent-text)
                            : Theme.accent-muted);
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: root.lightbox ? transparent
                            : in-set ? Theme.selection : (ct.has-hover ? Theme.hover-veil : transparent);
                        animate background { duration: Theme.quick; }
                    }
                    // In the lightbox, the whole cell: there is no name
                    // under it, and its room goes to the picture.
                    Image {
                        x: Theme.space-1;
                        y: Theme.space-1;
                        width: parent.width - 2 * Theme.space-1;
                        height: (root.lightbox ? parent.height : parent.p.pic) - 2 * Theme.space-1;
                        source: root.lightbox ? t.big : t.image;
                        image-fit: contain;
                        // A frame whose root is offline: there, but
                        // not to be had until the drive is back. In the
                        // lightbox, an edit's picture since replaced,
                        // up until the new one is kept.
                        opacity: t.offline ? 0.4 : root.lightbox && t.pending ? 0.5 : 1;
                    }
                    if t.failed: Rectangle {
                        x: Theme.space-1;
                        y: Theme.space-1;
                        width: parent.width - 2 * Theme.space-1;
                        height: parent.p.pic - 2 * Theme.space-1;
                        border-radius: Theme.radius-sm;
                        // Its own ground, the sheet as it is with no
                        // label, selection or hover: a labeled,
                        // chosen or hovered plate is lighter or more
                        // colorful than `text-muted` and
                        // `border-strong` were chosen against, and a
                        // box drawn straight over one would lose the
                        // border and wash the text out.
                        background: Theme.sheet;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        Text {
                            // A tile's word when its picture could not be read
                            text: @tr("Unreadable");
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // A frame whose edit's picture is still to be made, and
                    // nothing of it to show meanwhile: said, quietly, so a
                    // dark tile is not taken for a black picture.
                    if root.lightbox && t.pending && t.big.width == 0: developing := Text {
                        width: parent.width;
                        height: parent.height;
                        // A tile's word while its picture is made
                        text: @tr("Developing");
                        // 4:1 on black and 4.7:1 on white; the greys
                        // between take the lighter one, 4:1 and up.
                        color: root.ground-mid ? Theme.over-text-secondary : Theme.dark-muted;
                        font-size: Theme.font-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    // A version is named by its own name, the file's
                    // own by the file's.
                    if !root.lightbox: cell-name := Text {
                        // Said by the cell, which it names.
                        accessible-role: none;
                        y: parent.p.pic;
                        width: 100%;
                        height: root.grid-label;
                        text: t.version != "" ? t.version : t.name;
                        color: in-set ? Theme.text : Theme.text-secondary;
                        font-size: Theme.font-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                        // Cut short, the whole name at the pointer.
                        NameTip {
                            width: 100%;
                            height: 100%;
                            name: cell-name.text;
                            cut: cell-name.preferred-width > cell-name.width;
                            row-hover: ct.has-hover;
                            shape: root.grid-shape;
                            // Over the name, not the picture.
                            hover: ct.has-hover && ct.mouse-y >= cell-name.y
                                && ct.mouse-y < cell-name.y + cell-name.height;
                            pointer-x: ct.mouse-x;
                            pointer-y: ct.mouse-y;
                            downs: ct.downs;
                            scroll: root.grid-scroll;
                            quiet: root.menu-shown();
                        }
                    }
                    // The picture's own box inside the cell, as wide
                    // as the cell and as tall as the layout made its
                    // room. `contain` leaves a margin on one axis (a
                    // portrait's sides), and a badge in that margin
                    // sits beside the frame rather than on it; before
                    // the thumbnail arrives there is no aspect to go
                    // on and the box is the room's.
                    property <length> box-w: root.grid-cell - 2 * Theme.space-1;
                    property <length> box-h: self.p.pic - 2 * Theme.space-1;
                    property <length> shown-w: t.image.width > 0 && t.image.height > 0
                        ? min(self.box-w, self.box-h * t.image.width / t.image.height)
                        : self.box-w;
                    property <length> shown-h: t.image.width > 0 && t.image.height > 0
                        ? min(self.box-h, self.box-w * t.image.height / t.image.width)
                        : self.box-h;
                    if !root.lightbox: cell-badges := ThumbBadges {
                        // On the picture's bottom left corner,
                        // held inside the cell: a tall frame in a
                        // small cell is narrower than the badge,
                        // and a pill that hangs over the edge
                        // belongs to the frame beside it.
                        x: clamp(
                            Theme.space-1 + (parent.box-w - parent.shown-w) / 2 + Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box-w - self.width));
                        y: clamp(
                            Theme.space-1 + (parent.box-h + parent.shown-h) / 2
                                - self.height - Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box-h - self.height));
                        rating: t.rating;
                        flag: t.flag;
                        label: t.label;
                        stars: root.meta-stars;
                        // With the cell, within reason: the
                        // smallest cell keeps the size the strip
                        // uses, and the largest does not turn a
                        // quiet mark into a label across the
                        // picture.
                        glyph: clamp(root.grid-cell / 16, 9px, 18px);
                    }
                    // In the lightbox when asked, the same badges on its
                    // tile's picture, which fills the cell.
                    if root.lightbox && root.lightbox-badges: tile-badges := ThumbBadges {
                        property <length> bw: parent.width - 2 * Theme.space-1;
                        property <length> bh: parent.height - 2 * Theme.space-1;
                        property <length> pw: t.big.width > 0 && t.big.height > 0
                            ? min(self.bw, self.bh * t.big.width / t.big.height)
                            : self.bw;
                        property <length> ph: t.big.width > 0 && t.big.height > 0
                            ? min(self.bh, self.bw * t.big.height / t.big.width)
                            : self.bh;
                        x: clamp(
                            Theme.space-1 + (self.bw - self.pw) / 2 + Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + self.bw - self.width));
                        y: clamp(
                            Theme.space-1 + (self.bh + self.ph) / 2 - self.height - Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + self.bh - self.height));
                        rating: t.rating;
                        flag: t.flag;
                        label: t.label;
                        stars: root.meta-stars;
                        glyph: clamp(root.grid-cell / 16, 9px, 18px);
                        light-ground: root.ground-light;
                    }
                    if !root.lightbox: ThumbMarks {
                        // On the picture's top right corner, held
                        // inside the cell as the badges are; the
                        // badges are at the bottom left.
                        x: clamp(
                            Theme.space-1 + (parent.box-w + parent.shown-w) / 2
                                - self.width - Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box-w - self.width));
                        y: clamp(
                            Theme.space-1 + (parent.box-h - parent.shown-h) / 2 + Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box-h - self.height));
                        edited: t.edited;
                        exported: t.exported || t.queue-done;
                        collected: t.collected;
                        paired: t.paired;
                        glyph: clamp(root.grid-cell / 16, 9px, 18px);
                    }
                    // The frame the export queue is writing now: the
                    // status plate's running bar, along the foot of
                    // its picture, on the sheet's one phase.
                    if !root.lightbox && t.queue-busy: Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.p.pic - Theme.space-1 - 3px - Theme.space-2;
                        width: min(60px, parent.width - 4 * Theme.space-1);
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.over-track;
                        clip: true;
                        Rectangle {
                            x: (parent.width + 24px) * root.busy-phase - 24px;
                            width: 24px;
                            height: 100%;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }
                    }
                    // A version's name on the picture's top left, held
                    // inside the cell as the marks are.
                    if !root.lightbox: ThumbTag {
                        x: clamp(
                            Theme.space-1 + (parent.box-w - parent.shown-w) / 2 + Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box-w - self.width));
                        y: clamp(
                            Theme.space-1 + (parent.box-h - parent.shown-h) / 2 + Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box-h - self.height));
                        name: t.version;
                        glyph: clamp(root.grid-cell / 16, 9px, 18px);
                        most: parent.shown-w / 2;
                    }
                    // `clicked` carries no modifiers, so the press
                    // says which were held and the click reads them.
                    // A right-click asks for the menu on the press;
                    // a Mac's Control+click is one, and is then not
                    // also a click.
                    // In a collection's own order a press dragged past
                    // a few pixels moves the frame, and the set with it
                    // when it is in the set, to the slot under the
                    // pointer; the press is then no click.
                    ct := TouchArea {
                        property <bool> ctrl;
                        property <bool> shift;
                        property <bool> menu;
                        property <bool> dragging;
                        property <bool> dragged;
                        property <length> down-x;
                        property <length> down-y;
                        /// A middle press, as the strip's cell has it.
                        property <bool> middle;
                        /// Presses of any button, for the name's tip.
                        property <int> downs;
                        mouse-cursor: self.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
                        moved => {
                            if (!root.reorder || self.menu || !self.pressed) { return; }
                            if (!self.dragging && abs(self.mouse-x - self.down-x) + abs(self.mouse-y - self.down-y) > 6px) {
                                self.dragging = true;
                            }
                            if (self.dragging) {
                                root.drop-slot = root.slot-at(cell.x + self.mouse-x, cell.y + self.mouse-y);
                            }
                        }
                        pointer-event(e) => {
                            root.pointer-seen(e);
                            if (e.kind == PointerEventKind.down) { self.downs += 1; }
                            if (root.side-press(e)) { return; }
                            if (e.kind == PointerEventKind.cancel) {
                                self.middle = false;
                            }
                            if (e.button == PointerEventButton.middle) {
                                if (e.kind == PointerEventKind.down) {
                                    self.middle = !root.menu-shown() && !self.pressed;
                                } else if (e.kind == PointerEventKind.up && self.middle) {
                                    self.middle = false;
                                    if (!self.pressed && !self.dragging
                                            && self.mouse-x >= 0 && self.mouse-x < self.width
                                            && self.mouse-y >= 0 && self.mouse-y < self.height) {
                                        root.frame-middle-clicked(i);
                                    }
                                }
                            }
                            if (e.kind == PointerEventKind.up && self.dragging) {
                                self.dragging = false;
                                self.dragged = true;
                                let slot = root.drop-slot;
                                root.drop-slot = -1;
                                if (slot >= 0) { root.frame-moved(i, slot); }
                                return;
                            }
                            if (e.kind == PointerEventKind.down) {
                                self.dragged = false;
                                self.dragging = false;
                                self.down-x = self.mouse-x;
                                self.down-y = self.mouse-y;
                                let closing = root.menu-shown();
                                self.menu = closing || e.button == PointerEventButton.right
                                    || (root.ctrl-click-menu && e.button == PointerEventButton.left
                                        && e.modifiers.meta);
                                if (closing && e.button == PointerEventButton.left
                                    && !(root.ctrl-click-menu && e.modifiers.meta)) {
                                    // The press closed the menu: nothing more.
                                    return;
                                }
                                if (self.menu) {
                                    root.focus-keys();
                                    root.frame-menu(i, self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                    return;
                                }
                                self.ctrl = e.modifiers.control;
                                self.shift = e.modifiers.shift;
                            }
                        }
                        clicked => {
                            if (self.menu || self.dragged) { return; }
                            root.focus-keys();
                            root.frame-clicked(i, self.ctrl, self.shift);
                        }
                        // The frame under the pointer, in the loupe.
                        double-clicked => { if (!self.menu) { root.loupe-asked(); } }
                    }
                    // The stack's badge on the picture's bottom right,
                    // held inside the cell as the marks are; after the
                    // cell's press, so a click on it is the badge's.
                    if !root.lightbox: ThumbStack {
                        x: clamp(
                            Theme.space-1 + (parent.box-w + parent.shown-w) / 2
                                - self.width - Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box-w - self.width));
                        y: clamp(
                            Theme.space-1 + (parent.box-h + parent.shown-h) / 2
                                - self.height - Theme.space-1,
                            Theme.space-1,
                            max(Theme.space-1, Theme.space-1 + parent.box-h - self.height));
                        count: t.stack;
                        place: t.stack-place;
                        open: t.stack-open;
                        glyph: clamp(root.grid-cell / 16, 9px, 18px);
                        clicked => {
                            root.focus-keys();
                            root.stack-clicked(i);
                        }
                    }
                    // In the lightbox too, on its tile's picture, which
                    // fills the cell: a closed stack's top is still a
                    // stack there.
                    if root.lightbox: ThumbStack {
                        property <length> bw: parent.width - 2 * Theme.space-1;
                        property <length> bh: parent.height - 2 * Theme.space-1;
                        property <length> pw: t.big.width > 0 && t.big.height > 0
                            ? min(self.bw, self.bh * t.big.width / t.big.height)
                            : self.bw;
                        property <length> ph: t.big.width > 0 && t.big.height > 0
                            ? min(self.bh, self.bw * t.big.height / t.big.width)
                            : self.bh;
                        x: max(Theme.space-1, Theme.space-1 + (self.bw + self.pw) / 2 - self.width - Theme.space-1);
                        y: max(Theme.space-1, Theme.space-1 + (self.bh + self.ph) / 2 - self.height - Theme.space-1);
                        count: t.stack;
                        place: t.stack-place;
                        open: t.stack-open;
                        glyph: clamp(parent.width / 24, 9px, 18px);
                        light-ground: root.ground-light;
                        clicked => {
                            root.focus-keys();
                            root.stack-clicked(i);
                        }
                    }
                }
                // Where a dragged frame would land: a bar in the gap
                // before the slot.
                // The slot past the last frame is after it, on its row.
                if root.drop-slot >= 0: Rectangle {
                    property <GridPlace> p: root.place(min(root.drop-slot, root.thumbs.length - 1));
                    x: root.grid-left
                        + (self.p.col + (root.drop-slot >= root.thumbs.length ? 1 : 0)) * root.grid-pitch
                        - root.grid-gap / 2 - 1px;
                    y: root.grid-pad + root.grid-top + self.p.y;
                    width: 2px;
                    height: self.p.pic;
                    background: Theme.accent;
                }
            }
            // The scroll bar, over the cells at the sheet's right edge.
            // A move over it wakes the lightbox's bar as one over the
            // cells does.
            property <length> band-y: band.mouse-y;
            changed band-y => { root.bar-wake(); }
            band := ScrollBand {
                x: parent.width - Theme.scrollbar-band;
                width: Theme.scrollbar-band;
                height: parent.height;
                // Spoken by a screen reader: the grid's scroll bar
                label: @tr("Grid scroll");
                scroll: root.grid-scroll;
                max: root.grid-max;
                awake <=> root.bar-awake;
                scroll-to(to) => { root.grid-scroll-to(to); }
                // A sideways wheel is nobody's here, as over the cells.
                wheel(dx, dy, ctrl) => {
                    if (dy != 0px) { root.grid-wheel(dy, ctrl); }
                }
                bar-length(a, b) => { return root.bar-length(a, b); }
                bar-offset(a, b, c) => { return root.bar-offset(a, b, c); }
                bar-drag(a, b, c, d) => { return root.bar-drag(a, b, c, d); }
                menu-shown => { return root.menu-shown(); }
                side-press(e) => { return root.side-press(e); }
                focus-keys => { root.focus-keys(); }
            }
            // One menu for the tiles, placed where the right-click was,
            // as the frame menu is one for the window. Zero-sized and
            // never enabled itself, so it takes no click of its own.
            tile-menu := ContextMenuArea {
                width: 0px;
                height: 0px;
                enabled: false;
                Menu {
                    MenuItem {
                        title: @tr("Reveal in file manager");
                        activated => { root.tile-reveal(root.menu-tile); root.menu-done(); }
                    }
                }
            }
            if root.loading-shown: LoadingCard {
                width: 280px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                fraction: root.loading-fraction;
                line: root.loading-line;
            }
            // The lightbox's bar, over the sheet's top on its own scrim,
            // so the tiles stay where they are as it comes and goes:
            // close at the left, the selection and the count in the
            // grid header's words in the middle, the tiles' size at the
            // right. Faded out, it takes no press; the sheet under it
            // wakes it.
            // Short of the scroll bar's band, whose thumb and track stay
            // the band's under it.
            bar := Rectangle {
                property <length> side: 160px;
                y: 0;
                width: parent.width - Theme.scrollbar-band;
                height: root.bar-h;
                visible: root.lightbox && (root.bar-up || self.opacity > 0);
                opacity: root.bar-up ? 1 : 0;
                animate opacity { duration: root.bar-up ? 120ms : 400ms; easing: ease-out; }
                // The viewport's plates' scrim, denser on a white canvas.
                background: root.ground-light ? Theme.over-plate-dense : #00000099;
                bar-ta := TouchArea {
                    pointer-event(e) => { root.side-press(e); }
                    scroll-event(e) => {
                        if (e.delta-y == 0px) { return reject; }
                        root.grid-wheel(e.delta-y, e.modifiers.control);
                        return accept;
                    }
                }
                HorizontalLayout {
                    padding-left: Theme.space-4;
                    padding-right: Theme.space-4;
                    padding-top: Theme.space-2;
                    padding-bottom: Theme.space-2;
                    spacing: Theme.space-3;
                    HorizontalLayout {
                        width: bar.side;
                        alignment: start;
                        bar-close := BarButton {
                            icon: @image-url("../icons/x.svg");
                            label: @tr("Close lightbox");
                            // The key in brackets after the words, as
                            // the View menu's Full screen (F11) shows
                            // one; outside `@tr` here, where that one
                            // is inside it, so the words translate
                            // alone and the key is the same in every
                            // language.
                            words: @tr("Close lightbox") + " (L)";
                            clicked => { root.focus-keys(); root.lightbox-close(); }
                        }
                    }
                    bar-words := Text {
                        horizontal-stretch: 1;
                        // The grid header's own words: the frame on
                        // screen, or it and the rest of the set, and
                        // how many frames the view has.
                        text: (root.selected >= 0 && root.selected < root.thumbs.length
                                ? (root.set-count > 1
                                    ? @tr("{} and {n} other" | "{} and {n} others" % (root.set-count - 1), root.thumbs[root.selected].name)
                                    : root.thumbs[root.selected].name) + " · "
                                : "")
                            + @tr("{n} frame" | "{n} frames" % root.thumbs.length);
                        color: Theme.over-text;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    bar-size := SizeSlider {
                        width: bar.side;
                        over: true;
                        label: @tr("Tile size");
                        words: @tr("Tile size");
                        value: root.size-at;
                        steps: root.size-steps;
                        shown: root.grid-cell / 1px;
                        least: root.size-least / 1px;
                        most: root.size-most / 1px;
                        moved(at) => { root.size-moved(at); }
                        stepped(by) => { root.size-stepped(by); }
                        released => { root.focus-keys(); }
                    }
                }
            }
        }
    }
}
