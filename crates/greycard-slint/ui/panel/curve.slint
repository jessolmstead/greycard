// The CURVES section: the parametric curve and the point curves.

import { Theme } from "../theme.slint";
import { Section, EditSlider, PanelButton, Segmented, CurveEditor, ValueField } from "../controls.slint";

export component CurvesSection inherits Section {
    in-out property <bool> curves-enabled;
    in-out property <string> curve-mode;
    in-out property <float> para-highlights;
    in-out property <float> para-lights;
    in-out property <float> para-darks;
    in-out property <float> para-shadows;
    in-out property <string> curve-channel;
    in property <image> curve-image;
    in-out property <bool> collapsed-curves;
    in-out property <string> picking;
    callback pick-started(string);
    in-out property <string> target-name;
    callback curve-press(float, float);
    callback curve-move(float, float);
    callback curve-release();
    callback curve-double(float, float);
    // The point last pressed, which stays selected after the release,
    // or -1; its In and Out as the fields show them, 0 to 255.
    in property <int> curve-selected: -1;
    in property <string> curve-point-in;
    in property <string> curve-point-out;
    // A number typed into "in" or "out" for the selected point.
    callback curve-typed(string, string);
    callback curve-reset();
    callback curve-channel-changed();
    callback curve-mode-changed();
    callback parametric-changed();
    callback view-changed();

    title: "CURVES";
    owner: root.target-name;
    icon: @image-url("../icons/spline.svg");
    collapsed <=> root.collapsed-curves;
    switchable: true;
    on <=> root.curves-enabled;
    switched => { root.view-changed(); }
    Segmented {
        options: ["Parametric", "Point"];
        current <=> root.curve-mode;
        selected(v) => { root.curve-mode-changed(); }
    }
    if root.curve-mode == "Point": Segmented {
        options: ["RGB", "Red", "Green", "Blue", "R/G", "B/Y"];
        current <=> root.curve-channel;
        selected(v) => { root.curve-channel-changed(); }
    }
    CurveEditor {
        picture: root.curve-image;
        enabled: root.curves-enabled;
        pressed(x, y) => { root.curve-press(x, y); }
        moved(x, y) => { root.curve-move(x, y); }
        released => { root.curve-release(); }
        double-clicked(x, y) => { root.curve-double(x, y); }
    }
    // The selected point's coordinates, to type: greyed with none.
    if root.curve-mode == "Point": HorizontalLayout {
        spacing: Theme.space-2;
        alignment: start;
        Text {
            text: "In";
            color: root.curve-selected >= 0 && root.curves-enabled ? Theme.text : Theme.text-muted;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
        ValueField {
            width: 48px;
            height: Theme.control-height - 4px;
            boxed: true;
            enabled: root.curves-enabled && root.curve-selected >= 0;
            label: "Point in";
            shown: root.curve-selected >= 0 ? root.curve-point-in : "";
            committed(typed) => { root.curve-typed("in", typed); }
        }
        Rectangle { width: Theme.space-2; }
        Text {
            text: "Out";
            color: root.curve-selected >= 0 && root.curves-enabled ? Theme.text : Theme.text-muted;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
        ValueField {
            width: 48px;
            height: Theme.control-height - 4px;
            boxed: true;
            enabled: root.curves-enabled && root.curve-selected >= 0;
            label: "Point out";
            shown: root.curve-selected >= 0 ? root.curve-point-out : "";
            committed(typed) => { root.curve-typed("out", typed); }
        }
    }
    if root.curve-mode == "Parametric": EditSlider {
        label: "Highlights";
        enabled: root.curves-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        value <=> root.para-highlights;
        scale: 100;
        text: (root.para-highlights >= 0 ? "+" : "") + round(root.para-highlights * 100);
        changed(v) => { root.parametric-changed(); }
    }
    if root.curve-mode == "Parametric": EditSlider {
        label: "Lights";
        enabled: root.curves-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        value <=> root.para-lights;
        scale: 100;
        text: (root.para-lights >= 0 ? "+" : "") + round(root.para-lights * 100);
        changed(v) => { root.parametric-changed(); }
    }
    if root.curve-mode == "Parametric": EditSlider {
        label: "Darks";
        enabled: root.curves-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        value <=> root.para-darks;
        scale: 100;
        text: (root.para-darks >= 0 ? "+" : "") + round(root.para-darks * 100);
        changed(v) => { root.parametric-changed(); }
    }
    if root.curve-mode == "Parametric": EditSlider {
        label: "Shadows";
        enabled: root.curves-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        value <=> root.para-shadows;
        scale: 100;
        text: (root.para-shadows >= 0 ? "+" : "") + round(root.para-shadows * 100);
        changed(v) => { root.parametric-changed(); }
    }
    HorizontalLayout {
        spacing: Theme.space-2;
        alignment: end;
        if root.curve-mode == "Point": PanelButton {
            text: "Pick";
            icon: @image-url("../icons/pipette.svg");
            enabled: root.curves-enabled;
            primary: root.picking == "Curve";
            clicked => { root.pick-started("Curve"); }
        }
        PanelButton {
            text: "Reset";
            icon: @image-url("../icons/rotate-ccw.svg");
            clicked => { root.curve-reset(); }
        }
    }
}
