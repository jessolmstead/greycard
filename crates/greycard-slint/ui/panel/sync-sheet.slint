// The sync sheet: which of the current frame's sections, parts and
// masks go over the rest of the selection, until applied or left. The
// preset sheet's twin, with no name to give: nothing is kept but the
// frames' own sidecars. A paste opens the same sheet, the settings of
// the frame copied going over the whole selection.

import { Theme } from "../theme.slint";
import { PanelButton, Segmented } from "../controls.slint";
import { CarryList } from "carry-list.slint";
import { CarryRow } from "../structs.slint";

// One of the relative choices: a field's name, then Set or Shift.
component ShiftChoice inherits HorizontalLayout {
    in property <string> label;
    in-out property <bool> shift;
    in property <bool> enabled: true;
    callback changed();
    spacing: Theme.space-2;
    Text {
        text: root.label;
        font-size: Theme.font-sm;
        color: root.enabled ? Theme.text : Theme.text-muted;
        vertical-alignment: center;
    }
    Segmented {
        width: 112px;
        options: ["Set", "Shift"];
        current: root.shift ? "Shift" : "Set";
        enabled: root.enabled;
        accessible-role: list;
        accessible-label: root.label + " set or shift";
        accessible-value: root.shift ? "Shift" : "Set";
        selected(o) => {
            root.shift = o == "Shift";
            root.changed();
        }
    }
}

export component SyncSheet inherits Rectangle {
    in-out property <bool> sync-open;
    /// What the sync will do, in words: from which frame onto how
    /// many.
    in property <string> sync-text;
    /// A paste rather than a sync: the settings copied from
    /// `paste-from`, over the selection.
    in property <bool> paste;
    in property <string> paste-from;
    in property <[CarryRow]> sync-rows;
    in property <int> sync-lines;
    callback sync-row-toggled(int);
    callback sync-all(bool);
    callback sync-join-chosen(bool);
    callback sync-applied();
    /// The relative choices (`App::sync-shift-*`).
    in-out property <bool> shift-temperature;
    in-out property <bool> shift-tint;
    in-out property <bool> shift-exposure;
    in property <bool> shift-shown;
    in property <bool> shift-white;
    in property <bool> shift-light;
    in property <string> shift-words;
    callback shift-changed();

    background: #000000a0;
    TouchArea { clicked => { root.sync-open = false; } }
    Rectangle {
        width: min(680px, root.width - 2 * Theme.space-5);
        height: sync-sheet.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        TouchArea { }
        // A check has the focus, and a key goes up from it and never
        // reaches the window's keys: Escape is taken here, on the card,
        // so a click beside it still reaches the scrim.
        FocusScope {
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.sync-open = false;
                    return accept;
                }
                return reject;
            }
            sync-sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: root.paste ? "Paste settings from " + root.paste-from : "Sync settings";
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                }
                Text {
                    text: root.sync-text;
                    font-size: Theme.font-sm;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: "Crop and retouch never copy; camera profiles only to the same camera. A part copied alone leaves the rest of its section as each frame has it.";
                    font-size: Theme.font-xs;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                // Lightroom's Quick Develop: a field set takes this
                // frame's value; shifted, each frame moves from its own
                // by as much as this one moved.
                if root.shift-shown: VerticalLayout {
                    spacing: Theme.space-2;
                    HorizontalLayout {
                        spacing: Theme.space-4;
                        alignment: start;
                        ShiftChoice {
                            label: "Temperature";
                            shift <=> root.shift-temperature;
                            enabled: root.shift-white;
                            changed => { root.shift-changed(); }
                        }
                        ShiftChoice {
                            label: "Tint";
                            shift <=> root.shift-tint;
                            enabled: root.shift-white;
                            changed => { root.shift-changed(); }
                        }
                        ShiftChoice {
                            label: "Exposure";
                            shift <=> root.shift-exposure;
                            enabled: root.shift-light;
                            changed => { root.shift-changed(); }
                        }
                    }
                    Text {
                        text: root.shift-words;
                        font-size: Theme.font-xs;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
                CarryList {
                    rows: root.sync-rows;
                    lines: root.sync-lines;
                    // The window less the sheet's words and buttons.
                    max-list-height: root.height - (root.shift-shown ? 380px : 300px);
                    toggled(i) => { root.sync-row-toggled(i); }
                    all(on) => { root.sync-all(on); }
                    join-chosen(join) => { root.sync-join-chosen(join); }
                }
                Rectangle { height: Theme.space-2; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Cancel";
                        clicked => { root.sync-open = false; }
                    }
                    PanelButton {
                        text: root.paste ? "Paste" : "Apply";
                        icon: @image-url("../icons/layers.svg");
                        primary: true;
                        clicked => { root.sync-applied(); }
                    }
                }
            }
        }
    }
}
