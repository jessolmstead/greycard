// The settings sheet: what belongs to the installation rather than to a
// picture, over everything until closed, in five categories down its
// left side, one shown at a time. Interface: the scale, which applies
// at the next start, the theme, the scroll bars, and whether opening a
// panel section folds the rest. Library: the folder a launch opens and
// whether the filter bar shows; where the sidecars go and whether an
// XMP goes beside them; with frames open, the move that puts their
// sidecars where the setting says now, since flipping it moves nothing
// by itself; whether the camera's JPEG beside a raw is a frame of its
// own; the thumbnail cache; and the network folders' rescan. Editing:
// the canvas, the monitor's profile, and the soft proof's, the same
// choices the panel's MONITOR and SOFT PROOF sections make, bound to
// the window's own properties so a change in either place shows in
// both; whether a raw's new edit starts with its lens corrections on;
// the aspect an uncropped frame's crop opens at; the shipped
// presets put back; the export sheet's format and color space,
// bound the same way; the apps Edit in hands a frame to; and the
// author and copyright every export carries. Models:
// every model the registry knows, its size and where it stands, and
// Fetch all, which fetches those this machine runs. Keys:
// each rebindable action of the key table (`keys.rs`), a click on its
// chord to press a new one, Backspace or Delete for none, Escape to
// keep the old. About: the check
// for a newer release, the version, and where greycard keeps its
// files.
import { Theme } from "../theme.slint";
import { BindRow, ModelLine } from "../structs.slint";
import { Toggle, PanelButton, Segmented, ScrollPane } from "../controls.slint";
import { ComboBox, LineEdit } from "std-widgets.slint";

// The Language row's first choice, in the window's language: the Rust
// side reads it to build the row's list, which also holds each
// catalog's language in its own name.
export global LanguageWords {
    out property <string> system: @tr("System");
}

/// An action's chord on the Keys category's row, a click to listen
/// for a new one; red when another action or a fixed key has it too.
component BindChip inherits Rectangle {
    in property <bool> on;
    in property <string> keys;
    in property <string> does;
    in property <bool> warn;
    callback listen();
    // Keys: the binding's field while it listens
    property <string> shown: self.on ? @tr("Press a key") : root.keys;
    width: 112px;
    height: Theme.control-height;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: self.on ? Theme.focus-ring : root.warn ? Theme.warn-red : Theme.border-strong;
    background: chip.pressed ? Theme.pressed : chip.has-hover ? Theme.hover : Theme.raised;
    accessible-role: button;
    accessible-label: root.does;
    accessible-value: self.shown;
    accessible-action-default => { root.listen(); }
    Text {
        text: root.shown;
        font-size: Theme.font-sm;
        font-weight: Theme.weight-medium;
        color: root.on ? Theme.text-secondary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    chip := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.listen(); }
    }
}

export component SettingsSheet inherits Rectangle {
    in-out property <bool> settings-open;
    /// The interface's scale, percent of the system's: as typed, taken
    /// on Enter or Done; as taken, 50 to 300; the one this window
    /// started at, which a different one waits for the next start to
    /// replace; and whether SLINT_SCALE_FACTOR, set by hand, wins over
    /// all of them.
    in-out property <string> ui-scale;
    in property <int> ui-scale-percent;
    in property <int> ui-scale-started;
    in property <bool> ui-scale-by-hand;
    callback ui-scale-changed();
    /// The palette: "Charcoal", "Grey", or "Light" (`Theme`).
    in-out property <string> theme;
    callback theme-changed();
    /// The scroll bars: "Fade" or "Stay", and "Thin", "Medium", or
    /// "Wide" (`ScrollBars`).
    in-out property <string> scroll-bars;
    callback scroll-bars-changed();
    in-out property <string> scroll-bar-size;
    callback scroll-bar-size-changed();
    /// The Language row: "System" and each language a catalog holds,
    /// in its own name, and the place of the one chosen.
    in property <[string]> languages;
    in-out property <int> language-index;
    callback language-changed();
    // The Interface rows' labels, wide enough for "Scroll bar size".
    property <length> interface-label-w: 96px;
    /// Opening one of the panel's sections folds the others.
    in-out property <bool> one-section;
    callback one-section-changed();
    /// Where a launch opens: "Last folder" or "Chosen folder", as the
    /// row spells it, and the chosen folder as shown. The host sets
    /// the choice once the chooser answers: a click on "Chosen folder"
    /// asks for one, again whenever it is clicked.
    in-out property <string> start-choice;
    in property <string> start-folder;
    callback start-picked(string);
    /// The view a launch opens on: "Loupe" or "Library".
    in-out property <string> start-view;
    callback start-view-changed();
    /// Whether the filter bar is shown, over the grid and in culling.
    in-out property <bool> filter-bar;
    callback filter-bar-changed();
    /// The grid's cell in logical pixels as typed; taken on Enter or
    /// Done. Whether Ctrl and the wheel size the cells.
    in-out property <string> grid-cell-typed;
    callback grid-cell-typed-changed();
    in-out property <bool> wheel-resizes;
    callback wheel-resizes-changed();
    /// "Beside the raw" or "Hidden folder", as the row spells it.
    in-out property <string> sidecar-placement;
    in-out property <bool> xmp-sidecars;
    /// How many frames are open (a folder's, or one file opened on its
    /// own), and how many of them have a sidecar in the place the
    /// setting does not name. The move runs over the same list.
    in property <int> open-frames;
    in property <int> sidecars-elsewhere;
    /// False under `--no-sidecars`: nothing is moved in a run that
    /// promised not to write them.
    in property <bool> sidecars-written: true;
    /// What the last move did, in words; empty before one.
    in property <string> settings-note;
    callback placement-changed();
    callback xmp-changed();
    callback sidecars-move();
    /// Whether a JPEG beside a raw of its name is a frame of its own;
    /// off, it is the raw's companion. Flipping it lists the open
    /// frames again.
    in-out property <bool> jpegs-apart;
    callback jpegs-apart-changed();
    /// The aspect the crop opens under on a frame not cropped yet:
    /// "Original", "Last used" or "Free".
    in-out property <string> crop-start;
    callback crop-start-changed();
    /// Whether a raw's new edit starts with the lens section on; a
    /// sidecar already written keeps its own.
    in-out property <bool> lens-on-new;
    callback lens-on-new-changed();
    in-out property <string> fill-choice;
    in property <[string]> fill-why-not;
    callback fill-chosen(string);
    /// The canvas, by its index into `canvas-names`, which the row
    /// spells it by.
    in-out property <int> canvas-choice;
    in property <[string]> canvas-names;
    callback canvas-changed();
    /// The monitor's profile: as the panel's MONITOR section has it.
    in-out property <string> display-profile;
    in-out property <string> display-monitor;
    in property <string> display-file;
    in property <[string]> monitors;
    callback display-changed();
    callback choose-display-file();
    /// The soft proof's profile and intent: as the panel's SOFT PROOF
    /// section has them.
    in-out property <string> proof-profile;
    in property <string> proof-file;
    in-out property <string> proof-intent;
    callback proof-changed();
    callback choose-proof-file();
    /// The export sheet's format and color space, which the window
    /// keeps as each changes.
    in-out property <string> export-format;
    in-out property <string> export-space;
    /// The apps Edit in hands a frame to, by name, in the order added;
    /// the chooser that adds one, and the × that takes one off.
    in property <[string]> edit-in-list;
    callback edit-in-add();
    callback edit-in-remove(int);
    /// The author and copyright every export carries, as typed; taken
    /// on Enter or as the sheet closes, empty for none.
    in-out property <string> author;
    in-out property <string> copyright;
    callback rights-changed();
    /// The thumbnail cache: whether this run has one, what it holds
    /// in words, and the button that empties it.
    in property <bool> thumb-cache-on;
    in property <int> thumb-cache-entries;
    in property <string> thumb-cache-words;
    /// The cap in megabytes as typed; taken on Enter or Done.
    in-out property <string> thumb-cache-cap;
    callback thumb-cache-clear();
    callback thumb-cache-cap-changed();
    /// The local previews' own cap in megabytes as typed; taken on
    /// Enter or Done.
    in-out property <string> preview-cache-cap;
    callback preview-cache-cap-changed();
    /// How often a library root on a network mount, which is not
    /// watched, is passed over, in minutes as typed; taken on Enter or
    /// Done. Zero for never.
    in-out property <string> network-poll-minutes;
    callback network-poll-changed();
    /// How many of the shipped presets the store is without,
    /// and which, in words; and the button that puts them back.
    in property <int> presets-missing;
    in property <string> presets-missing-words;
    callback presets-restore();
    /// Whether a launch asks GitHub for the latest release; Check now,
    /// and what it found, in words.
    in-out property <bool> update-check;
    in property <string> update-note;
    /// A Check now on its way: the button waits for its answer.
    in property <bool> update-checking;
    callback update-check-changed();
    callback update-check-now();
    /// The models: a line each, the Fetch all button's words (the size
    /// left to fetch beside them) and whether it can be pressed, and a
    /// note under them.
    in property <[ModelLine]> models-lines;
    in property <string> models-fetch-label;
    in property <bool> models-fetch-enabled;
    in property <string> models-note;
    callback models-fetch-all();
    // A model line's two columns: the name and what it is for, and the
    // size and where it stands.
    property <length> models-status-w: 152px;
    property <length> models-text-w: root.pane-w - 2 * Theme.space-5 - Theme.scrollbar-band
        - root.models-status-w - Theme.space-2;
    /// The keys: each action and its chord, under its group's heading;
    /// a press taken as the listening action's chord (Backspace or
    /// Delete for none), true once the listening is over; every action
    /// back to its default; and the window told as the listening ends.
    in property <[BindRow]> key-bindings;
    callback key-rebound(string, string, bool, bool, bool, bool) -> bool;
    callback keys-reset();
    callback listening-done();
    /// The action the next press binds, empty for none.
    property <string> listening: "";
    function listen(id: string) {
        root.listening = id;
        catcher.focus();
    }
    /// The listening over: the window told, and the focus back on the
    /// column, so the keys step the categories again. The key just
    /// bound may still be held; its repeats are nobody's until a fresh
    /// press.
    property <bool> held: false;
    function listened() {
        root.listening = "";
        root.held = true;
        root.listening-done();
        names.focus();
    }
    /// The move asked for and not yet confirmed.
    property <bool> confirming: false;
    // Sidecars: the move row's count
    property <string> elsewhere-words: @tr("{n} sidecar" | "{n} sidecars" % root.sidecars-elsewhere);
    property <string> frames-words: root.open-frames == 1
        // Sidecars: what the move row moves
        ? @tr("the open frame")
        // Sidecars: what the move row moves
        : @tr("the {n} open frame" | "the {n} open frames" % root.open-frames);
    /// The category shown, one of `categories`; kept between runs by
    /// the host, which hears of a change.
    in-out property <string> category: "Interface";
    callback category-changed();
    /// What the About category says: the version, and the folders
    /// greycard keeps its files in, as shown; a row whose folder is
    /// unknown is left out.
    in property <string> version;
    in property <string> settings-dir;
    in property <string> library-dir;
    in property <string> caches-dir;
    in property <string> log-dir;
    /// A folder clicked, by its row (0 settings, 1 library, 2 caches,
    /// 3 log): the host opens it in the file manager.
    callback dir-clicked(int);
    property <[string]> categories: ["Interface", "Library", "Editing", "Models", "Keys", "About"];
    /// The categories in words, by index: the names above are what is
    /// kept and compared.
    // Settings: the category names on the sheet's left
    property <[string]> category-words: [@tr("Interface"), @tr("Library"), @tr("Editing"), @tr("Models"), @tr("Keys"), @tr("About")];
    property <length> column-w: 132px;
    property <length> pane-w: 440px;
    /// The focus goes to the column: a row left focused in the category
    /// hidden would take the next key and do nothing with it.
    function choose(name: string) {
        names.focus();
        if (name == root.category) { return; }
        root.category = name;
        pane.content-y = 0;
        root.category-changed();
    }
    /// The category `by` along from the one shown: held at the ends,
    /// or round them with `wrap`.
    function step(by: int, wrap: bool) {
        let n = root.categories.length;
        let at = root.category == "Library" ? 1
            : root.category == "Editing" ? 2
            : root.category == "Models" ? 3
            : root.category == "Keys" ? 4
            : root.category == "About" ? 5
            : 0;
        let next = wrap ? Math.mod(at + by + n, n) : Math.clamp(at + by, 0, n - 1);
        root.choose(root.categories[next]);
    }

    background: #000000a0;
    TouchArea { clicked => { root.settings-open = false; } }
    Rectangle {
        width: root.column-w + root.pane-w;
        // As tall as the category shown, the column at the least, up
        // to the window less a margin; past that the category scrolls
        // and Done stays in reach below it. The long categories, Keys
        // and Library, would otherwise hand the short ones a sheet
        // that is mostly blank. The top sits where the tallest
        // category's sheet would be centered, so a switch moves the
        // bottom edge only and the column stays under the pointer.
        property <length> tallest: min(
            max(column.preferred-height, interface.preferred-height, library.preferred-height,
                editing.preferred-height, models.preferred-height, keys.preferred-height,
                about.preferred-height)
                + done-row.preferred-height,
            root.height - 2 * Theme.space-5);
        height: min(
            max(column.preferred-height, root.category == "Library" ? library.preferred-height
                : root.category == "Editing" ? editing.preferred-height
                : root.category == "Models" ? models.preferred-height
                : root.category == "Keys" ? keys.preferred-height
                : root.category == "About" ? about.preferred-height
                : interface.preferred-height)
                + done-row.preferred-height,
            self.tallest);
        y: (root.height - self.tallest) / 2;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        clip: true;
        TouchArea { }
        // A key goes up from whatever on the sheet has the focus and
        // never reaches the window's: Escape is taken here, on the card.
        // Never focused by a click, which would take the focus from the
        // column or stop a chord listening. Ctrl+Tab steps the categories
        // from anywhere on the card.
        FocusScope {
            focus-on-tab-navigation: false;
            focus-on-click: false;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.settings-open = false;
                    return accept;
                }
                if (e.modifiers.alt || e.modifiers.meta) { return reject; }
                if (e.modifiers.control && e.text == Key.Backtab) {
                    root.step(-1, true);
                    return accept;
                }
                if (e.modifiers.control && e.text == Key.Tab) {
                    root.step(e.modifiers.shift ? -1 : 1, true);
                    return accept;
                }
                return reject;
            }
            // The press a chord is listened for by: every key while an
            // action listens, Escape keeping its old chord, Backspace or
            // Delete binding it to none (`keys.rs`).
            catcher := FocusScope {
                width: 0;
                height: 0;
                // Reached by a click on a chord, never by Tab.
                focus-on-tab-navigation: false;
                key-pressed(e) => {
                    if (root.listening == "") { return reject; }
                    // A key held from before the click: not a new chord.
                    if (e.repeat) { return accept; }
                    if (e.text == Key.Escape) {
                        root.listened();
                        return accept;
                    }
                    if (root.key-rebound(root.listening, e.text, e.modifiers.control,
                        e.modifiers.shift, e.modifiers.alt, e.modifiers.meta)) {
                        root.listened();
                    }
                    return accept;
                }
                focus-lost(reason) => { root.listening = ""; }
            }
            VerticalLayout {
                HorizontalLayout {
                    vertical-stretch: 1;
                    column := VerticalLayout {
                        width: root.column-w;
                        padding: Theme.space-5;
                        padding-right: 0;
                        padding-bottom: Theme.space-2;
                        spacing: Theme.space-3;
                        alignment: start;
                        Text {
                            text: @tr("Settings");
                            font-size: Theme.font-lg;
                            font-weight: Theme.weight-medium;
                            color: Theme.text;
                        }
                        Rectangle { height: Theme.space-1; }
                        // The categories, one shown at a time, marked as the
                        // panel's tabs mark theirs. Up and Down step them while
                        // the column has the focus, Ctrl+Tab from anywhere on
                        // the card; Tab goes on into the category's rows.
                        names := FocusScope {
                            init => { self.focus(); }
                            key-pressed(e) => {
                                if (root.held) {
                                    if (e.repeat) { return accept; }
                                    root.held = false;
                                }
                                if (e.modifiers.alt || e.modifiers.meta) { return reject; }
                                if (!e.modifiers.control && e.text == Key.UpArrow) {
                                    root.step(-1, false);
                                    return accept;
                                }
                                if (!e.modifiers.control && e.text == Key.DownArrow) {
                                    root.step(1, false);
                                    return accept;
                                }
                                return reject;
                            }
                            Rectangle {
                                border-radius: Theme.radius-md;
                                background: Theme.base;
                                border-width: 1px;
                                border-color: names.has-focus ? Theme.focus-ring : Theme.border;
                                VerticalLayout {
                                    padding: 2px;
                                    spacing: 2px;
                                    for name[i] in root.categories: Rectangle {
                                        property <bool> on: name == root.category;
                                        height: Theme.control-height;
                                        border-radius: Theme.radius-sm;
                                        background: self.on ? Theme.raised : (pick.has-hover ? Theme.hover : transparent);
                                        animate background { duration: Theme.quick; }
                                        accessible-role: tab;
                                        accessible-label: root.category-words[i];
                                        accessible-checked: self.on;
                                        accessible-action-default => { root.choose(name); }
                                        Text {
                                            x: Theme.space-3;
                                            width: parent.width - 2 * Theme.space-3;
                                            text: root.category-words[i];
                                            color: parent.on ? Theme.text : Theme.text-secondary;
                                            font-size: Theme.font-sm;
                                            font-weight: parent.on ? Theme.weight-medium : Theme.weight-regular;
                                            vertical-alignment: center;
                                        }
                                        pick := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => {
                                                names.focus();
                                                root.choose(name);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    pane := ScrollPane {
                        width: root.pane-w;
                        min-height: 80px;
                        content-width: root.pane-w;
                        content-height: root.category == "Library" ? library.preferred-height
                            : root.category == "Editing" ? editing.preferred-height
                            : root.category == "Models" ? models.preferred-height
                            : root.category == "Keys" ? keys.preferred-height
                            : root.category == "About" ? about.preferred-height
                            : interface.preferred-height;
                        interface := VerticalLayout {
                            visible: root.category == "Interface";
                            x: 0;
                            y: 0;
                            width: root.pane-w;
                            height: self.preferred-height;
                            padding: Theme.space-5;
                            padding-right: Theme.space-5 + Theme.scrollbar-band;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-3;
                            Text {
                                text: @tr("INTERFACE");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Scale"); width: root.interface-label-w; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                LineEdit {
                                    width: 96px;
                                    text <=> root.ui-scale;
                                    input-type: number;
                                    accepted => { root.ui-scale-changed(); }
                                }
                                Text { text: "%"; color: Theme.text-secondary; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            Text {
                                text: @tr("Type and controls, on top of the system's own scaling.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            if root.ui-scale-by-hand: Text {
                                text: @tr("SLINT_SCALE_FACTOR is set, and wins over this.");
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            if !root.ui-scale-by-hand && root.ui-scale-percent != root.ui-scale-started: Text {
                                text: @tr("Applies at the next start.");
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Theme"); width: root.interface-label-w; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                Segmented {
                                    options: ["Charcoal", "Grey", "Light"];
                                    labels: [@tr("Charcoal"), @tr("Grey"), @tr("theme" => "Light")];
                                    current <=> root.theme;
                                    selected => { root.theme-changed(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Scroll bars"); width: root.interface-label-w; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                Segmented {
                                    options: ["Fade", "Stay"];
                                    // Scroll bars: fade when idle, or stay
                                    labels: [@tr("Fade"), @tr("Stay")];
                                    current <=> root.scroll-bars;
                                    selected => { root.scroll-bars-changed(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Scroll bar size"); width: root.interface-label-w; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                Segmented {
                                    options: ["Thin", "Medium", "Wide"];
                                    // Scroll bar size
                                    labels: [@tr("Thin"), @tr("Medium"), @tr("Wide")];
                                    current <=> root.scroll-bar-size;
                                    selected => { root.scroll-bar-size-changed(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Language"); width: root.interface-label-w; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                ComboBox {
                                    width: 160px;
                                    accessible-label: @tr("Language");
                                    model: root.languages;
                                    current-index <=> root.language-index;
                                    selected => { root.language-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text {
                                text: @tr("Applies at the next start.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            Toggle {
                                // Interface: the develop panel's sections
                                label: @tr("One section open at a time");
                                checked <=> root.one-section;
                                toggled => { root.one-section-changed(); }
                            }
                        }
                        library := VerticalLayout {
                            visible: root.category == "Library";
                            x: 0;
                            y: 0;
                            width: root.pane-w;
                            height: self.preferred-height;
                            padding: Theme.space-5;
                            padding-right: Theme.space-5 + Theme.scrollbar-band;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-3;
                            Text {
                                text: @tr("LIBRARY");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Start in"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                Segmented {
                                    options: ["Last folder", "Chosen folder"];
                                    labels: [@tr("Last folder"), @tr("Chosen folder")];
                                    current: root.start-choice;
                                    picks: false;
                                    selected(c) => { root.start-picked(c); }
                                }
                            }
                            if root.start-choice == "Chosen folder": Text {
                                text: root.start-folder;
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Rectangle { width: 68px; }
                                Segmented {
                                    options: ["Loupe", "Library"];
                                    labels: [@tr("Loupe"), @tr("Library")];
                                    current <=> root.start-view;
                                    selected => { root.start-view-changed(); }
                                }
                            }
                            Toggle {
                                label: @tr("Show the filter bar");
                                checked <=> root.filter-bar;
                                toggled => { root.filter-bar-changed(); }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Cell size"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                LineEdit {
                                    width: 96px;
                                    text <=> root.grid-cell-typed;
                                    input-type: number;
                                    accepted => { root.grid-cell-typed-changed(); }
                                }
                                Text { text: "px"; color: Theme.text-secondary; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            Toggle {
                                label: @tr("Resize with the wheel");
                                checked <=> root.wheel-resizes;
                                toggled => { root.wheel-resizes-changed(); }
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: @tr("SIDECARS");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Edits go"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                Segmented {
                                    options: ["Beside the raw", "Hidden folder"];
                                    labels: [@tr("Beside the raw"), @tr("Hidden folder")];
                                    current <=> root.sidecar-placement;
                                    selected => {
                                        root.confirming = false;
                                        root.placement-changed();
                                    }
                                }
                            }
                            Text {
                                text: root.sidecar-placement == "Hidden folder"
                                    ? @tr("In a hidden .greycard folder.")
                                    : @tr("IMG_0001.CR3.gcd, beside the raw.");
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            Text {
                                text: @tr("Sidecars move when next saved.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            if root.open-frames > 0: VerticalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: !root.sidecars-written
                                        ? @tr("Sidecars are not written this run (--no-sidecars), so none are moved.")
                                        : root.sidecars-elsewhere < 0
                                        ? @tr("Counting the sidecars of {}...", root.frames-words)
                                        : root.sidecars-elsewhere == 0
                                        ? @tr("Every sidecar of {} is in the chosen place.", root.frames-words)
                                        : @tr("{} of {} is in the other place." | "{} of {} are in the other place." % root.sidecars-elsewhere, root.elsewhere-words, root.frames-words);
                                    font-size: Theme.font-xs;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                }
                                if !root.confirming: PanelButton {
                                    text: root.open-frames == 1 ? @tr("Move the open frame's sidecar") : @tr("Move the open frames' sidecars");
                                    icon: @image-url("../icons/folder-open.svg");
                                    enabled: root.sidecars-written && root.sidecars-elsewhere > 0;
                                    clicked => { root.confirming = true; }
                                }
                                if root.confirming: HorizontalLayout {
                                    spacing: Theme.space-2;
                                    PanelButton {
                                        text: @tr("Cancel");
                                        clicked => { root.confirming = false; }
                                    }
                                    PanelButton {
                                        text: @tr("Move {}", root.elsewhere-words);
                                        primary: true;
                                        clicked => {
                                            root.confirming = false;
                                            root.sidecars-move();
                                        }
                                    }
                                }
                            }
                            if root.settings-note != "": Text {
                                text: root.settings-note;
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            Toggle {
                                label: @tr("Write XMP sidecars");
                                checked <=> root.xmp-sidecars;
                                toggled => { root.xmp-changed(); }
                            }
                            Text {
                                text: @tr("Rating, label and keywords, for Lightroom and darktable.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: "RAW+JPEG";
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            Toggle {
                                label: @tr("Treat a JPEG beside its raw as a separate frame");
                                checked <=> root.jpegs-apart;
                                toggled => { root.jpegs-apart-changed(); }
                            }
                            Text {
                                text: root.jpegs-apart
                                    ? @tr("IMG_0001.JPG is a frame of its own, with its own rating.")
                                    : @tr("IMG_0001.JPG goes with IMG_0001.CR3: one frame, marked +JPEG.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: @tr("THUMBNAILS");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: root.thumb-cache-words;
                                    font-size: Theme.font-sm;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                                if root.thumb-cache-entries > 0: PanelButton {
                                    text: @tr("Clear");
                                    width: 96px;
                                    clicked => { root.thumb-cache-clear(); }
                                }
                            }
                            if root.thumb-cache-on: HorizontalLayout {
                                spacing: Theme.space-2;
                                // Thumbnails: before the size field
                                Text { text: @tr("Keep up to"); color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                LineEdit {
                                    width: 96px;
                                    text <=> root.thumb-cache-cap;
                                    placeholder-text: "300";
                                    input-type: number;
                                    accepted => { root.thumb-cache-cap-changed(); }
                                }
                                // Thumbnails: after the size field
                                Text { text: @tr("MB, 0 for none"); color: Theme.text-secondary; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            if root.thumb-cache-on: HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Previews up to"); color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                LineEdit {
                                    width: 96px;
                                    text <=> root.preview-cache-cap;
                                    placeholder-text: "8192";
                                    input-type: number;
                                    accepted => { root.preview-cache-cap-changed(); }
                                }
                                Text { text: @tr("MB, 0 for none"); color: Theme.text-secondary; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            Text {
                                text: @tr("Previews let you cull offline drives; about 0.5 MB a frame.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: @tr("NETWORK FOLDERS");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                // Network folders: before the minutes field
                                Text { text: @tr("Rescan every"); color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                LineEdit {
                                    width: 96px;
                                    text <=> root.network-poll-minutes;
                                    placeholder-text: "10";
                                    input-type: number;
                                    accepted => { root.network-poll-changed(); }
                                }
                                // Network folders: after the minutes field
                                Text { text: @tr("minutes, 0 for never"); color: Theme.text-secondary; font-size: Theme.font-sm; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            Text {
                                text: @tr("Shares can't be watched, so they're rescanned.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }
                        editing := VerticalLayout {
                            visible: root.category == "Editing";
                            x: 0;
                            y: 0;
                            width: root.pane-w;
                            height: self.preferred-height;
                            padding: Theme.space-5;
                            padding-right: Theme.space-5 + Theme.scrollbar-band;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-3;
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Canvas"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                canvas-row := Segmented {
                                    options: root.canvas-names;
                                    current: root.canvas-names[root.canvas-choice];
                                    picks: false;
                                    accessible-role: list;
                                    accessible-value: self.current;
                                    selected(c) => {
                                        root.canvas-choice = c == root.canvas-names[4] ? 4
                                            : c == root.canvas-names[3] ? 3
                                            : c == root.canvas-names[2] ? 2
                                            : c == root.canvas-names[1] ? 1
                                            : 0;
                                        root.canvas-changed();
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                // Editing: the monitor profile row
                                Text { text: @tr("Monitor"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                monitor-row := Segmented {
                                    options: ["System", "sRGB", "Adobe RGB", "Display P3", "File"];
                                    labels: [@tr("System"), "sRGB", "Adobe RGB", "Display P3", @tr("File")];
                                    current <=> root.display-profile;
                                    accessible-role: list;
                                    // Spoken as the label shown.
                                    accessible-value: self.current == "System" ? @tr("System")
                                        : self.current == "File" ? @tr("File")
                                        : self.current;
                                    selected(p) => { root.display-changed(); }
                                }
                            }
                            if root.display-profile == "System" && root.monitors.length > 1: HorizontalLayout {
                                padding-left: 68px + Theme.space-2;
                                Segmented {
                                    options: root.monitors;
                                    current <=> root.display-monitor;
                                    selected(m) => { root.display-changed(); }
                                }
                            }
                            if root.display-profile == "File": HorizontalLayout {
                                spacing: Theme.space-2;
                                padding-left: 68px + Theme.space-2;
                                Text {
                                    text: root.display-file == "" ? @tr("No profile chosen") : root.display-file;
                                    font-size: Theme.font-xs;
                                    color: root.display-file == "" ? Theme.text-muted : Theme.text-secondary;
                                    vertical-alignment: center;
                                    wrap: char-wrap;
                                    horizontal-stretch: 1;
                                }
                                PanelButton {
                                    text: @tr("Choose...");
                                    clicked => { root.choose-display-file(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                // Editing: the soft proof row
                                Text { text: @tr("Soft proof"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                proof-row := Segmented {
                                    options: ["sRGB", "Display P3", "Rec.2020", "Adobe RGB", "File"];
                                    labels: ["sRGB", "Display P3", "Rec.2020", "Adobe RGB", @tr("File")];
                                    current <=> root.proof-profile;
                                    accessible-role: list;
                                    // Spoken as the label shown.
                                    accessible-value: self.current == "File" ? @tr("File")
                                        : self.current;
                                    selected(p) => { root.proof-changed(); }
                                }
                            }
                            if root.proof-profile == "File": HorizontalLayout {
                                spacing: Theme.space-2;
                                padding-left: 68px + Theme.space-2;
                                Text {
                                    text: root.proof-file == "" ? @tr("No profile chosen") : root.proof-file;
                                    font-size: Theme.font-xs;
                                    color: root.proof-file == "" ? Theme.text-muted : Theme.text-secondary;
                                    vertical-alignment: center;
                                    wrap: char-wrap;
                                    horizontal-stretch: 1;
                                }
                                PanelButton {
                                    text: @tr("Choose...");
                                    clicked => { root.choose-proof-file(); }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 68px + Theme.space-2;
                                intent-row := Segmented {
                                    options: ["Perceptual", "Relative"];
                                    labels: [@tr("Perceptual"), @tr("Relative")];
                                    current <=> root.proof-intent;
                                    accessible-role: list;
                                    // Spoken as the label shown.
                                    accessible-value: self.current == "Perceptual" ? @tr("Perceptual")
                                        : self.current == "Relative" ? @tr("Relative")
                                        : self.current;
                                    selected(i) => { root.proof-changed(); }
                                }
                            }
                            Toggle {
                                label: @tr("Lens corrections on new edits");
                                checked <=> root.lens-on-new;
                                toggled => { root.lens-on-new-changed(); }
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: @tr("CROP");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Aspect"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                Segmented {
                                    options: ["Original", "Last used", "Free"];
                                    // Editing: the aspect a new crop opens at
                                    labels: [@tr("aspect" => "Original"), @tr("Last used"), @tr("Free")];
                                    current <=> root.crop-start;
                                    selected => { root.crop-start-changed(); }
                                }
                            }
                            Text {
                                text: root.crop-start == "Last used"
                                    ? @tr("An uncropped frame's crop opens at the aspect last picked.")
                                    : root.crop-start == "Free"
                                    ? @tr("An uncropped frame's crop opens free, any shape.")
                                    : @tr("An uncropped frame's crop opens at the frame's own shape.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: @tr("RETOUCH");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Fill"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                fill-row := Segmented {
                                    options: ["Patch", "Fast", "Best"];
                                    labels: [@tr("Patch"), @tr("Fast"), @tr("Best")];
                                    tips: [@tr("From the picture around it, at once"), @tr("The remove in four steps: quicker, rougher on large areas"), @tr("The remove in full")];
                                    why-not: root.fill-why-not;
                                    current <=> root.fill-choice;
                                    picks: false;
                                    accessible-role: list;
                                    // Spoken as the label shown.
                                    accessible-value: self.current == "Patch" ? @tr("Patch")
                                        : self.current == "Fast" ? @tr("Fast")
                                        : self.current == "Best" ? @tr("Best")
                                        : self.current;
                                    selected(c) => { root.fill-chosen(c); }
                                }
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: @tr("PRESETS");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: root.presets-missing-words;
                                    font-size: Theme.font-sm;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                                if root.presets-missing > 0: PanelButton {
                                    text: @tr("Restore");
                                    width: 96px;
                                    clicked => { root.presets-restore(); }
                                }
                            }
                            Text {
                                text: @tr("Restores removed built-in presets.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: @tr("EXPORT");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Format"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                format-row := Segmented {
                                    options: ["JPEG", "PNG", "TIFF 16-bit", "WebP"];
                                    labels: ["JPEG", "PNG", @tr("TIFF 16-bit"), "WebP"];
                                    current <=> root.export-format;
                                    accessible-role: list;
                                    // Spoken as the label shown.
                                    accessible-value: self.current == "TIFF 16-bit" ? @tr("TIFF 16-bit")
                                        : self.current;
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text { text: @tr("Color"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                space-row := Segmented {
                                    options: ["sRGB", "Display P3", "Rec.2020", "Adobe RGB"];
                                    current <=> root.export-space;
                                    accessible-role: list;
                                    accessible-value: self.current;
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: @tr("Edit in");
                                    width: 68px;
                                    height: Theme.control-height;
                                    color: Theme.text;
                                    font-size: Theme.font-sm;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    spacing: Theme.space-1;
                                    horizontal-stretch: 1;
                                    for name[i] in root.edit-in-list: HorizontalLayout {
                                        spacing: Theme.space-2;
                                        Text {
                                            text: name;
                                            font-size: Theme.font-xs;
                                            color: Theme.text-secondary;
                                            vertical-alignment: center;
                                            wrap: char-wrap;
                                            horizontal-stretch: 1;
                                        }
                                        PanelButton {
                                            text: "×";
                                            clicked => { root.edit-in-remove(i); }
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        PanelButton {
                                            // Export presets: the button that adds one
                                            text: @tr("Add...");
                                            clicked => { root.edit-in-add(); }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                // Editing: the name every export carries
                                Text { text: @tr("Author"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                author-field := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.author;
                                    accepted => { root.rights-changed(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                // Editing: the copyright notice every export carries
                                Text { text: @tr("Copyright"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                                copyright-field := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.copyright;
                                    accepted => { root.rights-changed(); }
                                }
                            }
                        }
                        models := VerticalLayout {
                            visible: root.category == "Models";
                            x: 0;
                            y: 0;
                            width: root.pane-w;
                            height: self.preferred-height;
                            padding: Theme.space-5;
                            padding-right: Theme.space-5 + Theme.scrollbar-band;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-3;
                            Text {
                                text: @tr("MODELS");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            // Fetch all and what is left first, in reach without a
                            // scroll however long the list.
                            HorizontalLayout {
                                alignment: start;
                                PanelButton {
                                    text: root.models-fetch-label;
                                    icon: @image-url("../icons/image-down.svg");
                                    enabled: root.models-fetch-enabled;
                                    clicked => { root.models-fetch-all(); }
                                }
                            }
                            // Each wrapping text has its own width, as the keys' rows
                            // have, so a wrapped line counts in the category's height
                            // and the note at the foot stays in reach.
                            for line in root.models-lines: HorizontalLayout {
                                spacing: Theme.space-2;
                                VerticalLayout {
                                    Text {
                                        text: line.name;
                                        width: root.models-text-w;
                                        font-size: Theme.font-sm;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: line.purpose + " · " + line.license;
                                        width: root.models-text-w;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-muted;
                                        wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    Text {
                                        text: line.size;
                                        width: root.models-status-w;
                                        font-size: Theme.font-sm;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: right;
                                    }
                                    Text {
                                        text: line.status;
                                        width: root.models-status-w;
                                        font-size: Theme.font-xs;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: right;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            if root.models-note != "": Text {
                                text: root.models-note;
                                width: root.models-text-w + root.models-status-w + Theme.space-2;
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }
                        keys := VerticalLayout {
                            visible: root.category == "Keys";
                            x: 0;
                            y: 0;
                            width: root.pane-w;
                            height: self.preferred-height;
                            padding: Theme.space-5;
                            padding-right: Theme.space-5 + Theme.scrollbar-band;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-3;
                            Text {
                                text: @tr("KEYS");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            for row in root.key-bindings: VerticalLayout {
                                spacing: 2px;
                                padding-top: row.heading ? Theme.space-2 : 0;
                                if row.heading: Text {
                                    text: row.does;
                                    font-size: Theme.font-xs;
                                    color: Theme.text-muted;
                                }
                                if !row.heading: HorizontalLayout {
                                    spacing: Theme.space-2;
                                    Text {
                                        text: row.does;
                                        font-size: Theme.font-sm;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                        // Its own width, so a wrapped line counts in the
                                        // sheet's height and Reset to defaults stays in reach.
                                        // A pair's second chord takes another chip's.
                                        width: root.pane-w - 2 * Theme.space-5 - Theme.scrollbar-band - 112px - Theme.space-2
                                            - (row.id2 != "" ? 112px + Theme.space-1 : 0);
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space-1;
                                        BindChip {
                                            on: root.listening == row.id;
                                            keys: row.keys;
                                            does: row.does;
                                            warn: row.warn;
                                            listen => { root.listen(row.id); }
                                        }
                                        if row.id2 != "": BindChip {
                                            on: root.listening == row.id2;
                                            keys: row.keys2;
                                            does: row.does;
                                            warn: row.warn;
                                            listen => { root.listen(row.id2); }
                                        }
                                    }
                                }
                                if !row.heading && row.also != "": Text {
                                    text: row.also;
                                    font-size: Theme.font-xs;
                                    color: Theme.warn-red;
                                    wrap: word-wrap;
                                }
                            }
                            HorizontalLayout {
                                alignment: end;
                                PanelButton {
                                    text: @tr("Reset to defaults");
                                    // The button's click takes the focus from a
                                    // row listening; the focus goes back to the
                                    // column either way.
                                    clicked => {
                                        root.keys-reset();
                                        root.listened();
                                    }
                                }
                            }
                        }
                        about := VerticalLayout {
                            visible: root.category == "About";
                            x: 0;
                            y: 0;
                            width: root.pane-w;
                            height: self.preferred-height;
                            padding: Theme.space-5;
                            padding-right: Theme.space-5 + Theme.scrollbar-band;
                            padding-bottom: Theme.space-2;
                            spacing: Theme.space-3;
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                // About: the version row
                                Text { text: @tr("Version"); width: 68px; color: Theme.text; font-size: Theme.font-sm; }
                                Text { text: root.version; font-size: Theme.font-sm; color: Theme.text-secondary; horizontal-stretch: 1; }
                            }
                            Rectangle { height: Theme.space-1; }
                            Text {
                                text: @tr("UPDATES");
                                font-size: Theme.font-xs;
                                font-weight: Theme.weight-medium;
                                color: Theme.text-secondary;
                            }
                            Toggle {
                                label: @tr("Check for a new version at launch");
                                checked <=> root.update-check;
                                toggled => { root.update-check-changed(); }
                            }
                            Text {
                                text: @tr("Once a day; sends only the version number.");
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                Text {
                                    text: root.update-note;
                                    font-size: Theme.font-sm;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                                PanelButton {
                                    text: @tr("Check now");
                                    width: 96px;
                                    enabled: !root.update-checking;
                                    clicked => { root.update-check-now(); }
                                }
                            }
                            Rectangle { height: Theme.space-1; }
                            if root.settings-dir != "": HorizontalLayout {
                                spacing: Theme.space-2;
                                min-height: settings-path.preferred-height;
                                Text { text: @tr("Settings"); width: 68px; color: Theme.text; font-size: Theme.font-sm; }
                                settings-path := Text {
                                    text: root.settings-dir;
                                    font-size: Theme.font-sm;
                                    color: settings-open.has-hover ? Theme.accent-text : Theme.text-secondary;
                                    wrap: char-wrap;
                                    horizontal-stretch: 1;
                                    settings-open := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.dir-clicked(0); }
                                    }
                                }
                            }
                            if root.library-dir != "": HorizontalLayout {
                                spacing: Theme.space-2;
                                min-height: library-path.preferred-height;
                                Text { text: @tr("Library"); width: 68px; color: Theme.text; font-size: Theme.font-sm; }
                                library-path := Text {
                                    text: root.library-dir;
                                    font-size: Theme.font-sm;
                                    color: library-open.has-hover ? Theme.accent-text : Theme.text-secondary;
                                    wrap: char-wrap;
                                    horizontal-stretch: 1;
                                    library-open := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.dir-clicked(1); }
                                    }
                                }
                            }
                            if root.caches-dir != "": HorizontalLayout {
                                spacing: Theme.space-2;
                                min-height: caches-path.preferred-height;
                                // About: the cache folder's row
                                Text { text: @tr("Caches"); width: 68px; color: Theme.text; font-size: Theme.font-sm; }
                                caches-path := Text {
                                    text: root.caches-dir;
                                    font-size: Theme.font-sm;
                                    color: caches-open.has-hover ? Theme.accent-text : Theme.text-secondary;
                                    wrap: char-wrap;
                                    horizontal-stretch: 1;
                                    caches-open := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.dir-clicked(2); }
                                    }
                                }
                            }
                            if root.log-dir != "": HorizontalLayout {
                                spacing: Theme.space-2;
                                min-height: log-path.preferred-height;
                                // About: the log folder's row
                                Text { text: @tr("Log"); width: 68px; color: Theme.text; font-size: Theme.font-sm; }
                                log-path := Text {
                                    text: root.log-dir;
                                    font-size: Theme.font-sm;
                                    color: log-open.has-hover ? Theme.accent-text : Theme.text-secondary;
                                    wrap: char-wrap;
                                    horizontal-stretch: 1;
                                    log-open := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.dir-clicked(3); }
                                    }
                                }
                            }
                        }
                    }
                }
                done-row := HorizontalLayout {
                    padding: Theme.space-5;
                    padding-top: Theme.space-2;
                    alignment: end;
                    PanelButton {
                        text: @tr("Done");
                        primary: true;
                        width: 96px;
                        clicked => { root.settings-open = false; }
                    }
                }
            }
        }
    }
}
