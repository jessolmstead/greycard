// The import sheet: the export sheet's twin, the other way. Copy, its
// opening choice: where the frames come from (a card, found when there
// is one), where they go, the folders and names they are given, a
// preset laid over each, and a second copy for a backup. Or Add in
// place: a folder added to the library where it is, nothing copied.
// Over everything until a choice is made.

import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PanelButton, Toggle, Segmented, ScrollPane } from "../controls.slint";

// A folder: its path, or what is missing, and the button that asks
// the desktop for one.
component FolderRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> path;
    in property <string> empty;
    in property <bool> clearable: false;
    callback choose();
    callback clear();
    spacing: Theme.space-2;
    Text { text: root.label; width: 76px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text {
        text: root.path == "" ? root.empty : root.path;
        color: root.path == "" ? Theme.text-muted : Theme.text-secondary;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
    if root.clearable && root.path != "": PanelButton {
        text: "Clear";
        clicked => { root.clear(); }
    }
    PanelButton {
        text: "Choose...";
        clicked => { root.choose(); }
    }
}

export component ImportSheet inherits Rectangle {
    in-out property <bool> import-open;
    in property <string> import-source;
    in property <string> import-destination;
    in property <string> import-backup;
    in-out property <string> import-subfolder;
    in-out property <string> import-name;
    /// The presets by name, "None" first, and the one chosen.
    in property <[string]> import-presets;
    in-out property <string> import-preset;
    /// What the source holds, or what is being looked for.
    in property <string> import-note;
    /// Where the first frame would land, or why nothing would.
    in property <string> import-preview;
    /// A word on the folders, when there is one to say.
    in property <string> import-folders-note;
    /// Frames to import; none keeps the button off.
    in property <int> import-count;
    /// Whether there is something to import, somewhere to put it and
    /// patterns that make names.
    in property <bool> import-ready;
    in-out property <bool> import-verify;
    /// "Copy" or "Add in place".
    in-out property <string> import-mode;
    /// Add in place's folder, and what it holds.
    in property <string> import-place;
    in property <string> import-place-note;
    /// Which folder to ask the desktop for: source, destination,
    /// backup, or place (Add in place's).
    callback import-choose(string);
    callback import-backup-cleared();
    callback import-started();

    background: #000000a0;
    TouchArea { clicked => { root.import-open = false; } }
    Rectangle {
        width: 520px;
        // As tall as it needs, up to the window less a margin; past
        // that the rows scroll and the buttons stay in reach below.
        height: min(body.preferred-height + buttons.preferred-height, root.height - 2 * Theme.space-5);
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        clip: true;
        TouchArea { }
        VerticalLayout {
            ScrollPane {
                min-height: 80px;
                vertical-stretch: 1;
                body := VerticalLayout {
                    padding: Theme.space-5;
                    padding-right: Theme.space-5 + Theme.scrollbar-band;
                    padding-bottom: Theme.space-2;
                    spacing: Theme.space-2;
                    Text {
                        text: "Import";
                        font-size: Theme.font-lg;
                        font-weight: Theme.weight-medium;
                        color: Theme.text;
                    }
                    Segmented {
                        options: ["Copy", "Add in place"];
                        current <=> root.import-mode;
                    }
                    Text {
                        text: root.import-mode == "Copy"
                            ? "Copies are verified; the card is untouched."
                            : "Adds a folder and its subfolders to the library where it is; nothing is copied.";
                        wrap: word-wrap;
                        font-size: Theme.font-xs;
                        color: Theme.text-secondary;
                    }
                    Rectangle { height: Theme.space-1; }
                    if root.import-mode == "Add in place": VerticalLayout {
                        spacing: Theme.space-2;
                        FolderRow {
                            label: "Folder";
                            path: root.import-place;
                            empty: "No folder chosen";
                            choose => { root.import-choose("place"); }
                        }
                        HorizontalLayout {
                            padding-left: 76px + Theme.space-2;
                            Text {
                                text: root.import-place-note;
                                wrap: word-wrap;
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                            }
                        }
                    }
                    if root.import-mode == "Copy": VerticalLayout {
                        spacing: Theme.space-2;
                        FolderRow {
                            label: "From";
                            path: root.import-source;
                            empty: "No card found";
                            choose => { root.import-choose("source"); }
                        }
                        HorizontalLayout {
                            padding-left: 76px + Theme.space-2;
                            Text {
                                text: root.import-note;
                                wrap: word-wrap;
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                            }
                        }
                        FolderRow {
                            label: "To";
                            path: root.import-destination;
                            empty: "No folder chosen";
                            choose => { root.import-choose("destination"); }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: "Folders"; width: 76px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.import-subfolder;
                                placeholder-text: "none";
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: "Name"; width: 76px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.import-name;
                                placeholder-text: "{name}";
                            }
                        }
                        HorizontalLayout {
                            padding-left: 76px + Theme.space-2;
                            Text {
                                text: "{date} {yyyy} {mm} {dd} {name} {camera} {seq} {folder}; a / in Folders makes a folder in a folder.";
                                wrap: word-wrap;
                                font-size: Theme.font-xs;
                                color: Theme.text-muted;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 76px + Theme.space-2;
                            Text {
                                text: root.import-preview;
                                wrap: word-wrap;
                                font-size: Theme.font-sm;
                                color: Theme.text;
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            Text { text: "Preset"; width: 76px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.import-presets;
                                current-value <=> root.import-preset;
                            }
                        }
                        FolderRow {
                            label: "Backup";
                            path: root.import-backup;
                            empty: "None: one copy only";
                            clearable: true;
                            choose => { root.import-choose("backup"); }
                            clear => { root.import-backup-cleared(); }
                        }
                        if root.import-folders-note != "": HorizontalLayout {
                            padding-left: 76px + Theme.space-2;
                            Text {
                                text: root.import-folders-note;
                                wrap: word-wrap;
                                font-size: Theme.font-xs;
                                color: Theme.text-secondary;
                            }
                        }
                        Toggle {
                            label: "Verify against the card";
                            checked <=> root.import-verify;
                        }
                        Text {
                            text: "Verify compares every byte (slower).";
                            wrap: word-wrap;
                            font-size: Theme.font-xs;
                            color: Theme.text-muted;
                        }
                    }
                }
            }
            buttons := HorizontalLayout {
                padding: Theme.space-5;
                padding-top: Theme.space-2;
                spacing: Theme.space-2;
                alignment: end;
                PanelButton {
                    text: "Cancel";
                    clicked => { root.import-open = false; }
                }
                PanelButton {
                    // Add in place copies nothing, and says so.
                    property <string> verb: root.import-mode == "Copy" ? "Import" : "Add";
                    text: root.import-count == 1 ? verb + " 1 frame" : verb + " " + root.import-count + " frames";
                    icon: @image-url("../icons/camera.svg");
                    primary: true;
                    enabled: root.import-ready;
                    clicked => { root.import-started(); }
                }
            }
        }
    }
}
