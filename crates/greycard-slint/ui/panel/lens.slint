// The LENS section: the lens picked or the profile the database
// found, the manual corrections, and the defringe.

import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Section, EditSlider, Steps, Toggle, PanelButton, Typing } from "../controls.slint";

export component LensSection inherits Section {
    in-out property <bool> lens-enabled;
    in-out property <bool> collapsed-lens;
    in-out property <string> picking;
    callback pick-started(string);
    in property <brush> hue-circle;
    in property <string> lens-profile;
    in property <bool> lens-available;
    in property <bool> lens-database;
    in property <[string]> lens-choice-labels;
    in property <[string]> lens-choice-keys;
    in-out property <string> lens-choice;
    in-out property <int> lens-choice-index;
    in property <[string]> lens-makers;
    in-out property <int> lens-maker-index;
    in-out property <string> lens-filter;
    callback lens-rows-changed();
    in-out property <bool> lens-profile-on;
    in-out property <bool> lens-distortion;
    in-out property <bool> lens-ca;
    in property <bool> lens-ca-measured;
    in-out property <bool> lens-vignetting;
    in-out property <float> lens-manual;
    in-out property <float> lens-ca-red;
    in-out property <float> lens-ca-blue;
    in-out property <bool> lens-auto-scale;
    in-out property <float> lens-scale;
    in-out property <bool> lens-defringe;
    in-out property <float> lens-defringe-radius;
    in-out property <float> lens-defringe-threshold;
    in-out property <float> lens-defringe-purple-center;
    in-out property <float> lens-defringe-purple-width;
    in-out property <float> lens-defringe-purple-amount;
    in-out property <float> lens-defringe-green-center;
    in-out property <float> lens-defringe-green-width;
    in-out property <float> lens-defringe-green-amount;
    callback fetch-lenses();
    callback develop-changed();

    title: @tr("LENS");
    icon: @image-url("../icons/aperture.svg");
    collapsed <=> root.collapsed-lens;
    switchable: true;
    on <=> root.lens-enabled;
    switched => { root.develop-changed(); }
    // Which lens: the file's, or one picked by
    // hand for a file that names none. The
    // maker and the words narrow the list; the
    // words share the maker's row, whose names
    // are short, so the lens's name has the
    // width of its own.
    HorizontalLayout {
        spacing: Theme.space-2;
        Text { text: @tr("Maker"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
        ComboBox {
            min-width: 64px;
            horizontal-stretch: 1;
            model: root.lens-makers;
            current-index <=> root.lens-maker-index;
            selected(v) => { root.lens-rows-changed(); }
        }
        LineEdit {
            width: 96px;
            text <=> root.lens-filter;
            placeholder-text: @tr("Find a lens");
            accessible-label: @tr("Find a lens");
            edited(t) => { root.lens-rows-changed(); }
            // Enter or Escape gives the keys back to the window.
            accepted(t) => { Typing.done += 1; }
            key-pressed(e) => {
                if (e.text == Key.Escape) { Typing.done += 1; return accept; }
                return reject;
            }
            changed has-focus => { Typing.box-focus(self.has-focus); }
        }
    }
    Rectangle { height: Theme.space-1; }
    HorizontalLayout {
        spacing: Theme.space-2;
        Text { text: @tr("Lens"); width: 68px; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
        ComboBox {
            model: root.lens-choice-labels;
            current-index <=> root.lens-choice-index;
            selected(v) => {
                root.lens-choice = root.lens-choice-keys[self.current-index];
                root.develop-changed();
            }
        }
    }
    Rectangle { height: Theme.space-2; }
    VerticalLayout {
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        Text {
            text: root.lens-profile;
            color: root.lens-available ? Theme.text : Theme.text-secondary;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
    if !root.lens-database: VerticalLayout {
        padding-bottom: Theme.space-1;
        PanelButton {
            text: @tr("Get lens profiles");
            icon: @image-url("../icons/image-down.svg");
            clicked => { root.fetch-lenses(); }
        }
    }
    Toggle {
        label: @tr("Profile");
        enabled: root.lens-available;
        checked <=> root.lens-profile-on;
        toggled => { root.develop-changed(); }
    }
    Toggle {
        label: @tr("Distortion");
        enabled: root.lens-available && root.lens-profile-on;
        checked <=> root.lens-distortion;
        toggled => { root.develop-changed(); }
    }
    Toggle {
        label: @tr("Chromatic aberration");
        enabled: root.lens-available && root.lens-profile-on && !root.lens-ca-measured;
        checked <=> root.lens-ca;
        toggled => { root.develop-changed(); }
    }
    Toggle {
        label: @tr("Vignetting");
        enabled: root.lens-available && root.lens-profile-on;
        checked <=> root.lens-vignetting;
        toggled => { root.develop-changed(); }
    }
    EditSlider {
        // Lens section: the heading over the corrections set by hand
        label: @tr("Manual");
        minimum: -0.5;
        maximum: 0.5;
        default: 0;
        step: 0.005;
        steps: Steps.distortion;
        value <=> root.lens-manual;
        scale: 100;
        text: (root.lens-manual >= 0 ? "+" : "") + round(root.lens-manual * 1000) / 10;
        changed(v) => { root.develop-changed(); }
    }
    // The aberration by hand: each channel's
    // radius scaled beyond the green's, in
    // tenths of a percent.
    EditSlider {
        // Lens section: the chromatic aberration slider set by hand
        label: @tr("Red / cyan");
        minimum: -0.01;
        maximum: 0.01;
        default: 0;
        step: 0.0001;
        steps: Steps.fringe;
        value <=> root.lens-ca-red;
        scale: 1000;
        text: (root.lens-ca-red >= 0 ? "+" : "") + round(root.lens-ca-red * 10000) / 10 + "\u{2030}";
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        // Lens section: the chromatic aberration slider set by hand
        label: @tr("Blue / yellow");
        minimum: -0.01;
        maximum: 0.01;
        default: 0;
        step: 0.0001;
        steps: Steps.fringe;
        value <=> root.lens-ca-blue;
        scale: 1000;
        text: (root.lens-ca-blue >= 0 ? "+" : "") + round(root.lens-ca-blue * 10000) / 10 + "\u{2030}";
        changed(v) => { root.develop-changed(); }
    }
    Toggle {
        label: @tr("Auto scale");
        checked <=> root.lens-auto-scale;
        toggled => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Scale");
        enabled: !root.lens-auto-scale;
        minimum: 0.5;
        maximum: 2;
        default: 1;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.lens-scale;
        scale: 100;
        text: round(root.lens-scale * 100) + "%";
        changed(v) => { root.develop-changed(); }
    }
    // Axial aberration and purple fringing: a
    // different fault from the lateral one the
    // profile and the two sliders above correct.
    Toggle {
        label: @tr("Defringe");
        checked <=> root.lens-defringe;
        toggled => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Radius");
        enabled: root.lens-defringe;
        minimum: 0.5;
        maximum: 5;
        default: 2;
        step: 0.1;
        steps: Steps.tenths;
        value <=> root.lens-defringe-radius;
        text: round(root.lens-defringe-radius * 10) / 10 + " px";
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Threshold");
        enabled: root.lens-defringe;
        minimum: 0;
        maximum: 100;
        default: 13;
        step: 1;
        steps: Steps.whole;
        value <=> root.lens-defringe-threshold;
        text: round(root.lens-defringe-threshold);
        changed(v) => { root.develop-changed(); }
    }
    Rectangle { height: Theme.space-1; }
    // Which hues count as a fringe. The two
    // windows are the two sides of an axial
    // aberration; a chroma that departs from
    // its neighborhood in any other direction
    // is a red berry on a grey wall, and is
    // left alone. The dropper reads a click's
    // deviation hue and moves the nearer
    // window's center to it.
    Text {
        text: @tr("Purple");
        color: root.lens-defringe ? Theme.text-secondary : Theme.text-muted;
        font-size: Theme.font-xs;
        font-weight: Theme.weight-semibold;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    Rectangle { height: Theme.space-1; }
    EditSlider {
        // Defringe: the slider for the hue it centers on
        label: @tr("Center");
        enabled: root.lens-defringe;
        tinted: true;
        tint: root.hue-circle;
        minimum: 0;
        maximum: 360;
        default: 310;
        step: 1;
        steps: Steps.degrees;
        value <=> root.lens-defringe-purple-center;
        text: round(root.lens-defringe-purple-center) + "\u{00b0}";
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Width");
        enabled: root.lens-defringe;
        minimum: 10;
        maximum: 360;
        default: 120;
        step: 5;
        steps: Steps.degrees;
        value <=> root.lens-defringe-purple-width;
        text: round(root.lens-defringe-purple-width) + "\u{00b0}";
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Amount");
        enabled: root.lens-defringe;
        minimum: 0;
        maximum: 1;
        default: 1;
        step: 0.05;
        steps: Steps.percent;
        value <=> root.lens-defringe-purple-amount;
        scale: 100;
        text: round(root.lens-defringe-purple-amount * 100) + "%";
        changed(v) => { root.develop-changed(); }
    }
    Rectangle { height: Theme.space-1; }
    Text {
        text: @tr("Green");
        color: root.lens-defringe ? Theme.text-secondary : Theme.text-muted;
        font-size: Theme.font-xs;
        font-weight: Theme.weight-semibold;
        vertical-alignment: center;
        horizontal-alignment: left;
    }
    Rectangle { height: Theme.space-1; }
    EditSlider {
        label: @tr("Center");
        enabled: root.lens-defringe;
        tinted: true;
        tint: root.hue-circle;
        minimum: 0;
        maximum: 360;
        default: 130;
        step: 1;
        steps: Steps.degrees;
        value <=> root.lens-defringe-green-center;
        text: round(root.lens-defringe-green-center) + "\u{00b0}";
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Width");
        enabled: root.lens-defringe;
        minimum: 10;
        maximum: 360;
        default: 120;
        step: 5;
        steps: Steps.degrees;
        value <=> root.lens-defringe-green-width;
        text: round(root.lens-defringe-green-width) + "\u{00b0}";
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Amount");
        enabled: root.lens-defringe;
        minimum: 0;
        maximum: 1;
        default: 1;
        step: 0.05;
        steps: Steps.percent;
        value <=> root.lens-defringe-green-amount;
        scale: 100;
        text: round(root.lens-defringe-green-amount * 100) + "%";
        changed(v) => { root.develop-changed(); }
    }
    HorizontalLayout {
        spacing: Theme.space-2;
        padding-top: Theme.space-1;
        alignment: end;
        PanelButton {
            // Defringe: the dropper that reads the hue off the picture
            text: @tr("Pick hue");
            icon: @image-url("../icons/pipette.svg");
            enabled: root.lens-defringe;
            primary: root.picking == "Defringe";
            clicked => { root.pick-started("Defringe"); }
        }
    }
}
