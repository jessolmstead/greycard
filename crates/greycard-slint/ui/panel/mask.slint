// The Masks tab: the Adjustments list, pinned above the tab's
// scrolling sections so Global or another mask is one click from any
// slider, and the chosen mask's own controls, its shapes, and the one
// row that adds another to it, the first of those sections.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Tips, TipArea, Section, EditSlider, Steps, Toggle, PanelButton, Segmented, Typing, ScrollPane, ButtonKeys } from "../controls.slint";

// The list: Global, then each mask with its switch, the chosen one
// with its bin; then New mask. It never scrolls with the sections
// under it, and holds at most six rows before it scrolls inside
// itself, so a long list leaves the sections their room. Folded, its
// header names the chosen row. A right-click on a mask offers a copy
// of it below, or the mask clipboard; on any row, once the clipboard
// holds a mask, its paste.
export component AdjustmentsList inherits Section {
    in-out property <[string]> adjustment-names;
    in-out property <int> target;
    in-out property <[bool]> adjustment-on;
    in-out property <bool> collapsed-adjustments;
    callback target-changed(int);
    callback adjustment-toggled(int);
    // The mask whose row is under the pointer, by its index among the
    // masks, -1 for none: lit over the picture while it is.
    in-out property <int> mask-lit: -1;
    callback lit-changed();
    changed adjustment-names => { root.mask-lit = -1; root.lit-changed(); }
    callback new-mask();
    callback delete-adjustment();
    in property <bool> ctrl-click-menu;
    // Whether the mask clipboard holds a mask, which the menu then
    // offers to paste.
    in property <bool> mask-held;
    // A mask, by its index among the masks: copied below itself, or
    // onto the mask clipboard; the clipboard's mask pasted.
    callback duplicate-mask(int);
    callback copy-mask(int);
    // Every mask, as Copy settings with only the masks checked.
    callback copy-masks();
    callback paste-mask();
    callback focus-keys();
    callback menu-done();
    pure callback menu-shown() -> bool;
    // The row the menu was asked on.
    property <int> menu-row;
    function open-menu(i: int, x: length, y: length) {
        if (i == 0 && !root.mask-held) { return; }
        root.focus-keys();
        root.menu-row = i;
        menu.show({ x: x - frame.absolute-position.x, y: y - frame.absolute-position.y });
    }

    // The height between the panel's tab bar and its footer. How many
    // rows show before the list scrolls follows it: as many as leave
    // the sections a view of at least 150 px, from one to six, so the
    // list gives up rows before the sections' view and the footer are
    // squeezed. Set by handlers, not bound: the window's height itself
    // answers to what is laid out in it, this list among it, and a
    // binding would be a loop.
    in property <length> room: 1000px;
    property <int> max-rows: 6;
    // What the list takes besides its rows: its block's padding (8 +
    // 8) and the line under it (1), the section's padding (4), header
    // (16 + 4) and rule with the spacing either side (6 + 1 + 6), the
    // list's border (2), the spacing before New mask (4) and New mask
    // itself (28), plus the 3 px the layout adds around the header: 91 px.
    property <length> chrome: Theme.space-2 * 2 + 1px + Theme.space-1 + Theme.icon + Theme.space-1 + 6px + 1px + 6px + 2px + Theme.space-1 + Theme.control-height + 3px;
    // The least view of the sections a row is given up for.
    property <length> sections-view: 150px;
    function fit-rows() {
        root.max-rows = clamp(floor((root.room - root.chrome - root.sections-view) / root.pitch), 1, 6);
    }
    changed room => { root.fit-rows(); }
    // A row's pitch in the list.
    property <length> pitch: Theme.control-height + 2px;

    title: @tr("ADJUSTMENTS");
    icon: @image-url("../icons/layers.svg");
    note: root.collapsed ? root.adjustment-names[root.target] : "";
    collapsed <=> root.collapsed-adjustments;
    // The chosen row kept in sight, whether chosen here, from a shape
    // drawn on the picture or by New mask at the list's foot, and no
    // empty space left under the last row: on a change of target, of
    // the rows (a delete, an undo, another photo), of the list's own
    // height, and when the list is built again on coming back to the
    // tab.
    function reveal-target() {
        if (root.target * root.pitch < -list.content-y) {
            list.content-y = -root.target * root.pitch;
        } else if ((root.target + 1) * root.pitch > -list.content-y + list.height) {
            list.content-y = list.height - (root.target + 1) * root.pitch;
        }
        list.content-y = min(0px, max(list.content-y, list.height - rows.preferred-height));
    }
    property <length> rows-height: rows.preferred-height;
    property <length> view-height: list.height;
    changed target => { root.reveal-target(); }
    changed rows-height => { root.reveal-target(); }
    changed view-height => { root.reveal-target(); }
    init => {
        root.fit-rows();
        root.reveal-target();
        // Built again on coming back to the tab: no row under the
        // pointer yet.
        root.mask-lit = -1;
    }
    frame := Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.border;
        height: min(rows.preferred-height, root.max-rows * root.pitch) + 2px;
        menu := ContextMenuArea {
            x: 0;
            y: 0;
            width: 0px;
            height: 0px;
            enabled: false;
            Menu {
                if root.menu-row > 0: MenuItem {
                    title: @tr("Duplicate mask");
                    activated => { root.duplicate-mask(root.menu-row - 1); root.menu-done(); }
                }
                if root.menu-row > 0: MenuItem {
                    title: @tr("Copy mask");
                    activated => { root.copy-mask(root.menu-row - 1); root.menu-done(); }
                }
                if root.menu-row > 0: MenuItem {
                    title: @tr("Copy masks");
                    activated => { root.copy-masks(); root.menu-done(); }
                }
                if root.mask-held: MenuItem {
                    title: @tr("Paste mask");
                    activated => { root.paste-mask(); root.menu-done(); }
                }
            }
        }
        list := ScrollPane {
            // A row scrolled from under a resting pointer takes its word along.
            changed content-y => { Tips.show("", 0, 0); }
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            content-height: rows.preferred-height;
            content-width: self.visible-width;
            rows := VerticalLayout {
                width: list.visible-width;
                padding: 1px;
                spacing: 2px;
                for name[i] in root.adjustment-names: Rectangle {
                    accessible-role: button;
                    accessible-label: name;
                    property <bool> on: i == root.target;
                    property <bool> lit: i == 0 || root.adjustment-on[i - 1];
                    // The pointer is on the row's switch: the row's
                    // hover lights no mask there, whichever of the
                    // two hovers moves first.
                    property <bool> on-switch;
                    height: Theme.control-height;
                    border-radius: Theme.radius-sm;
                    background: on ? Theme.raised : (row.has-hover ? Theme.hover : transparent);
                    animate background { duration: Theme.quick; }
                    // The row's switch and bin inside it, so the row
                    // keeps its hover over them; the switch takes the
                    // mask's overlay down while the pointer is on it,
                    // so a toggle shows the adjustment's effect alone.
                    row := TouchArea {
                        property <bool> skip;
                        mouse-cursor: MouseCursor.pointer;
                        changed has-hover => {
                            if (self.has-hover && !on-switch) {
                                root.mask-lit = i - 1;
                            } else if (root.mask-lit == i - 1) {
                                root.mask-lit = -1;
                            }
                            root.lit-changed();
                        }
                        pointer-event(e) => {
                            if (e.kind != PointerEventKind.down) { return; }
                            // As a collection's row: the press that
                            // closes a menu is nothing more, and a
                            // right-click asks for the row's own.
                            let closing = root.menu-shown();
                            let ctrl-menu = root.ctrl-click-menu && e.button == PointerEventButton.left
                                && e.modifiers.meta;
                            let asks = e.button == PointerEventButton.right || ctrl-menu;
                            self.skip = closing || asks || e.button != PointerEventButton.left;
                            if (asks) {
                                root.open-menu(i, self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                        clicked => {
                            if (self.skip) { return; }
                            root.target-changed(i);
                        }
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            // Room for the inner scroll bar, which draws
                            // over the rows, so the bin stays clickable.
                            padding-right: Theme.space-1 + Theme.scrollbar-band;
                            spacing: Theme.space-2;
                            if i > 0: Rectangle {
                                width: 14px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: lit ? Theme.accent : transparent;
                                    border-width: 1px;
                                    border-color: lit ? Theme.accent : Theme.text-secondary;
                                }
                                TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    changed has-hover => {
                                        on-switch = self.has-hover;
                                        root.mask-lit = self.has-hover ? -1 : i - 1;
                                        root.lit-changed();
                                    }
                                    clicked => { root.adjustment-toggled(i - 1); }
                                }
                            }
                            Text {
                                text: name;
                                color: !lit ? Theme.text-secondary : on ? Theme.text : Theme.text-secondary;
                                font-size: Theme.font-xs;
                                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if on && i > 0: Rectangle {
                                width: Theme.control-height - 4px;
                                accessible-role: button;
                                accessible-label: @tr("Remove {}", name);
                                accessible-action-default => { root.delete-adjustment(); }
                                Image {
                                    source: @image-url("../icons/trash-2.svg");
                                    colorize: bin.has-hover ? Theme.text : Theme.text-secondary;
                                    width: Theme.icon;
                                    height: Theme.icon;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                                bin := TipArea {
                                    words: @tr("Remove");
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.delete-adjustment(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    PanelButton {
        text: @tr("New mask");
        icon: @image-url("../icons/plus.svg");
        clicked => { root.new-mask(); }
    }
}

// The chosen mask: its name and its own switches, one block: then its
// shapes as a list under it, each a row that says its kind, has its
// own invert and reaches its settings by being chosen; then, once,
// the row that adds another shape to it.
export component AdjustmentsSection inherits Section {
    in-out property <[string]> adjustment-names;
    in-out property <bool> collapsed-mask;
    in-out property <int> target;
    in-out property <bool> mask-invert;
    in-out property <float> mask-refine;
    in-out property <float> mask-opacity;
    in-out property <bool> has-feather;
    in-out property <float> mask-feather;
    in-out property <float> lum-low;
    in-out property <float> lum-high;
    in-out property <float> lum-low-feather;
    in-out property <float> lum-high-feather;
    in-out property <float> range-hue;
    in-out property <float> range-width;
    in-out property <float> range-hue-feather;
    in-out property <float> range-chroma;
    in-out property <float> range-chroma-feather;
    in property <brush> hue-circle;
    in-out property <string> picking;
    // The color pick's square, its side in the picture's pixels.
    in-out property <int> range-sample;
    callback pick-started(string);
    in-out property <bool> show-mask;
    callback show-mask-toggled();
    in-out property <string> placing;
    in-out property <string> adjustment-name;
    in-out property <[string]> component-names;
    in-out property <[bool]> component-on;
    // One per shape, beside its name: at a glance, not only the
    // chosen row's, in a card the others do not show.
    in-out property <[bool]> shape-invert;
    in-out property <int> component;
    in-out property <bool> placing-into;
    in-out property <string> component-kind;
    in property <string> component-heading;
    in-out property <float> brush-size;
    in-out property <float> brush-feather;
    in-out property <float> brush-flow;
    in-out property <string> brush-op;
    in-out property <string> shape-mode;
    callback add-shape(string, string);
    // A part from the People menu, by its label, joined by the mode.
    callback add-part(string, string);
    in-out property <bool> parts-menu-shown;
    // The Landscape button, joined by the mode: the model runs once on
    // the picture, and a menu of only what it found opens from Rust
    // once the answer is in, each entry's words and the kind it makes.
    callback find-landscape(string);
    callback add-landscape(string);
    in-out property <[string]> landscape-offers;
    in-out property <[string]> landscape-kinds;
    in-out property <bool> landscape-menu-shown;
    // The People or Landscape menu about to open: the window's keys
    // take the focus first, as Fit's menu does, so the click that
    // closes it is no click, and a pick leaves the keys with them, not
    // with the button.
    callback menu-opening();
    // A person picked for a People shape that a paste or a sync took
    // to other frames as well: the offer's words ("Use this person on
    // all 8 pictures"), empty for none, and the mask its shape is in,
    // as `target` counts them; taken, or put away.
    in property <string> people-offer;
    in property <int> people-offer-mask;
    callback people-offer-used();
    callback people-offer-dismissed();
    callback delete-shape-at(int);
    callback shape-toggled(int);
    callback invert-shape-toggled(int);
    callback component-changed(int);
    callback renamed();
    callback view-changed();
    // Set by New mask: the new mask's name takes the keys, so a name
    // can be typed at once. Let go once taken.
    in-out property <bool> name-wanted: false;

    title: @tr("MASK");
    owner: root.adjustment-names[root.target];
    icon: @image-url("../icons/layers.svg");
    collapsed <=> root.collapsed-mask;
    if root.target > 0: VerticalLayout {
        spacing: Theme.space-2;
        // A turn later, not in the press: the target's change closes
        // whatever field was open and hands the keys back, which would
        // take them from the name again. The placeholder's name is
        // selected so typing replaces it.
        Timer {
            interval: 1ms;
            running: root.name-wanted;
            triggered => {
                root.name-wanted = false;
                name-field.focus();
                name-field.select-all();
            }
        }
        Rectangle {
            border-radius: Theme.radius-md;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space-2;
                spacing: Theme.space-2;
                name-field := LineEdit {
                    text <=> root.adjustment-name;
                    placeholder-text: @tr("Name");
                    // Spoken by a screen reader: the mask's name field
                    accessible-label: @tr("Mask name");
                    edited(t) => { root.renamed(); }
                    // Enter or Escape gives the keys back to the
                    // window.
                    accepted(t) => { Typing.done += 1; }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) { Typing.done += 1; return accept; }
                        return reject;
                    }
                    changed has-focus => { Typing.box-focus(self.has-focus); }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Toggle {
                        label: @tr("Show mask");
                        checked <=> root.show-mask;
                        toggled => { root.show-mask-toggled(); root.view-changed(); }
                    }
                    Toggle {
                        label: @tr("Invert");
                        checked <=> root.mask-invert;
                        toggled => { root.view-changed(); }
                    }
                }
                // The whole mask's edge drawn onto the picture's.
                EditSlider {
                    label: @tr("Refine edge");
                    label-width: 84px;
                    minimum: 0;
                    maximum: 1;
                    default: 0;
                    step: 0.01;
                    steps: Steps.percent;
                    value <=> root.mask-refine;
                    scale: 100;
                    text: round(root.mask-refine * 100) + "%";
                    changed(v) => { root.view-changed(); }
                }
                // How much of the mask's look goes on, the overlay
                // as it is.
                EditSlider {
                    // Mask: the strength of its whole look
                    label: @tr("Opacity");
                    label-width: 84px;
                    minimum: 0;
                    maximum: 1;
                    default: 1;
                    step: 0.01;
                    steps: Steps.percent;
                    value <=> root.mask-opacity;
                    scale: 100;
                    text: round(root.mask-opacity * 100) + "%";
                    changed(v) => { root.view-changed(); }
                }
            }
        }
        Text {
            text: @tr("Shapes");
            color: Theme.text-secondary;
            font-size: Theme.font-xs;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            height: Theme.control-height - Theme.space-2;
        }
        VerticalLayout {
            padding-left: Theme.space-2;
            spacing: Theme.space-2;
            Rectangle {
                border-radius: Theme.radius-md;
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 2px;
                    spacing: 2px;
                    for name[i] in root.component-names: Rectangle {
                        property <bool> on: i == root.component;
                        property <bool> lit: root.component-on[i];
                        property <bool> inverted: root.shape-invert[i];
                        height: Theme.control-height;
                        border-radius: Theme.radius-sm;
                        // Chosen as a history step is, so it stands out
                        // among shapes of one kind; its settings are
                        // the card just under this list.
                        background: on ? Theme.selection : (shape-row.has-hover ? Theme.hover : transparent);
                        animate background { duration: Theme.quick; }
                        shape-row := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.component-changed(i); }
                        }
                        HorizontalLayout {
                            padding-left: Theme.space-2;
                            padding-right: Theme.space-1;
                            spacing: Theme.space-2;
                            // The shape's switch, as an adjustment's.
                            Rectangle {
                                width: 14px;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: lit ? Theme.accent : transparent;
                                    border-width: 1px;
                                    border-color: lit ? Theme.accent : Theme.text-secondary;
                                }
                                TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.shape-toggled(i); }
                                }
                            }
                            Text {
                                text: name;
                                color: !lit ? Theme.text-secondary : on ? Theme.text : Theme.text-secondary;
                                opacity: lit ? 1.0 : 0.5;
                                font-size: Theme.font-xs;
                                font-weight: on ? Theme.weight-medium : Theme.weight-regular;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            // The shape's own invert, beside it here
                            // rather than only in the card below for
                            // whichever row happens to be chosen: a
                            // half-filled circle, which reads as
                            // invert rather than mirror.
                            Rectangle {
                                width: Theme.control-height - 4px;
                                border-radius: Theme.radius-sm;
                                border-width: invert-focus.has-focus ? 2px : 0;
                                border-color: Theme.focus-ring;
                                accessible-role: button;
                                accessible-label: @tr("Invert this shape");
                                Image {
                                    source: @image-url("../icons/contrast.svg");
                                    colorize: inverted ? Theme.accent-text : (invert-hit.has-hover || invert-focus.has-focus ? Theme.text : Theme.text-secondary);
                                    width: Theme.icon;
                                    height: Theme.icon;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                                invert-focus := FocusScope {
                                    key-pressed(e) => {
                                        if (e.text == " " || e.text == Key.Return) {
                                            root.invert-shape-toggled(i);
                                            return accept;
                                        }
                                        return ButtonKeys.pass(e) ? accept : reject;
                                    }
                                }
                                invert-hit := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        invert-focus.focus();
                                        root.invert-shape-toggled(i);
                                    }
                                }
                                if invert-hit.has-hover || invert-focus.has-focus: Rectangle {
                                    y: -self.height - 4px;
                                    x: parent.width - self.width;
                                    width: tip-text.width + Theme.space-2 * 2;
                                    height: Theme.control-height - 6px;
                                    border-radius: Theme.radius-sm;
                                    background: Theme.raised;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    tip-text := Text {
                                        text: @tr("Invert this shape");
                                        color: Theme.text;
                                        font-size: Theme.font-xs;
                                        x: Theme.space-2;
                                        vertical-alignment: center;
                                        height: 100%;
                                        wrap: no-wrap;
                                    }
                                }
                            }
                            // The last one too: the mask stays, empty,
                            // as New mask leaves one.
                            Rectangle {
                                width: Theme.control-height - 4px;
                                accessible-role: button;
                                accessible-label: @tr("Remove this shape");
                                accessible-action-default => { root.delete-shape-at(i); }
                                Text {
                                    text: "\u{00d7}";
                                    color: cross.has-hover ? Theme.text : Theme.text-secondary;
                                    font-size: Theme.font-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                cross := TipArea {
                                    words: @tr("Remove");
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.delete-shape-at(i); }
                                }
                            }
                        }
                    }
                }
            }
            // Under the shapes of the mask a person was picked in, and
            // only that mask: the same person on the other frames the
            // paste or sync reached, one press, or put away with the
            // cross.
            if root.people-offer != "" && root.target == root.people-offer-mask: HorizontalLayout {
                spacing: Theme.space-2;
                PanelButton {
                    text: root.people-offer;
                    // Whole at the pointer when a narrow panel elides it.
                    words: root.people-offer;
                    icon: @image-url("../icons/users-round.svg");
                    primary: true;
                    horizontal-stretch: 1;
                    clicked => { root.people-offer-used(); }
                }
                Rectangle {
                    width: Theme.control-height;
                    accessible-role: button;
                    accessible-label: @tr("Not now");
                    accessible-action-default => { root.people-offer-dismissed(); }
                    Text {
                        text: "\u{00d7}";
                        color: offer-cross.has-hover ? Theme.text : Theme.text-secondary;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                    offer-cross := TipArea {
                        words: @tr("Not now");
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.people-offer-dismissed(); }
                    }
                }
            }
            // The chosen shape's own settings, reached by choosing its
            // row above; its invert is there already, not repeated
            // here. Nothing shown for a shape whose only setting is
            // its own invert (Linear, Brush, Subject, Background, Sky,
            // Object) — a card with nothing in it but the row's own
            // name would say it twice.
            if root.component-kind != ""
                && (root.has-feather || root.component-kind == "Luminance" || root.component-kind == "Color"): Rectangle {
                border-radius: Theme.radius-md;
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: Theme.space-2;
                    spacing: Theme.space-2;
                    Text {
                        text: root.component-heading.to-uppercase();
                        color: Theme.text-secondary;
                        font-size: Theme.font-xs;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: 0.8px;
                        overflow: elide;
                    }
                    if root.has-feather: EditSlider {
                        label: @tr("Feather");
                        minimum: 0;
                        maximum: 1;
                        default: 0.5;
                        step: 0.01;
                        steps: Steps.percent;
                        value <=> root.mask-feather;
                        scale: 100;
                        text: round(root.mask-feather * 100) + "%";
                        changed(v) => { root.view-changed(); }
                    }
                    // A luminance window: the lightness it takes in full, from
                    // Low to High, and how far past each it fades to nothing.
                    if root.component-kind == "Luminance": VerticalLayout {
                        spacing: Theme.space-2;
                        EditSlider {
                            label: @tr("Low");
                            minimum: 0;
                            maximum: 1;
                            default: 0.7;
                            step: 0.01;
                            steps: Steps.percent;
                            value <=> root.lum-low;
                            scale: 100;
                            text: round(root.lum-low * 100);
                            // Low pushes High ahead of it.
                            changed(v) => {
                                if (root.lum-high < v) { root.lum-high = v; }
                                root.view-changed();
                            }
                        }
                        EditSlider {
                            // Luminance range: the fade at the dark end
                            label: @tr("Low fade");
                            minimum: 0;
                            maximum: 0.5;
                            default: 0.1;
                            step: 0.01;
                            steps: Steps.percent;
                            value <=> root.lum-low-feather;
                            scale: 100;
                            text: round(root.lum-low-feather * 100);
                            changed(v) => { root.view-changed(); }
                        }
                        EditSlider {
                            label: @tr("High");
                            minimum: 0;
                            maximum: 1;
                            default: 1;
                            step: 0.01;
                            steps: Steps.percent;
                            value <=> root.lum-high;
                            scale: 100;
                            text: round(root.lum-high * 100);
                            changed(v) => {
                                if (root.lum-low > v) { root.lum-low = v; }
                                root.view-changed();
                            }
                        }
                        EditSlider {
                            // Luminance range: the fade at the light end
                            label: @tr("High fade");
                            minimum: 0;
                            maximum: 0.5;
                            default: 0;
                            step: 0.01;
                            steps: Steps.percent;
                            value <=> root.lum-high-feather;
                            scale: 100;
                            text: round(root.lum-high-feather * 100);
                            changed(v) => { root.view-changed(); }
                        }
                    }
                    // A color window: the hue it centers on, how wide it is in
                    // full and how far round it fades; the least chroma it
                    // takes in full, and how far under that it fades.
                    if root.component-kind == "Color": VerticalLayout {
                        spacing: Theme.space-2;
                        HorizontalLayout {
                            spacing: Theme.space-2;
                            PanelButton {
                                text: @tr("picker" => "Pick");
                                icon: @image-url("../icons/pipette.svg");
                                primary: root.picking == "Range";
                                clicked => { root.pick-started("Range"); }
                            }
                            Text {
                                // Color range: the button that reads a color off the picture
                                text: @tr("Sample");
                                color: Theme.text-secondary;
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                                horizontal-stretch: 1;
                            }
                            Segmented {
                                options: ["5", "11", "21", "41"];
                                current: root.range-sample;
                                picks: false;
                                selected(v) => { root.range-sample = v.to-float(); }
                            }
                        }
                        EditSlider {
                            label: @tr("Hue");
                            label-width: 84px;
                            tinted: true;
                            tint: root.hue-circle;
                            minimum: 0;
                            maximum: 360;
                            default: 55;
                            step: 0.5;
                            steps: Steps.degrees;
                            value <=> root.range-hue;
                            text: round(root.range-hue) + "\u{00b0}";
                            changed(v) => { root.view-changed(); }
                        }
                        EditSlider {
                            label: @tr("Width");
                            label-width: 84px;
                            minimum: 0;
                            maximum: 180;
                            default: 60;
                            step: 0.5;
                            steps: Steps.degrees;
                            value <=> root.range-width;
                            text: round(root.range-width) + "\u{00b0}";
                            changed(v) => { root.view-changed(); }
                        }
                        EditSlider {
                            // Color range: the fade
                            label: @tr("Hue fade");
                            label-width: 84px;
                            minimum: 0;
                            maximum: 90;
                            default: 25;
                            step: 0.5;
                            steps: Steps.degrees;
                            value <=> root.range-hue-feather;
                            text: round(root.range-hue-feather) + "\u{00b0}";
                            changed(v) => { root.view-changed(); }
                        }
                        EditSlider {
                            label: @tr("Chroma");
                            label-width: 84px;
                            minimum: 0;
                            maximum: 0.2;
                            default: 0.02;
                            step: 0.001;
                            steps: Steps.thousandths;
                            value <=> root.range-chroma;
                            scale: 100;
                            text: round(root.range-chroma * 1000) / 10;
                            // The fade runs down to no chroma at most.
                            changed(v) => {
                                if (root.range-chroma-feather > v) { root.range-chroma-feather = v; }
                                root.view-changed();
                            }
                        }
                        EditSlider {
                            // Color range: the fade
                            label: @tr("Chroma fade");
                            label-width: 84px;
                            minimum: 0;
                            maximum: 0.1;
                            default: 0.01;
                            step: 0.001;
                            steps: Steps.thousandths;
                            value <=> root.range-chroma-feather;
                            scale: 100;
                            text: round(root.range-chroma-feather * 1000) / 10;
                            changed(v) => {
                                if (v > root.range-chroma) { root.range-chroma-feather = root.range-chroma; }
                                root.view-changed();
                            }
                        }
                    }
                }
            }
            // The brush in hand: its next stroke, wherever "Add a
            // shape" below put it there from — directly under the
            // chosen shape's own settings, since it is the chosen
            // shape's own settings while a brush is chosen.
            if root.placing == "Brush": VerticalLayout {
                spacing: Theme.space-2;
                EditSlider {
                    label: @tr("Size");
                    minimum: 0.002;
                    maximum: 0.5;
                    default: 0.05;
                    step: 0.001;
                    steps: Steps.thousandths;
                    value <=> root.brush-size;
                    scale: 100;
                    text: round(root.brush-size * 1000) / 10 + "%";
                    changed(v) => { }
                }
                EditSlider {
                    label: @tr("Feather");
                    minimum: 0;
                    maximum: 1;
                    default: 0.5;
                    step: 0.01;
                    steps: Steps.percent;
                    value <=> root.brush-feather;
                    scale: 100;
                    text: round(root.brush-feather * 100) + "%";
                    changed(v) => { }
                }
                EditSlider {
                    // Brush: the slider
                    label: @tr("Opacity");
                    minimum: 0;
                    maximum: 1;
                    default: 1;
                    step: 0.01;
                    steps: Steps.percent;
                    value <=> root.brush-flow;
                    scale: 100;
                    text: round(root.brush-flow * 100) + "%";
                    changed(v) => { }
                }
                Segmented {
                    options: ["Add", "Subtract", "Erase"];
                    // Brush: what a stroke does
                    labels: [@tr("Add"), @tr("Subtract"), @tr("Erase")];
                    current <=> root.brush-op;
                }
            }
            // Add a shape: the row it joins as, then its kind. Under
            // the shapes list and the chosen one's own settings (so
            // the order reads mask, shapes, the chosen shape's
            // settings, then how to add another).
            Text {
                text: @tr("Add a shape");
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                font-weight: Theme.weight-medium;
                vertical-alignment: center;
                height: Theme.control-height - Theme.space-2;
            }
            Rectangle {
                // Dims while a chosen brush, sky or object is the one
                // in hand, so the row it would otherwise duplicate
                // reads as spoken for.
                opacity: root.placing-into && root.placing == root.component-kind
                    && (root.placing == "Brush" || root.placing == "Sky" || root.placing == "Object")
                    ? 0.4 : 1.0;
                VerticalLayout {
                    spacing: Theme.space-2;
                    // A mask with no shape yet has nothing to join,
                    // take from or intersect with: its first shape is
                    // always Add, so the row that picks among them for
                    // a second one is not shown to ask a question a
                    // first shape has no answer to.
                    if root.component-names.length > 0: Segmented {
                        accessible-role: button;
                        // Spoken by a screen reader: the shape mode button
                        accessible-label: @tr("Next shape mode");
                        options: ["Add", "Subtract", "Intersect"];
                        // Shape mode: the shape cuts the mask down to where both are
                        labels: [@tr("Add"), @tr("Subtract"), @tr("Intersect")];
                        current <=> root.shape-mode;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PanelButton {
                            // Add a shape: the kinds
                            text: @tr("Linear");
                            icon: @image-url("../icons/plus.svg");
                            primary: root.placing == "Linear" && root.placing-into;
                            clicked => { root.add-shape("Linear", root.shape-mode); }
                        }
                        PanelButton {
                            // Add a shape: the kinds
                            text: @tr("Radial");
                            icon: @image-url("../icons/plus.svg");
                            primary: root.placing == "Radial" && root.placing-into;
                            clicked => { root.add-shape("Radial", root.shape-mode); }
                        }
                        PanelButton {
                            // Add a shape: a brush; once one exists its button says Paint
                            text: root.component-kind == "Brush" ? @tr("Paint") : @tr("Brush");
                            icon: root.component-kind == "Brush" ? @image-url("../icons/brush.svg") : @image-url("../icons/plus.svg");
                            primary: root.placing == "Brush" && root.placing-into;
                            clicked => { root.add-shape("Brush", root.shape-mode); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PanelButton {
                            text: @tr("Subject");
                            icon: @image-url("../icons/user-round.svg");
                            clicked => { root.add-shape("Subject", root.shape-mode); }
                        }
                        // The Subject model's complement: everything a look
                        // should reach but the subject, with no shape drawn.
                        PanelButton {
                            text: @tr("Background");
                            icon: @image-url("../icons/image.svg");
                            clicked => { root.add-shape("Background", root.shape-mode); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        // On a chosen sky, clicks that correct it.
                        PanelButton {
                            text: root.component-kind == "Sky" ? @tr("picker" => "Pick") : @tr("Sky");
                            icon: @image-url("../icons/cloud.svg");
                            primary: root.placing == "Sky" && root.placing-into;
                            clicked => { root.add-shape("Sky", root.shape-mode); }
                        }
                        // The picture's water, foliage, mountains and
                        // buildings, and its sky: only what the model
                        // found, the largest first.
                        landscape-button := PanelButton {
                            property <bool> want: root.landscape-menu-shown;
                            changed want => {
                                if (self.want) {
                                    root.landscape-menu-shown = false;
                                    root.menu-opening();
                                    landscape-menu.show({ x: 0, y: self.height });
                                }
                            }
                            text: @tr("Landscape");
                            icon: @image-url("../icons/mountain.svg");
                            clicked => { root.find-landscape(root.shape-mode); }
                            landscape-menu := ContextMenuArea {
                                width: 0px;
                                height: 0px;
                                enabled: false;
                                Menu {
                                    for offer[i] in root.landscape-offers: MenuItem {
                                        title: offer;
                                        activated => { root.add-landscape(root.landscape-kinds[i]); }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PanelButton {
                            text: root.component-kind == "Object" ? @tr("picker" => "Pick") : @tr("Object");
                            icon: @image-url("../icons/mouse-pointer-click.svg");
                            primary: root.placing == "Object" && root.placing-into;
                            clicked => { root.add-shape("Object", root.shape-mode); }
                        }
                        // A person whole, or a part of one by name, from
                        // a menu in three groups under the whole person;
                        // the labels are the Rust table's
                        // (`greycard_edit::mask::PARTS`).
                        parts-button := PanelButton {
                            // Raised from Rust, for a snapshot of it.
                            property <bool> want: root.parts-menu-shown;
                            changed want => {
                                if (self.want) {
                                    root.parts-menu-shown = false;
                                    root.menu-opening();
                                    parts-menu.show({ x: 0, y: self.height });
                                }
                            }
                            text: @tr("People");
                            icon: @image-url("../icons/users-round.svg");
                            primary: root.placing == "Part";
                            clicked => {
                                root.menu-opening();
                                parts-menu.show({ x: 0, y: self.height });
                            }
                            parts-menu := ContextMenuArea {
                                width: 0px;
                                height: 0px;
                                enabled: false;
                                Menu {
                                    MenuItem { title: @tr("Whole person"); activated => { root.add-part("Whole person", root.shape-mode); } }
                                    MenuSeparator { }
                                    MenuItem { title: @tr("Face"); enabled: false; }
                                    MenuItem { title: @tr("Face"); activated => { root.add-part("Face", root.shape-mode); } }
                                    MenuItem { title: @tr("Facial skin"); activated => { root.add-part("Facial skin", root.shape-mode); } }
                                    MenuItem { title: @tr("Eyebrows"); activated => { root.add-part("Eyebrows", root.shape-mode); } }
                                    MenuItem { title: @tr("Eyes"); activated => { root.add-part("Eyes", root.shape-mode); } }
                                    MenuItem { title: @tr("Iris"); activated => { root.add-part("Iris", root.shape-mode); } }
                                    MenuItem { title: @tr("Lips"); activated => { root.add-part("Lips", root.shape-mode); } }
                                    MenuItem { title: @tr("Teeth"); activated => { root.add-part("Teeth", root.shape-mode); } }
                                    MenuSeparator { }
                                    MenuItem { title: @tr("Body"); enabled: false; }
                                    MenuItem { title: @tr("Skin"); activated => { root.add-part("Skin", root.shape-mode); } }
                                    MenuItem { title: @tr("Hair"); activated => { root.add-part("Hair", root.shape-mode); } }
                                    MenuItem { title: @tr("Hands"); activated => { root.add-part("Hands", root.shape-mode); } }
                                    MenuSeparator { }
                                    MenuItem { title: @tr("Clothing"); enabled: false; }
                                    MenuItem { title: @tr("clothing" => "Top"); activated => { root.add-part("Top", root.shape-mode); } }
                                    MenuItem { title: @tr("Bottoms"); activated => { root.add-part("Bottoms", root.shape-mode); } }
                                    MenuItem { title: @tr("Shoes"); activated => { root.add-part("Shoes", root.shape-mode); } }
                                    MenuItem { title: @tr("All clothing"); activated => { root.add-part("All clothing", root.shape-mode); } }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        PanelButton {
                            text: @tr("Luminance");
                            icon: @image-url("../icons/sun.svg");
                            clicked => { root.add-shape("Luminance", root.shape-mode); }
                        }
                        PanelButton {
                            text: @tr("Color");
                            icon: @image-url("../icons/palette.svg");
                            clicked => { root.add-shape("Color", root.shape-mode); }
                        }
                    }
                }
            }
        }
    }
}
