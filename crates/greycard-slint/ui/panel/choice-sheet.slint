// A menu's whole list, searchable and scrolled inside the window:
// what a menu held to the window's height (`MenuFit`) leaves out is
// reached here. Add to collection's All collections... is one use
// (`CollectionPickerSheet`), Edit in's All apps... and the archive
// menus' All archives... the others. Rust narrows one held list as
// the field is typed into, and only the rows in view are made, so a
// list of thousands opens and narrows at once. The keys
// stay in the field, as the keys sheet's do: Up and Down move the
// highlight, Return takes it (the first match until moved), Escape
// closes, and Tab goes round the field and the buttons, never the rows.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PanelButton, ScrollPane } from "../controls.slint";
import { CollectionChoice } from "../structs.slint";

// A row of the list, as the collections pane's rows are: plain, lit
// under the pointer and when highlighted, taken by a click.
component ChoiceRow inherits Rectangle {
    in property <string> name;
    in property <bool> lit;
    callback clicked();
    border-radius: Theme.radius-sm;
    background: root.lit ? Theme.selection : (ta.has-hover ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: root.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.lit;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    Text {
        x: Theme.space-2;
        width: parent.width - 2 * Theme.space-2;
        text: root.name;
        color: root.lit || ta.has-hover ? Theme.text : Theme.text-secondary;
        font-size: Theme.font-sm;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component ChoiceSheet inherits Rectangle {
    in-out property <bool> open;
    /// The sheet's heading, the field's hint, and what is said when
    /// nothing matches.
    in property <string> title;
    in property <string> placeholder;
    in property <string> none-text;
    /// The choices that match what is typed, as Rust holds them.
    in property <[CollectionChoice]> choices;
    /// The row Return takes: the first until Up or Down moves it.
    in-out property <int> highlight: 0;
    /// What is typed, on each change and once as the sheet opens.
    callback searched(string);
    /// A choice taken: its id, and the name it was offered under.
    callback picked(CollectionChoice);
    /// The field's text after a key typed while a button has the keys.
    pure callback typed-into(string, string) -> string;
    property <length> row-height: Theme.control-height - 6px;
    property <length> row-step: root.row-height + 1px;

    init => { root.searched(""); }

    function narrowed() {
        root.highlight = 0;
        scroll.content-y = 0;
        root.searched(search.text);
    }
    // The highlight moved by `by` rows, held to the list and kept in view.
    function step(by: int) {
        if (root.choices.length == 0) { return; }
        root.highlight = clamp(root.highlight + by, 0, root.choices.length - 1);
        let top = root.highlight * root.row-step;
        if (top < -scroll.content-y) {
            scroll.content-y = -top;
        } else if (top + root.row-height > scroll.visible-height - scroll.content-y) {
            scroll.content-y = scroll.visible-height - top - root.row-height;
        }
    }
    function take() {
        if (root.highlight >= 0 && root.highlight < root.choices.length) {
            root.picked(root.choices[root.highlight]);
        }
    }

    background: #000000a0;
    TouchArea { clicked => { root.open = false; } }
    Rectangle {
        width: min(480px, root.width - 2 * Theme.space-5);
        height: min(sheet.preferred-height, root.height - 2 * Theme.space-5);
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        TouchArea { }
        // The field has the focus and a key goes up from it, or from a
        // button Tab reached: Escape is taken here, and text typed on a
        // button goes back to the field.
        FocusScope {
            focus-on-tab-navigation: false;
            focus-on-click: false;
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.open = false;
                    return accept;
                }
                // Text, Backspace among it, but not Space, which
                // presses the button (`keys::typed_into`).
                let plain = !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta;
                let typed = root.typed-into(search.text, e.text);
                if (plain && !search.has-focus && typed != search.text) {
                    search.focus();
                    search.text = typed;
                    search.set-selection-offsets(typed.character-count * 4, typed.character-count * 4);
                    root.narrowed();
                    return accept;
                }
                return reject;
            }
            sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: root.title;
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                search := LineEdit {
                    accessible-label: root.placeholder;
                    placeholder-text: root.placeholder;
                    init => { self.focus(); }
                    edited(text) => { root.narrowed(); }
                    accepted(text) => { root.take(); }
                    key-pressed(e) => {
                        if (e.text == Key.DownArrow) { root.step(1); return accept; }
                        if (e.text == Key.UpArrow) { root.step(-1); return accept; }
                        if (e.text == Key.PageDown) {
                            root.step(max(1, floor(scroll.visible-height / root.row-step) - 1));
                            return accept;
                        }
                        if (e.text == Key.PageUp) {
                            root.step(-max(1, floor(scroll.visible-height / root.row-step) - 1));
                            return accept;
                        }
                        return reject;
                    }
                }
                scroll := ScrollPane {
                    // The rows in view and one more are made; the rest
                    // are room to scroll.
                    property <int> first: max(0, floor(-self.content-y / root.row-step));
                    property <int> shown: max(0, min(root.choices.length - self.first,
                        ceil(self.visible-height / root.row-step) + 1));
                    preferred-height: min(360px, max(root.row-step, root.choices.length * root.row-step));
                    content-height: root.choices.length * root.row-step;
                    content-width: self.visible-width;
                    for k in scroll.shown: row := ChoiceRow {
                        property <int> at: scroll.first + k;
                        x: 0;
                        y: self.at * root.row-step;
                        // Clear of the scroll bar's band.
                        width: scroll.visible-width - scroll.band-width;
                        height: root.row-height;
                        name: root.choices[self.at].name;
                        lit: self.at == root.highlight;
                        clicked => { root.picked(root.choices[self.at]); }
                    }
                    if root.choices.length == 0: none := Text {
                        x: 0;
                        y: 0;
                        text: root.none-text;
                        color: Theme.text-secondary;
                        font-size: Theme.font-sm;
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: end;
                    PanelButton {
                        text: @tr("Cancel");
                        clicked => { root.open = false; }
                    }
                    // A use's own buttons, after Cancel.
                    @children
                }
            }
        }
    }
}
