// The folder entry point and the open root's tree in the left pane:
// each folder indented under the one it is in, a
// triangle where it has folders of its own, its count muted after its
// name, the one open lit. A click opens the folder's frames from the
// index; the switch above takes in the folders under it too. Built
// from the index, so a root that is offline still shows its shape.

import { Theme } from "../theme.slint";
import { NameTip, PanelButton, Section, Toggle, ScrollPane } from "../controls.slint";
import { FolderName } from "recent.slint";
import { FolderRow } from "../structs.slint";

export component FoldersSection inherits Section {
    in property <[FolderRow]> rows;
    in property <bool> tree-shown;
    in property <string> open-name;
    in property <string> open-root;
    in property <string> open-path;
    in property <string> open-note;
    in property <bool> has-recent;
    in property <bool> quiet;
    in property <string> rt-offer;
    in-out property <bool> subfolders;
    in-out property <bool> collapsed-folders;
    callback open-folder();
    callback recent-menu(length, length);
    callback tip(string, length, length);
    pure callback menu-shown() -> bool;
    callback rt-offer-import();
    callback rt-offer-dismissed();
    /// A folder chosen, by its row.
    callback picked(int);
    /// A folder's triangle pressed, by its row.
    callback folded(int);
    callback subfolders-changed();
    /// The keys take the focus back after a press: nothing here keeps it.
    callback focus-keys();

    title: @tr("FOLDERS");
    icon: @image-url("../icons/folder-open.svg");
    collapsed <=> root.collapsed-folders;
    // With no tree, the button to open a folder must stay in sight.
    init => { if (!root.tree-shown) { root.collapsed-folders = false; } }
    changed tree-shown => { if (!root.tree-shown) { root.collapsed-folders = false; } }
    changed collapsed-folders => {
        if (!root.tree-shown && root.collapsed-folders) { root.collapsed-folders = false; }
    }
    shares: root.tree-shown;
    VerticalLayout {
        vertical-stretch: 0;
        spacing: 2px;
        padding-bottom: Theme.space-2;
        PanelButton {
            text: @tr("Open folder...");
            icon: @image-url("../icons/folder-open.svg");
            clicked => { root.focus-keys(); root.open-folder(); }
        }
        if root.open-name != "" || root.open-note != "" || root.has-recent: FolderName {
            name: root.open-name;
            root-name: root.open-root;
            path: root.open-path;
            note: root.open-note;
            has-list: root.has-recent;
            quiet: root.quiet;
            menu(x, y) => { root.recent-menu(x, y); }
            tip(t, x, y) => { root.tip(t, x, y); }
            menu-shown => { return root.menu-shown(); }
        }
        // Profiles found beside the folder's frames, offered once.
        if root.rt-offer != "": VerticalLayout {
            vertical-stretch: 0;
            spacing: 2px;
            padding-top: 2px;
            padding-bottom: Theme.space-2;
            Text {
                text: root.rt-offer;
                color: Theme.text-secondary;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                PanelButton {
                    text: @tr("Import...");
                    horizontal-stretch: 1;
                    clicked => { root.focus-keys(); root.rt-offer-import(); }
                }
                PanelButton {
                    text: @tr("Not now");
                    horizontal-stretch: 1;
                    clicked => { root.focus-keys(); root.rt-offer-dismissed(); }
                }
            }
        }
    }
    if root.tree-shown: Toggle {
        label: @tr("With subfolders");
        checked <=> root.subfolders;
        toggled => { root.subfolders-changed(); root.focus-keys(); }
    }
    if root.tree-shown && root.rows.length > 0: Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.border;
        // Three rows, or the list when shorter, and as much more of the
        // list as the pane's share gives it (app.slint), the rest a
        // scroll away, so a root of a thousand folders never pushes
        // the pane past the window.
        property <length> floor: min(folder-list.preferred-height, 3 * (Theme.control-height - 8px) + 6px);
        preferred-height: self.floor;
        min-height: self.floor;
        max-height: folder-list.preferred-height;
        vertical-stretch: 1;
        folder-pane := ScrollPane {
            folder-list := VerticalLayout {
                padding: 2px;
                spacing: 1px;
                for row[i] in root.rows: Rectangle {
                    height: Theme.control-height - 8px;
                    border-radius: Theme.radius-sm;
                    background: row.open ? Theme.selection
                        : folder-row.has-hover ? Theme.hover : transparent;
                    accessible-role: button;
                    accessible-label: row.name;
                    accessible-description: row.path;
                    accessible-action-default => { root.picked(i); }
                    animate background { duration: Theme.quick; }
                    folder-row := TouchArea {
                        /// Presses of any button, for the name's tip.
                        property <int> downs;
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { self.downs += 1; }
                        }
                        clicked => { root.picked(i); root.focus-keys(); }
                    }
                    HorizontalLayout {
                        padding-left: 2px + row.depth * 12px;
                        // Clears the scroll bar's band, as the
                        // snapshots' bins do.
                        padding-right: Theme.space-1 + Theme.scrollbar-band;
                        spacing: 2px;
                        // The triangle, or its room, so names at one
                        // depth line up whether or not they fold.
                        Rectangle {
                            width: Theme.icon;
                            if row.children: Image {
                                source: @image-url("../icons/chevron-right.svg");
                                colorize: fold.has-hover ? Theme.text : Theme.text-muted;
                                width: Theme.icon;
                                height: Theme.icon;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                transform-rotation: row.expanded ? 90deg : 0deg;
                            }
                            fold := TouchArea {
                                enabled: row.children;
                                mouse-cursor: row.children ? MouseCursor.pointer : MouseCursor.default;
                                accessible-role: button;
                                accessible-label: row.expanded ? @tr("Fold {}", row.name) : @tr("Unfold {}", row.name);
                                clicked => { root.folded(i); root.focus-keys(); }
                            }
                        }
                        folder-name := Text {
                            text: row.name;
                            color: row.open || folder-row.has-hover ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-weight: row.open ? Theme.weight-medium : Theme.weight-regular;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            // Cut short, the whole name at the pointer;
                            // the path is the row's description.
                            NameTip {
                                width: 100%;
                                height: 100%;
                                name: row.name;
                                cut: folder-name.preferred-width > folder-name.width;
                                row-hover: folder-row.has-hover;
                                hover: folder-row.has-hover;
                                pointer-x: folder-row.mouse-x;
                                pointer-y: folder-row.mouse-y;
                                downs: folder-row.downs;
                                scroll: folder-pane.content-y;
                            }
                        }
                        if row.count >= 0: Text {
                            text: row.count;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
