// The open root's folders as a tree in the left pane: each folder
// indented under the one it is in, a triangle where it has folders of
// its own, its count muted after its name, the one open lit. A click
// opens the folder's frames from the index; the switch above takes in
// the folders under it too. Built from the index, so a root that is
// offline still shows its shape.

import { Theme } from "../theme.slint";
import { NameTip, Section, Toggle, ScrollPane } from "../controls.slint";
import { FolderRow } from "../structs.slint";

export component FoldersSection inherits Section {
    in property <[FolderRow]> rows;
    /// The open folder's row, -1 for none, and a count that goes up
    /// when that row is to be brought into the list's view.
    in property <int> open-row: -1;
    in property <int> reveal: 0;
    /// Where each row of the list before went in the list now, by its
    /// folder (-1 for one gone), and a count that goes up when a row
    /// moved: folders found or gone above it.
    in property <[int]> moved;
    in property <int> moves: 0;
    /// Set with `moves`: the rows' marks land where they now are at
    /// once, not fade, since a row moving is no change of its own. Put
    /// back here once the move has been drawn.
    in-out property <bool> still-marks: false;
    in-out property <bool> subfolders;
    in-out property <bool> collapsed-folders;
    /// A folder chosen, by its row.
    callback picked(int);
    /// A folder's triangle pressed, by its row.
    callback folded(int);
    callback subfolders-changed();
    /// The keys take the focus back after a press: nothing here keeps it.
    callback focus-keys();

    title: @tr("FOLDERS");
    icon: @image-url("../icons/folder-open.svg");
    collapsed <=> root.collapsed-folders;
    shares: true;
    body-spacing: Theme.space-1;
    HorizontalLayout {
        padding-left: Theme.space-2 - 2px;
        subfolders-toggle := Toggle {
            label: @tr("With subfolders");
            checked <=> root.subfolders;
            toggled => { root.subfolders-changed(); root.focus-keys(); }
        }
    }
    if root.rows.length > 0: folder-box := Rectangle {
        // Three rows, or the list when shorter, and as much more of the
        // list as the pane's share gives it (app.slint), the rest a
        // scroll away, so a root of a thousand folders never pushes
        // the pane past the window.
        property <length> floor: min(folder-list.preferred-height, 3 * (Theme.control-height - 8px) + 6px);
        preferred-height: self.floor;
        min-height: self.floor;
        max-height: folder-list.preferred-height;
        vertical-stretch: 1;
        // The open folder's row brought wholly into view, by the least
        // scroll, a row to spare where there is room: when a folder is
        // opened anew (the count goes up), and when the list is built.
        // A row already in view moves nothing. On a timer, after the
        // rows have their heights: a scroll set while the layout is
        // still settling lands wrong (§693).
        property <int> served: -1;
        Timer {
            interval: 1ms;
            running: folder-box.served != root.reveal;
            triggered => {
                folder-box.served = root.reveal;
                folder-box.bring-in(root.open-row);
            }
        }
        function bring-in(i: int) {
            if (i < 0 || i >= root.rows.length) { return; }
            let h = Theme.control-height - 8px;
            let top = folder-list.padding-top + i * (h + folder-list.spacing);
            let view = folder-pane.visible-height;
            let at = -folder-pane.content-y;
            if (top >= at && top + h <= at + view) { return; }
            let spare = clamp((view - h) / 2, 0px, h + folder-list.spacing);
            let to = top < at ? top - spare : top + h + spare - view;
            folder-pane.content-y = -clamp(to, 0px, max(0px, folder-pane.content-height - view));
        }
        // Folders found or gone above the top row in sight (a pass over
        // the root while the list is scrolled) move the list by as many
        // rows, so that row stays where it is, as part of a row cut at
        // the top stays cut; a list at its top stays at its top.
        property <int> moves: root.moves;
        changed moves => {
            let pitch = Theme.control-height - 8px + folder-list.spacing;
            let at = -folder-pane.content-y - folder-list.padding-top;
            if (at <= 0px) { return; }
            let top = Math.floor(at / pitch);
            if (top >= root.moved.length) { return; }
            let now = root.moved[top];
            if (now < 0 || now == top) { return; }
            let view = folder-pane.visible-height;
            folder-pane.content-y = -clamp(-folder-pane.content-y + (now - top) * pitch,
                0px, max(0px, folder-pane.content-height - view));
        }
        // Past the marks' fade, so a fade the move would have started
        // has had its frames drawn at once.
        Timer {
            interval: 250ms;
            running: root.still-marks;
            triggered => { root.still-marks = false; }
        }
        folder-pane := ScrollPane {
            folder-list := VerticalLayout {
                spacing: 1px;
                for row[i] in root.rows: folder-line := Rectangle {
                    height: Theme.control-height - 8px;
                    border-radius: Theme.radius-sm;
                    background: row.open ? Theme.selection
                        : folder-row.has-hover ? Theme.hover : transparent;
                    accessible-role: button;
                    accessible-label: row.name;
                    accessible-description: row.path;
                    // Its key, for automation: the folder's path.
                    accessible-id: row.path;
                    accessible-action-default => { root.picked(i); }
                    animate background { duration: root.still-marks ? 0ms : Theme.quick; }
                    folder-row := TouchArea {
                        /// Presses of any button, for the name's tip.
                        property <int> downs;
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { self.downs += 1; }
                        }
                        clicked => { root.picked(i); root.focus-keys(); }
                    }
                    HorizontalLayout {
                        padding-left: 2px + row.depth * 12px;
                        // Clears the scroll bar's band, as the
                        // snapshots' bins do.
                        padding-right: Theme.space-1 + Theme.scrollbar-band;
                        spacing: 2px;
                        // The triangle, or its room, so names at one
                        // depth line up whether or not they fold.
                        Rectangle {
                            width: Theme.icon;
                            if row.children: Image {
                                source: @image-url("../icons/chevron-right.svg");
                                colorize: fold.has-hover ? Theme.text : Theme.text-muted;
                                width: Theme.icon;
                                height: Theme.icon;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                transform-rotation: row.expanded ? 90deg : 0deg;
                            }
                            fold := TouchArea {
                                enabled: row.children;
                                mouse-cursor: row.children ? MouseCursor.pointer : MouseCursor.default;
                                accessible-role: button;
                                accessible-label: row.expanded ? @tr("Fold {}", row.name) : @tr("Unfold {}", row.name);
                                accessible-id: row.path;
                                accessible-enabled: row.children;
                                accessible-action-default => {
                                    if (row.children) { root.folded(i); root.focus-keys(); }
                                }
                                clicked => { root.folded(i); root.focus-keys(); }
                            }
                        }
                        folder-name := Text {
                            text: row.name;
                            color: row.open || folder-row.has-hover ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-weight: row.open ? Theme.weight-medium : Theme.weight-regular;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            // Cut short, the whole name at the pointer;
                            // the path is the row's description.
                            NameTip {
                                width: 100%;
                                height: 100%;
                                name: row.name;
                                cut: folder-name.preferred-width > folder-name.width;
                                row-hover: folder-row.has-hover;
                                hover: folder-row.has-hover;
                                pointer-x: folder-row.mouse-x;
                                pointer-y: folder-row.mouse-y;
                                downs: folder-row.downs;
                                scroll: folder-pane.content-y;
                            }
                        }
                        if row.count >= 0: Text {
                            text: row.count;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
