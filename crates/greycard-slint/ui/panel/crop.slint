// The Crop tab's sections: the crop and its aspect, the rotation and
// the level, the perspective and its guide.

import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme, LabelColumn } from "../theme.slint";
import { Section, EditSlider, Steps, Toggle, PanelButton, Typing } from "../controls.slint";

export component CropSection inherits Section {
    in-out property <bool> crop-mode;
    in-out property <bool> level-mode;
    in-out property <string> guide-mode;
    in-out property <bool> collapsed-crop;
    in-out property <string> aspect-name;
    in-out property <string> aspect-custom;
    in-out property <bool> portrait;
    in property <bool> portrait-shown;
    in property <bool> portrait-live: true;
    // Draw in hand: the next drag on the picture, inside the crop
    // too, draws a fresh one (`Viewport.crop-draw-armed`).
    in-out property <bool> crop-draw-armed;
    // The guide drawn inside the crop, a view's and no part of the
    // edit (`Viewport.crop-overlay`); a choice is kept in the file.
    in-out property <string> crop-overlay;
    callback crop-overlay-chosen();
    callback crop-toggled();
    // The Crop button: the window's, which R shares.
    callback crop-clicked();
    callback geometry-changed();
    /// A change of the geometry over, after which the engine may be
    /// asked for a develop: a slider let go, an aspect typed and
    /// accepted or left.
    callback geometry-settled();
    /// The Custom aspect being typed: no develop while it is.
    in-out property <bool> aspect-typing;
    callback guide-dropped();
    // The keys to the window, so Escape puts a tool down wherever the
    // pointer is.
    callback focus-keys();

    // The custom aspect's box goes with "Custom", which a frame
    // change, an undo, or a paste can take away under its focus: a
    // box destroyed says nothing itself. Only that box: another
    // with the keys (the filter's) keeps them.
    property <bool> custom-focused: false;
    changed aspect-name => {
        if (root.aspect-name != "Custom" && root.custom-focused) {
            root.custom-focused = false;
            Typing.close-all();
        }
        // The box gone, what was typed in it is over.
        if (root.aspect-name != "Custom" && root.aspect-typing) {
            root.aspect-typing = false;
            root.geometry-settled();
        }
        aspect-box.current-index = root.aspect-index(root.aspect-name);
    }
    // The guides by their names, which the settings file keeps, in
    // the order O steps through them (`panel::crop::overlay`).
    property <[string]> overlays: ["Thirds", "Golden ratio", "Golden spiral", "Diagonals", "Triangles", "None"];
    pure function overlay-index(name: string) -> int {
        return name == "Thirds" ? 0 : name == "Golden ratio" ? 1 : name == "Golden spiral" ? 2
            : name == "Diagonals" ? 3 : name == "Triangles" ? 4 : name == "None" ? 5 : -1;
    }
    changed crop-overlay => { overlay-box.current-index = root.overlay-index(root.crop-overlay); }
    // The aspects by their names, which the edit keeps and the Rust
    // side compares; the box shows each in words, at the same index.
    property <[string]> aspects: ["Free", "Original", "1:1", "3:2", "4:3", "5:4", "16:9", "65:24", "Custom"];
    pure function aspect-index(name: string) -> int {
        return name == "Free" ? 0 : name == "Original" ? 1 : name == "1:1" ? 2 : name == "3:2" ? 3
            : name == "4:3" ? 4 : name == "5:4" ? 5 : name == "16:9" ? 6 : name == "65:24" ? 7
            : name == "Custom" ? 8 : -1;
    }

    title: @tr("CROP");
    icon: @image-url("../icons/crop.svg");
    collapsed <=> root.collapsed-crop;
    VerticalLayout {
        spacing: Theme.space-2;
        HorizontalLayout {
            spacing: Theme.space-2;
            crop-done-button := PanelButton {
                // Crop section: the button that leaves the crop
                text: root.crop-mode ? @tr("Done") : @tr("Crop");
                icon: @image-url("../icons/crop.svg");
                primary: root.crop-mode;
                clicked => { root.crop-clicked(); }
            }
            // A crop at the whole frame leaves nowhere outside it to
            // start a drag, and a drag inside moves it: this one shot
            // makes the next drag draw wherever it starts. As the Level
            // does, it brings crop mode with it.
            draw-button := PanelButton {
                // Crop section: the button that starts a new crop drawn by hand
                text: @tr("Draw");
                icon: @image-url("../icons/pencil.svg");
                primary: root.crop-draw-armed;
                clicked => {
                    if (!root.crop-mode) { root.crop-mode = true; root.crop-toggled(); }
                    root.level-mode = false;
                    root.guide-mode = "";
                    root.guide-dropped();
                    root.crop-draw-armed = !root.crop-draw-armed;
                    root.focus-keys();
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            aspect-words := Text { accessible-role: none; text: @tr("Aspect"); width: LabelColumn.width; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
            aspect-box := ComboBox {
                accessible-label: aspect-words.text;
                // Crop aspect choices
                model: [@tr("Free"), @tr("aspect" => "Original"), "1:1", "3:2", "4:3", "5:4", "16:9", "65:24", @tr("Custom")];
                current-index: root.aspect-index(root.aspect-name);
                selected(v) => {
                    root.aspect-name = root.aspects[self.current-index];
                    root.geometry-changed();
                }
            }
        }
        if root.aspect-name == "Custom": HorizontalLayout {
            spacing: Theme.space-2;
            Text { text: @tr("Custom"); width: LabelColumn.width; color: Theme.text; font-size: Theme.font-sm; vertical-alignment: center; }
            custom-aspect-field := LineEdit {
                text <=> root.aspect-custom;
                placeholder-text: "W:H";
                accessible-label: @tr("Custom aspect");
                // Enter or Escape gives the keys back to the window.
                accepted(t) => {
                    root.aspect-typing = false;
                    root.geometry-changed();
                    Typing.done += 1;
                }
                edited(t) => {
                    root.aspect-typing = true;
                    root.geometry-changed();
                }
                key-pressed(e) => {
                    if (e.text == Key.Escape) { Typing.done += 1; return accept; }
                    return reject;
                }
                changed has-focus => {
                    root.custom-focused = self.has-focus;
                    Typing.box-focus(self.has-focus);
                    if (!self.has-focus && root.aspect-typing) {
                        root.aspect-typing = false;
                        root.geometry-settled();
                    }
                }
            }
        }
        // Shows whether the crop is tall, which is the stored flag but
        // under "Original" on a tall plane (see `portrait-shown`). A
        // click flips the flag, and so what is shown, either way. Under
        // Free nothing reads the flag, so the switch is greyed and a
        // click is nothing.
        portrait-toggle := Toggle {
            // Crop section: the toggle that stands the aspect upright
            label: @tr("Portrait");
            checked: root.portrait-shown;
            enabled: root.portrait-live;
            follows: true;
            toggled => {
                if (root.portrait-live) {
                    root.portrait = !root.portrait;
                    root.geometry-changed();
                }
            }
        }
        // The guide over the crop in crop mode: a view's, so the
        // edit and its history never hear of it.
        HorizontalLayout {
            spacing: Theme.space-2;
            overlay-words := Text {
                accessible-role: none;
                // Crop section: the list of composition guides over the crop
                text: @tr("Guides");
                width: LabelColumn.width;
                color: Theme.text;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
            overlay-box := ComboBox {
                accessible-label: overlay-words.text;
                // Crop section: composition guides drawn over the crop
                model: [@tr("Thirds"), @tr("Golden ratio"), @tr("Golden spiral"), @tr("Diagonals"),
                    @tr("Triangles"), @tr("crop guide" => "None")];
                current-index: root.overlay-index(root.crop-overlay);
                selected(v) => {
                    root.crop-overlay = root.overlays[self.current-index];
                    root.crop-overlay-chosen();
                }
            }
        }
    }
}

export component RotateSection inherits Section {
    callback frame-turned(int);
    in-out property <bool> crop-mode;
    in-out property <bool> level-mode;
    in-out property <string> guide-mode;
    in-out property <bool> collapsed-rotate;
    in-out property <float> geo-angle;
    /// The Angle slider being set, by drag, wheel, or key: the
    /// viewport lays its grid on.
    in-out property <bool> angle-moving;
    callback geometry-settled();
    callback geometry-turned(int);
    callback geometry-flipped(bool);
    callback crop-toggled();
    callback geometry-changed();
    callback guide-dropped();
    callback straightened();
    callback focus-keys();

    title: @tr("ROTATE");
    icon: @image-url("../icons/rotate-cw.svg");
    collapsed <=> root.collapsed-rotate;
    VerticalLayout {
        spacing: Theme.space-2;
        // The level drawn by hand, and found: the picture's dominant line
        // leveled as if it had been drawn.
        HorizontalLayout {
            spacing: Theme.space-2;
            level-button := PanelButton {
                // Rotate section: the button that takes the level tool in hand
                text: @tr("Level");
                icon: @image-url("../icons/ruler.svg");
                primary: root.level-mode;
                clicked => {
                    if (!root.crop-mode) { root.crop-mode = true; root.crop-toggled(); }
                    root.guide-mode = "";
                    root.guide-dropped();
                    root.level-mode = !root.level-mode;
                    root.focus-keys();
                }
            }
            PanelButton {
                text: @tr("Auto level");
                clicked => { root.straightened(); }
            }
        }
        // Quarter turns and mirrors.
        HorizontalLayout {
            spacing: Theme.space-2;
            PanelButton {
                text: "";
                icon: @image-url("../icons/rotate-ccw.svg");
                words: @tr("Rotate left: part of the edit");
                accessible-role: button;
                accessible-label: @tr("Rotate left");
                clicked => { root.geometry-turned(1); }
            }
            PanelButton {
                text: "";
                icon: @image-url("../icons/rotate-cw.svg");
                words: @tr("Rotate right: part of the edit");
                accessible-role: button;
                accessible-label: @tr("Rotate right");
                clicked => { root.geometry-turned(-1); }
            }
            flip-button := PanelButton {
                text: "";
                icon: @image-url("../icons/flip-horizontal.svg");
                // Rotate section: flip the frame left to right
                words: @tr("Flip");
                accessible-role: button;
                accessible-label: @tr("Flip");
                clicked => { root.geometry-flipped(false); }
            }
            PanelButton {
                text: "";
                icon: @image-url("../icons/flip-vertical.svg");
                // Rotate section: flip the frame top to bottom
                words: @tr("Flip vertical");
                accessible-role: button;
                accessible-label: @tr("Flip vertical");
                clicked => { root.geometry-flipped(true); }
            }
        }
        angle := EditSlider {
            label: @tr("Angle");
            minimum: -45;
            maximum: 45;
            default: 0;
            step: 0.1;
            steps: Steps.tenths;
            value <=> root.geo-angle;
            text: (root.geo-angle >= 0 ? "+" : "") + round(root.geo-angle * 10) / 10 + "°";
            // Said before the change, not after it as `changed moving`
            // would: the change's develop waits while the slider moves.
            changed(v) => {
                root.angle-moving = self.moving;
                root.geometry-changed();
            }
            changed moving => {
                root.angle-moving = self.moving;
                if (!self.moving) { root.geometry-settled(); }
            }
        }
        // The frame's own turn, under the edit's.
        // The four above are a step in developing
        // the picture; these two say the camera
        // recorded the wrong way up, so they are
        // no part of the edit.
        HorizontalLayout {
            spacing: Theme.space-2;
            PanelButton {
                text: @tr("Turn left");
                icon: @image-url("../icons/rotate-ccw.svg");
                words: @tr("Turn the frame left");
                clicked => { root.frame-turned(-1); }
            }
            PanelButton {
                text: @tr("Turn right");
                icon: @image-url("../icons/rotate-cw.svg");
                words: @tr("Turn the frame right");
                clicked => { root.frame-turned(1); }
            }
        }
        Text {
            text: @tr("Not part of the edit.");
            font-size: Theme.font-xs;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}

export component PerspectiveSection inherits Section {
    in-out property <bool> crop-mode;
    in-out property <bool> level-mode;
    in-out property <string> guide-mode;
    in-out property <bool> collapsed-perspective;
    in-out property <float> geo-vertical;
    in-out property <float> geo-horizontal;
    /// The Vertical or the Horizontal slider being set, as the Angle
    /// slider's `angle-moving`: the viewport lays its grid on.
    in-out property <bool> perspective-moving;
    callback geometry-settled();
    callback crop-toggled();
    callback geometry-changed();
    callback geometry-reset();
    callback guide-dropped();
    callback focus-keys();
    title: @tr("PERSPECTIVE");
    icon: @image-url("../icons/keystone.svg");
    collapsed <=> root.collapsed-perspective;
    VerticalLayout {
        spacing: Theme.space-2;
        // The guide: two strokes along lines of the
        // picture that should run one way give the
        // turn and that way's keystone at once.
        HorizontalLayout {
            spacing: Theme.space-2;
            verticals-button := PanelButton {
                // Perspective section: the slider
                text: @tr("Verticals");
                icon: @image-url("../icons/ruler.svg");
                primary: root.guide-mode == "Vertical";
                clicked => {
                    if (!root.crop-mode) { root.crop-mode = true; root.crop-toggled(); }
                    root.level-mode = false;
                    root.guide-dropped();
                    root.guide-mode = root.guide-mode == "Vertical" ? "" : "Vertical";
                    root.focus-keys();
                }
            }
            horizontals-button := PanelButton {
                // Perspective section: the slider
                text: @tr("Horizontals");
                icon: @image-url("../icons/ruler.svg");
                primary: root.guide-mode == "Horizontal";
                clicked => {
                    if (!root.crop-mode) { root.crop-mode = true; root.crop-toggled(); }
                    root.level-mode = false;
                    root.guide-dropped();
                    root.guide-mode = root.guide-mode == "Horizontal" ? "" : "Horizontal";
                    root.focus-keys();
                }
            }
        }
        VerticalLayout {
            vertical := EditSlider {
                // Perspective section: the slider
                label: @tr("Vertical");
                minimum: -40;
                maximum: 40;
                default: 0;
                step: 0.1;
                steps: Steps.tenths;
                value <=> root.geo-vertical;
                text: (root.geo-vertical >= 0 ? "+" : "") + round(root.geo-vertical * 10) / 10 + "°";
                changed(v) => {
                    root.perspective-moving = self.moving || horizontal.moving;
                    root.geometry-changed();
                }
                changed moving => {
                    root.perspective-moving = self.moving || horizontal.moving;
                    if (!root.perspective-moving) { root.geometry-settled(); }
                }
            }
            horizontal := EditSlider {
                // Perspective section: the slider
                label: @tr("Horizontal");
                minimum: -40;
                maximum: 40;
                default: 0;
                step: 0.1;
                steps: Steps.tenths;
                value <=> root.geo-horizontal;
                text: (root.geo-horizontal >= 0 ? "+" : "") + round(root.geo-horizontal * 10) / 10 + "°";
                changed(v) => {
                    root.perspective-moving = self.moving || vertical.moving;
                    root.geometry-changed();
                }
                changed moving => {
                    root.perspective-moving = self.moving || vertical.moving;
                    if (!root.perspective-moving) { root.geometry-settled(); }
                }
            }
        }
        // The whole of the Crop tab goes back at
        // once, from the end of it: the three
        // sections are one edit, and a Reset inside
        // any one of them would read as that one's.
        reset-all-button := PanelButton {
            text: @tr("Reset all");
            icon: @image-url("../icons/undo-2.svg");
            clicked => { root.geometry-reset(); }
        }
    }
}
