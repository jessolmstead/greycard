// The top of the panel, pinned over the sections: the file and what it
// was shot at, the undo and redo buttons, and the scopes.

import { Theme } from "../theme.slint";
import { PanelButton, Segmented, ClipMark } from "../controls.slint";
import { ScopeMark } from "../structs.slint";

export component PanelHead inherits VerticalLayout {
    in-out property <bool> culling;
    in property <string> file-name;
    /// The camera's JPEG beside the raw, in words; empty for none.
    in property <string> file-companion;
    in property <string> shot-camera;
    in property <string> shot-exposure;
    in property <string> shot-size;
    in property <string> shot-time;
    in property <image> scope-picture;
    in property <[string]> scopes;
    in-out property <string> scope;
    callback scope-changed(string);
    // The color under the pointer on the picture: where it lands on
    // the scope, and its levels in words; empty for none.
    in property <[ScopeMark]> scope-marks;
    in property <string> scope-readout;
    // With Selection on, the pointer is outside the mask: its pixel is
    // counted on no trace, so its marks show faded, where it would sit
    // against the selection's, and its numbers dimmed.
    in property <bool> scope-marks-outside;
    // A channel's color for its mark, bright enough to read over the
    // trace it sits on; the luma's is white.
    pure function mark-tone(channel: int) -> color {
        return channel == 0 ? #ff5a5a : channel == 1 ? #5ae05a : channel == 2 ? #6a9cff : #ffffff;
    }
    // The scopes weighed by the chosen adjustment's mask: off by
    // default, for the session only, and greyed while there is no
    // mask to weigh by.
    in-out property <bool> scope-selection;
    in property <bool> scope-mask-active;
    callback scope-selection-changed();
    in property <bool> clip-shadows-lit;
    in property <color> clip-shadows-mark;
    in property <bool> clip-highlights-lit;
    in property <color> clip-highlights-mark;
    in-out property <bool> warn-shadows;
    in-out property <bool> warn-highlights;
    callback warn-changed();
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();
    /// How many frames are selected, the one on screen among them:
    /// over one, the Sync button, Ctrl+Shift+S's sheet.
    in property <int> set-count;
    callback sync-asked();

    // While the vectorscope shows, the shot's lines fold away to make
    // room for its circle; the file's name and the undo buttons stay.
    property <bool> shot-folded: !root.culling && root.scope == "Vector";

    padding-left: Theme.space-4;
    padding-right: Theme.space-4;
    padding-top: Theme.space-4;
    spacing: Theme.space-2;
    // The file and what it was shot at, as one
    // caption: the name, then the body and its
    // lens, then the exposure triangle, which
    // wants two lines since the whole of it does
    // not fit the panel's width. Both lines keep
    // their height when the file says nothing, so
    // the panel below does not jump between one
    // picture and the next. The vectorscope folds
    // them away (`shot-folded`).
    VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: Theme.space-2;
            Text {
                text: root.file-name;
                color: Theme.text;
                font-size: Theme.font-lg;
                font-weight: Theme.weight-semibold;
                overflow: elide;
                vertical-alignment: center;
            }
            PanelButton {
                icon: @image-url("../icons/rotate-ccw.svg");
                words: "Undo";
                accessible-role: button;
                accessible-label: "Undo";
                accessible-action-default => { root.undo(); }
                enabled: root.can-undo;
                width: Theme.control-height + Theme.space-2;
                clicked => { root.undo(); }
            }
            PanelButton {
                icon: @image-url("../icons/rotate-cw.svg");
                words: "Redo";
                accessible-role: button;
                accessible-label: "Redo";
                accessible-action-default => { root.redo(); }
                enabled: root.can-redo;
                width: Theme.control-height + Theme.space-2;
                clicked => { root.redo(); }
            }
        }
        if !root.shot-folded: Text {
            text: root.shot-camera;
            height: 16px;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }
        if !root.shot-folded: Text {
            text: root.shot-exposure;
            height: 16px;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }
        if !root.shot-folded: Text {
            text: root.shot-size;
            height: 16px;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }
        if !root.shot-folded && root.shot-time != "": Text {
            text: root.shot-time;
            height: 16px;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }
        if !root.shot-folded && root.file-companion != "": Text {
            text: root.file-companion;
            height: 16px;
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            overflow: elide;
        }
    }
    // A batch edit, where a hand from Lightroom looks for it: with
    // frames chosen beside this one, the sheet that lays this one's
    // settings over them, which Ctrl+Shift+S and the frame menu open
    // too, and whose words these are.
    if root.set-count > 1: PanelButton {
        text: "Sync " + (root.set-count - 1)
            + (root.set-count == 2 ? " frame to this one..." : " frames to this one...");
        icon: @image-url("../icons/layers.svg");
        accessible-role: button;
        accessible-label: "Sync";
        accessible-action-default => { root.sync-asked(); }
        clicked => { root.sync-asked(); }
    }
    // The scopes read the develop; in culling
    // there is none, and they are not shown.
    if !root.culling: VerticalLayout {
        spacing: Theme.space-1;
        scope-box := Rectangle {
            // A waveform wants height to hold its trace apart; the
            // histogram is low. The vectorscope's circle sits square in
            // the middle, 180 px across, with the shot's lines folded
            // away to make room for it, so the panel below moves by
            // tens of pixels when it is chosen rather than a hundred.
            height: root.scope == "Vector" ? 180px
                : (root.scope == "RGB" ? 84px : 144px);
            border-radius: Theme.radius-md;
            background: Theme.base;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            // What the scope's picture fills, and its marks are placed
            // on as fractions of.
            scope-plot := Rectangle {
                width: root.scope == "Vector" ? min(parent.height, parent.width) : parent.width;
                height: parent.height;
                Image {
                    source: root.scope-picture;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    image-fit: fill;
                    image-rendering: smooth;
                }
                // The color under the pointer in numbers, drawn before
                // its marks so they lie over it: a mark at the top of
                // the trace is never hidden.
                if root.scope-readout != "": Rectangle {
                    y: 3px;
                    width: readout.preferred-width + 2 * Theme.space-2;
                    height: readout.preferred-height + 2px;
                    border-radius: Theme.radius-sm;
                    background: Theme.base.with-alpha(0.85);
                    readout := Text {
                        text: root.scope-readout;
                        color: root.scope-marks-outside ? Theme.text-secondary : Theme.text;
                        font-size: Theme.font-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // The color under the pointer: a line on the histogram
                // through each channel's bar and the luma's level, a
                // dot on the others where the pixel's cell is. Each has
                // a dark edge, since it sits on the trace of its own
                // color: the vectorscope's white ring a dark one just
                // outside it.
                for m in root.scope-marks: Rectangle {
                    property <length> cx: 1px + m.x * (parent.width - 2px);
                    property <length> cy: 1px + m.y * (parent.height - 2px);
                    property <bool> line: root.scope == "RGB";
                    property <length> size: self.line ? 3px : (m.channel == 3 ? 9px : 7px);
                    x: self.cx - self.size / 2;
                    y: self.line ? 1px : self.cy - self.size / 2;
                    width: self.size;
                    height: self.line ? parent.height - 2px : self.size;
                    border-radius: self.line ? 0 : self.size / 2;
                    background: self.line ? #000000a0 : (m.channel == 3 ? transparent : root.mark-tone(m.channel));
                    border-width: self.line ? 0 : (m.channel == 3 ? 2px : 1px);
                    border-color: m.channel == 3 ? root.mark-tone(3) : #000000c0;
                    opacity: root.scope-marks-outside ? 0.4 : 1;
                    animate x, y { duration: 120ms; easing: ease-out; }
                    if root.scope == "RGB": Rectangle {
                        x: 1px;
                        width: 1px;
                        background: root.mark-tone(m.channel);
                    }
                    if root.scope == "Vector": Rectangle {
                        x: -1px;
                        y: -1px;
                        width: parent.width + 2px;
                        height: parent.height + 2px;
                        border-radius: self.width / 2;
                        border-width: 1px;
                        border-color: #000000c0;
                    }
                }
            }
            if root.scope == "RGB": ClipMark {
                x: 1px;
                y: 1px;
                lit: root.clip-shadows-lit;
                mark: root.clip-shadows-mark;
                on: root.warn-shadows;
                clicked => {
                    root.warn-shadows = !root.warn-shadows;
                    root.warn-changed();
                }
            }
            if root.scope == "RGB": ClipMark {
                x: parent.width - self.width - 1px;
                y: 1px;
                lit: root.clip-highlights-lit;
                mark: root.clip-highlights-mark;
                on: root.warn-highlights;
                clicked => {
                    root.warn-highlights = !root.warn-highlights;
                    root.warn-changed();
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-1;
            Segmented {
                horizontal-stretch: 1;
                options: root.scopes;
                current <=> root.scope;
                selected(name) => { root.scope-changed(name); }
            }
            // Selection: every bin weighed by the mask, so a skin mask
            // shows the skin cloud on the vectorscope and a face its
            // level on the waveform.
            Rectangle {
                property <bool> on: root.scope-selection && root.scope-mask-active;
                horizontal-stretch: 0;
                width: selection-label.preferred-width + 2 * Theme.space-2;
                height: Theme.control-height;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border;
                background: self.on ? Theme.raised
                    : (selection-touch.has-hover && root.scope-mask-active ? Theme.hover : Theme.base);
                opacity: root.scope-mask-active ? 1 : 0.45;
                animate background { duration: Theme.quick; }
                selection-label := Text {
                    text: "Selection";
                    color: parent.on ? Theme.text : Theme.text-secondary;
                    font-size: Theme.font-xs;
                    font-weight: parent.on ? Theme.weight-medium : Theme.weight-regular;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                selection-touch := TouchArea {
                    enabled: root.scope-mask-active;
                    mouse-cursor: root.scope-mask-active ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        root.scope-selection = !root.scope-selection;
                        root.scope-selection-changed();
                    }
                }
            }
        }
    }
}
