// The develop sections that are sliders on the edit and nothing else:
// light, noise, detail, sharpening, the vignette, grain, the demosaic.

import { Theme } from "../theme.slint";
import { Section, EditSlider, Steps, Toggle, Segmented, PanelButton } from "../controls.slint";

export component LightSection inherits Section {
    in-out property <float> exposure;
    in-out property <float> contrast;
    in-out property <float> highlights;
    in-out property <float> midtones;
    in-out property <float> shadows;
    in-out property <float> whites;
    in-out property <float> blacks;
    in-out property <bool> light-enabled;
    // The display curve: per channel, on a norm with the hue held as a
    // color rolls off to white, or AgX; named as `DisplayCurve::name`
    // names them. The picture's, not a mask's, and a raw's only: shown
    // on the global look of a raw.
    in-out property <string> display-curve;
    in property <bool> show-display-curve;
    in-out property <bool> collapsed-light;
    in-out property <string> target-name;
    /// The open frame is a raw, which Auto reads.
    in property <bool> raw-input;
    /// The picture's light, not a mask's: Auto sets the former only.
    in property <bool> auto-shown;
    callback view-changed();
    callback light-auto();

    title: @tr("LIGHT");
    owner: root.target-name;
    icon: @image-url("../icons/sun.svg");
    collapsed <=> root.collapsed-light;
    switchable: true;
    on <=> root.light-enabled;
    switched => { root.view-changed(); }
    EditSlider {
        label: @tr("Exposure");
        minimum: -5;
        maximum: 5;
        default: 0;
        step: 0.05;
        steps: Steps.exposure;
        value <=> root.exposure;
        text: (root.exposure >= 0 ? "+" : "") + round(root.exposure * 100) / 100 + " EV";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Contrast");
        logarithmic: true;
        minimum: 0.5;
        maximum: 2;
        default: 1;
        step: 0.02;
        steps: Steps.contrast;
        value <=> root.contrast;
        text: round(root.contrast * 100) / 100;
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Highlights");
        minimum: -2;
        maximum: 2;
        default: 0;
        step: 0.05;
        steps: Steps.tone;
        value <=> root.highlights;
        text: (root.highlights >= 0 ? "+" : "") + round(root.highlights * 100) / 100 + " EV";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Midtones");
        minimum: -2;
        maximum: 2;
        default: 0;
        step: 0.05;
        steps: Steps.tone;
        value <=> root.midtones;
        text: (root.midtones >= 0 ? "+" : "") + round(root.midtones * 100) / 100 + " EV";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Shadows");
        minimum: -2;
        maximum: 2;
        default: 0;
        step: 0.05;
        steps: Steps.tone;
        value <=> root.shadows;
        text: (root.shadows >= 0 ? "+" : "") + round(root.shadows * 100) / 100 + " EV";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Whites");
        minimum: -2;
        maximum: 2;
        default: 0;
        step: 0.05;
        steps: Steps.tone;
        value <=> root.whites;
        text: (root.whites >= 0 ? "+" : "") + round(root.whites * 100) / 100 + " EV";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Blacks");
        minimum: -0.3;
        maximum: 0.3;
        default: 0;
        step: 0.01;
        steps: Steps.blacks;
        value <=> root.blacks;
        scale: 100;
        text: (root.blacks >= 0 ? "+" : "") + round(root.blacks * 100) + "%";
        changed(v) => { root.view-changed(); }
    }
    // Exposure, Highlights, Shadows, Whites, and Blacks from the
    // frame's own histogram.
    if root.auto-shown: HorizontalLayout {
        spacing: Theme.space-2;
        padding-top: Theme.space-1;
        alignment: end;
        PanelButton {
            text: @tr("Auto");
            enabled: root.raw-input;
            clicked => { root.light-auto(); }
        }
    }
    if root.show-display-curve: VerticalLayout {
        spacing: 4px;
        Text {
            text: @tr("Display curve");
            color: Theme.text;
            font-size: Theme.font-sm;
        }
        Segmented {
            options: ["Per channel", "AgX"];
            labels: [@tr("Per channel"), "AgX"];
            equal-width: true;
            current <=> root.display-curve;
            selected(v) => { root.view-changed(); }
        }
    }
}

// The learned blend's chroma slider's name, in one place so it is
// renamed in one place: the Rust side's is `greycard_edit::LEARNED_CHROMA`,
// and a test holds the two to the same word.
export global NoiseWords {
    out property <string> chroma: @tr("Chroma");
}

export component NoiseSection inherits Section {
    in-out property <bool> noise-enabled;
    in-out property <bool> collapsed-noise;
    in-out property <bool> denoise;
    in-out property <float> denoise-strength;
    in-out property <string> denoise-learned;
    in property <[string]> denoise-tiers;
    in-out property <float> denoise-learned-strength;
    in-out property <float> denoise-learned-chroma-strength;
    // Why the section rests, or "" when it does not.
    in property <string> unavailable;
    // Why the learned tiers rest (an X-Trans raw), or "" when they do
    // not; the profiled denoise is unaffected.
    in property <string> learned-unavailable;
    // A merge of ours whose frames are beside it as merged, and that
    // the learned denoiser takes: it can be made again from its recipe,
    // the frames denoised at `again-tier`, the window's and not the
    // edit's.
    in property <bool> again-shown;
    in-out property <string> again-tier;
    // The row is up, and its picker stands in for the section's: on a
    // merge the edit's tier steers no develop.
    property <bool> again: root.again-shown && root.learned-unavailable == "";
    // A merge is running: none other is asked from here.
    in property <bool> merging;
    callback develop-changed();
    callback merge-again();

    title: @tr("NOISE");
    icon: @image-url("../icons/sparkles.svg");
    hint: root.unavailable != "" ? root.unavailable : root.learned-unavailable;
    collapsed <=> root.collapsed-noise;
    switchable: true;
    on <=> root.noise-enabled;
    switched => { root.develop-changed(); }
    // The learned denoiser stands in for the
    // demosaic and the profiled denoise both. Where it rests, a tier
    // already set (a sync from a Bayer frame) can still be turned off,
    // and off and that tier are all it offers: no other is reachable.
    if !root.again: VerticalLayout {
        padding-bottom: Theme.space-1;
        Segmented {
            options: root.learned-unavailable == "" ? root.denoise-tiers
                : root.denoise-learned == "off" ? ["off"] : ["off", root.denoise-learned];
            // The tiers' names are the values; only the "off" this side
            // adds is shown in words of its own.
            labels: root.learned-unavailable == "" ? []
                // Noise: the learned denoiser's choice when it is off
                : root.denoise-learned == "off" ? [@tr("off")] : [@tr("off"), root.denoise-learned];
            enabled: root.unavailable == "" && (root.learned-unavailable == "" || root.denoise-learned != "off");
            current <=> root.denoise-learned;
            selected(v) => { root.develop-changed(); }
        }
    }
    EditSlider {
        label: @tr("Luma");
        enabled: root.unavailable == "" && root.learned-unavailable == "" && root.denoise-learned != "off";
        minimum: 0;
        maximum: 1;
        default: 1;
        step: 0.05;
        steps: Steps.percent;
        value <=> root.denoise-learned-strength;
        scale: 100;
        text: round(root.denoise-learned-strength * 100) + "%";
        changed(v) => { root.develop-changed(); }
    }
    // The blend's chroma alone: the color noise can go while the
    // grain stays.
    EditSlider {
        label: NoiseWords.chroma;
        enabled: root.unavailable == "" && root.learned-unavailable == "" && root.denoise-learned != "off";
        minimum: 0;
        maximum: 1;
        default: 1;
        step: 0.05;
        steps: Steps.percent;
        value <=> root.denoise-learned-chroma-strength;
        scale: 100;
        text: round(root.denoise-learned-chroma-strength * 100) + "%";
        changed(v) => { root.develop-changed(); }
    }
    // The learned tier on a merge acts on no develop of it: it is the
    // file written again, so a row of its own.
    if root.again: VerticalLayout {
        spacing: 4px;
        Segmented {
            options: root.denoise-tiers;
            enabled: root.unavailable == "" && !root.merging;
            current <=> root.again-tier;
        }
        PanelButton {
            text: @tr("Denoise the frames and merge again");
            enabled: root.unavailable == "" && !root.merging;
            clicked => { root.merge-again(); }
        }
    }
    Toggle {
        label: @tr("Denoise");
        enabled: root.unavailable == "" && root.denoise-learned == "off";
        checked <=> root.denoise;
        toggled => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Strength");
        enabled: root.unavailable == "" && root.denoise && root.denoise-learned == "off";
        minimum: 0.5;
        maximum: 3;
        default: 1.5;
        step: 0.05;
        steps: Steps.twentieths;
        value <=> root.denoise-strength;
        text: round(root.denoise-strength * 100) / 100;
        changed(v) => { root.develop-changed(); }
    }
}

// The Detail section's widest band's name, in one place so it is
// renamed in one place: the Rust side's is `greycard_edit::STRUCTURE`,
// and a test holds the two to the same word.
export global DetailWords {
    // Noise: the slider
    out property <string> structure: @tr("Structure");
}

export component DetailSection inherits Section {
    in-out property <bool> collapsed-detail;
    // A mask's own Detail names the mask it is under, as the other
    // sections of its look do; empty for the picture's.
    in-out property <string> target-name;
    in-out property <bool> detail-enabled;
    in-out property <float> detail-texture;
    in-out property <float> detail-clarity;
    in-out property <float> detail-structure;
    in-out property <float> detail-dehaze;
    // A mask's share of the capture sharpen, shown only on a mask's
    // Detail: the picture's sharpen is its own section.
    in property <bool> local;
    in-out property <float> detail-sharpen;
    callback develop-changed();

    title: @tr("DETAIL");
    icon: @image-url("../icons/blend.svg");
    owner: root.target-name;
    collapsed <=> root.collapsed-detail;
    switchable: true;
    on <=> root.detail-enabled;
    switched => { root.develop-changed(); }
    EditSlider {
        label: @tr("Texture");
        enabled: root.detail-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.detail-texture;
        scale: 100;
        text: (root.detail-texture >= 0 ? "+" : "") + round(root.detail-texture * 100);
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Clarity");
        enabled: root.detail-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.detail-clarity;
        scale: 100;
        text: (root.detail-clarity >= 0 ? "+" : "") + round(root.detail-clarity * 100);
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: DetailWords.structure;
        enabled: root.detail-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.detail-structure;
        scale: 100;
        text: (root.detail-structure >= 0 ? "+" : "") + round(root.detail-structure * 100);
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Dehaze");
        enabled: root.detail-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.detail-dehaze;
        scale: 100;
        text: (root.detail-dehaze >= 0 ? "+" : "") + round(root.detail-dehaze * 100);
        changed(v) => { root.develop-changed(); }
    }
    if root.local: EditSlider {
        label: @tr("Sharpen");
        enabled: root.detail-enabled;
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.detail-sharpen;
        scale: 100;
        text: (root.detail-sharpen >= 0 ? "+" : "") + round(root.detail-sharpen * 100);
        changed(v) => { root.develop-changed(); }
    }
}

export component SharpenSection inherits Section {
    in-out property <bool> collapsed-sharpen;
    in-out property <bool> show-sharpen-mask;
    in-out property <bool> sharpen;
    in-out property <bool> sharpen-auto-radius;
    in-out property <float> sharpen-radius;
    in-out property <float> sharpen-iterations;
    in-out property <bool> sharpen-auto-threshold;
    in-out property <float> sharpen-threshold;
    in property <float> sharpen-measured-radius;
    in property <float> sharpen-measured-threshold;
    callback view-changed();
    callback develop-changed();

    title: @tr("SHARPEN");
    icon: @image-url("../icons/focus.svg");
    collapsed <=> root.collapsed-sharpen;
    switchable: true;
    on <=> root.sharpen;
    switched => { root.develop-changed(); }
    Toggle {
        label: @tr("Auto radius");
        enabled: root.sharpen;
        checked <=> root.sharpen-auto-radius;
        toggled => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Radius");
        enabled: root.sharpen && !root.sharpen-auto-radius;
        minimum: 0.4;
        maximum: 2;
        default: 0.75;
        step: 0.01;
        steps: Steps.hundredths;
        value <=> root.sharpen-radius;
        text: root.sharpen-auto-radius
            // Sharpen: the radius field's word while the radius is automatic
            ? (root.sharpen-measured-radius > 0 ? @tr("auto {}", round(root.sharpen-measured-radius * 100) / 100) : @tr("auto"))
            : round(root.sharpen-radius * 100) / 100;
        changed(v) => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Iterations");
        enabled: root.sharpen;
        minimum: 5;
        maximum: 50;
        default: 20;
        step: 1;
        steps: Steps.whole;
        value <=> root.sharpen-iterations;
        text: round(root.sharpen-iterations);
        changed(v) => { root.develop-changed(); }
    }
    Toggle {
        label: @tr("Auto threshold");
        enabled: root.sharpen;
        checked <=> root.sharpen-auto-threshold;
        toggled => { root.develop-changed(); }
    }
    EditSlider {
        label: @tr("Threshold");
        enabled: root.sharpen && !root.sharpen-auto-threshold;
        minimum: 0;
        maximum: 2;
        default: 0.1;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.sharpen-threshold;
        scale: 100;
        text: root.sharpen-auto-threshold
            ? @tr("auto {}", round(root.sharpen-measured-threshold * 100) + "%")
            : round(root.sharpen-threshold * 100) + "%";
        changed(v) => { root.develop-changed(); }
    }
    Toggle {
        // Sharpen: show where the sharpen lands
        label: @tr("Show mask");
        enabled: root.sharpen;
        checked <=> root.show-sharpen-mask;
        toggled => { root.view-changed(); }
    }
}

export component VignetteSection inherits Section {
    in-out property <bool> vignette-enabled;
    in-out property <bool> collapsed-vignette;
    in-out property <float> vignette-amount;
    in-out property <float> vignette-midpoint;
    in-out property <float> vignette-feather;
    in-out property <float> vignette-roundness;
    callback view-changed();

    title: @tr("VIGNETTE");
    icon: @image-url("../icons/circle-dashed.svg");
    collapsed <=> root.collapsed-vignette;
    switchable: true;
    on <=> root.vignette-enabled;
    switched => { root.view-changed(); }
    EditSlider {
        label: @tr("Amount");
        minimum: -5;
        maximum: 5;
        default: 0;
        step: 0.05;
        steps: Steps.exposure;
        value <=> root.vignette-amount;
        text: (root.vignette-amount >= 0 ? "+" : "") + round(root.vignette-amount * 100) / 100 + " EV";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Midpoint");
        minimum: 0;
        maximum: 1;
        default: 0.5;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.vignette-midpoint;
        scale: 100;
        text: round(root.vignette-midpoint * 100) + "%";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Feather");
        minimum: 0;
        maximum: 1;
        default: 0.5;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.vignette-feather;
        scale: 100;
        text: round(root.vignette-feather * 100) + "%";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Roundness");
        minimum: -1;
        maximum: 1;
        default: 0;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.vignette-roundness;
        scale: 100;
        text: (root.vignette-roundness >= 0 ? "+" : "") + round(root.vignette-roundness * 100);
        changed(v) => { root.view-changed(); }
    }
}

export component GrainSection inherits Section {
    in-out property <bool> grain-enabled;
    in-out property <bool> collapsed-grain;
    in-out property <float> grain-amount;
    in-out property <float> grain-size;
    in-out property <string> grain-kind;
    callback view-changed();

    title: @tr("GRAIN");
    icon: @image-url("../icons/grip.svg");
    collapsed <=> root.collapsed-grain;
    switchable: true;
    on <=> root.grain-enabled;
    switched => { root.view-changed(); }
    EditSlider {
        label: @tr("Amount");
        minimum: 0;
        maximum: 1;
        default: 0;
        step: 0.01;
        steps: Steps.percent;
        value <=> root.grain-amount;
        scale: 100;
        text: round(root.grain-amount * 100) + "%";
        changed(v) => { root.view-changed(); }
    }
    EditSlider {
        label: @tr("Size");
        minimum: 0.1;
        maximum: 2;
        default: 0.5;
        step: 0.01;
        steps: Steps.hundredths;
        value <=> root.grain-size;
        text: round(root.grain-size * 100) / 100 + "\u{2030}";
        changed(v) => { root.view-changed(); }
    }
    Rectangle { height: Theme.space-1; }
    Segmented {
        options: ["Cubic", "Tabular"];
        // Grain: the two kinds of grain
        labels: [@tr("Cubic"), @tr("Tabular")];
        current <=> root.grain-kind;
        selected(k) => { root.view-changed(); }
    }
}

export component DemosaicSection inherits Section {
    in-out property <bool> collapsed-demosaic;
    in property <bool> raw-input;
    in property <string> source-note;
    in-out property <string> demosaic;
    in property <[string]> demosaics;
    // Why the menu rests (the raw's mosaic not read yet), or "".
    in property <string> menu-hint;
    // A pick from the menu: the window stores it in the edit.
    callback picked(string);

    title: @tr("DEMOSAIC");
    icon: @image-url("../icons/grid-2x2.svg");
    hint: root.raw-input ? root.menu-hint : @tr("raw only");
    collapsed <=> root.collapsed-demosaic;
    if root.raw-input: Segmented {
        options: root.demosaics;
        enabled: root.menu-hint == "";
        current <=> root.demosaic;
        selected(v) => { root.picked(v); }
    }
    if !root.raw-input: Text {
        text: root.source-note;
        color: Theme.text-secondary;
        font-size: Theme.font-sm;
        wrap: word-wrap;
    }
}
