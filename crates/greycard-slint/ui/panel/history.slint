// The left bar's record of the edit: the snapshots kept by name, and
// the history's steps.

import { LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Section, PanelButton, TipArea, ScrollPane } from "../controls.slint";
import { HistoryRow } from "../structs.slint";

/// A snapshot row's icon: its picture, lit under the pointer, and
/// named for what a click on it does, which is also how the tests
/// find it.
component SnapshotIcon inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    /// Hover text at the pointer, a word or two, once the pointer has
    /// rested on the icon for a moment (`TipArea`). The label stays
    /// the screen reader's, with the name in it.
    in property <string> words;
    width: Theme.control-height - 4px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Image {
        source: root.icon;
        colorize: ta.has-hover ? Theme.text : Theme.text-muted;
        width: Theme.icon;
        height: Theme.icon;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TipArea {
        words: root.words;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component SnapshotsSection inherits Section {
    in-out property <int> selected;
    in-out property <[string]> snapshot-names;
    in-out property <int> snapshot-editing;
    callback snapshot-taken();
    callback snapshot-restored(int);
    /// The row under the pointer (-1 for none), and the part of it:
    /// "row", "restore", "rename" or "remove".
    callback snapshot-hovered(int, string);
    callback snapshot-renamed(int, string);
    callback snapshot-deleted(int);
    in-out property <bool> collapsed-snapshots;

    /// A click on a row restores it, but not at once: a double-click
    /// renames, and its first click is a click too. So the restore
    /// waits out the double-click's window, and a second click inside
    /// it takes the restore back and renames instead. Slint counts a
    /// second click by its press, within its click interval (500 ms;
    /// no backend we run on changes it) of the first press, and
    /// reports the double-click only at its release. So every press
    /// on the row stops the wait and only a release starts it: a
    /// second press, however late in the window and however long it
    /// is held, finds the restore not yet made.
    ///
    /// A restore still waiting is for the frame it was clicked on:
    /// another frame chosen in the meantime drops it.
    property <int> restore-pending: -1;
    function hold-restore() {
        root.restore-pending = -1;
        restore-wait.running = false;
    }
    restore-wait := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.restore-pending >= 0) {
                let i = root.restore-pending;
                root.restore-pending = -1;
                root.snapshot-restored(i);
            }
        }
    }
    changed selected => { root.hold-restore(); }

    title: "SNAPSHOTS";
    icon: @image-url("../icons/image.svg");
    collapsed <=> root.collapsed-snapshots;
    if root.snapshot-names.length > 0: Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.border;
        // As the presets' and the history's box: the list's height up
        // to 200 px, so a long run of snapshots never pushes the pane
        // past the window (and the window past the screen). The pane
        // scrolls around this section rather than the other way, so
        // the box never squeezes a row to make room.
        preferred-height: min(snapshot-list.preferred-height, 200px);
        max-height: self.preferred-height;
        vertical-stretch: 1;
        ScrollPane {
            snapshot-list := VerticalLayout {
                padding: 2px;
                spacing: 2px;
                for name[i] in root.snapshot-names: snapshot-box := Rectangle {
                    // What the pointer is over: the row, one of its
                    // icons, or nothing. The status line names what a
                    // click there does.
                    property <string> part: restore.hovered ? "restore"
                        : rename.hovered ? "rename"
                        : bin.hovered ? "remove"
                        : snapshot-row.has-hover ? "row" : "";
                    changed part => { root.snapshot-hovered(self.part == "" ? -1 : i, self.part); }
                    height: Theme.control-height;
                    border-radius: Theme.radius-sm;
                    background: self.part != "" ? Theme.hover : transparent;
                    animate background { duration: Theme.quick; }
                    snapshot-row := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        enabled: root.selected >= 0 && root.snapshot-editing != i;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) { root.hold-restore(); }
                        }
                        clicked => {
                            root.restore-pending = i;
                            restore-wait.running = true;
                            restore-wait.restart();
                        }
                        // Not while another row's name is being typed:
                        // its text box would go without ending the
                        // naming, and what was typed would go with it.
                        double-clicked => {
                            root.hold-restore();
                            if (root.snapshot-editing >= 0) { return; }
                            root.snapshot-editing = i;
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        // Clears the scroll bar's band so an
                        // overflowing list never lets the bin's hit
                        // area sit under it.
                        padding-right: Theme.space-1 + Theme.scrollbar-band;
                        spacing: 0px;
                        if root.snapshot-editing == i: LineEdit {
                            text: name;
                            font-size: Theme.font-xs;
                            horizontal-stretch: 1;
                            accepted(t) => {
                                root.snapshot-editing = -1;
                                root.snapshot-renamed(i, t);
                            }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) { root.snapshot-editing = -1; return accept; }
                                return reject;
                            }
                            // A click anywhere else ends the naming
                            // and keeps what was typed, as Enter does:
                            // left open, the row took every later
                            // click as a name to edit and could not be
                            // restored.
                            changed has-focus => {
                                if (!self.has-focus && root.snapshot-editing == i) {
                                    root.snapshot-editing = -1;
                                    root.snapshot-renamed(i, self.text);
                                }
                            }
                            init => { self.focus(); self.select-all(); }
                        }
                        if root.snapshot-editing != i: Text {
                            text: name;
                            color: snapshot-box.part != "" ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        // The row is the only way back to a snapshot,
                        // so what a click does is on it in pictures:
                        // back to it, a new name, away. The rename
                        // icon names it without restoring it.
                        restore := SnapshotIcon {
                            icon: @image-url("../icons/undo-2.svg");
                            label: "Restore " + name;
                            words: "Restore";
                            clicked => {
                                root.hold-restore();
                                if (root.selected >= 0) { root.snapshot-restored(i); }
                            }
                        }
                        rename := SnapshotIcon {
                            icon: @image-url("../icons/pencil.svg");
                            label: "Rename " + name;
                            words: "Rename";
                            // As the double-click: never over another
                            // row's name being typed.
                            clicked => {
                                root.hold-restore();
                                if (root.snapshot-editing >= 0) { return; }
                                root.snapshot-editing = i;
                            }
                        }
                        bin := SnapshotIcon {
                            icon: @image-url("../icons/trash-2.svg");
                            label: "Remove " + name;
                            words: "Remove";
                            clicked => {
                                root.hold-restore();
                                root.snapshot-deleted(i);
                            }
                        }
                    }
                }
            }
        }
    }
    if root.snapshot-names.length == 0: Text {
        text: "None yet.";
        font-size: Theme.font-xs;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
    PanelButton {
        text: "Take";
        icon: @image-url("../icons/plus.svg");
        enabled: root.selected >= 0;
        clicked => { root.snapshot-taken(); }
    }
}

export component HistorySection inherits Section {
    in-out property <[HistoryRow]> history-rows;
    in-out property <int> history-current;
    callback history-clicked(int);
    callback history-hovered(int);
    in-out property <bool> collapsed-history;

    title: "HISTORY";
    icon: @image-url("../icons/undo-2.svg");
    collapsed <=> root.collapsed-history;
    if root.history-rows.length > 0: Rectangle {
        border-radius: Theme.radius-md;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.border;
        // Its list's height up to 260 px, the rest a scroll away, so
        // a long history never pushes the pane past the window. The
        // pane scrolls around this section rather than the other way,
        // so the box never squeezes a row to make room.
        preferred-height: min(history-list.preferred-height, 260px);
        max-height: self.preferred-height;
        // Three rows at least, whatever sits below the pane's
        // sections: the pane scrolls before this box shrinks past them.
        min-height: min(history-list.preferred-height, 3 * (Theme.control-height - 4px) + 4px);
        vertical-stretch: 1;
        ScrollPane {
            history-list := VerticalLayout {
                padding: 2px;
                spacing: 2px;
                for row[i] in root.history-rows: Rectangle {
                    height: Theme.control-height - 6px;
                    border-radius: Theme.radius-sm;
                    background: i == root.history-current ? Theme.selection
                        : history-row.has-hover ? Theme.hover : transparent;
                    animate background { duration: Theme.quick; }
                    history-row := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.history-clicked(i); }
                        changed has-hover => { root.history-hovered(self.has-hover ? i : -1); }
                    }
                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        // A row's words, and an export's time, clear the
                        // scroll bar's band, as the snapshots' bins do.
                        padding-right: Theme.space-1 + Theme.scrollbar-band;
                        spacing: Theme.space-1;
                        // An export is a record of what went out, not a
                        // change: the export's mark before its words,
                        // in italics, and when it was written after.
                        if row.exported: Rectangle {
                            width: 12px;
                            Image {
                                source: @image-url("../icons/image-down.svg");
                                colorize: Theme.text-muted;
                                width: 12px;
                                height: 12px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Text {
                            text: row.name;
                            // Muted when undone: a step waiting to be
                            // redone, or an export made from one. The
                            // current state's exports sit above its row
                            // and are as live as it is.
                            color: row.undone ? Theme.text-muted
                                : i == root.history-current ? Theme.text
                                : history-row.has-hover ? Theme.text : Theme.text-secondary;
                            font-size: Theme.font-xs;
                            font-italic: row.exported;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if row.exported: Text {
                            text: row.time;
                            color: Theme.text-muted;
                            font-size: Theme.font-xs;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
    if root.history-rows.length == 0: Text {
        text: "No changes yet.";
        font-size: Theme.font-xs;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
