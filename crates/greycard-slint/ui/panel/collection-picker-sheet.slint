// The full list of Add to collection destinations: All collections...
// on the frame menu. The shared sheet (`ChoiceSheet`), with New
// collection... beside Cancel. Rust narrows the list as the field is
// typed into (`panel::collections`).

import { PanelButton } from "../controls.slint";
import { ChoiceSheet } from "choice-sheet.slint";

export component CollectionPickerSheet inherits ChoiceSheet {
    callback make-new();
    title: @tr("Add to collection");
    placeholder: @tr("Search collections");
    none-text: @tr("No matching collections.");
    new-collection := PanelButton {
        text: @tr("New collection...");
        clicked => { root.make-new(); }
    }
}
