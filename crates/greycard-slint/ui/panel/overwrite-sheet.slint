// The overwrite sheet: an export whose policy is Overwrite, about to
// write over files that are there, names every one of them first.
// Keep both (the next free name, as Increment writes) is the default
// and Enter's; Overwrite is red, never the default and never Enter's:
// only a click reaches it (the delete sheet's rule).

import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PanelButton } from "../controls.slint";
import { DangerButton } from "delete-sheet.slint";

export component OverwriteSheet inherits Rectangle {
    in property <string> overwrite-title;
    /// The files that are there, one a line, by their whole paths.
    in property <[string]> overwrite-files;
    /// 0 no, 1 keep both, 2 overwrite.
    callback overwrite-answered(int);

    background: #000000a0;
    TouchArea { clicked => { root.overwrite-answered(0); } }
    Rectangle {
        width: 520px;
        height: sheet.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        TouchArea { }
        // The sheet takes the keys while it is up (§234): Escape is its
        // no, Enter its default, which is Keep both.
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.overwrite-answered(0);
                    return accept;
                }
                if (e.text == Key.Return && !e.repeat) {
                    root.overwrite-answered(1);
                    return accept;
                }
                return accept;
            }
            sheet := VerticalLayout {
                padding: Theme.space-5;
                spacing: Theme.space-3;
                Text {
                    text: root.overwrite-title;
                    font-size: Theme.font-lg;
                    font-weight: Theme.weight-medium;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.overwrite-files.length == 1
                        ? "Overwrite writes over this file:"
                        : "Overwrite writes over each of these files:";
                    font-size: Theme.font-sm;
                    color: Theme.text-secondary;
                }
                // Every file, however many: a long list scrolls.
                ScrollView {
                    height: min(list.preferred-height, 240px);
                    list := VerticalLayout {
                        spacing: Theme.space-1;
                        for file in root.overwrite-files: Text {
                            text: file;
                            font-size: Theme.font-xs;
                            color: Theme.text;
                            overflow: elide;
                        }
                    }
                }
                Text {
                    text: "Keep both writes each beside the one there, under the next free name.";
                    font-size: Theme.font-sm;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                Rectangle { height: Theme.space-2; }
                HorizontalLayout {
                    spacing: Theme.space-2;
                    PanelButton {
                        text: "Cancel";
                        clicked => { root.overwrite-answered(0); }
                    }
                    DangerButton {
                        text: "Overwrite";
                        icon: @image-url("../icons/save.svg");
                        clicked => { root.overwrite-answered(2); }
                    }
                    PanelButton {
                        text: "Keep both";
                        primary: true;
                        clicked => { root.overwrite-answered(1); }
                    }
                }
            }
        }
    }
}
