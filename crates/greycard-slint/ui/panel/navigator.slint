// The NAVIGATOR section: the whole frame, the part of it the view
// has, and a press or a drag to move the view there.

import { Theme } from "../theme.slint";
import { Section } from "../controls.slint";

export component NavigatorSection inherits Section {
    in property <string> zoom-text;
    in-out property <bool> collapsed-navigator;
    in property <image> navigator;
    in property <bool> nav-partial;
    in property <float> nav-left;
    in property <float> nav-top;
    in property <float> nav-width;
    in property <float> nav-height;
    // A frame is chosen, so its picture is here or on its way: the
    // box holds its place while there is none yet.
    in property <bool> reserve;
    callback navigate(float, float);
    callback focus-keys();

    title: @tr("NAVIGATOR");
    icon: @image-url("../icons/maximize.svg");
    note: root.zoom-text;
    collapsed <=> root.collapsed-navigator;
    // Keep the preview at the default panel's size when the left panel
    // grows. The full-width slot centers it and holds the same height
    // while a frame loads or changes orientation.
    if root.navigator.width > 0 || root.reserve: slot := Rectangle {
        width: 100%;
        height: min(self.width, 260px) / 1.5;
        held := Rectangle {
            x: (parent.width - self.width) / 2;
            width: min(parent.width, 260px);
            height: 100%;
            property <bool> has: root.navigator.width > 0;
            property <float> aspect: self.has ? root.navigator.width / max(1, root.navigator.height) : 1.5;
            property <length> shown-w: min(self.width, self.height * self.aspect);
            property <length> shown-h: self.shown-w / self.aspect;
            clip: true;
            shown := Rectangle {
                visible: parent.has;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.shown-w;
                height: parent.shown-h;
                Image {
                    source: root.navigator;
                    width: 100%;
                    height: 100%;
                    image-fit: fill;
                    image-rendering: smooth;
                }
                // Always here, drawn only when the view
                // shows less than the frame: a conditional
                // element appearing under this clip would not refresh
                // the renderer's cached layer.
                Rectangle {
                    x: root.nav-left * parent.width;
                    y: root.nav-top * parent.height;
                    width: root.nav-width * parent.width;
                    height: root.nav-height * parent.height;
                    border-width: root.nav-partial ? 1px : 0px;
                    border-color: Theme.over-text;
                    background: root.nav-partial ? #ffffff1a : transparent;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.focus-keys();
                            root.navigate(self.mouse-x / self.width, self.mouse-y / self.height);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.navigate(self.mouse-x / self.width, self.mouse-y / self.height);
                        }
                    }
                }
            }
        }
    }
}
