// The Lightroom catalog import: the catalog's roots and where each is
// now, the set its collections go under, then the import's dry run as
// the command prints it, then a write on its own thread and the report
// again with what was written. Over everything until closed, and while
// it writes.
//
// The roots and the report scroll between a head and a foot that stay:
// a catalog of many roots, or a long report, never puts the set or the
// buttons off the sheet.

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PanelButton, Toggle } from "../controls.slint";
import { LightroomRoot, ReportLine } from "../structs.slint";

// A line of the report: its word in a column, then what it says.
component Line inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    in property <length> size: Theme.font-xs;
    spacing: Theme.space-2;
    Text {
        text: root.label;
        width: 88px;
        font-size: root.size;
        color: Theme.text-secondary;
    }
    // Its width said, so that its height is the wrapped text's and the
    // scroll measures the whole report.
    Text {
        text: root.text;
        width: max(40px, root.width - 88px - Theme.space-2);
        wrap: word-wrap;
        font-size: root.size;
        color: Theme.text;
    }
}

export component LightroomSheet inherits Rectangle {
    in-out property <bool> lr-open;
    /// 0 the roots, 1 the dry run's report, 2 what was written.
    in property <int> lr-step;
    in property <string> lr-title;
    in property <string> lr-subtitle;
    /// A word over the sheet: the catalog's log, a refusal, an error.
    in property <string> lr-note;
    in property <[LightroomRoot]> lr-roots;
    in-out property <string> lr-set;
    in property <bool> lr-has-creations;
    in-out property <bool> lr-creations: true;
    /// Frames whose sidecar has edits already; none hides the switch.
    in property <int> lr-already;
    in-out property <bool> lr-force: false;
    in property <[ReportLine]> lr-lines;
    /// What the write did: the report's lines from its "written" on.
    in property <[ReportLine]> lr-done;
    /// A dry run is reading, or the write writing; the buttons wait.
    in property <bool> lr-busy;
    in property <string> lr-busy-text;
    /// The write is writing: not even Cancel stops it. A dry run can be
    /// canceled, which stops it.
    in property <bool> lr-running;
    /// Something of the catalog was found: a write would carry it.
    in property <bool> lr-ready;
    callback lr-choose-root(int);
    callback lr-check();
    callback lr-back();
    callback lr-write();
    /// The sheet closed, a dry run under way stopped.
    callback lr-cancel();

    background: #000000a0;
    TouchArea { clicked => { if (!root.lr-running) { root.lr-cancel(); } } }
    Rectangle {
        width: min(600px, root.width - 2 * Theme.space-5);
        height: min(body.preferred-height, root.height - 2 * Theme.space-5);
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        clip: true;
        TouchArea { }
        body := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-2;
            // The head.
            Text {
                text: root.lr-title;
                font-size: Theme.font-lg;
                font-weight: Theme.weight-medium;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.lr-subtitle != "": Text {
                text: root.lr-subtitle;
                wrap: word-wrap;
                font-size: Theme.font-xs;
                color: Theme.text-secondary;
            }
            if root.lr-note != "": Text {
                text: root.lr-note;
                wrap: word-wrap;
                font-size: Theme.font-sm;
                color: Theme.label-red;
            }
            if root.lr-step == 0 && root.lr-roots.length > 0: Text {
                text: "Where each of the catalog's folders is now:";
                font-size: Theme.font-sm;
                color: Theme.text;
            }
            // What the write did, over the report it ends.
            if root.lr-step == 2: VerticalLayout {
                spacing: 2px;
                for l in root.lr-done: Line {
                    label: l.label;
                    text: l.text;
                    size: Theme.font-sm;
                }
            }

            // The middle, which scrolls: the roots, or the report.
            scroll := ScrollView {
                vertical-stretch: 1;
                min-height: root.lr-step == 0 && root.lr-roots.length == 0 ? 0px : 72px;
                preferred-height: list.preferred-height;
                content-height: list.preferred-height;
                content-width: self.visible-width;
                list := VerticalLayout {
                    width: scroll.visible-width;
                    spacing: root.lr-step == 0 ? Theme.space-2 : 2px;
                    if root.lr-step == 0: VerticalLayout {
                        spacing: Theme.space-2;
                        for r[i] in root.lr-roots: VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: r.catalog + (r.name != "" ? "  (" + r.name + ")" : "");
                                width: scroll.visible-width;
                                font-size: Theme.font-sm;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: Theme.space-2;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    // The folder by its own name, which a
                                    // long path's end would hide, then the
                                    // path.
                                    Text {
                                        text: r.local == "" ? "not found" : r.folder;
                                        color: r.local == "" ? Theme.text-muted : Theme.text;
                                        font-size: Theme.font-sm;
                                        overflow: elide;
                                    }
                                    if r.local != "": Text {
                                        text: r.local;
                                        color: Theme.text-muted;
                                        font-size: Theme.font-xs;
                                        overflow: elide;
                                    }
                                }
                                PanelButton {
                                    text: "Choose...";
                                    enabled: !root.lr-busy;
                                    clicked => { root.lr-choose-root(i); }
                                }
                            }
                            Text {
                                text: r.note;
                                width: scroll.visible-width;
                                wrap: word-wrap;
                                font-size: Theme.font-xs;
                                color: r.taken ? Theme.text-secondary : Theme.label-red;
                            }
                        }
                    }
                    if root.lr-step > 0: VerticalLayout {
                        spacing: 2px;
                        for l in root.lr-lines: Line {
                            label: l.label;
                            text: l.text;
                        }
                    }
                }
            }
            // The foot: the set and the switches, then the buttons.
            if root.lr-step == 0: VerticalLayout {
                spacing: Theme.space-2;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "Set";
                        width: 76px;
                        color: Theme.text;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.lr-set;
                        placeholder-text: "none: the collections at the top";
                    }
                }
                Text {
                    text: "The catalog's collections go under this set, its own sets inside it; the catalog's name unless changed, none when empty.";
                    wrap: word-wrap;
                    font-size: Theme.font-xs;
                    color: Theme.text-muted;
                }
                if root.lr-has-creations: Toggle {
                    label: "Books, prints, slideshows and web pages as collections";
                    checked <=> root.lr-creations;
                }
                if root.lr-already > 0: Toggle {
                    label: root.lr-already == 1
                        ? "Write over the 1 frame with edits here already"
                        : "Write over the " + root.lr-already + " frames with edits here already";
                    checked <=> root.lr-force;
                }
            }
            Rectangle { height: Theme.space-2; }
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;
                if root.lr-busy: Text {
                    text: root.lr-busy-text;
                    font-size: Theme.font-xs;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                if root.lr-step < 2: PanelButton {
                    text: "Cancel";
                    enabled: !root.lr-running;
                    clicked => { root.lr-cancel(); }
                }
                if root.lr-step == 1: PanelButton {
                    text: "Back";
                    enabled: !root.lr-busy;
                    clicked => { root.lr-back(); }
                }
                if root.lr-step == 0: PanelButton {
                    text: "Check";
                    primary: true;
                    enabled: !root.lr-busy && root.lr-roots.length > 0;
                    clicked => { root.lr-check(); }
                }
                if root.lr-step == 1: PanelButton {
                    text: "Write";
                    primary: true;
                    enabled: !root.lr-busy && root.lr-ready;
                    clicked => { root.lr-write(); }
                }
                if root.lr-step == 2: PanelButton {
                    text: "OK";
                    primary: true;
                    clicked => { root.lr-open = false; }
                }
            }
        }
        // A report longer than the sheet says that it goes on, laid over
        // the foot of its scroll rather than in the layout it measures.
        if root.lr-step > 0 && list.preferred-height > scroll.visible-height + 1px
            && scroll.content-y > scroll.visible-height - list.preferred-height + 1px: Rectangle {
            x: scroll.x;
            y: scroll.y + scroll.height - self.height;
            width: scroll.width;
            height: more.preferred-height + 6px;
            background: Theme.surface;
            more := Text {
                text: "The report goes on below: scroll for the rest.";
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                horizontal-alignment: right;
            }
        }
    }
}
