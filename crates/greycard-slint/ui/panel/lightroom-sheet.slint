// The Lightroom catalog import: the catalog's roots and where each
// stands, the set its collections go under, then the dry run's summary,
// then a write on its own thread and a line of what it wrote. Whatever
// else the report knows is under Details on both. Over everything until
// closed, and while it writes.
//
// The roots and the details scroll between a head and a foot that
// stay: a catalog of many roots, or long details, never puts the set
// or the buttons off the sheet.

import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PanelButton, Toggle } from "../controls.slint";
import { LightroomRoot, ReportLine } from "../structs.slint";

// A line of the details: its word in a column, then what it says.
component Line inherits HorizontalLayout {
    in property <string> label;
    in property <string> text;
    spacing: Theme.space-2;
    Text {
        text: root.label;
        width: 88px;
        font-size: Theme.font-xs;
        color: Theme.text-secondary;
    }
    // Its width said, so that its height is the wrapped text's and the
    // scroll measures the whole of the details.
    Text {
        text: root.text;
        width: max(40px, root.width - 88px - Theme.space-2);
        wrap: word-wrap;
        font-size: Theme.font-xs;
        color: Theme.text;
    }
}

// Details' header: a chevron and the word, a click folding them away
// and back.
component Fold inherits Rectangle {
    in-out property <bool> open;
    height: Theme.icon + Theme.space-1;
    accessible-role: button;
    accessible-label: "Details";
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.open = !root.open; }
    accessible-action-expand => { root.open = true; }
    HorizontalLayout {
        spacing: Theme.space-1;
        alignment: start;
        Image {
            source: @image-url("../icons/chevron-down.svg");
            colorize: head.has-hover ? Theme.text : Theme.text-secondary;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
            transform-rotation: root.open ? 0deg : -90deg;
            animate transform-rotation { duration: 120ms; easing: ease-out; }
        }
        Text {
            text: "Details";
            font-size: Theme.font-xs;
            color: head.has-hover ? Theme.text : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    head := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.open = !root.open; }
    }
}

export component LightroomSheet inherits Rectangle {
    in-out property <bool> lr-open;
    /// 0 the roots, 1 the dry run's summary, 2 what was written.
    in property <int> lr-step;
    in property <string> lr-title;
    in property <string> lr-subtitle;
    /// A word over the sheet: a refusal, an error.
    in property <string> lr-note;
    in property <[LightroomRoot]> lr-roots;
    in-out property <string> lr-set;
    in property <bool> lr-has-creations;
    in-out property <bool> lr-creations: true;
    /// Frames whose sidecar has edits already; none hides the switch.
    in property <int> lr-already;
    in-out property <bool> lr-force: false;
    /// The catalog copied without its -wal: what may be missing, and
    /// what to do. Empty when its log is whole.
    in property <string> lr-warning;
    in property <string> lr-remedy;
    /// The dry run in two or three short sentences.
    in property <string> lr-summary;
    /// What the write did, in one line.
    in property <string> lr-done;
    /// The rest of the report, under Details.
    in property <[ReportLine]> lr-details;
    /// A dry run is reading, or the write writing; the buttons wait.
    in property <bool> lr-busy;
    in property <string> lr-busy-text;
    /// The write is writing: not even Cancel stops it. A dry run can be
    /// canceled, which stops it.
    in property <bool> lr-running;
    /// Something of the catalog was found: a write would carry it.
    in property <bool> lr-ready;
    callback lr-choose-root(int);
    callback lr-check();
    callback lr-back();
    callback lr-write();
    /// The sheet closed, a dry run under way stopped.
    callback lr-cancel();
    /// Details unfolded; folded each time the sheet opens.
    property <bool> details-open: false;
    /// The middle has something to scroll: the roots, or the details
    /// unfolded.
    property <bool> shows-list: root.lr-step == 0 ? root.lr-roots.length > 0
        : root.details-open && root.lr-details.length > 0;

    background: #000000a0;
    TouchArea { clicked => { if (!root.lr-running) { root.lr-cancel(); } } }
    Rectangle {
        width: min(600px, root.width - 2 * Theme.space-5);
        height: min(body.preferred-height, root.height - 2 * Theme.space-5);
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000099;
        clip: true;
        TouchArea { }
        body := VerticalLayout {
            padding: Theme.space-5;
            spacing: Theme.space-2;
            // The head.
            Text {
                text: root.lr-title;
                font-size: Theme.font-lg;
                font-weight: Theme.weight-medium;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.lr-subtitle != "": Text {
                text: root.lr-subtitle;
                wrap: word-wrap;
                font-size: Theme.font-xs;
                color: Theme.text-secondary;
            }
            if root.lr-note != "": Text {
                text: root.lr-note;
                wrap: word-wrap;
                font-size: Theme.font-sm;
                color: Theme.label-red;
            }
            // The one thing that can lose work, over the summary.
            if root.lr-step > 0 && root.lr-warning != "": VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.lr-warning;
                    wrap: word-wrap;
                    font-size: Theme.font-sm;
                    color: Theme.label-red;
                }
                Text {
                    text: root.lr-remedy;
                    wrap: word-wrap;
                    font-size: Theme.font-xs;
                    color: Theme.text-secondary;
                }
            }
            // What the dry run found, or what the write did.
            if root.lr-step > 0: Text {
                text: root.lr-step == 1 ? root.lr-summary : root.lr-done;
                wrap: word-wrap;
                font-size: Theme.font-sm;
                color: Theme.text;
            }
            // Details' header and the middle, which scrolls: the roots, or
            // the details. Folded, the empty scroll takes no spacing.
            middle := VerticalLayout {
                vertical-stretch: 1;
                spacing: root.shows-list ? Theme.space-2 : 0px;
                if root.lr-step > 0 && root.lr-details.length > 0: Fold {
                    open <=> root.details-open;
                }

                scroll := ScrollView {
                    vertical-stretch: 1;
                    min-height: root.shows-list ? 72px : 0px;
                    preferred-height: root.shows-list ? list.preferred-height : 0px;
                    content-height: list.preferred-height;
                    content-width: self.visible-width;
                    visible: root.shows-list;
                    list := VerticalLayout {
                        width: scroll.visible-width;
                        if root.lr-step == 0: VerticalLayout {
                            spacing: Theme.space-2;
                            // A root a line: its folder's name, where it
                            // stands, and Choose... to say where it is.
                            for r[i] in root.lr-roots: HorizontalLayout {
                                spacing: Theme.space-2;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: Theme.space-2;
                                        Text {
                                            text: r.name;
                                            color: Theme.text;
                                            font-size: Theme.font-sm;
                                            overflow: elide;
                                            horizontal-stretch: 0;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: r.state;
                                            color: r.taken ? Theme.text-secondary : Theme.label-red;
                                            font-size: Theme.font-sm;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // Where it was taken, so that a guess at
                                    // the wrong folder of the name shows here,
                                    // and the catalog's path when the name
                                    // alone could be another root's.
                                    if r.under != "": Text {
                                        text: r.under;
                                        color: Theme.text-muted;
                                        font-size: Theme.font-xs;
                                        overflow: elide;
                                    }
                                }
                                PanelButton {
                                    text: "Choose...";
                                    enabled: !root.lr-busy;
                                    clicked => { root.lr-choose-root(i); }
                                }
                            }
                        }
                        if root.lr-step > 0 && root.details-open: VerticalLayout {
                            spacing: 2px;
                            for l in root.lr-details: Line {
                                label: l.label;
                                text: l.text;
                            }
                        }
                    }
                }
            }
            // The foot: the set and the switches, then the buttons.
            if root.lr-step == 0: VerticalLayout {
                spacing: Theme.space-2;
                HorizontalLayout {
                    spacing: Theme.space-2;
                    Text {
                        text: "Collection set";
                        color: Theme.text;
                        font-size: Theme.font-sm;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.lr-set;
                        placeholder-text: "none: the collections at the top";
                    }
                }
                if root.lr-has-creations: Toggle {
                    label: "Books, prints, slideshows, and web pages as collections";
                    checked <=> root.lr-creations;
                }
                if root.lr-already > 0: Toggle {
                    label: root.lr-already == 1
                        ? "Write over the 1 frame with edits here already"
                        : "Write over the " + root.lr-already + " frames with edits here already";
                    checked <=> root.lr-force;
                }
            }
            Rectangle { height: Theme.space-2; }
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: end;
                if root.lr-busy: Text {
                    text: root.lr-busy-text;
                    font-size: Theme.font-xs;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                if root.lr-step < 2: PanelButton {
                    text: "Cancel";
                    enabled: !root.lr-running;
                    clicked => { root.lr-cancel(); }
                }
                if root.lr-step == 1: PanelButton {
                    text: "Back";
                    enabled: !root.lr-busy;
                    clicked => { root.lr-back(); }
                }
                if root.lr-step == 0: PanelButton {
                    text: "Check";
                    primary: true;
                    enabled: !root.lr-busy && root.lr-roots.length > 0;
                    clicked => { root.lr-check(); }
                }
                if root.lr-step == 1: PanelButton {
                    text: "Write";
                    primary: true;
                    enabled: !root.lr-busy && root.lr-ready;
                    clicked => { root.lr-write(); }
                }
                if root.lr-step == 2: PanelButton {
                    text: "OK";
                    primary: true;
                    clicked => { root.lr-open = false; }
                }
            }
        }
        // Details longer than the sheet say that they go on, laid over
        // the foot of their scroll rather than in the layout it measures.
        if root.shows-list && root.lr-step > 0 && list.preferred-height > scroll.visible-height + 1px
            && scroll.content-y > scroll.visible-height - list.preferred-height + 1px: Rectangle {
            x: middle.x + scroll.x;
            y: middle.y + scroll.y + scroll.height - self.height;
            width: scroll.width;
            height: more.preferred-height + 6px;
            background: Theme.surface;
            more := Text {
                text: "Scroll for more";
                font-size: Theme.font-xs;
                color: Theme.text-muted;
                horizontal-alignment: right;
            }
        }
    }
}
