// The structs App's properties carry, which Rust reads and writes
// as generated types; here so the panel's files can name them too.

/// A line of the keys sheet (`keys.rs`): a group's heading, its title
/// in `keys`, or a binding, its keys as the platform names them and
/// what they do.
export struct KeyRow {
    heading: bool,
    keys: string,
    does: string,
}

/// A row of the Settings sheet's Keys section (`keys.rs`): a group's
/// heading in `does`, or an action by its settings name, its chord as
/// the platform names it, what it does, and what else has the chord,
/// empty when nothing does.
export struct BindRow {
    heading: bool,
    id: string,
    keys: string,
    does: string,
    also: string,
}

/// A row of the list of what a sheet carries (`carry.rs`): a
/// section's heading, a part or a mask under it, or the line that
/// says whether the masks replace the frames' or join them. Rust lays
/// the list out: which of two columns, which line of it, and for a
/// part which half of the line.
export struct CarryRow {
    label: string,
    /// The name a screen reader and a test know it by: a part's says
    /// its section too ("Detail: Dehaze"). Empty for the masks' line,
    /// whose two choices are known by their words.
    a11y: string,
    /// 0 a heading, 1 a part or a mask, 2 how the masks land.
    kind: int,
    /// 0 off, 1 some of a heading's parts, 2 on; for the masks' line,
    /// 1 when they join.
    state: int,
    col: int,
    line: int,
    sub: int,
}

/// A root of a Lightroom catalog on the import sheet: its folder's
/// name, the catalog's path to it, the line under the name (where it
/// was taken, and the catalog's path when another root goes by the
/// same name; empty for neither), where it stands in a few words, and
/// whether its files were found.
export struct LightroomRoot {
    name: string,
    catalog: string,
    under: string,
    state: string,
    taken: bool,
}

/// A line of the Lightroom import's report: its word, empty for a line
/// going on from the one before, and what it says.
export struct ReportLine {
    label: string,
    text: string,
}

/// A point on the view, logical pixels.
export struct Pt {
    x: float,
    y: float,
}

/// The color under the pointer, one mark of it on the scope: where,
/// as fractions of the scope's picture, and what it marks, 0 to 2 a
/// channel and 3 the luma (`scope::Mark`).
export struct ScopeMark {
    x: float,
    y: float,
    channel: int,
}

export struct Thumb {
    name: string,
    image: image,
    /// The lightbox's picture of the frame, the size of its tile: the
    /// picture of its edit, or the camera's for a frame with none.
    /// Empty but for the rows the lightbox has a tile for.
    big: image,
    /// The lightbox waits for the picture of the frame's edit: what
    /// `big` holds (an edit since replaced) is drawn dimmed, and a tile
    /// with nothing says Developing.
    pending: bool,
    /// The frame's meta, as the badges want it: stars, the flag (1 a
    /// pick, 2 a reject) and the color label (1 to 5). Rust owns what
    /// the numbers mean; see `greycard_edit::meta`.
    rating: int,
    flag: int,
    label: int,
    /// In the selection's set. The current frame, the one the
    /// viewport shows, is `selected`'s row and is always in it.
    chosen: bool,
    /// No picture could be made of the file (damaged, truncated, a
    /// format the decoder refuses): the cell says so rather than
    /// staying empty as if one were on its way.
    failed: bool,
    /// The frame is under a root of the library that is offline (a
    /// drive unplugged): listed from the index, drawn dimmed, its
    /// picture from the cache if one is there.
    offline: bool,
    /// The frame's edit is not the default, and an export of it is
    /// on record: the two marks in the corner of its picture. Rust
    /// owns what they mean; see `greycard_library::develop_marks`.
    edited: bool,
    exported: bool,
    /// The picture is in a collection: a third mark beside those two.
    collected: bool,
    /// The camera's JPEG of the frame is beside its raw, and goes where
    /// it goes: a fourth mark. Only on the file's own cell.
    paired: bool,
    /// The version of the file the cell is, by its name ("Warm"): a
    /// tag on its picture, and the grid's label under it. Empty for
    /// the file's own.
    version: string,
    /// The frame is in a stack the list shows: how many frames the
    /// stack shows, 0 for none; its place in it from 1, the top's; and
    /// whether the stack is open. A closed stack's top alone carries
    /// it, and an open stack's every member.
    stack: int,
    stack-place: int,
    stack-open: bool,
}

/// One of the strip's or the grid's cells: the browser's row it
/// shows, and that row. A view has cells only for the rows on screen
/// and a margin round them (`cells.rs`).
export struct ThumbCell {
    row: int,
    thumb: Thumb,
}

/// A box drawn for an object, on the view, logical pixels.
export struct MaskBox {
    x: float,
    y: float,
    w: float,
    h: float,
}

/// A person a part may be of, outlined on the view while one is to
/// be picked: their face's box, logical pixels, and whether it is the
/// guess, drawn more strongly (a highlight, never a pick).
export struct PersonBox {
    x: float,
    y: float,
    w: float,
    h: float,
    guess: bool,
}

/// A pick for an object on the view: on it, or not on it.
export struct MaskPick {
    x: float,
    y: float,
    positive: bool,
}

/// One frame of the culling loupe's compare view: its box on the
/// view, logical pixels, its name, whether it is the selection, and
/// its stars, flag and label as `Thumb` has them, for its badge.
export struct CompareTile {
    x: float,
    y: float,
    w: float,
    h: float,
    name: string,
    on: bool,
    rating: int,
    flag: int,
    label: int,
}

/// One chip of the browser's filter: what it asks, how many frames
/// would be left if it were the only thing that changed, whether it
/// is on, and which flag or color it stands for. Rust owns what the
/// number means; see `greycard_ui::filter`.
export struct FilterChip {
    text: string,
    count: int,
    on: bool,
    code: int,
}

/// A keyword on the selection, in the METADATA section: the word, and
/// whether every frame chosen carries it (one on only some is dimmed).
export struct KeywordChip {
    word: string,
    all: bool,
}

/// One chip of an EXIF facet: what it shows, the value it hands
/// back when pressed, how many frames hold that value among the
/// frames the other tests leave, and whether it is on. The count is
/// the index's, one GROUP BY a facet; see `greycard_ui::library`.
export struct FacetChip {
    text: string,
    key: string,
    count: int,
    on: bool,
}

/// The filter bar's Sort menu, as the view's choice has it: Rust owns
/// every word and which entry is checked.
export struct SortMenu {
    /// The order chosen, "Capture time", "Hand order".
    words: string,
    /// The same in the count's line, "7 of 7 · capture time": lowercase,
    /// with no way up, which the button's arrows say.
    label: string,
    /// The button's tip and its accessible name: "Sort: Capture time,
    /// oldest first".
    tip: string,
    /// The menu's entries: "Hand order" first in a collection's, then
    /// each order.
    entries: [string],
    /// The entry checked.
    checked: int,
    /// The two ways up of the order chosen, "Oldest first" and "Newest
    /// first"; none for a collection's hand order, which has no way up.
    ways: [string],
    descending: bool,
}

/// A collection's row in the left pane.
export struct CollectionChip {
    /// The id its file is named by.
    id: string,
    name: string,
    /// The sets it sits in, slashed (`Clients/2026`); empty for none.
    set: string,
    /// Its frames, the missing among them; unused for a smart one.
    count: int,
    on: bool,
    /// A saved filter, not a list.
    smart: bool,
    /// It is in an order chosen rather than its own: what the row's
    /// "Capture order" checks, which takes it back to its own.
    capture: bool,
    /// That order, as the row says it while it is open ("capture
    /// time"); empty for its own.
    order: string,
}

/// One of the library's roots, as the grid's left pane lists it: the
/// folder's name, its path (what a press hands back), how many files
/// the index holds under it, and whether the browser shows it.
export struct RootChip {
    name: string,
    path: string,
    count: int,
    on: bool,
    /// Not there now: a drive unplugged. Its files are left out of
    /// the view and its rows as they were.
    offline: bool,
    /// Marked as an archive (§197): a mark on its row, and its menu's
    /// toggle checked.
    archive: bool,
}

/// A folder in Recently opened: how the list says it (its name, and
/// the root it is under or the folder it is in), its path, and whether
/// it is the one open.
export struct RecentFolder {
    title: string,
    path: string,
    open: bool,
}

/// A folder in the open root's tree, as the left pane shows it: its
/// name and path, how deep under the root, its count (the frames
/// directly in it, or folded, all those under it; -1 for none shown),
/// whether it has folders under it and shows them, and whether it is
/// the one open.
export struct FolderRow {
    name: string,
    path: string,
    depth: int,
    count: int,
    children: bool,
    expanded: bool,
    open: bool,
}

/// A folder under the one open, as a tile at the top of the grid: its
/// name, the frames under it as the tree counts them, and whether its
/// root is offline (dimmed, and no reveal).
export struct FolderTile {
    name: string,
    count: int,
    offline: bool,
}

/// A facet's row of chips: its caption, which facet it is (its place
/// in `greycard_library::Facet::ALL`), and the chips.
export struct FacetRow {
    name: string,
    code: int,
    chips: [FacetChip],
}

/// One row of the history, newest first: a state, named for what it
/// changed, or an export made from the state below it, marked as a
/// record with when it was written. `undone` when its state is one
/// undone and waiting to be redone. Rust owns the order; see
/// `greycard_edit::Sidecar::rows`.
export struct HistoryRow {
    name: string,
    exported: bool,
    time: string,
    undone: bool,
}

/// One group on the camera match sheet: its look's name, the line that
/// says what the fit will do with it, and whether it is checked.
export struct MatchGroup {
    name: string,
    text: string,
    checked: bool,
}

/// One row of the LOOK section's list: a group's heading (a body, or
/// the general looks) or a look. Rust builds them
/// (`greycard_edit::look::grouped`).
export struct LookRow {
    heading: bool,
    /// A look: what the edit stores. A heading: the group's key, which
    /// a click toggles.
    name: string,
    label: string,
    /// A look: the display curves it has a table for, "per channel ·
    /// AgX", when it is made per curve. A heading: its count of looks.
    note: string,
    /// A look with no table for this picture's curve, drawn dimmed.
    off: bool,
    /// A heading folded.
    folded: bool,
    /// A heading for the open frame's own body.
    own: bool,
    /// A look under a heading, set in under its text.
    indented: bool,
}

/// One set of the export queue as the export sheet lists it: the
/// preset it was queued under (the format when none), its frames, and
/// where it goes; `running` while it is the set the queue is on.
export struct QueueRow {
    name: string,
    frames: string,
    folder: string,
    running: bool,
}
